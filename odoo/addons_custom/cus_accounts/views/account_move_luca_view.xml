<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cus_accounts_view_move_form_2" model="ir.ui.view">
            <field name="name">cus_accounts_view_move_form_2</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="view_move_form_cus_accounts"/>
            <field name="arch" type="xml">
                <field name="x_document" position="after">
                    <field name="x_luca_entry_state" string="Luca (Status)" widget="state_selection" attrs="{'invisible':[('company_id', '!=', 2)]}"/>
                    <field name="x_odoo_entry_state" string="Odoo (Status)" widget="state_selection" attrs="{'invisible':[('company_id', '!=', 2)]}"/>
                </field>
            </field>
        </record>

        <record id="view_move_luca_tree" model="ir.ui.view">
            <field name="name">view_move_luca_tree</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" string="Journal Entries" decoration-muted="state == 'cancel'">
                    <field name="id" optional="show"/>
                    <field name="date"/>
                    <field name="name"/>
                    <field name="partner_id" optional="show"/>
                    <field name="ref" optional="show"/>
                    <field name="journal_id" optional="hide"/>
                    <field name="x_related_purchase_id" optional="hide"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                    <field name="amount_total" sum="Total Amount" string="Amount Currency" optional="show"/>
                    <field name="x_rate" string="Currency Rate (DB)" optional="hide"/>
                    <field name="x_je_rate" string="Currency Rate (JE)" optional="show"/>
                    <field name="amount_total_signed" sum="Total Amount" string="Total (USD)" optional="show"/>
                    <field name="x_amount_total_try" sum="Total Amount" string="Total (TRY)" optional="show"/>
                    <field name="state" optional="hide"/>

                    <field name="x_odoo_entry_state" widget="state_selection" optional="show"/>
                    <field name="x_compute_odoo_status" invisible="1"/>
                    <button string="Odoo (OK)" name="change_odoo_state_to_done" type="object" icon="fa-check"/>
                    <button string="Odoo (Discuss)" name="change_odoo_state_to_normal" type="object" icon="fa-bell"/>
                    <button string="Odoo (Error)" name="change_odoo_state_to_blocked" type="object" icon="fa-warning"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="x_analytic_tag_ids" widget="many2many_tags" optional="show"/>
                    <field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                    <field name="x_document_name" invisible="1"/>
                    <field name="x_document" widget="download_link" filename="x_document_name"/>
                    <field name="x_attachment_ids" invisible="1"/>
                    <button string="Download Attachments" name="action_download_attachments" type="object" icon="fa-download"
                            attrs="{'invisible': [('x_attachment_ids', '=', [])]}"/>

                    <field name="x_luca_entry_state" widget="state_selection" optional="show"/>
                    <button string="Luca (Posted)" name="change_luca_state_to_done" type="object" icon="fa-check"/>
                    <button string="Luca (Not Posted)" name="change_luca_state_to_pending" type="object" icon="fa-times"/>
                    <button string="Luca (Error)" name="change_luca_state_to_blocked" type="object" icon="fa-warning"/>
                </tree>
            </field>
        </record>

        <record id="view_move_luca_search" model="ir.ui.view">
           <field name="name">view_move_luca_search</field>
           <field name="model">account.move</field>
            <field name="arch" type="xml">
                <search string="Search Move">
                    <field name="name" string="Journal Entry"
                           filter_domain="['|', '|', '|', '|', '|',
                           ('name', 'ilike', self),
                           ('ref', 'ilike', self),
                           ('partner_id', 'ilike', self),
                           ('id', 'ilike', self),
                           ('x_account_id', 'ilike', self),
                           ('x_analytic_tag_ids', 'ilike', self),
                           ]"/>
                    <field name="x_account_id"/>
                    <field name="x_product_id" filter_domain="['|', ('x_product_id', 'ilike', self), ('x_name', 'ilike', self), ]"/>
                    <field name="date"/>
                    <field name="partner_id"/>
                    <field name="journal_id"/>
                    <field name="x_tag_ids"/>
                    <field name="x_analytic_tag_ids"/>
                    <filter string="Unposted" name="unposted" domain="[('state', '=', 'draft')]" help="Unposted Journal Entries"/>
                    <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]" help="Posted Journal Entries"/>
                    <separator/>
                    <filter name="in_payment" string="In Payment" domain="[('invoice_payment_state', '=', 'in_payment'), ('state', '=', 'posted')]"/>
                    <filter name="paid" string="Paid" domain="[('invoice_payment_state', '=', 'paid'), ('state', '=', 'posted')]"/>
                    <filter name="unpaid" string="Not Paid" domain="[('invoice_payment_state', '=', 'not_paid'), ('state', '=', 'posted')]"/>
                    <filter name="late" string="Overdue" domain="['&amp;', ('invoice_date_due', '&lt;', time.strftime('%Y-%m-%d')), ('state', '=', 'posted'), ('invoice_payment_state', '=', 'not_paid')]" help="Overdue invoices, maturity date passed"/>
                    <separator/>
                    <filter string="To Check" name="to_check" domain="[('to_check', '=', True)]"/>
                    <separator/>
                    <filter name="reported" string="Reported" domain="[('x_unreported', '=', False)]"/>
                    <filter name="inside_fz" string="Unreported (Inside FZ)" domain="[('x_unreported', '=', 'inside_fz')]"/>
                    <filter name="outside_fz" string="Unreported (Outside FZ)" domain="[('x_unreported', '=', 'outside_fz')]"/>
                    <separator/>
                    <filter name="document_attached" string="Documents Attached"
                            domain="['|', ('x_attachment_ids', '!=', False), ('x_document', '!=', False)]"/>
                    <filter name="document_not_attached" string="Documents not Attached"
                            domain="[('x_attachment_ids', '=', False), ('x_document', '=', False)]"/>
                    <separator/>
                    <filter name="try_currency" string="TRY Currency" domain="[('currency_id', '=', 31)]"/>
                    <filter name="other_currency" string="Other Currency" domain="[('currency_id', '!=', 31)]"/>
                    <separator/>
                    <filter name="currency_rate_error" string="Currency Error" domain="[('x_currency_error', '!=', False)]"/>
                    <separator/>
                    <filter name="purchase_bill" string="PO Bills" domain="[('x_move_type', '=', 'purchase_bill')]"/>
                    <filter name="related_bill" string="PO Related EXP Bills" domain="[('x_move_type','=','related_bill')]"/>
                    <filter name="landed_cost_bill" string="PO Related LC Bills" domain="[('x_move_type','=','landed_cost_bill')]"/>
                    <separator/>
                    <filter name="luca_blocked" string="Luca (Error)" domain="[('x_luca_entry_state', '=', 'blocked')]"/>
                    <filter name="luca_done" string="Luca (Posted)" domain="[('x_luca_entry_state', '=', 'done')]"/>
                    <filter name="luca_pending" string="Luca (Not Posted)" domain="[('x_luca_entry_state','=','pending')]"/>
                    <separator/>
                    <filter name="odoo_blocked" string="Odoo (Error)" domain="[('x_odoo_entry_state', '=', 'blocked')]"/>
                    <filter name="odoo_done" string="Odoo (OK)" domain="[('x_odoo_entry_state', '=', 'done')]"/>
                    <filter name="odoo_normal" string="Odoo (Discuss)" domain="[('x_odoo_entry_state','=','normal')]"/>
                    <separator/>
                    <filter string="Sales" name="sales" domain="[('journal_id.type', '=', 'sale')]" context="{'default_journal_type': 'sale'}"/>
                    <filter string="Purchases" name="purchases" domain="[('journal_id.type', '=', 'purchase')]" context="{'default_journal_type': 'purchase'}"/>
                    <filter string="Bank" name="bankoperations" domain="[('journal_id.type', '=', 'bank')]" context="{'default_journal_type': 'bank'}"/>
                    <filter string="Cash" name="cashoperations" domain="[('journal_id.type', '=', 'cash')]" context="{'default_journal_type': 'cash'}"/>
                    <filter string="Miscellaneous" name="misc_filter" domain="[('journal_id.type', '=', 'general')]" context="{'default_journal_type': 'general'}"/>
                    <separator/>
                    <filter string="Date" name="date" date="date"/>
                    <separator/>
                    <filter string="Current Month" name="current_month"
                            domain="[
                            ('date', '&lt;', (context_today() + relativedelta(months=1)).strftime('%%Y-%%m-01')),
                            ('date','&gt;=', time.strftime('%%Y-%%m-01'))
                            ]"/>
                    <filter string="Previous Month" name="previous_month"
                            domain="[
                            ('date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%%Y-%%m-01')),
                            ('date', '&lt;', time.strftime('%%Y-%%m-01'))
                            ]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Partner" name="partner" domain="[]" context="{'group_by': 'partner_id'}"/>
                        <filter string="Journal" name="journal" domain="[]" context="{'group_by': 'journal_id'}"/>
                        <filter string="Status (Entry)" name="status_entry" domain="[]" context="{'group_by': 'state'}"/>
                        <filter string="Status (Luca)" name="status_luca" domain="[]" context="{'group_by': 'x_luca_entry_state'}"/>
                        <filter string="Status (Odoo)" name="status_odoo" domain="[]" context="{'group_by': 'x_odoo_entry_state'}"/>
                        <filter string="Status (Payment)" name="status_payment" domain="[]" context="{'group_by': 'invoice_payment_state'}"/>
                        <filter string="Purchase Order" name="related_purchase_order" domain="[]" context="{'group_by': 'x_related_purchase_id'}"/>
                        <filter string="Bill Type" name="bill_type" domain="[]" context="{'group_by': 'x_move_type'}"/>
                        <filter string="Unreported" name="unreported" domain="[]" context="{'group_by': 'x_unreported'}"/>
                        <filter string="Related PO" name="related_purchase_order" domain="[]" context="{'group_by': 'x_related_purchase_id'}"/>
                        <filter string="Date" name="by_date" domain="[]" context="{'group_by': 'date'}" help="Journal Entries by Date"/>
                        <filter string="Company" name="by_company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                        <filter string="Created On" name="create_day" domain="[]" context="{'group_by': 'create_date:day'}"/>
                        <filter string="Created By" name="created_by" domain="[]" context="{'group_by':'create_uid'}"/>
                    </group>
                </search>
           </field>
        </record>

        <record id="view_move_luca_action" model="ir.actions.act_window">
            <field name="name">Luca View</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{
                'search_default_posted': 1,
                'search_default_by_date': 1,
            }</field>
            <field name="domain">[
                ('company_id', '=', 2)
             ]</field>
            <field name="view_id" ref="view_move_luca_tree"/>
            <field name="search_view_id" ref="view_move_luca_search"/>
        </record>

        <menuitem id="menu_move_luca_status"
                  name="Luca View"
                  parent="account.menu_finance"
                  sequence="5"
                  action="view_move_luca_action"
                  groups="account.group_account_user"/>

        <record id="action_download_attached_documents" model="ir.actions.server">
            <field name="name">Download Attachments</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                    action = records.action_download_attachments()
            </field>
        </record>
    </data>
</odoo>
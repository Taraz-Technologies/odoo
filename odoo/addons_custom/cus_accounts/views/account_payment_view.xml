<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_account_payment_search_cus_accounts" model="ir.ui.view">
            <field name="name">view_account_payment_search_cus_accounts</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_search"/>
            <field name="arch" type="xml">
                <data>
                    <field name="name" position="after">
                        <field name="amount"/>
                    </field>
                    <filter name="currency" position="after">
                        <separator/>
                        <filter string="Created On" name="create_day" domain="[]" context="{'group_by': 'create_date:day'}"/>
                        <filter string="Created By" name="created_by" domain="[]" context="{'group_by':'create_uid'}"/>
                    </filter>
                </data>
            </field>
        </record>
    </data>
</odoo>
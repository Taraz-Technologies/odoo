<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cus_accounts_view_currency_rate_tree" model="ir.ui.view">
            <field name="name">cus_accounts_view_currency_rate_tree</field>
            <field name="model">res.currency.rate</field>
            <field name="inherit_id" ref="base.view_currency_rate_tree"/>
            <field name="arch" type="xml">
                <field name="rate" position="after">
                    <field name="x_rate_buying" digits="[12,12]"/>
                    <field name="x_rate_selling" digits="[12,12]"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
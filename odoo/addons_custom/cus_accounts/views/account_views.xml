<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cus_accounts_view_account_journal_form" model="ir.ui.view">
            <field name="name">cus_accounts_view_account_journal_form</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <field name="type" position="after">
                    <field name="x_short_code"/>
                </field>
                <page name="advanced_settings" position="after">
                    <page name="invoice_bill_settings" string="Invoice/Bill Settings"
                          attrs="{'invisible': [('type', 'not in', ('sale', 'purchase'))]}">
                        <group>
                            <group>
                                <field name="x_hide_paid_banner"/>
                                <field name="x_remove_down_payment_lines"
                                       attrs="{'invisible': [('type', '!=', 'sale')]}"/>
                            </group>
                            <group>
                                <field name="x_create_bills" attrs="{'invisible': [('type', '!=', 'sale')]}"/>
                                <field name="x_attach_invoices" attrs="{'invisible': [('type', '!=', 'purchase')]}"/>
                                <field name="x_attach_pickings" attrs="{'invisible': [('type', '!=', 'purchase')]}"/>
                            </group>
                        </group>
                        <separator colspan="4" string="Journal Default Products"
                                   attrs="{'invisible': [('type', '!=', 'purchase')]}"/>
                        <field name="x_product_ids" attrs="{'invisible': [('type', '!=', 'purchase')]}"/>
                    </page>
                </page>
            </field>
        </record>

        <record id="cus_accounts_view_account_journal_tree" model="ir.ui.view">
            <field name="name">cus_accounts_view_account_journal_tree</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_tree"/>
            <field name="arch" type="xml">
                <field name="type" position="after">
                    <field name="x_short_code" string="Bank Short Code"/>
                </field>
                <field name="name" position="after">
                    <field name="bank_id"/>
                    <field name="bank_account_id"/>
                    <field name="code" string="JE Short Code"/>
                    <field name="default_debit_account_id" optional="hide"/>
                    <field name="default_credit_account_id" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="cus_accounts_view_account_form" model="ir.ui.view">
            <field name="name">cus_accounts_view_account_form</field>
            <field name="model">account.account</field>
            <field name="inherit_id" ref="account.view_account_form"/>
            <field name="arch" type="xml">
                <field name="tax_ids" position="before">
                    <field name="x_gl_type_id"/>
                    <field name="x_gl_group_id"/>
                </field>
                <field name="deprecated" position="after">
                    <field name="x_parent_id"/>
                    <field name="x_is_otb_account"/>
                    <field name="x_main_account_id" attrs="{'invisible': [('x_is_otb_account', '=', False)]}"/>
                    <field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="write_uid" invisible="1"/>
                </field>
                <xpath expr="//group" position="after">
                    <group name="journals" string="Journals">
                    <field name="x_journal_ids" nolabel="1"/>
                    </group>
                </xpath>
                <xpath expr="/form/sheet" position="after">
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                        <field name="activity_ids" widget="mail_activity"/>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="cus_accounts_view_account_list" model="ir.ui.view">
            <field name="name">cus_accounts_view_account_list</field>
            <field name="model">account.account</field>
            <field name="inherit_id" ref="account.view_account_list"/>
            <field name="arch" type="xml">
                <field name="user_type_id" position="after">
                    <field name="x_gl_type_id" optional="show"/>
                    <field name="x_gl_group_id" optional="show"/>
                    <field name="x_parent_id"/>
                    <field name="x_main_account_id" optional="show"/>
                    <field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                    <field name="write_uid" optional="hide"/>
                </field>
                <field name="company_id" position="attributes">
                    <attribute name="optional">hide</attribute>
                </field>
                <field name="name" position="after">
                    <field name="x_journal_ids" widget="many2many_tags" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="cus_accounts_view_account_search" model="ir.ui.view">
            <field name="name">cus_accounts_view_account_search</field>
            <field name="model">account.account</field>
            <field name="inherit_id" ref="account.view_account_search"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="x_gl_type_id"/>
                    <field name="x_gl_group_id"/>
                    <field name="note"/>
                    <field name="x_parent_id"/>
                    <field name="x_main_account_id"/>
                    <field name="x_notes"/>
                    <field name="x_luca_name"/>
                    <field name="x_quickbooks_name"/>
                    <field name="x_tag_ids"/>
                </field>
                <filter name="used" position="after">
                    <filter string="Account without Entries" name="not_used" domain="[('used', '=', False)]"/>
                    <separator/>
                    <filter string="ITB Accounts" name="itb_accounts" domain="[('x_is_otb_account', '=', False)]"/>
                    <filter string="OTB Accounts" name="otb_accounts" domain="[('x_is_otb_account', '!=', False)]"/>
                </filter>
                <filter name="accounttype" position="after">
                    <filter string="Account GL Type" name="gl_type_id" context="{'group_by':'x_gl_type_id'}"/>
                    <filter string="Account GL Group" name="gl_group_id" context="{'group_by':'x_gl_group_id'}"/>
                    <filter string="Group" name="group_id" context="{'group_by':'group_id'}"/>
                    <filter string="Parent Account" name="parent_id" domain="" context="{'group_by':'x_parent_id'}"/>
                    <filter string="Parent Account 1" name="groupby_x_parent_id_1" context="{'group_by': 'x_parent_id_1'}"/>
                    <filter string="Parent Account 2" name="groupby_x_parent_id_2" context="{'group_by': 'x_parent_id_2'}"/>
                    <filter string="Parent Account 3" name="groupby_x_parent_id_3" context="{'group_by': 'x_parent_id_3'}"/>
                    <filter string="Parent Account 4" name="groupby_x_parent_id_4" context="{'group_by': 'x_parent_id_4'}"/>
                    <filter string="Parent Account 5" name="groupby_x_parent_id_5" context="{'group_by': 'x_parent_id_5'}"/>
                    <filter string="Currency" name="currency_id" context="{'group_by':'currency_id'}"/>
                    <filter string="Last Modified" name="by_last_modified" context="{'group_by': 'write_uid'}"/>
                </filter>
            </field>
        </record>

        <record id="view_account_account_gl_group_form" model="ir.ui.view">
            <field name="name">view_account_account_gl_group_form</field>
            <field name="model">account.account.gl.group</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="x_name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_account_account_gl_type_form" model="ir.ui.view">
            <field name="name">view_account_account_gl_type_form</field>
            <field name="model">account.account.gl.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="x_name"/>
                            <field name="x_gl_group_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
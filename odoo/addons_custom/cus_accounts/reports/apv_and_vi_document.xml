<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Custom Header with Logo for Third Page -->
    <template id="custom_header_with_logo">
            <div class="header" style="padding-top: 10px;">
                <img src="/cus_accounts/static/description/bank_alfalah_logo.png" alt="Bank Alfalah Islamic" style="width: 300px; height= 100px;"/>
            </div>
    </template>

    <!-- Custom Header for Fourth Page with "ANNEXURE A" Style -->
    <template id="custom_header_annexure_a">
            <div class="header" style="text-align: right; padding-top: 80px;">
                <span style="font-weight: bold; font-size: 18px;">ANNEXURE A</span>
                <div style="text-align: left; padding-top: 5px;">
                    <span style="font-size: 16px; color: #4682B4;">Format for Customer’s undertaking for Trade Pricing</span>
                    <hr style="border-top: 1px dashed black; margin-top: 5px;"/>
                </div>
            </div>
    </template>



    <template id="report_apv_and_vi_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                 <t t-set="fixed_company" t-value="env['res.company'].browse(1)"/>

                <!-- First Body Section with Standard Header and Footer -->
                <t t-call="web.external_layout">
                    <t t-set="company" t-value="fixed_company"/>
                    <div class="page">
                        <div class="row">
                            <div class="col" style="text-align: justify;">
                                <span t-raw="doc.x_body1_apv"/>
                            </div>
                        </div>
                    </div>
<!--                </t>-->

<!--                &lt;!&ndash; Second Body Section with Standard Header and Footer (New Page) &ndash;&gt;-->
<!--                <t t-call="web.external_layout">-->
<!--                    <t t-set="company" t-value="fixed_company"/>-->
                    <div class="page" style="page-break-before: always;">
                        <div class="row">
                            <div class="col" style="text-align: justify;">
                                <span t-raw="doc.x_body2_apv"/>
                            </div>
                        </div>
                    </div>
                </t>


                <div class="article o_report_layout_standard" t-att-data-oe-model="doc and doc._name" t-att-data-oe-id="doc and doc.id">
                <!-- Third Body Section with Logo Header, No Footer (New Page) -->
                <t t-call="cus_accounts.custom_header_with_logo"/>
                    <div class="page" style="page-break-before: always;">
                        <div class="row">
                            <div class="col" style="text-align: justify;">
                                <span t-raw="doc.x_body3_apv"/>
                            </div>
                        </div>
                    </div>
<!--                </t>-->
                </div>

                <div class="article o_report_layout_standard" t-att-data-oe-model="doc and doc._name" t-att-data-oe-id="doc and doc.id">

                <!-- Fourth Body Section with "ANNEXURE A" Header, No Footer (New Page) -->
                <t t-call="cus_accounts.custom_header_annexure_a"/>
                    <div class="page" style="page-break-before: always;">
                        <div class="row">
                            <div class="col" style="text-align: justify;">
                                <span t-raw="doc.x_body4_apv"/>
                            </div>
                        </div>
                    </div>
<!--                </t>-->

                </div>
            </t>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--        Form View-->
        <record id="mrp_production_workorder_form_view_inherit_cus_mrp_workorder" model="ir.ui.view">
            <field name="name">mrp_production_workorder_form_view_inherit_cus_mrp_workorder</field>
            <field name="model">mrp.workorder</field>
            <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="action_view_production_order" type="object" class="oe_stat_button" icon="fa-wrench">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Manufacturing<br/>Order
                            </span>
                        </div>
                    </button>
                </div>
                <field name="is_produced" position="after">
                    <field name="user_id"/>
                    <field name="x_user_ids" widget="many2many_tags"/>
                    <field name="x_workorder_id"/>
                    <field name="x_production_id" invisible="1"/>
                    <field name="x_name" invisible="1"/>
                    <field name="x_need_material"/>
                    <field name="x_is_need_material" invisible="1"/>
                    <field name="x_need_attention"/>
                    <field name="x_is_need_attention" invisible="1"/>
                    <field name="x_custom_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </field>
                <field name="qty_producing" position="attributes">
                    <attribute name="attrs">{
                        'readonly': ['|', '|',
                        ('product_tracking', '=', 'serial'),
                        ('state', 'in', ('done', 'cancel')),
                        ('x_production_type', '=', 'full'),
                        ]
                    }</attribute>
                </field>
                <field name="qty_producing" position="before">
                    <field name="x_production_type" widget="radio" options="{'horizontal': true}"/>
                </field>
                <page name="workorder_page_misc" position="before">
                    <page name="workorder_qc" string="Quality Control" groups="mrp.group_mrp_manager"
                          attrs="{'invisible': [('workcenter_id', '!=', 17)]}">
                        <group>
                            <group>
                                <field name="x_qc_status"/>
                            </group>
                            <group>
                                <field name="x_qc_comment"/>
                                <field name="x_is_qc_comment" invisible="1"/>
                            </group>
                        </group>
                        <separator string="Products with serial number" colspan="4"/>
                        <div class="o_row">
                            <button name="get_serial_products" string="Get Products" type="object" class="oe_highlight"/>
                        </div>
                        <field name="x_serial_product_ids">
                            <tree create="0" delete="0">
                                <field name="x_serial_number"/>
                                <field name="x_sale_order_number" widget="many2one"/>
                                <field name="x_mega_mo_number"/>
                                <field name="x_status"/>
                            </tree>
                            <form>
                                <sheet>
                                    <group col="4">
                                        <field name="x_serial_number" readonly="1"/>
                                        <field name="x_sale_order_number" readonly="1"/>
                                        <field name="x_mega_mo_number" readonly="1"/>
                                        <field name="x_status"/>
                                        <field name="x_notes"/>
                                    </group>
                                    <separator colspan="4" string="QC Checklist"/>
                                    <div class="o_row">
                                        <button name="get_qc_checklist" string="Refresh" type="object"
                                                class="oe_highlight" icon="fa-refresh"/>
                                    </div>
                                    <field name="x_qc_checklist_ids">
                                        <tree create="0" delete="0" editable="bottom">
                                            <field name="x_checklist" readonly="1"/>
                                            <field name="x_description" readonly="1"/>
                                            <field name="x_notes" readonly="1"/>
                                            <field name="x_typical_value" readonly="1"/>
                                            <field name="x_measured_value"/>
                                            <field name="x_status"/>
                                        </tree>
                                    </field>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </page>
            </field>
        </record>
        <!--        List View-->
        <record id="mrp_production_workorder_tree_view_inherit_cus_mrp_workorder" model="ir.ui.view">
            <field name="name">mrp_production_workorder_tree_view_inherit_cus_mrp_workorder</field>
            <field name="model">mrp.workorder</field>
            <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_view_inherit"/>
            <field name="arch" type="xml">
                <field name="product_uom_id" position="after">
                    <field name="user_id"/>
                    <field name="x_user_ids" widget="many2many_tags"/>
                    <field name="x_workorder_id"/>
                    <field name="x_mrp_demand_ids" widget="many2many_tags"/>
                    <field name="x_custom_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </field>
            </field>
        </record>
        <!--        Calendar View-->
        <record id="workcenter_line_calendar_cus_mrp_workorder" model="ir.ui.view">
            <field name="name">workcenter_line_calendar_cus_mrp_workorder</field>
            <field name="model">mrp.workorder</field>
            <field name="inherit_id" ref="mrp.workcenter_line_calendar"/>
            <field name="arch" type="xml">
                <field name="workcenter_id" position="before">
                    <field name="user_id" avatar_field="image_128"/>
                    <field name="x_user_ids" widget="many2many_tags"/>
                </field>
            </field>
        </record>
        <!--        Kanban View-->
        <record id="workcenter_line_kanban_cus_mrp_workorder" model="ir.ui.view">
            <field name="name">workcenter_line_kanban_cus_mrp_workorder</field>
            <field name="model">mrp.workorder</field>
            <field name="inherit_id" ref="mrp.workcenter_line_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban" position="replace">
                    <kanban class="oe_background_grey o_kanban_small_column o_mrp_workorder_kanban" create="0"
                            default_group_by="state" default_order="state">
                        <field name="name"/>
                        <field name="x_is_need_material"/>
                        <field name="x_is_need_attention"/>
                        <field name="x_is_qc_comment"/>
                        <field name="production_id"/>
                        <field name="state"/>
                        <field name="workcenter_id"/>
                        <field name="product_id"/>
                        <field name="qty_production"/>
                        <field name="product_uom_id"/>
                        <field name="user_id"/>
                        <field name="x_user_ids"/>
<!--                        <field name="working_user_ids"/>-->
<!--                        <field name="last_working_user_id"/>-->
                        <field name="working_state"/>
                        <field name="x_workorder_id"/>
                        <field name="x_mrp_demand_ids"/>
<!--                        <field name="stage_id" options='{"fold_field": "fold"}'/>-->
                        <templates>
                            <t t-name="kanban-box">
                                <div class="oe_kanban_global_click">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings o_kanban_card_header_title">
                                            <strong>
                                                <span>
                                                    <t t-esc="record.production_id.value"/>
                                                </span>
                                                -
                                                <span>
                                                    <t t-esc="record.name.value"/>
                                                </span>
                                            </strong>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <span>
                                            <t t-esc="record.product_id.value"/>
                                        </span>
                                        <t t-if="record.x_workorder_id.raw_value">
                                            <br/>
                                            <strong>Interrupted by:</strong>
                                            <br/>
                                            <span>
                                                <field name="x_production_id"/>
                                            </span>
                                            -
                                            <span>
                                                <field name="x_name"/>
                                            </span>
                                        </t>
                                        <br/>
                                        <span t-attf-class="badge #{['pending'].indexOf(record.state.raw_value) > -1 ? 'badge-warning' :['progress'].indexOf(record.state.raw_value) > -1 ? 'badge-secondary' : ['ready'].indexOf(record.state.raw_value) > -1 ? 'badge-primary' : ['done'].indexOf(record.state.raw_value) > -1 ? 'badge-success' : 'badge-danger'}">
                                            <t t-esc="record.state.value"/>
                                        </span>
                                        <field name="x_mrp_demand_ids" widget="form.many2many_tags"/>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <span>
                                                <t t-esc="record.qty_production.value"/>
                                                <t
                                                        t-esc="record.product_uom_id.value"/>
                                            </span>
                                        </div>
                                        <div class="container oe_kanban_bottom_right o_kanban_manage_button_section">
                                            <span class="fa fa-cubes" style="color: red; padding-right: 2px;"
                                                  attrs="{'invisible': [('x_is_need_material', '=', False)]}" string="Material"/>
                                            <span class="fa fa-exclamation-triangle" style="color: orange; padding-right: 2px;"
                                                  attrs="{'invisible': [('x_is_need_attention', '=', False)]}" string="Attention"/>
                                            <span class="fa fa-comment" style="color: black; padding-right: 2px;"
                                                  attrs="{'invisible': [('x_is_qc_comment', '=', False)]}" string="Quality Control"/>
                                            <span>
                                                <button name="button_start" string="Start" type="object"
                                                        class="btn fa fa-play fa-2x" style="padding-right:4px;"
                                                        attrs="{'invisible': [('state', '!=', 'ready')]}"/>
                                            </span>
<!--                                            <t t-if="record.state.raw_value == 'progress'">-->
<!--                                                <span t-if="record.working_state.raw_value != 'blocked' and record.working_user_ids.raw_value.length == 0 and record.last_working_user_id.raw_value">-->
<!--                                                    <button name="button_start" string="Continue" type="object"-->
<!--                                                            class="btn fa fa-play fa-2x" style="padding-right:4px;"/>-->
<!--                                                </span>-->
<!--                                                <span t-if="record.working_state.raw_value != 'blocked' and record.working_user_ids.raw_value.length > 0">-->
<!--                                                    <button name="button_pending" string="Pause" type="object"-->
<!--                                                            class="btn fa fa-pause fa-2x" style="padding-right:4px;"/>-->
<!--                                                </span>-->
<!--                                                <span t-if="record.working_state.raw_value != 'blocked' and record.working_user_ids.raw_value.length > 0">-->
<!--                                                    <button name="record_production" string="Done" type="object"-->
<!--                                                            class="btn fa fa-check-square fa-2x"-->
<!--                                                            style="padding-right:4px;"/>-->
<!--                                                </span>-->
<!--                                            </t>-->
                                            <t t-if="record.user_id.raw_value">
                                                <img t-att-src="kanban_image('res.users', 'image_128', record.user_id.raw_value)"
                                                     class="oe_kanban_avatar" alt="Avatar"/>
                                            </t>
                                            <t t-foreach="record.x_user_ids.raw_value" t-as="user_id">
                                                <img t-att-src="kanban_image('res.users', 'image_128', user_id)"
                                                     t-att-title="user_id" t-att-alt="user_id"
                                                     class="oe_kanban_avatar"/>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </templates>
                    </kanban>
                </xpath>
            </field>
        </record>
        <!--        Filter View-->
        <record id="view_mrp_production_workorder_form_view_filter_cus_mrp_workorder" model="ir.ui.view">
            <field name="name">view_mrp_production_workorder_form_view_filter_cus_mrp_workorder</field>
            <field name="model">mrp.workorder</field>
            <field name="inherit_id" ref="mrp.view_mrp_production_workorder_form_view_filter"/>
            <field name="arch" type="xml">
                <field name="name" position="attributes">
                    <attribute name="filter_domain">
                        [
                        '|', '|', '|', '|', '|', '|',
                        ('name', 'ilike', self),
                        ('workcenter_id', 'ilike', self),
                        ('production_id', 'ilike', self),
                        ('user_id', 'ilike', self),
                        ('x_user_ids', 'ilike', self),
                        ('x_mrp_demand_ids', 'ilike', self),
                        ('x_custom_tag_ids', 'ilike', self),
                        ]
                    </attribute>
                </field>
                <field name="production_id" position="after">
                    <field name="user_id"/>
                    <field name="x_user_ids"/>
                    <field name="x_mrp_demand_ids"/>
                </field>
                <filter name="progress" position="before">
                    <filter name="assigned_to_me" string="Assigned to me"
                            domain="['|', ('user_id', '=', uid), ('x_user_ids', 'ilike', uid)]"/>
                    <separator/>
                </filter>
                <filter name="activities_upcoming_all" position="after">
                    <separator/>
                    <filter name="need_material" string="Need Material" domain="[('x_is_need_material', '!=', False)]"/>
                    <filter name="need_attention" string="Need Attention" domain="[('x_is_need_attention', '!=', False)]"/>
                    <separator/>
                    <filter name="quality_control" string="Quality Control" domain="[('workcenter_id', '=', 17)]"/>
                    <separator/>
                    <filter name="quality_control_comment" string="QC Comment"
                            domain="[('x_is_qc_comment', '!=', False)]"/>
                    <separator/>
                    <filter name="quality_control_pass" string="QC Pass" domain="[('x_qc_status', '=', 'pass')]"/>
                    <filter name="quality_control_rework" string="QC Re-work"
                            domain="[('x_qc_status', '=', 'rework')]"/>
                    <filter name="quality_control_fail" string="QC Fail" domain="[('x_qc_status', '=', 'fail')]"/>
                    <separator/>
                    <filter name="tagged" string="Tagged" domain="[('x_custom_tag_ids', '!=', False)]"/>
                </filter>
                <filter name="scheduled_month" position="after">
                    <filter string="Responsible" name="user" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="QC Status" name="qc_status" domain="[]" context="{'group_by': 'x_qc_status'}"/>
                </filter>
            </field>
        </record>
        <!--        Workorder Action-->
        <record id="mrp_workorder_action_cus_mrp_workorder_company" model="ir.actions.act_window">
            <field name="name">WO Kanban</field>
            <field name="res_model">mrp.workorder</field>
            <field name="view_mode">kanban,calendar,tree,form</field>
            <field name="view_id" ref="mrp.workcenter_line_kanban"/>
            <field name="search_view_id" ref="mrp.view_mrp_production_workorder_form_view_filter"/>
            <field name="context">
                {
                    'search_default_ready': True,
                    'search_default_progress': True,
                    'search_default_pending': True,
                    'search_default_assigned_to_me': True,
                }
            </field>
        </record>
        <!--        Menu Item-->
        <menuitem id="menu_mrp_workorder_action_cus_mrp_workorder_company"
                  name="WO Kanban"
                  action="mrp_workorder_action_cus_mrp_workorder_company"
                  parent="mrp.menu_mrp_root"
                  sequence="100"/>


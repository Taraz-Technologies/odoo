<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_alternate_mass_usage_editing_wizard_form" model="ir.ui.view">
        <field name="name">alternate.mass.usage.editing.wizard.form.view</field>
        <field name="model">alternate.mass.usage.editing.wizard</field>
        <field name="arch" type="xml">
            <form string="Alternate Usage Mass Editing">
                <group col="2">
                    <field name="x_taraz_part_id" readonly="1"/>
                </group>
				<separator col="4" string="Define Alternate Usage:"/>
                <group col="4" class="oe_edit_only">
                    <label for="x_search_usage"/>
                    <div class="o_row">
                        <field name="x_search_usage" placeholder="Search Usage"/>
                        <button name="select_all_usage" string="Select All" type="object" class="btn-primary"/>
                        <button name="unselect_all_usage" string="Unselect All" type="object" class="btn-primary"/>
                        <button name="usage_auto_use" string="Auto Use" type="object" class="btn-success"/>
                        <button name="usage_not_use" string="Don't Use" type="object" class="btn-danger"/>
                    </div>
                </group>
                <field name="x_usage_ids" style="width:100%;"/>
                <footer>
                    <button string="Save" class="btn-primary" special="save"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window id="action_alternate_mass_usage_editing"
                name="Alternate Usage Mass Editing"
                res_model="alternate.mass.usage.editing.wizard"
                binding_model="taraz.part.number"
                binding_views="from"
                view_mode="form"
                target="new"/>
</odoo>
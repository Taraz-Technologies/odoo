<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="inventory_sale_report_view_form" model="ir.ui.view">
		<field name="name">inventory.sale.report.view.form</field>
		<field name="model">inventory.sale.report</field>
		<field name="arch" type="xml">
			<form string="Product Portfolio &amp; Activity in Free Zone" delete="0" duplicate="0">
				<sheet>
					<field name="x_name" invisible="1"/>
					<field name="x_compute_report_lines" invisible="1"/>
					<group col="4">
						<label for="x_date_from" string="Date Range"/>
						<div class="o_row p-1">
							<field name="x_apply_date_range"/>
							<field name="x_date_from"/>
							-
							<field name="x_date_to"/>
						</div>
						<field name="x_currency_id"/>
						<label for="x_rounding_number"/>
						<div class="o_row">
							<field name="x_rounding"/>
							<field name="x_rounding_number"/>
						</div>
						<field name="x_letter_head_report"/>
						<field name="x_months"/>
						<field name="x_excluded_product_ids" widget="many2many_tags"/>
					</group>
					<notebook>
						<page string="Goods to be Sold">
							<field name="x_order_ids" widget="many2many_tags" invisible="1"/>
							<group col="4">
								<field name="x_sale_group_by"/>
							</group>
							<br/><label for="x_sale_table_text"/>
							<br/><field name="x_sale_table_text"/>
							<separator col="4" string="Goods to be Sold (Manual Entries)"
									   attrs="{'invisible': [('x_apply_date_range', '!=', False)]}"/>
							<field name="x_manual_sale_line_ids"
								   attrs="{'invisible': [('x_apply_date_range', '!=', False)]}">
								<tree editable="bottom">
									<field name="x_report_id" invisible="1"/>
									<field name="x_currency_id" invisible="1"/>
									<field name="x_product_id"/>
									<field name="x_hide_in_report"/>
									<field name="x_product_series_id"/>
									<field name="x_hs_code_id"/>
									<field name="x_local_qty" sum="Total"/>
									<field name="x_local_value" sum="Total"/>
									<field name="x_export_qty" sum="Total"/>
									<field name="x_export_value" sum="Total"/>
								</tree>
							</field>
							<separator col="4" string="Goods to be Sold (From SOs in Date Range)"/>
							<field name="x_sale_line_ids">
								<tree editable="bottom">
									<field name="x_report_id" invisible="1"/>
									<field name="x_currency_id" invisible="1"/>
									<field name="x_product_id"/>
									<field name="x_hide_in_report"/>
									<field name="x_product_series_id"/>
									<field name="x_hs_code_id"/>
									<field name="x_local_qty" sum="Total"/>
									<field name="x_local_value" sum="Total"/>
									<field name="x_export_qty" sum="Total"/>
									<field name="x_export_value" sum="Total"/>
								</tree>
							</field>
						</page>
						<page string="Goods to be Produced">
							<group col="4">
								<field name="x_manufacturing_group_by"/>
								<label for="x_workmanship"/>
								<div class="o_row p-1">
									<field name="x_workmanship"/>
									<span>Employees</span>
									<field name="x_persons"/>
									<span>Salary</span>
									<field name="x_salary"/>
								</div>
								<label for="x_electricity"/>
								<div class="o_row p-1">
									<field name="x_electricity"/>
									<span>Units</span>
									<field name="x_units"/>
									<span>Rate</span>
									<field name="x_rate"/>
								</div>
								<label for="x_rent"/>
								<div class="o_row p-1">
									<field name="x_rent"/>
									<field name="x_rent_amount"/>
								</div>
							</group>
							<br/><label for="x_manufacturing_table_text"/>
							<br/><field name="x_manufacturing_table_text"/>
							<separator col="4" string="Goods to be Produced"/>
							<field name="x_manufacturing_line_ids">
								<tree editable="bottom">
									<field name="x_report_id" invisible="1"/>
									<field name="x_currency_id" invisible="1"/>
									<field name="x_product_id"/>
									<field name="x_product_series_id"/>
									<field name="x_hs_code_id"/>
									<field name="x_export_qty" sum="Total"/>
									<field name="x_export_value" sum="Total"/>
								</tree>
							</field>
						</page>
						<page string="Raw Material to be Purchased">
							<group col="4">
								<field name="x_raw_material_group_by" widget="radio" options="{'horizontal': true}"/>
								<field name="x_raw_material_show_by" widget="radio" options="{'horizontal': true}"/>
							</group>
							<br/><label for="x_raw_material_table_text"/>
							<br/><field name="x_raw_material_table_text"/>
							<separator col="4" string="Raw Material to be Purchased"/>
							<field name="x_raw_material_line_ids">
								<tree editable="bottom">
									<field name="x_report_id" invisible="1"/>
									<field name="x_currency_id" invisible="1"/>
									<field name="x_product_id"/>
									<field name="x_sub_type_id"/>
									<field name="x_hs_code_id"/>
									<field name="x_local_qty" sum="Total"/>
									<field name="x_local_value" sum="Total"/>
									<field name="x_export_qty" sum="Total"/>
									<field name="x_export_value" sum="Total"/>
								</tree>
							</field>
						</page>
						<page string="Production Process">
							<group col="6">
								<field name="x_smt_assembly"/>
								<field name="x_making_process"/>
								<field name="x_final_assembly"/>
							</group>
							<field name="x_production_process"/>
						</page>
						<page string="Portfolio Products">
							<field name="x_portfolio_products_ids">
								<tree editable="bottom">
									<field name="x_report_id" invisible="1"/>
									<field name="sequence" widget="handle"/>
									<field name="x_product_id"/>
								</tree>
							</field>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

    <record id="action_inventory_sale_report" model="ir.actions.act_window">
		<field name="name">Product Portfolio &amp; Activity in Free Zone</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">inventory.sale.report</field>
		<field name="view_mode">form</field>
		<field name="res_id">2</field>
		<field name="view_id" ref="cus_product_360_view.inventory_sale_report_view_form"/>
    </record>

	<menuitem id="menu_inventory_sale_report"
			  name="Product Portfolio &amp; Activity in Free Zone"
			  parent="stock.menu_warehouse_report"
			  sequence="10"
			  action="action_inventory_sale_report"/>
</odoo>
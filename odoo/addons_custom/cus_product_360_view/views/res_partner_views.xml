<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record model="ir.ui.view" id="view_partner_form_customization_1">
		<field name="name">res.partner.form.customization.1</field>
		<field name="model">res.partner</field>
		<field name="inherit_id" ref="customizations.view_partner_form_customization_0"/>
		<field name="arch" type="xml">
			<data>
				<field name="x_partner_type" position="after">
					<field name="x_manufacturer" attrs="{'invisible': [('x_partner_type','!=', 'Vendor')]}"/>
				</field>
			</data>
		</field>
	</record>

	<record model="ir.ui.view" id="view_partner_form_customization_2">
		<field name="name">res.partner.form.customization.2</field>
		<field name="model">res.partner</field>
		<field name="inherit_id" ref="base.view_partner_form"/>
		<field name="arch" type="xml">
			<data>
				<field name="country_id" position="attributes">
					<attribute name="attrs">
						{
						'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)],
						'required': [('x_manufacturer', '!=', True)],
						}
					</attribute>
				</field>
			</data>
		</field>
	</record>

	<record model="ir.ui.view" id="view_res_partner_filter_customization_1">
		<field name="name">res.partner.select.customization.1</field>
		<field name="model">res.partner</field>
		<field name="inherit_id" ref="customizations.view_res_partner_filter_customization"/>
		<field name="priority" eval="99" />
		<field name="arch" type="xml">
			<data>
				<filter name="distributor" position="before">
					<filter string="Manufacturer" name="manufacturer" domain="[('x_manufacturer','=', True)]"/>
				</filter>
			</data>
		</field>
	</record>
</odoo>
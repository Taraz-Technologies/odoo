<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="product_category_form_view_inherit" model="ir.ui.view">
		<field name="name">product.category.form</field>
		<field name="model">product.category</field>
		<field name="inherit_id" ref="product.product_category_form_view" />
		<field name="arch" type="xml">
			<field name="parent_id" position="after">
				<field name="x_goods_type" class="oe_inline"/>
				<field name="x_investment_markup" widget="percentage" class="oe_inline"/>
				<field name="x_bonus_percentage" widget="percentage" class="oe_inline"/>
				<field name="x_form_field_03" class="oe_inline"/>
				<field name="x_company_id" class="oe_inline"/>
			</field>
		</field>
	</record>
	
	<record id="product_category_list_view_cus_product_360_view" model="ir.ui.view">
	    <field name="name">product_category_list_view_cus_product_360_view</field>
	    <field name="model">product.category</field>
	    <field name="inherit_id" ref="product.product_category_list_view"/>
	    <field name="arch" type="xml">
			<field name="display_name" position="after">
				<field name="x_form_field_03"/>
				<field name="x_company_id"/>
			</field>
	    </field>
	</record>
	
    <menuitem id="menu_product_360"
              name="Product 360 View"
              parent="stock.menu_stock_root"
			  groups="stock.group_stock_manager"
              sequence="99"/>

    <record id="action_view_taraz_part_number" model="ir.actions.act_window">
		<field name="name">Taraz Part Number</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">taraz.part.number</field>
		<field name="view_mode">form</field>
    </record>

	<record model="ir.ui.view" id="product_template_kanban_stock_view_1">
		<field name="name">Product Template Kanban Stock</field>
		<field name="model">product.template</field>
		<field name="inherit_id" ref="product.product_template_kanban_view"/>
		<field name="arch" type="xml">
			<xpath expr="//kanban" position="inside">
				<field name="type"/>
				<field name="x_alternates_exist"/>
				<field name="x_compromised_exist"/>
				<field name="x_taraz_part_number_id"/>
			</xpath>
			<ul position="replace">
				<ul>
					<li t-if="record.type.raw_value == 'product'"><field name="x_taraz_part_number_id"/></li>
					<li t-if="record.type.raw_value == 'product'">
						<b>Cost (Average):</b> <field name="x_average_price" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
						-- <b>UoM:</b> <field name="uom_id"/>
					</li>
<!--					<li t-if="record.type.raw_value == 'product'">UoM: <field name="uom_id"/></li>-->
					<li t-if="record.type.raw_value == 'product'"><field name="x_product_tag"/></li>
				</ul>
			</ul>
			<div class="oe_kanban_details" position="after">
				<t t-if="record.type.raw_value == 'product'">
					<style>
						.btn-o {
							background-color: white;
							border: 0.5px solid gray;
							padding: 1px 4px;
							font-size: 11px;
							cursor: pointer;
							width: 100%;
						}

						/* Darker background on mouse-over */
						.btn-o:hover {
							background-color: #5d8da8;
							color: white;
						}
					</style>
					<table name="quantity_details" style="width:100%; font-size: 11px;">
						<tr>
							<td style="width:50%">
								<button type="object" class="btn-o" name="action_open_quants" string="Available">
									<span>Available: <field name="x_available_qty"/></span>
								</button>
							</td>
							<td style="width:50%">
								<button type="object" class="btn-o" name="action_view_product_tmpl_incoming_receipts" string="Incoming">
									<span>Incoming: <field name="x_incoming_qty"/></span>
								</button>
							</td>
						</tr>
						<tr>
							<td style="width:50%">
								<button type="object" class="btn-o" name="action_view_product_tmpl_manufacturing_to_consume" string="To Consume">
									<span>To Consume: <field name="x_to_consume_qty"/></span>
								</button>
							</td>
							<td style="width:50%">
								<button type="object" class="btn-o" name="action_view_product_tmpl_backorder_receipts" string="Backorder">
									<span>Backorder: <field name="x_backorder_qty"/></span>
								</button>
							</td>
						</tr>
						<tr>
							<td style="width:50%">
								<button type="object" class="btn-o" name="action_view_product_tmpl_manufacturing_tray_out" string="Tray Out">
									<span>Tray Out: <field name="x_tray_out_qty"/></span>
								</button>
							</td>
							<td style="width:50%">
								<button type="object" class="btn-o" name="action_view_product_tmpl_manufacturing_delivery" string="Reserved">
									<span>Reserved: <field name="outgoing_qty"/></span>
								</button>
							</td>
						</tr>
						<tr>
							<td style="width:50%">
								<button type="object" class="btn-o" name="action_open_quants" string="On Hand">
									<span>On Hand: <field name="qty_available"/></span>
								</button>
							</td>
							<td style="width:50%">
								<button type="action" class="btn-o" string="Forecasted">
									<span>Forecasted: <field name="virtual_available"/></span>
								</button>
							</td>
						</tr>
					</table>
					<table name="alternates_compromised" style="width:100%; font-size: 11px;" t-if="record.x_alternates_exist.raw_value or record.x_compromised_exist.raw_value">
						<tr>
							<td>
								<button type="object" class="btn-o" name="action_view_taraz_part" string="Incoming">
									<span t-if="record.x_alternates_exist.raw_value">Alternates:</span>
									<field name="x_alternate_ids" widget="form.many2many_tags" t-if="record.x_alternates_exist.raw_value"/>
									<span t-if="record.x_compromised_exist.raw_value">Compromised:</span>
									<field name="x_compromised_ids" widget="form.many2many_tags" t-if="record.x_compromised_exist.raw_value"/>
								</button>
							</td>
						</tr>
					</table>
				</t>
			</div>
		</field>
	</record>

    <record id="view_product_supplier_inherit_custom_0" model="ir.ui.view">
        <field name="name">product.template.supplier.form.inherit.custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="purchase.view_product_supplier_inherit"/>
        <field name="arch" type="xml">
            <data>
                <field name="seller_ids" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="seller_ids" position="after">
                    <field name="x_purchase_history_ids"/>
                </field>
            </data>
        </field>
    </record>

    <record id="product_template_form_view_bom_button_custom_0" model="ir.ui.view">
        <field name="name">product.template.common.form.custom.0</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="mrp.product_template_form_view_bom_button"/>
        <field name="arch" type="xml">
            <data>
                <button name="action_used_in_bom" position="after">
                    <button name="action_view_usage" type="object" icon="fa-sitemap"
                            class="oe_stat_button" attrs="{'invisible': [('x_usage_count', '=', 0)]}">
                        <field string="Usage" name="x_usage_count" widget="statinfo"/>
                    </button>
                </button>
            </data>
        </field>
    </record>

    <record id="product_template_form_view_custom_0" model="ir.ui.view">
        <field name="name">product.template.common.form.custom.0</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <data>
				<div name="options" position="before">
					<label for="x_name_translation" string="Translation"/>
					<h1><field name="x_name_translation" placeholder="Product Name Translation"/></h1>
				</div>
				<xpath expr="/form/sheet/notebook/page[1]/group[2]" position="attributes">
					<attribute name="string">Description</attribute>
				</xpath>
				<field name="description" position="attributes">
					<attribute name="colspan">6</attribute>
				</field>
				<field name="description" position="after">
					<b>Translation</b>
					<field name="x_description_translation" nolabel="1" colspan="6"/>
				</field>
				<xpath expr="/form/sheet/notebook/page[1]/group[2]" position="after">
					<group string="Short Description">
						<field name="x_short_description" nolabel="1" colspan="6"/>
						<b>Translation</b>
						<field name="x_short_description_translation" nolabel="1" colspan="6"/>
					</group>
				</xpath>
				<div name="options" position="inside">
					<div attrs="{'invisible': [('categ_id', 'not in', (262, 263, 264, 265, 266, 267, 268, 275))]}">
						<field name="x_production_bonus"/>
						<label for="x_production_bonus"/>
					</div>
				</div>
                <group name='group_general' position="inside">
					<field name="x_other_name_tag_ids" widget="many2many_tags"/>
					<label for="x_taraz_part_number_id"/>
					<div class="o_row">
                    	<field name="x_taraz_part_number_id" readonly="0"/>
						<button name="compute_taraz_part_number" type="object" string="Create Taraz Part"
								attrs="{'invisible': [('x_taraz_part_number_id', '!=', False)]}"/>
						<button name="action_open_in_editor" type="object" string="Open in Editor"
								attrs="{'invisible': [('x_taraz_part_number_id', '=', False)]}"/>
					</div>
                    <field name="x_alternate_ids" widget="many2many_tags" attrs="{'invisible': [('x_alternate_ids', '=', False)]}"/>
                    <field name="x_compromised_ids" widget="many2many_tags" attrs="{'invisible': [('x_compromised_ids', '=', False)]}"/>
					<field name="x_tzp_type" invisible="1"/>
					<field name="x_mounting_type"/>
                </group>
				<field name="type" position="after">
					<field name="dk_category" attrs="{'invisible': [('categ_id', 'in', (262, 263, 264, 265, 266, 267, 268, 275))]}"/>
					<field name="dk_sub_category" attrs="{'invisible': [('categ_id', 'in', (262, 263, 264, 265, 266, 267, 268, 275))]}"/>
					<field name="x_product_purchase_packaging_id" attrs="{'invisible': [('categ_id', 'in', (262, 263, 264, 265, 266, 267, 268, 275))]}"/>
				</field>
				<label for="list_price" position="before">
					<field name="dk_manufacturer" invisible="1"/>
					<field name="x_manufacturer" attrs="{'invisible': [('categ_id', 'in', (262, 263, 264, 265, 266, 267, 268, 275))]}"/>
					<field name="dk_digiKey_part_number" attrs="{'invisible': [('categ_id', 'in', (262, 263, 264, 265, 266, 267, 268, 275))]}"/>
				</label>
				<label for="standard_price" position="attributes">
					<attribute name="string">Cost (FIFO)</attribute>
				</label>
				<field name="company_id" position="before">
					<label for="x_average_price" groups="base.group_user" attrs="{'invisible': [('product_variant_count', '&gt;', 1), ('is_product_variant', '=', False)]}"/>
					<div name="standard_price_uom" groups="base.group_user" attrs="{'invisible': [('product_variant_count', '&gt;', 1), ('is_product_variant', '=', False)]}" class="o_row">
						<field name="x_average_price" widget="monetary" options="{'currency_field': 'cost_currency_id', 'field_digits': True}"/>
						<span groups="uom.group_uom" class="oe_read_only">per
							<field name="uom_name"/>
						</span>
					</div>
				</field>
                <group name="group_standard_price" position="after">
                    <group string="Total Summary">
                        <field name="x_total_purchased" attrs="{'invisible':[('x_total_purchased', '=', 0)]}"/>
                        <field name="x_total_manufactured" attrs="{'invisible':[('x_total_manufactured', '=', 0)]}"/>
                        <field name="x_total_consumed" attrs="{'invisible':[('x_total_consumed', '=', 0)]}"/>
                        <field name="x_total_sold" attrs="{'invisible':[('x_total_sold', '=', 0)]}"/>
                        <field name="x_quarterly_consumption" attrs="{'invisible':[('x_quarterly_consumption', '=', 0)]}"/>
                    </group>
                    <group string="Inventory Turnover Ratio">
                        <label for="x_start_date" string="Period" attrs="{'invisible':[('type', '=', 'service')]}"/>
                        <div class="d-flex" attrs="{'invisible':[('type', '=', 'service')]}">
                            <field name="x_start_date" class="oe_inline"/>
                            -
                            <field name="x_end_date" class="oe_inline"/>
                        </div>
                        <field name="x_period_purchased" attrs="{'invisible':[('x_period_purchased', '=', 0)]}"/>
                        <field name="x_period_manufactured" attrs="{'invisible':[('x_period_manufactured', '=', 0)]}"/>
                        <field name="x_period_consumed" attrs="{'invisible':[('x_period_consumed', '=', 0)]}"/>
                        <field name="x_period_sold" attrs="{'invisible':[('x_period_sold', '=', 0)]}"/>
                        <field name="x_cogs" attrs="{'invisible':[('x_cogs', '=', 0)]}"/>
                        <field name="x_start_inventory" attrs="{'invisible':[('x_start_inventory', '=', 0)]}"/>
                        <field name="x_end_inventory" attrs="{'invisible':[('x_end_inventory', '=', 0)]}"/>
                        <field name="x_average_inventory" attrs="{'invisible':[('x_average_inventory', '=', 0)]}"/>
                        <field name="x_period_days" attrs="{'invisible':[('x_period_days', '=', 0)]}"/>
                        <field name="x_inventory_turnover" attrs="{'invisible':[('x_inventory_turnover', '=', 0)]}"/>
                    </group>
                </group>
                <group name="description" position="before">
					<group name="accessories" string="Accessories" colspan="4">
						<div class="o_row" colspan="8">
							<b>Select Product: </b>
							<field name="x_product_id" options="{'no_quick_create': True, 'no_create_edit': True}"/>
							<button name="autofill_accessory_ids" string="Autofill Accessories" class="oe_highlight" type="object"/>
						</div>
						<field name="x_accessory_ids" nolabel="1">
							<tree editable="bottom">
								<field name="x_product_id" invisible="1"/>
								<field name="x_accessory_id" options="{'no_quick_create': True, 'no_create_edit': True}"/>
								<field name="x_description" optional="show"/>
								<field name="x_short_description" optional="show"/>
								<field name="x_quantity"/>
								<field name="x_uom_id"/>
								<field name="x_comment"/>
								<field name="x_active"/>
							</tree>
							<form>
								<group>
									<field name="x_product_id" invisible="1"/>
									<field name="x_accessory_id"/>
									<field name="x_description" optional="show"/>
									<field name="x_short_description" optional="show"/>
									<field name="x_quantity"/>
									<field name="x_uom_id"/>
									<field name="x_comment"/>
									<field name="x_active"/>
								</group>
							</form>
						</field>
					</group>
				</group>
				<label for="weight" position="before">
					<label for="x_unit_weight" attrs="{'invisible':[('categ_id', 'in', (262, 263, 264, 265, 266, 267, 268, 275))]}"/>
					<div class="o_row" name="x_unit_weight" attrs="{'invisible':[('categ_id', 'in', (262, 263, 264, 265, 266, 267, 268, 275))]}">
						<field name="x_unit_weight" readonly="0"/>
						<span><field name="weight_uom_name"/></span>
					</div>
					<label for="x_gross_weight"/>
					<div class="o_row" name="x_gross_weight">
						<field name="x_gross_weight"/>
						<span><field name="weight_uom_name"/></span>
					</div>
					<label for="weight" attrs="{'invisible':[('categ_id', 'not in', (262, 263, 264, 265, 266, 267, 268, 275))]}"/>
					<div class="o_row" name="weight" attrs="{'invisible':[('categ_id', 'not in', (262, 263, 264, 265, 266, 267, 268, 275))]}">
						<field name="weight"/>
						<span><field name="weight_uom_name"/></span>
					</div>
				</label>
				<label for="weight" position="attributes">
					<attribute name="string" >Weight(Last Purchase)</attribute>
					<attribute name="attrs">{'invisible':[('categ_id', 'in', (262, 263, 264, 265, 266, 267, 268, 275))]}</attribute>
				</label>
				<div name="weight" position="attributes">
					<attribute name="attrs">{'invisible':[('categ_id', 'in', (262, 263, 264, 265, 266, 267, 268, 275))]}</attribute>
				</div>
            </data>
        </field>
    </record>

    <record id="product_template_form_view_custom_1" model="ir.ui.view">
        <field name="name">product.template.common.form.custom.1</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="customizations.product_template_only_form_view_customization_0"/>
        <field name="arch" type="xml">
            <data>
				<field name="x_main_product_id" position="after">
					<field name="x_form_field_03"/>
				</field>
				<field name="x_product_division" position="after">
					<field name="x_goods_type"/>
					<field name="x_investment_markup" widget="percentage"/>
					<field name="x_bonus_percentage" widget="percentage"/>
				</field>
				<field name="hs_code" position="after">
					<field name="dk_hs_code"/>
					<field name="x_hs_code_tr_id"/>
				</field>
                <group name="description_for_distributor" position="after">
                    <separator colspan="4" string="Quotation History"
                               attrs="{'invisible': [('x_quotation_history_ids', '=', [])]}"/>
                    <field name="x_quotation_history_ids" attrs="{'invisible': [('x_quotation_history_ids', '=', [])]}"/>
                    <separator colspan="4" string="Sale History"
                               attrs="{'invisible': [('x_sale_order_history_ids', '=', [])]}"/>
                    <field name="x_sale_order_history_ids" attrs="{'invisible': [('x_sale_order_history_ids', '=', [])]}"/>
                </group>
				<field name="x_country_id" position="after">
					<span>Last Purchase:<field name="x_order_id"/></span>
				</field>
				<field name="x_hs_code_vendor" position="before">
					<field name="x_country_ids" widget="many2many_tags"
						   attrs="{'invisible': [('x_total_coos', '&lt;', 2)]}"/>
					<field name="x_total_coos" invisible="1"/>
				</field>
                <page name="manufacturing" position="inside">
                    <separator colspan="4" string="Quarterly Consumption"
                               attrs="{'invisible': [('x_quarterly_consumption_ids', '=', [])]}"/>
                    <field name="x_quarterly_consumption_ids" attrs="{'invisible': [('x_quarterly_consumption_ids', '=', [])]}"/>
                    <separator colspan="4" string="Manufacturing History"
                               attrs="{'invisible': [('x_manufacturing_history_ids', '=', [])]}"/>
                    <field name="x_manufacturing_history_ids" attrs="{'invisible': [('x_manufacturing_history_ids', '=', [])]}">
                        <tree>
                            <field name="x_order_id" widget="many2one"/>
                            <field name="x_date"/>
                            <field name="x_product_id" invisible="1"/>
                            <field name="x_product_uom_qty" string="Quantity" sum="Total"/>
                            <field name="x_product_uom"/>
                            <field name="x_currency_id" invisible="1"/>
                            <field name="x_unit_cost" widget="monetary" avg="Average"/>
                            <field name="x_cost" widget="monetary" sum="Total"
                                   options="{'currency_field': 'x_currency_id'}"/>
                        </tree>
                    </field>
                    <separator colspan="4" string="Consumption History"
                               attrs="{'invisible': [('x_consumption_history_ids', '=', [])]}"/>
                    <field name="x_consumption_history_ids" attrs="{'invisible': [('x_consumption_history_ids', '=', [])]}">
                        <tree>
                            <field name="x_order_id" widget="many2one"/>
                            <field name="x_date"/>
                            <field name="x_master_product_id"/>
                            <field name="x_component_id" invisible="1"/>
                            <field name="x_product_uom_qty" sum="Total"/>
                            <field name="x_reserved_availability" sum="Total"/>
                            <field name="x_quantity_done" sum="Total"/>
                            <field name="x_product_uom"/>
                            <field name="x_currency_id" invisible="1"/>
                            <field name="x_unit_cost" widget="monetary" avg="Average"/>
                            <field name="x_cost" widget="monetary" sum="Total"
                                   options="{'currency_field': 'x_currency_id'}"/>
                        </tree>
                    </field>
                    <separator colspan="4" string="Scrap History"
                               attrs="{'invisible': [('x_scrap_history_ids', '=', [])]}"/>
                    <field name="x_scrap_history_ids" attrs="{'invisible': [('x_scrap_history_ids', '=', [])]}"/>
                </page>
				<page name="manufacturing" position="after">
					<page name="product_details" string="Digi-Key Details"
						  attrs="{'invisible': [('categ_id', 'in', (262, 263, 264, 265, 266, 267, 268, 275))]}">
						<group>
							<group>
								<field name="dk_get_digikey_details"/>
								<field name="dk_manufacturer_part_number"/>
								<field name="dk_product_description"/>
								<field name="dk_detailed_description"/>
							</group>
							<group>
								<field name="dk_htsus_code"/>
								<field name="x_original_htsus"/>
							</group>
						</group>
					</page>
				</page>
				<field name="x_form_field_03" position="after">
					<field name="x_custom_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
				</field>
            </data>
        </field>
    </record>

    <record id="product_template_tree_view_custom_1" model="ir.ui.view">
        <field name="name">product.template.product.tree.custom.1</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <data>
                <field name="list_price" position="before">
                    <field name="x_inventory_turnover"/>
                </field>
				<field name="uom_id" position="after">
					<field name="x_custom_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
				</field>
            </data>
        </field>
    </record>

	<record id="product_product_tree_view_custom_1" model="ir.ui.view">
        <field name="name">product.product.tree.view.custom.1</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
			<field name="uom_id" position="after">
				<field name="x_custom_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
			</field>
		</field>

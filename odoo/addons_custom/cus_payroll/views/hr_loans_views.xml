<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<menuitem id="menu_hr_employee_loans"
			  name="Employee Loans"
			  parent="om_hr_payroll.menu_hr_payroll_root"
			  groups="om_hr_payroll.group_hr_payroll_user"
			  sequence="50"/>
<!--	Loan Contracts-->
	<record id="hr_loans_form_view" model="ir.ui.view">
		<field name="name">hr.loans.form.view</field>
		<field name="model">hr.loans</field>
		<field name="arch" type="xml">
			<form string="Loan Contracts">
				<header>
					<button name="create_installments" string="Create Installment Plan" type="object" class="oe_highlight" states="draft"/>
					<button name="create_payslip" string="Create Payslip" type="object" class="oe_highlight"
							attrs="{'invisible': ['|', ('x_payslip_id', '!=', False), ('state', '!=', 'in_progress')]}"/>
					<button name="action_loan_done" string="Run Installments" class="oe_highlight" type="object" states="in_progress"/>
					<button name="action_loan_draft" string="Set to Draft" type="object" states="in_progress,paid,cancel"/>
					<button name="action_loan_cancel" string="Cancel Loan" type="object" states="draft"/>
					<button name="action_loan_paid" string="Mark as Paid" type="object" class="oe_highlight" states="in_progress"/>
					<field name="state" widget="statusbar" statusbar_visible="draft,in_progress,paid"/>
				</header>
				<sheet>
					<widget name="web_ribbon" title="Paid" attrs="{'invisible': [('state', '!=', 'paid')]}"/>
					<div class="oe_title">
						<h1>
							<field name="x_number"/>
						</h1>
					</div>
					<group>
						<group>
							<field name="x_employee_id"/>
							<field name="x_payment_date"/>
							<label for="x_payroll_rate_id"/>
							<div class="o_row">
								<field name="x_payroll_rate_id"/>
								<span>@</span>
								<field name="x_rate" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
							</div>
							<label for="x_amount_currency" string="Loan Amount"/>
							<div class="o_row">
								<field name="x_amount_currency" widget="monetary" options="{'currency_field': 'x_amount_currency_id'}"/>
								<field name="x_amount_currency_id" required="1"/>
							</div>
							<label for="x_amount" string="Loan Amount (USD)"/>
							<div class="o_row">
								<field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
								<field name="x_currency_id" required="1"/>
							</div>
							<field name="x_description"/>
							<field name="x_installments"/>
							<label for="x_interval_number" string="Installment Interval"/>
							<div class="o_row">
								<field name="x_interval_number"/>
								<field name="x_interval_type"/>
							</div>
							<field name="x_start_date"/>
							<field name="x_amount_due" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
						</group>
						<group>
							<field name="x_payslip_id"/>
						</group>
					</group>
					<separator col="4" string="Loan Installments"/>
					<field name="x_installment_ids"/>
				</sheet>
				<div class="oe_chatter">
					<field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
					<field name="message_ids" widget="mail_thread"/>
					<field name="activity_ids" widget="mail_activity"/>
				</div>
			</form>
		</field>
	</record>

	<record id="hr_loans_tree_view" model="ir.ui.view">
		<field name="name">hr.loans.tree.view</field>
		<field name="model">hr.loans</field>
		<field name="arch" type="xml">
			<tree string="Loan Contracts">
				<field name="x_number"/>
				<field name="x_payslip_id"/>
				<field name="x_employee_id"/>
				<field name="x_payment_date"/>
				<field name="x_currency_id" invisible="1"/>
				<field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}" sum="Net Loan"/>
				<field name="x_description"/>
				<field name="x_installments"/>
				<field name="x_amount_due" widget="monetary" options="{'currency_field': 'x_currency_id'}" sum="Net Due"/>
				<field name="state"/>
			</tree>
		</field>
	</record>

	<record id="hr_loans_search_view" model="ir.ui.view">
		<field name="name">hr.loans.search.view</field>
		<field name="model">hr.loans</field>
		<field name="arch" type="xml">
			<search string="Loan Contracts">
				<filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
				<filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
				<filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
				<group expand="0" string="Group by">
					<filter name="employee" string="Employee" context="{'group_by': 'x_employee_id'}"/>
					<filter name="status" string="Status" context="{'group_by': 'state'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="action_view_hr_loans" model="ir.actions.act_window">
		<field name="name">Loan Contracts</field>
		<field name="res_model">hr.loans</field>
		<field name="view_mode">tree,form</field>
		<field name="search_view_id" ref="hr_loans_search_view"/>
	</record>

	<menuitem id="menu_hr_loan_contracts"
			  name="Loan Contracts"
			  action="action_view_hr_loans"
			  parent="cus_payroll.menu_hr_employee_loans"
			  groups="om_hr_payroll.group_hr_payroll_user"
			  sequence="10"/>
<!--	Loan Installments-->
	<record id="hr_loans_Installments_form_view" model="ir.ui.view">
		<field name="name">hr.loans.installments.form.view</field>
		<field name="model">hr.loans.installments</field>
		<field name="arch" type="xml">
			<form string="Loan Installments" write="0" create="0" delete="0">
				<header>
					<field name="state" widget="statusbar" statusbar_visible="draft,in_progress,paid"/>
				</header>
				<sheet>
					<widget name="web_ribbon" title="Paid" attrs="{'invisible': [('state', '!=', 'paid')]}"/>
					<div class="oe_title">
						<h1>
							<field name="x_number"/>
						</h1>
					</div>
					<group>
						<group>
							<field name="x_employee_id"/>
							<field name="x_payment_date"/>
							<field name="x_currency_id"/>
							<field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
							<field name="x_amount_due" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
							<field name="x_description"/>
							<field name="x_loan_id"/>
						</group>
						<group>
							<field name="x_payslip_id"/>
						</group>
					</group>
				</sheet>
				<div class="oe_chatter">
					<field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
					<field name="message_ids" widget="mail_thread"/>
					<field name="activity_ids" widget="mail_activity"/>
				</div>
			</form>
		</field>
	</record>

	<record id="hr_loans_Installments_tree_view" model="ir.ui.view">
		<field name="name">hr.loans.installments.tree.view</field>
		<field name="model">hr.loans.installments</field>
		<field name="arch" type="xml">
			<tree string="Loan Installments" create="0" delete="0">
				<field name="x_number"/>
				<field name="x_payslip_id"/>
				<field name="x_employee_id"/>
				<field name="x_payment_date"/>
				<field name="x_currency_id"/>
				<field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}" sum="Net Loan"/>
				<field name="x_amount_due" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
				<field name="x_description"/>
				<field name="x_loan_id"/>
				<field name="state"/>
			</tree>
		</field>
	</record>

	<record id="hr_loans_Installments_search_view" model="ir.ui.view">
		<field name="name">hr.loans.installments.search.view</field>
		<field name="model">hr.loans.installments</field>
		<field name="arch" type="xml">
			<search string="Loan Installments">
				<filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
				<filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
				<filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
				<group expand="0" string="Group by">
					<filter name="employee" string="Employee" context="{'group_by': 'x_employee_id'}"/>
					<filter name="contract" string="Contract" context="{'group_by': 'x_loan_id'}"/>
					<filter name="status" string="Status" context="{'group_by': 'state'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="action_view_hr_loans_Installments" model="ir.actions.act_window">
		<field name="name">Loan Installments</field>
		<field name="res_model">hr.loans.installments</field>
		<field name="view_mode">tree,form</field>
		<field name="context">
			{
			'search_default_employee': 1,
			'search_default_contract': 1,
			}
		</field>
		<field name="search_view_id" ref="hr_loans_Installments_search_view"/>
	</record>

	<menuitem id="menu_hr_loans_installments"
			  name="Loan Installments"
			  action="action_view_hr_loans_Installments"
			  parent="cus_payroll.menu_hr_employee_loans"
			  groups="om_hr_payroll.group_hr_payroll_user"
			  sequence="20"/>
</odoo>




<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_attendance_tree_inherit_cus_0" model="ir.ui.view">
        <field name="name">hr.attendance.tree.inherit.cus.0</field>
        <field name="model">hr.attendance</field>
		<field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
			<data>
				<field name="employee_id" position="after">
					<field name="x_type"/>
				</field>
				<field name="check_out" position="after">
					<field name="x_work_from" widget="float_time" optional="hide"/>
					<field name="x_work_to" widget="float_time" optional="hide"/>
					<field name="x_break_from" widget="float_time" optional="hide"/>
					<field name="x_break_to" widget="float_time" optional="hide"/>
					<field name="x_break_from_1" widget="float_time" optional="show"/>
					<field name="x_break_to_1" widget="float_time" optional="show"/>
					<field name="x_break_from_2" widget="float_time" optional="hide"/>
					<field name="x_break_to_2" widget="float_time" optional="hide"/>
					<field name="x_break_from_3" widget="float_time" optional="hide"/>
					<field name="x_break_to_3" widget="float_time" optional="hide"/>
					<field name="x_break_from_4" widget="float_time" optional="hide"/>
					<field name="x_break_to_4" widget="float_time" optional="hide"/>
					<field name="x_break_from_5" widget="float_time" optional="hide"/>
					<field name="x_break_to_5" widget="float_time" optional="hide"/>
				</field>
				<field name="worked_hours" position="attributes">
					<attribute name="string">Work Hours (Employee)</attribute>
					<attribute name="sum">Total Hours</attribute>
				</field>
				<field name="worked_hours" position="before">
					<field name="x_working_hours" widget="float_time" sum="Total Hours"/>
				</field>
				<field name="worked_hours" position="after">
					<field name="x_balance" widget="float_time" sum="Total Balance"/>
				</field>
				<field name="worked_hours" position="after">
					<field name="x_currency_id"/>
					<field name="x_apply_late_coming_fine"/>
					<field name="x_late_coming_fine" widget="monetary" options="{'currency_field': 'x_currency_id'}" sum="Total Fine"/>
					<field name="x_apply_early_going_fine"/>
					<field name="x_early_going_fine" widget="monetary" options="{'currency_field': 'x_currency_id'}" sum="Total Fine"/>
				</field>
			</data>
		</field>
	</record>
</odoo>
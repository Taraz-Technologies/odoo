<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <report id="hr_employee_print_badge_card"
			string="Print Badge (Custom)"
			model="hr.employee"
			report_type="qweb-pdf"
			name="cus_payroll.print_employee_badge_card"
			file="cus_payroll.print_employee_badge_card"
			print_report_name="'Print Badge - %s' % (object.name).replace('/', '')"
			paperformat="cus_payroll.paper_format_cr79"/>

    <template id="print_employee_badge_card">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-foreach="docs" t-as="employee">
<!--                    <img class="card-img" src='/customizations/static/images/certificate-of-origin.jpg' style="width: 100%;"/>-->
<!--                    <div class="card-img-overlay">-->
                        <table style="height:238pt; width:147pt; border: 1pt solid black; border-collapse:separate; border-radius:8pt;">
                            <tr style="height:30%">
                                <td align="center" valign="center">
                                    <img t-if="employee.company_id.logo" t-att-src="image_data_uri(employee.company_id.logo)" style="max-height:45pt;max-width:90%" alt="Company Logo"/>
                                </td>
                            </tr>
                            <tr style="height:30%">
                                <td align="center" valign="center">
                                    <img t-if="employee.image_1920" t-att-src="image_data_uri(employee.image_1920)" style="max-height:72pt;max-width:90%" alt="Employee Image"/>
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <div align="center" style="font-size:15pt;">
                                        <t t-esc="employee.name"/>
                                    </div>
                                </th>
                            </tr>
                            <tr>
                                <td>
                                    <div align="center" style="font-size:10pt;">
                                        <t t-esc="employee.job_id.name"/>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div align="center" style="font-size:10pt;">
                                        <span>I.D. </span><t t-esc="employee.barcode"/>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td align="center" valign="center" style="margin-left: 2pt; margin-right: 2pt">
                                    <img alt="barcode" t-if="employee.barcode" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', employee.barcode, 600, 120)" style="max-height:50pt;max-width:90%;"/>
                                </td>
                            </tr>
                        </table>
                        <table style="height:238pt; width:147pt; border: 1pt solid black; border-collapse:separate; border-radius:8pt; page-break-before:always;">
                            <tr>
                                <td align="center" valign="center">
                                    <img t-if="employee.company_id.logo" t-att-src="image_data_uri(employee.company_id.logo)" style="max-height:45pt;max-width:90%" alt="Company Logo"/>
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <div style="font-size:15pt; margin-bottom:0pt;margin-top:0pt;" align="center">
                                        <t t-esc="employee.name"/>
                                    </div>
                                </th>
                            </tr>
                            <tr>
                                <td>
                                    <div align="center" style="font-size:10pt;margin-bottom:5pt;">
                                        <t t-esc="employee.job_id.name"/>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div align="left" style="font-size:10pt;">
                                        <span>Email: </span><t t-esc="employee.private_email"/>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div align="left" style="font-size:10pt;">
                                        <span>Phone: </span><t t-esc="employee.phone"/>
                                    </div>
                                </td>
                            </tr>
                        </table>
<!--                    </div>-->
                </t>
            </div>
        </t>
    </template>
</odoo>

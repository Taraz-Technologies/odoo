<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <report id="payroll_excel_report"
                model="hr.payslip.run"
                string="Export Excel"
                report_type="xlsx"
                name="cus_payroll.payroll_excel_report"
                file="cus_payroll.payroll_excel_report"
                print_report_name="object.name"/>

        <report id="wht_payroll_excel_report"
                model="hr.payslip.run"
                string="Export Excel (WHT)"
                report_type="xlsx"
                name="cus_payroll.wht_payroll_excel_report"
                file="cus_payroll.wht_payroll_excel_report"
                print_report_name="'WHT - %s' % object.name"/>

        <report id="bonus_excel_report"
                model="hr.bonus.batch"
                string="Export Excel"
                report_type="xlsx"
                name="cus_payroll.bonus_excel_report"
                file="cus_payroll.bonus_excel_report"
                print_report_name="object.x_name"/>

        <report id="action_report_wht_return_certificate"
                string="WHT Return Certificate"
                model="hr.payslip"
                report_type="qweb-pdf"
                file="cus_payroll.report_wht_return_certificate"
                name="cus_payroll.report_wht_return_certificate"
                print_report_name="'%s - WHT Return Certificate' % (object.employee_id.name)"
                paperformat="base.paperformat_euro_borderless"/>
</odoo>
<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_order_discount_view_form" model="ir.ui.view">
        <field name="name">purchase.order.discount.form</field>
        <field name="model">purchase.order.discount</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="x_order_id" invisible="1"/>
                        <field name="x_discount"/>
					</group>
				</group>
                <footer>
                    <button name="button_confirm" type="object" string="Add" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
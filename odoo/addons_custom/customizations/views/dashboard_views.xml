<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Dashboard Original View ID = 1438-->
<!--    Dashboard Items-->
    <record id="view_dashboard_item_form" model="ir.ui.view">
        <field name="name">dashboard.item.form</field>
        <field name="model">dashboard.item</field>
        <field name="arch" type="xml">
            <form string="Dashboard Items">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name"/>
                        </h1>
                    </div>
                    <button string="View Dashboard" name="view_user_dashboard" type="object" class="oe_highlight"/>
                    <group col="4">
                        <field name="x_user_id"/>
                        <field name="create_uid"/>
                        <field name="x_user_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <separator string="Item Code" colspan="4"/>
                        <field name="x_view_code" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dashboard_item_tree" model="ir.ui.view">
        <field name="name">dashboard.item.tree</field>
        <field name="model">dashboard.item</field>
        <field name="arch" type="xml">
            <tree string="Dashboard Items" multi_edit="1">
                <field name="x_sequence" widget="handle"/>
                <field name="create_date"/>
                <field name="create_uid"/>
                <field name="x_name"/>
                <field name="x_user_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_dashboard_item_filter" model="ir.ui.view">
        <field name="name">dashboard.item.select</field>
        <field name="model">dashboard.item</field>
        <field name="arch" type="xml">
            <search string="Search Dashboard Items">
                <field name="x_name" string="Dashboard Items" filter_domain="['|',('x_name','ilike',self),('create_uid','ilike',self)]"/>
                <field name="x_view_name"/>
                <field name="x_view_mode"/>
                <field name="create_uid"/>
                <group col="8" colspan="4" expand="0" string="Group By">
                    <filter string="Created By" name="category_id" context="{'group_by':'create_uid'}"/>
                    <filter string="View Mode" name="view_mode" context="{'group_by':'x_view_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dashboard_item" model="ir.actions.act_window">
        <field name="name">Dashboard Items</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dashboard.item</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_dashboard_item_filter"/>
        <field name="context">{}</field>
        <field name="domain">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Dashboard Item
            </p>
        </field>
    </record>

    <menuitem id="menu_dashboard_item"
              name="Dashboard Items"
              parent="base.menu_board_root"
              action="action_dashboard_item"
              groups="base.group_system"
              sequence="6"/>
<!--    User Dashboard-->
    <record id="view_user_dashboard_form" model="ir.ui.view">
        <field name="name">user.dashboard.form</field>
        <field name="model">user.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Duplicate Current Dashboard" name="duplicate_current_dashboard"
                            type="object" class="oe_highlight" groups="base.group_user"
                            attrs="{'invisible': [('x_hide_update_dashboard_button', '=', True)]}"
                            confirm="Are you sure you want to duplicate current user dashboard?"/>
                    <button string="Update User Dashboard" name="update_user_dashboard"
                            type="object" class="oe_highlight" groups="base.group_user"
                            attrs="{'invisible': [('x_hide_update_dashboard_button', '=', True)]}"/>
                    <button string="View Dashboard" name="view_dashboard"
                            type="object" class="oe_highlight" groups="base.group_user"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="x_user_id"/>
                        </group>
                        <group>
                            <field name="x_items_count"/>
                            <field name="x_hide_update_dashboard_button" invisible="1"/>
                        </group>
                    </group>
                    <button string="Get User Data" name="get_user_data" type="object" class="oe_highlight" groups="base.group_user"/>
                    <separator string="User Dashboard Items" colspan="4"/>
                    <field name="x_user_dashboard_items" nolabel="1" widget="many2many_tags"/>
                    <separator colspan="4"/>
                    <button string="Update Data" name="update_data" type="object" class="oe_highlight" groups="base.group_user"/>
                    <separator string="User Dashboard Code" colspan="4"/>
                    <field name="x_user_dashboard_code" nolabel="1"/>
                    <separator string="Current User Dashboard Code" colspan="4"/>
                    <field name="x_current_user_dashboard_code" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_user_dashboard_tree" model="ir.ui.view">
        <field name="name">user.dashboard.tree</field>
        <field name="model">user.dashboard</field>
        <field name="arch" type="xml">
            <tree string="User Dashboards" multi_edit="1">
                <field name="x_sequence" widget="handle"/>
                <field name="x_user_id"/>
                <field name="x_items_count"/>
                <field name="x_user_dashboard_items" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="action_user_dashboard" model="ir.actions.act_window">
        <field name="name">User Dashboard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">user.dashboard</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new User Dashboard
            </p>
        </field>
    </record>

    <menuitem id="menu_user_dashboard"
              name="User Dashboards"
              parent="base.menu_board_root"
              action="action_user_dashboard"
              groups="base.group_system"
              sequence="7"/>
<!--    Dynamic Date Range-->
    <record id="view_dynamic_date_range_form" model="ir.ui.view">
        <field name="name">dynamic.date.range.form</field>
        <field name="model">dynamic.date.range</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Add Filter" name="add_filter_in_search_view" type="object" class="oe_highlight" groups="base.group_user"
                    attrs="{'invisible': [('state', '=', 'added')]}"/>
                    <button string="Update Filter" name="update_filter_in_search_view" type="object" class="oe_highlight" groups="base.group_user"
                    attrs="{'invisible': [('state', 'in', ('new', 'cancel'))]}"/>
                    <button string="Remove Filter" name="remove_filter_from_search_view" type="object" class="oe_highlight" groups="base.group_user"
                    attrs="{'invisible': [('state', 'in', ('new', 'cancel'))]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,added"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" placeholder="Filter Name e.g. DDR1"/>
                        </h1>
                    </div>
                    <group col="4">
                        <field name="x_period"/>
                        <label for="x_date_from" string="Date Range"/>
                        <div>
                            <field name="x_date_from" class="oe_inline"/>
                            -
                            <field name="x_date_to" class="oe_inline"/>
                        </div>
                        <field name="x_search_view" options="{'no_create': True}"/>
                        <field name="x_model_date_field" options="{'no_create': True}"/>
                        <field name="x_view_external_id"/>
                        <field name="x_view_model" options="{'no_create': True}"/>
                    </group>
                    <separator string="How to get ControlPanelView" colspan="4"/>
                    <separator string="Open the model you want to add filter in and click on spider icon." colspan="4"/>
                    <img src="/customizations/static/images/Step1a.JPG" alt="Step1a"/>
                    <separator string="Get View Name &amp; External ID." colspan="4"/>
                    <img src="/customizations/static/images/Step1b.JPG" alt="Step1b"/>
                    <separator string="Search by Name &amp; Verify External ID." colspan="4"/>
                    <img src="/customizations/static/images/Step2.JPG" alt="Step2"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dynamic_date_range_tree" model="ir.ui.view">
        <field name="name">dynamic.date.range.tree</field>
        <field name="model">dynamic.date.range</field>
        <field name="arch" type="xml">
            <tree string="Dynamic Date Range" multi_edit="1">
                <field name="x_name"/>
                <field name="x_view_model"/>
                <field name="x_period"/>
                <field name="x_date_from"/>
                <field name="x_date_to"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="action_dynamic_date_range" model="ir.actions.act_window">
        <field name="name">Dynamic Date Range</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dynamic.date.range</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Dynamic Date Range
            </p>
        </field>
    </record>

    <menuitem id="menu_dynamic_date_range"
              name="Dynamic Date Ranges"
              parent="base.menu_board_root"
              action="action_dynamic_date_range"
              groups="base.group_system"
              sequence="7"/>
</odoo>
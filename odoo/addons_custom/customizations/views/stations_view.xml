<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_stations_view_form" model="ir.ui.view">
        <field name="name">res.stations.form</field>
        <field name="model">res.stations</field>
        <field name="arch" type="xml">
            <form string="Conditions">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name"/>
                        </h1>
                    </div>
                    <button name="create_station_tasks" string="Create Tasks" type="object" class="btn-primary"/>
                    <group>
                        <field name="x_responsible_person_ids" widget="many2many_tags"/>
                        <field name="x_consumable_ids" widget="many2many_tags"/>
                        <field name="x_items_ids" widget="many2many_tags"/>
                        <field name="x_equipment_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_stations_view_tree" model="ir.ui.view">
        <field name="name">res.stations.tree</field>
        <field name="model">res.stations</field>
        <field name="arch" type="xml">
            <tree string="Conditions">
                <field name="x_name"/>
                <field name="x_responsible_person_ids" widget="many2many_tags"/>
                <field name="x_consumable_ids" widget="many2many_tags"/>
                <field name="x_items_ids" widget="many2many_tags"/>
                <field name="x_equipment_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="action_res_stations" model="ir.actions.act_window">
        <field name="name">Stations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.stations</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Station
            </p>
        </field>
    </record>

    <menuitem id="menu_res_stations" name="Stations" parent="project.menu_project_config" action="action_res_stations"/>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_bom_form_view_customization" model="ir.ui.view">
            <field name="name">mrp.bom.form.customization</field>
            <field name="model">mrp.bom</field>
		    <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='bom_line_ids']/tree[1]//field[@name='product_uom_id']" position="after">
                        <field name="x_investor_product" optional="hide"/>
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>

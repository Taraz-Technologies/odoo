<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_stock_landed_cost_form_customization_0">
        <field name="name">stock.landed.cost.form.customization</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <data>
                <field name="vendor_bill_id" position="after">
                    <field name="x_notes"/>
                </field>
                <xpath expr="//field[@name='valuation_adjustment_lines']/tree[1]/field[@name='product_id']" position="before">
                    <field name="x_split_method" readonly="1"/>
                </xpath>
                <xpath expr="//field[@name='valuation_adjustment_lines']/tree[1]/field[@name='volume']" position="after">
                    <field name="x_custom_duty_value" readonly="1" string="CD(%)" optional="hide"/>
                    <field name="x_additional_custom_duty_value" readonly="1" string="ACD(%)" optional="hide"/>
                    <field name="x_regulatory_duty_value" readonly="1" string="RD(%)" optional="hide"/>
                </xpath>
                <xpath expr="//page[1]" position="after">
                    <page string="Edit Lines">
                        <group>
                            <field name="x_valuation_adjustment_lines" nolabel="1">
                                <form string="Valuation Adjustments">
                                    <group>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="quantity"/>
                                        </group>
                                        <group>
                                            <field name="former_cost"/>
                                            <field name="additional_landed_cost"/>
                                        </group>
                                    </group>
                                </form>
                                <tree string="Valuation Adjustments" editable="bottom" create="0">
                                    <field name="product_id" readonly="1"/>
                                    <field name="x_add_in_landed_cost"/>
                                    <field name="x_split_method" readonly="1"/>
                                    <field name="quantity" readonly="1"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="former_cost" string="Value" readonly="1" widget="monetary"/>
                                    <field name="x_weight" string="Weight"/>
                                    <field name="x_volume" string="Volume"/>
                                    <field name="x_custom_duty" string="CD(%)"/>
                                    <field name="x_additional_custom_duty" string="ACD(%)"/>
                                    <field name="x_regulatory_duty" string="RD(%)"/>
                                </tree>
                            </field>
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record model="ir.ui.view" id="view_stock_landed_cost_tree_customization_0">
        <field name="name">stock.landed.cost.tree.customization</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_tree"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='state']" position="after">
                    <field name="vendor_bill_id"/>
                    <field name="x_notes"/>
                    <field name="picking_ids" widget="many2many_tags"/>
                </xpath>
            </data>
        </field>
    </record>

    <record model="ir.ui.view" id="view_stock_landed_cost_search_customization_0">
        <field name="name">stock.landed.cost.search.customization</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_search"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <data>
                <field name="picking_ids" position="after">
                    <field name="vendor_bill_id"/>
                    <field name="x_notes"/>
                </field>
            </data>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="view_move_tree_receipt_picking_customization" model="ir.ui.view">
		<field name="name">stock.move.tree.customization.1</field>
		<field name="model">stock.move</field>
		<field name="inherit_id" ref="stock.view_move_tree_receipt_picking"/>
		<field name="priority" eval="99"/>
		<field name="arch" type="xml">
			<data>
                <field name="picking_id" position="attributes">
					<attribute name="invisible">0</attribute>
					<attribute name="optional">show</attribute>
					<attribute name="widget">many2one</attribute>
				</field>
                <field name="origin" position="after">
                    <field name="product_uom_category_id" invisible="1"/>
                    <field name="x_partner_id" string="Vendor" optional="show"/>
                    <field name="x_purchase_order_id" widget="many2one" string="Purchase Order" optional="show"/>
                    <field name="x_production_id" widget="many2one" string="Manufacturing Order" optional="show"/>
                    <field name="x_finished_product_id" widget="many2one" string="Finished Product" optional="show"/>
                </field>
            </data>
        </field>
    </record>

	<record id="view_move_tree_customization" model="ir.ui.view">
		<field name="name">stock.move.tree.customization.2</field>
		<field name="model">stock.move</field>
		<field name="inherit_id" ref="stock.view_move_tree"/>
		<field name="priority" eval="99" />
		<field name="arch" type="xml">
			<data>
                <field name="reference" position="after">
                    <field name="x_sale_order_id" widget="many2one" string="Sale Order" optional="show"/>
                    <field name="picking_id" widget="many2one" string="Delivery" optional="show"/>
                    <field name="x_production_id" widget="many2one" string="Manufacturing Order" optional="show"/>
                    <field name="x_finished_product_id" widget="many2one" string="Finished Product" optional="show"/>
<!--                    <field name="x_sale_order_list" widget="many2many_tags" string="Sale Orders" optional="show"/>-->
                </field>
            </data>
        </field>
    </record>

    <record id="act_product_stock_move_reserved" model="ir.actions.act_window">
        <field name="name">Moves</field>
        <field name="res_model">stock.move</field>
        <field name="view_id" ref="stock.view_move_tree"/>
    </record>
</odoo>
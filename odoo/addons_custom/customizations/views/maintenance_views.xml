<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="hr_equipment_view_form_customization_0" model="ir.ui.view">
                <field name="name">maintenance.equipment.form.customization</field>
                <field name="model">maintenance.equipment</field>
                <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
                <field name="priority" eval="99" />
                <field name="arch" type="xml">
                        <data>
                                <xpath expr="//field[@name='note']" position="after">
                                        <separator string="Capture Images" colspan="4"/>
                                        <field name="x_image_ids" mode="kanban"/>
                                </xpath>
                        </data>
                </field>
        </record>
</odoo>

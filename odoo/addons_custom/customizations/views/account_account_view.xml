<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_customization_0" model="ir.ui.view">
        <field name="name">view_account_customization_0</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <data>
                <field name="name" position="after">
                    <field name="x_quickbooks_name" attrs="{'invisible': [('company_id', '!=', 1)]}"/>
                    <field name="x_luca_name" attrs="{'invisible': [('company_id', '!=', 2)]}"/>
                </field>
                <field name="deprecated" position="after">
                    <field name="x_notes"/>
                    <field name="x_partner_id"/>
                </field>
            </data>
        </field>
    </record>

    <record id="view_account_list_view_customization_0" model="ir.ui.view">
        <field name="name">view_account_list_view_customization_0</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <data>
                <field name="name" position="after">
                    <field name="x_quickbooks_name" optional="hide"/>
                    <field name="x_luca_name" optional="hide"/>
                </field>
                <field name="group_id" position="before">
                    <field name="x_notes"/>
                </field>
            </data>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Country Region-->
    <record id="view_country_regions_form" model="ir.ui.view">
        <field name="name">country.regions.form</field>
        <field name="model">country.regions</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="x_name" placeholder="Region Name" class="oe_inline"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_country_regions_tree" model="ir.ui.view">
        <field name="name">country.regions.tree</field>
        <field name="model">country.regions</field>
        <field name="arch" type="xml">
            <tree string="Country Regions">
                <field name="x_name"/>
            </tree>
        </field>
    </record>

    <record id="action_country_regions" model="ir.actions.act_window">
        <field name="name">Country Regions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">country.regions</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Country Region
            </p>
        </field>
    </record>

    <menuitem id="menu_country_regions"
              name="Country Regions"
              parent="contacts.menu_localisation"
              action="action_country_regions"
              sequence="3"/>
<!--    Country Sub-region-->
    <record id="view_country_subregions_form" model="ir.ui.view">
        <field name="name">country.subregions.form</field>
        <field name="model">country.subregions</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="x_name" placeholder="Name" class="oe_inline"/>
                        <field name="x_region" placeholder="Region" class="oe_inline"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_country_subregions_tree" model="ir.ui.view">
        <field name="name">country.subregions.tree</field>
        <field name="model">country.subregions</field>
        <field name="arch" type="xml">
            <tree>
                <field name="x_name"/>
                <field name="x_region"/>
            </tree>
        </field>
    </record>

    <record id="action_country_subregions" model="ir.actions.act_window">
        <field name="name">Country Sub-region</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">country.subregions</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Country Sub-region
            </p>
        </field>
    </record>

    <menuitem id="menu_country_subregions"
              name="Country Sub-region"
              parent="contacts.menu_localisation"
              action="action_country_subregions"
              sequence="3"/>
<!--    AREA OF INTERESTS  -->
    <record id="view_partner_interest_form" model="ir.ui.view">
        <field name="name">partner.interest.view.form</field>
        <field name="model">partner.interest</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="x_name"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_partner_interest_tree" model="ir.ui.view">
        <field name="name">partner.interest.view.tree</field>
        <field name="model">partner.interest</field>
        <field name="arch" type="xml">
            <tree>
                <field name="x_name"/>
            </tree>
        </field>
    </record>

    <record id="action_partner_interest" model="ir.actions.act_window">
        <field name="name">Partner Interest</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">partner.interest</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Partner Interest
            </p>
        </field>
    </record>

    <menuitem id="partner_interest_menu"
        name="Area of Interest"
        action="customizations.action_partner_interest"
        parent="contacts.menu_localisation"
        sequence="4"/>
</odoo>
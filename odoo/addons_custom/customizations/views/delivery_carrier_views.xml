<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record model="ir.ui.view" id="view_delivery_carrier_form_customization">
                <field name="name">delivery.carrier.form.customization</field>
                <field name="model">delivery.carrier</field>
                <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
                <field name="priority" eval="99" />
                <field name="arch" type="xml">
                        <data>
                                <xpath expr="//page[@name='destination']" position="after">
                                        <page name="export_settings" string="Export Settings">
                                                <separator string="Export Charges" colspan="4"/>
                                                <field name="x_export_charges">
                                                        <tree editable="bottom">
                                                                <field name="x_carrier_id" invisible="1"/>
                                                                <field name="x_name"/>
                                                                <field name="x_type"/>
                                                                <field name="currency_id" invisible="1"/>
                                                                <field name="x_amount" widget="monetary" attrs="{'invisible':[('x_type','!=','fix')]}"/>
                                                                <field name="x_percentage" widget="percentage" attrs="{'invisible':[('x_type','!=','percentage')]}"/>
                                                        </tree>
                                                </field>
                                        </page>
                                        <page name="import_settings" string="Import Settings">
                                                <separator string="Import Charges" colspan="4"/>
                                                <field name="x_import_charges">
                                                        <tree editable="bottom">
                                                                <field name="x_carrier_id" invisible="1"/>
                                                                <field name="x_name"/>
                                                                <field name="x_type"/>
                                                                <field name="currency_id" invisible="1"/>
                                                                <field name="x_amount" widget="monetary" attrs="{'invisible':[('x_type','=','percentage')]}"/>
                                                                <field name="x_percentage" widget="percentage" attrs="{'invisible':[('x_type','=','fix')]}"/>
                                                        </tree>
                                                </field>
                                        </page>
                                </xpath>
                        </data>
                </field>
        </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ################### Departments ################### -->
    <data noupdate="1">
      <record id="dep_accounts_and_finance" model="hr.department">
          <field name="name">Accounts &amp; Finance</field>
      </record>
      <record id="dep_management" model="hr.department">
          <field name="name">Management</field>
      </record>
      <record id="dep_operations" model="hr.department">
          <field name="name">Operations</field>
      </record>
      <record id="dep_production" model="hr.department">
          <field name="name">Production</field>
      </record>
      <record id="dep_research_and_development" model="hr.department">
          <field name="name">Research &amp; Development</field>
      </record>
      <record id="dep_sales_and_marketing" model="hr.department">
          <field name="name">Sales &amp; Marketing</field>
      </record>
    </data>
    <!-- ################## Job Positions ################## -->
    <data noupdate="1">
      <record id="job_pos_director" model="hr.job">
          <field name="name">Director</field>
          <field name="department_id" ref="dep_management"/>
      </record>
      <record id="job_pos_accounts_and_finance_manager" model="hr.job">
          <field name="name">Accounts &amp; Finance Manager</field>
          <field name="department_id" ref="dep_accounts_and_finance"/>
      </record>
      <record id="job_pos_marketing_manager" model="hr.job">
          <field name="name">Marketing Manager</field>
          <field name="department_id" ref="dep_sales_and_marketing"/>
      </record>
      <record id="job_pos_production_manager" model="hr.job">
          <field name="name">Production Manager</field>
          <field name="department_id" ref="dep_production"/>
      </record>
      <record id="job_pos_application_engineer" model="hr.job">
          <field name="name">Application Engineer</field>
          <field name="department_id" ref="dep_sales_and_marketing"/>
      </record>
      <record id="job_pos_development_engineer" model="hr.job">
          <field name="name">Development Engineer</field>
          <field name="department_id" ref="dep_research_and_development"/>
      </record>
      <record id="job_pos_production_engineer" model="hr.job">
          <field name="name">Production Engineer</field>
          <field name="department_id" ref="dep_production"/>
      </record>
      <record id="job_pos_process_application_engineer" model="hr.job">
          <field name="name">Process Application Engineer</field>
          <field name="department_id" ref="dep_operations"/>
      </record>
      <record id="job_pos_senior_rnd_engineer" model="hr.job">
          <field name="name">Senior R&amp;D Engineer</field>
          <field name="department_id" ref="dep_research_and_development"/>
      </record>
      <record id="job_pos_junior_rnd_engineer" model="hr.job">
          <field name="name">Junior R&amp;D Engineer</field>
          <field name="department_id" ref="dep_research_and_development"/>
      </record>
      <record id="job_pos_admin_coordinator" model="hr.job">
          <field name="name">Admin Coordinator</field>
          <field name="department_id" ref="hr.dep_administration"/>
      </record>
      <record id="job_pos_senior_technician" model="hr.job">
          <field name="name">Senior Technician</field>
          <field name="department_id" ref="dep_production"/>
      </record>
      <record id="job_pos_junior_technician" model="hr.job">
          <field name="name">Junior Technician</field>
          <field name="department_id" ref="dep_production"/>
      </record>
      <record id="job_pos_office_boy" model="hr.job">
          <field name="name">Office Boy</field>
          <field name="department_id" ref="dep_operations"/>
      </record>
      <record id="job_pos_rider_cleaner" model="hr.job">
          <field name="name">Rider / Cleaner</field>
          <field name="department_id" ref="dep_operations"/>
      </record>
      <record id="job_pos_internee" model="hr.job">
          <field name="name">Internee</field>
          <field name="department_id" ref=""/>
      </record>
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_end_user_document">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page h5" style="font-size:16px;">
                        <img src="/customizations/static/images/company_logo.png" width="285"/>
                        <div class="row">
                            <div class="col">
                                <h4 style="text-align: center;">Customer End-User Certificate</h4>
                                <p style="text-align: justify;">Complete the form. Print and sign the form. Scan and e-mail
                                    back to <a href="mailto:sales@taraztechnologies.com"><ins>sales@taraztechnologies.com</ins></a>.
                                    Please note that incomplete, illegible or non-specific answers will delay order shipments.</p>
                                <h5>Company or Individual Information.</h5>
                            </div>
                        </div>
                        <table class="table-sm" style="width:100%;">
                            <tr>
                                <td style="border: 1px solid gray; width: 70%;">
                                    <span>Name or Company Name<br/>
                                    <span t-field="o.partner_id"/></span>
                                </td>
                                <td style="border: 1px solid gray; width: 30%;">
                                    <span>DUNS, Federal ID or SSN<br/>
                                    <span t-field="o.partner_id.vat"/></span>
                                </td>
                            </tr>
                        </table>
                        <table class="table-sm" style="width:100%;">
                            <tr>
                                <td style="border: 1px solid gray; width: 65%;">
                                    <span>Address:<br/>
                                    <span t-field="o.partner_id.street"/><br/>
                                    <span t-field="o.partner_id.street2"/></span>
                                </td>
                                <td style="border: 1px solid gray; width: 35%;">
                                    <span>Web Address:<br/>
                                    <span t-field="o.partner_id.website"/></span>
                                </td>
                            </tr>
                        </table>
                        <table class="table-sm" style="width:100%;">
                            <tr>
                                <td style="border: 1px solid gray; width: 25%;">
                                    <span>City:<br/>
                                    <span t-field="o.partner_id.city"/></span>
                                </td>
                                <td style="border: 1px solid gray; width: 25%;">
                                    <span>State:<br/>
                                    <span t-field="o.partner_id.state_id"/></span>
                                </td>
                                <td style="border: 1px solid gray; width: 25%;">
                                    <span>Country:<br/>
                                    <span t-field="o.partner_id.country_id"/></span>
                                </td>
                                <td style="border: 1px solid gray; width: 25%;">
                                    <span>Postal Code:<br/>
                                    <span t-field="o.partner_id.zip"/></span>
                                </td>
                            </tr>
                        </table>
                        <table class="table mt16 mb0">
                            <tr>
                                <td style="border: 1px solid gray; width: 75%;">
                                    <span>1. Have you or has your company ever been convicted of violating U.S.
                                        Export Laws and Regulation? If Yes, provide details below. </span>
                                </td>
                                <td style="border: 1px solid gray; width: 25%;">

                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid gray; width: 75%;">
                                    <span>2. Are you or is your company currently listed on the Denied Person List,
                                        Unverified List or Entity List of the Bureau of Industry and Security, Department of Commerce?<br/>
                                        <a href="https://bis.doc.gov/index.php/policy-guidance/lists-of-parties-of-concern">
                                            <ins>https://bis.doc.gov/index.php/policy-guidance/lists-of-parties-of-concern</ins></a></span>
                                </td>
                                <td style="border: 1px solid gray; width: 25%;">

                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid gray; width: 75%;">
                                    <span>3. Are you or is your company currently listed on the Debar List of the
                                        Directorate of Defense Trade Controls, U.S. State Department?<br/>
                                        <a href="https://www.pmddtc.state.gov/ddtc_public?id=ddtc_kb_article_page&amp;sys_id=c22d1833dbb8d300d0a370131f9619f0">
                                            <ins>https://www.pmddtc.state.gov/ddtc_public?id=ddtc_kb_article_page&amp;sys_id=c22d1833dbb8d300d0a370131f9619f0</ins></a></span>
                                </td>
                                <td style="border: 1px solid gray; width: 25%;">

                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid gray; width: 75%;">
                                    <span>4. Are you or is your company currently listed on the Specially Designated
                                        Nationals List of the Office of Foreign Controls, U.S. Treasury Department?<br/>
                                        <a href="https://sanctionssearch.ofac.treas.gov/">
                                            <ins>https://sanctionssearch.ofac.treas.gov/</ins></a></span>
                                </td>
                                <td style="border: 1px solid gray; width: 25%;">

                                </td>
                            </tr>
                        </table>
                        <table class="table-sm" style="width:100%;">
                            <tr>
                                <td style="border: 1px solid gray;">
                                    <span>Specify the End-Use for this product by name or its application and if military or civilian:<br/><br/><br/></span>
                                    <span>What is the country of Ultimate Destination of this product?<br/><br/><br/></span>
                                </td>
                            </tr>
                        </table>
                        <div class="row mt8 mb8">
                            <div class="col">
                                <h5>Signature of person or person authorized to sign on behalf of the company. </h5>
                            </div>
                        </div>
                        <table class="table-sm" style="width:100%;">
                            <tr>
                                <td style="border: 1px solid gray; width: 70%;">
                                    <span>Signature:<br/><br/><br/></span>
                                </td>
                                <td style="border: 1px solid gray; width: 30%;">
                                    <span>Date:<br/><br/><br/></span>
                                </td>
                            </tr>
                        </table>
                        <table class="table-sm" style="width:100%;">
                            <tr>
                                <td style="border: 1px solid gray; width: 50%;">
                                    <span>Printed Name:<br/><br/><br/></span>
                                </td>
                                <td style="border: 1px solid gray; width: 50%;">
                                    <span>Title:<br/><br/><br/></span>
                                </td>
                            </tr>
                        </table>
                        <div class="row mt8 mb8">
                            <div class="col">
                                <h5>Order Information (Taraz Use Only)</h5>
                            </div>
                        </div>
                        <table class="table-sm" style="width:100%;">
                            <tr>
                                <td style="border: 1px solid gray; width: 34%;">
                                    <span>SO or Invoice Number:<br/>
                                    <span t-field="o.name"/></span>
                                </td>
                                <td style="border: 1px solid gray; width: 33%;">
                                    <span>Customer ID:</span>
                                </td>
                                <td style="border: 1px solid gray; width: 33%;">
                                    <span>Date:<br/>
                                    <span t-field="o.date_order"/></span>
                                </td>
                            </tr>
                        </table>
                        <table class="table-sm" style="width:100%;">
                            <tr>
                                <td style="border: 1px solid gray; width: 50%;">
                                    <span>Taraz Part Numbers with ECCN</span>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
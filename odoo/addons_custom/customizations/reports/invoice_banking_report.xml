<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="custom_report_invoice_banking_document">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)" />
                <div class="page h5" style="font-size:16px;">
                    <t t-if="o.x_hide_customer">
                        <span><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/></span>
                    </t>
                    <t t-else="">
                        <div class="row">
                            <div class="col-5" t-if="o.x_show_customer and o.x_customer_id">
                                <strong>Customer:</strong>
                                <t t-if="o.x_customer_id.parent_id">
                                    <div t-field="o.x_customer_id.parent_id.name"/>
                                    <t t-if="o.x_customer_id.street">
                                        <div t-field="o.x_customer_id.street"/>
                                    </t>
                                    <t t-if="o.x_customer_id.street2">
                                        <div t-field="o.x_customer_id.street2"/>
                                    </t>
                                    <t t-if="o.x_customer_id.zip">
                                        <span t-field="o.x_customer_id.zip"/>
                                    </t>
                                    <t t-if="o.x_customer_id.city">
                                        <span t-field="o.x_customer_id.city"/>,
                                    </t>
                                    <t t-if="o.x_customer_id.state_id">
                                        <span t-field="o.x_customer_id.state_id.code"/>,
                                    </t>
                                    <span t-field="o.x_customer_id.country_id"/>
                                    <div class="mt8">
                                        <t t-if="o.x_customer_id.name">
                                            <div>Attn:
                                                <span t-field="o.x_customer_id.title"/>
                                                <span t-field="o.x_customer_id.name"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="else">
                                    <div t-field="o.x_customer_id.name"/>
                                    <t t-if="o.x_customer_id.street">
                                        <div t-field="o.x_customer_id.street"/>
                                    </t>
                                    <t t-if="o.x_customer_id.street2">
                                        <div t-field="o.x_customer_id.street2"/>
                                    </t>
                                    <t t-if="o.x_customer_id.zip">
                                        <span t-field="o.x_customer_id.zip"/>
                                    </t>
                                    <t t-if="o.x_customer_id.city">
                                        <span t-field="o.x_customer_id.city"/>,
                                    </t>
                                    <t t-if="o.x_customer_id.state_id">
                                        <span t-field="o.x_customer_id.state_id.code"/>,
                                    </t>
                                    <span t-field="o.x_customer_id.country_id"/>
                                    <div class="mt8">
                                        <t t-if="o.x_customer_id.x_contact_name">
                                            <div>Attn:
                                                <span t-field="o.x_customer_id.x_contact_name"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-if="o.x_customer_id.phone">
                                    <div>
                                        <span t-field="o.x_customer_id.phone"/>
                                    </div>
                                </t>
                                <t t-elif="o.x_customer_id.mobile">
                                    <div>
                                        <span t-field="o.x_customer_id.mobile"/>
                                    </div>
                                </t>
                                <t t-if="o.x_customer_id.email">
                                    <div>
                                        <span t-field="o.x_customer_id.email"/>
                                    </div>
                                </t>
                            </div>
                            <div class="col-2" t-if="o.x_show_customer and o.x_customer_id"/>
                            <div class="col-5" t-if="o.x_show_end_user and o.x_end_user_id">
                                <strong>End-User:</strong>
                                <t t-if="o.x_end_user_id.parent_id">
                                    <div t-field="o.x_end_user_id.parent_id.name"/>
                                    <t t-if="o.x_end_user_id.street">
                                        <div t-field="o.x_end_user_id.street"/>
                                    </t>
                                    <t t-if="o.x_end_user_id.street2">
                                        <div t-field="o.x_end_user_id.street2"/>
                                    </t>
                                    <t t-if="o.x_end_user_id.zip">
                                        <span t-field="o.x_end_user_id.zip"/>
                                    </t>
                                    <t t-if="o.x_end_user_id.city">
                                        <span t-field="o.x_end_user_id.city"/>,
                                    </t>
                                    <t t-if="o.x_end_user_id.state_id">
                                        <span t-field="o.x_end_user_id.state_id.code"/>,
                                    </t>
                                    <span t-field="o.x_end_user_id.country_id"/>
                                    <div class="mt8">
                                        <t t-if="o.x_end_user_id.name">
                                            <div>Attn:
                                                <span t-field="o.x_end_user_id.title"/>
                                                <span t-field="o.x_end_user_id.name"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="else">
                                    <div t-field="o.x_end_user_id.name"/>
                                    <t t-if="o.x_end_user_id.street">
                                        <div t-field="o.x_end_user_id.street"/>
                                    </t>
                                    <t t-if="o.x_end_user_id.street2">
                                        <div t-field="o.x_end_user_id.street2"/>
                                    </t>
                                    <t t-if="o.x_end_user_id.zip">
                                        <span t-field="o.x_end_user_id.zip"/>
                                    </t>
                                    <t t-if="o.x_end_user_id.city">
                                        <span t-field="o.x_end_user_id.city"/>,
                                    </t>
                                    <t t-if="o.x_end_user_id.state_id">
                                        <span t-field="o.x_end_user_id.state_id.code"/>,
                                    </t>
                                    <span t-field="o.x_end_user_id.country_id"/>
                                    <div class="mt8">
                                        <t t-if="o.x_end_user_id.x_contact_name">
                                            <div>Attn:
                                                <span t-field="o.x_end_user_id.x_contact_name"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-if="o.x_end_user_id.phone">
                                    <div>
                                        <span t-field="o.x_end_user_id.phone"/>
                                    </div>
                                </t>
                                <t t-elif="o.x_end_user_id.mobile">
                                    <div>
                                        <span t-field="o.x_end_user_id.mobile"/>
                                    </div>
                                </t>
                                <t t-if="o.x_end_user_id.email">
                                    <div>
                                        <span t-field="o.x_end_user_id.email"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <div class="row mt8">
                            <div class="col-5" t-if="o.x_show_bill_to and o.partner_id">
                                <strong>Bill To:</strong>
                                <t t-if="o.partner_id.parent_id">
                                    <div t-field="o.partner_id.parent_id.name"/>
                                    <t t-if="o.partner_id.street">
                                        <div t-field="o.partner_id.street"/>
                                    </t>
                                    <t t-if="o.partner_id.street2">
                                        <div t-field="o.partner_id.street2"/>
                                    </t>
                                    <t t-if="o.partner_id.zip">
                                        <span t-field="o.partner_id.zip"/>
                                    </t>
                                    <t t-if="o.partner_id.city">
                                        <span t-field="o.partner_id.city"/>,
                                    </t>
                                    <t t-if="o.partner_id.state_id">
                                        <span t-field="o.partner_id.state_id.code"/>,
                                    </t>
                                    <span t-field="o.partner_id.country_id"/>
                                    <div class="mt8">
                                        <t t-if="o.partner_id.name">
                                            <div>Attn:
                                                <span t-field="o.partner_id.title"/>
                                                <span t-field="o.partner_id.name"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="else">
                                    <div t-field="o.partner_id.name"/>
                                    <t t-if="o.partner_id.street">
                                        <div t-field="o.partner_id.street"/>
                                    </t>
                                    <t t-if="o.partner_id.street2">
                                        <div t-field="o.partner_id.street2"/>
                                    </t>
                                    <t t-if="o.partner_id.zip">
                                        <span t-field="o.partner_id.zip"/>
                                    </t>
                                    <t t-if="o.partner_id.city">
                                        <span t-field="o.partner_id.city"/>,
                                    </t>
                                    <t t-if="o.partner_id.state_id">
                                        <span t-field="o.partner_id.state_id.code"/>,
                                    </t>
                                    <span t-field="o.partner_id.country_id"/>
                                    <div class="mt8">
                                        <t t-if="o.partner_id.x_contact_name">
                                            <div>Attn:
                                                <span t-field="o.partner_id.x_contact_name"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-if="o.partner_id.phone">
                                    <div>
                                        <span t-field="o.partner_id.phone"/>
                                    </div>
                                </t>
                                <t t-elif="o.partner_id.mobile">
                                    <div>
                                        <span t-field="o.partner_id.mobile"/>
                                    </div>
                                </t>
                                <t t-if="o.partner_id.email">
                                    <div>
                                        <span t-field="o.partner_id.email"/>
                                    </div>
                                </t>
                            </div>
                            <div class="col-2" t-if="o.x_show_bill_to and o.partner_id"/>
                            <div class="col-5" t-if="o.x_show_ship_to and o.partner_shipping_id">
                                <strong>Ship To:</strong>
                                <t t-if="o.partner_shipping_id.x_company">
                                    <div t-field="o.partner_shipping_id.x_company"/>
                                </t>
                                <t t-else="else">
                                    <div t-field="o.partner_shipping_id.name"/>
                                </t>
                                <t t-if="o.partner_shipping_id.street">
                                    <div t-field="o.partner_shipping_id.street"/>
                                </t>
                                <t t-if="o.partner_shipping_id.street2">
                                    <div t-field="o.partner_shipping_id.street2"/>
                                </t>
                                <t t-if="o.partner_shipping_id.zip">
                                    <span t-field="o.partner_shipping_id.zip"/>
                                </t>
                                <t t-if="o.partner_shipping_id.city">
                                    <span t-field="o.partner_shipping_id.city"/>,
                                </t>
                                <t t-if="o.partner_shipping_id.state_id">
                                    <span t-field="o.partner_shipping_id.state_id.code"/>,
                                </t>
                                <span t-field="o.partner_shipping_id.country_id"/>
                                <div class="mt8">
                                    <t t-if="o.partner_shipping_id.name">
                                        <div>Attn:
                                            <span t-field="o.partner_shipping_id.title"/>
                                            <span t-field="o.partner_shipping_id.name"/>
                                        </div>
                                    </t>
                                    <t t-if="o.partner_shipping_id.phone">
                                        <div>
                                            <span t-field="o.partner_shipping_id.phone"/>
                                        </div>
                                    </t>
                                    <t t-elif="o.partner_shipping_id.mobile">
                                        <div>
                                            <span t-field="o.partner_shipping_id.mobile"/>
                                        </div>
                                    </t>
                                    <t t-if="o.partner_shipping_id.email">
                                        <div>
                                            <span t-field="o.partner_shipping_id.email"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                    <h2 class="mt24 mb16" style="color:#009999;">
                        <span t-if="o.type == 'out_invoice' and o.state == 'posted'">Invoice #</span>
                        <span t-if="o.type == 'out_invoice' and o.state == 'draft'">Invoice #</span>
                        <span t-if="o.type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                        <span t-if="o.type == 'out_refund'">Credit Note</span>
                        <span t-if="o.type == 'in_refund'">Vendor Credit Note</span>
                        <span t-if="o.type == 'in_invoice'">Vendor Bill</span>
                        <t t-if="o.x_old_number">
                            <span t-field="o.x_old_number"/>
                        </t>
                        <t t-elif="o.x_sale_tax_invoice_number">
                            <t t-if="'FY' in o.x_sale_tax_invoice_number or o.x_appear_taraz_invoice_number">
                                <span t-field="o.x_sale_tax_invoice_number"/>
                            </t>
                            <t t-else="else">
                                <span t-field="o.name"/>
                            </t>
                        </t>
                        <t t-else="else">
                            <span t-field="o.name"/>
                        </t>
                    </h2>
                    <div class="mt16 mb16" style="font-size:17px;">
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.invoice_date" name="invoice_date">
                            <div class="p-2">
                                <strong>Invoice Date:</strong>
                                <p class="m-0" t-esc="o.invoice_date"/>
                            </div>
                        </div>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.invoice_date_due and o.type == 'out_invoice' and o.state in ('open', 'in_payment', 'paid')" name="due_date">
                            <div class="p-2">
                                <strong>Due Date:</strong>
                                <p class="m-0" t-esc="o.invoice_date_due"/>
                            </div>
                        </div>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.invoice_origin" name="origin">
                            <div class="p-2">
                                <strong>Sale Order #:</strong>
                                <p class="m-0" t-field="o.invoice_origin"/>
                            </div>
                        </div>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_web_order_number">
                            <div class="p-2">
                                <strong>WEB Order#:</strong>
                                <p class="m-0" t-field="o.x_web_order_number"/>
                            </div>
                        </div>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.ref">
                            <div class="p-2">
                                <strong>Customer PO#:</strong>
                                <p class="m-0" t-field="o.ref"/>
                            </div>
                        </div>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.invoice_payment_term_id">
                            <div class="p-2">
                                <strong>Payment Terms:</strong>
                                <p class="m-0" t-field="o.invoice_payment_term_id"/>
                            </div>
                        </div>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_bank.x_report_code and o.x_appear_payment_method">
                            <div class="p-2">
                                <strong>Payment Method:</strong>
                                <p class="m-0" t-field="o.x_bank.x_report_code"/>
                            </div>
                        </div>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.invoice_incoterm_id">
                            <div class="p-2">
                                <strong>Incoterms:</strong>
                                <p class="m-0" t-field="o.invoice_incoterm_id.code"/>
                            </div>
                        </div>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_delivery_method">
                            <div class="p-2">
                                <strong>Carrier:</strong>
                                <p class="m-0" t-field="o.x_delivery_method"/>
                            </div>
                        </div>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_tracking_reference">
                            <div class="p-2">
                                <strong>Tracking #:</strong>
                                <p class="m-0" t-field="o.x_tracking_reference"/>
                            </div>
                        </div>
<!--                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.invoice_user_id">-->
<!--                            <div class="p-2">-->
<!--                                <strong>Sales Rep:</strong>-->
<!--                                <p class="m-0" t-field="o.invoice_user_id"/>-->
<!--                            </div>-->
<!--                        </div>-->
                    </div>
                    <t t-set="display_discount" t-value="any([l.discount for l in o.x_invoice_lines]) and not o.x_hide_discount"/>
                    <style>
                        tr:nth-child(odd)>td {
                          background-color: rgba(220, 220, 220, 0.02);
                        }
                    </style>
                    <table class="table table-sm" name="invoice_line_table">
                        <thead>
                            <tr>
                                <!-- TODO: remove in master -->
                                <t t-set="colspan" t-value="6"/>
                                <th class="text-left" style="color:#009999;">Description</th>
                                <th class="text-right" style="color:#009999;">Quantity</th>
                                <th t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="color:#009999;">Unit Price</th>
                                <th t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="color:#009999;">
                                    <span>Disc.(%)</span>
                                    <!-- TODO: remove in master -->
                                    <t t-set="colspan" t-value="colspan+1"/>
                                </th>
                                <!--<th t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>-->
                                <th class="text-right" style="color:#009999;">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-foreach="o.x_invoice_lines" t-as="line">
                                <t t-if="not 'Down Payment' in line.product_id.name and not 'BOS' in line.product_id.name and not 'PACKING' in line.product_id.name">
                                    <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                        <t t-if="not line.display_type" name="account_invoice_line_accountable">
                                            <td style="width: 50%;">
                                                <t t-if="o.x_hide_product != True">
                                                    <strong t-field="line.product_id"/><br/>
                                                </t>
                                                <span t-field="line.name"/>
                                                <t t-if="o.x_hs_code_and_coo">
                                                    <t t-if="line.product_id.dk_hs_code">
                                                        <br/>HS Code: <span t-field="line.product_id.dk_hs_code.x_hs_code"/>
                                                    </t>
                                                    <t t-if="line.product_id.x_country_id">
                                                        <br/>COO: <span t-field="line.product_id.x_country_id.name"/>
                                                    </t>
                                                </t>
                                                <t t-if="o.x_hide_discount and line.discount != 0">
                                                    <br/>Price incl. of <span t-esc="'{0:,.0f}'.format(line.discount)"/>% discount.
                                                </t>
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="'{0:,.0f}'.format(line.quantity)"/>
                                                <span t-field="line.product_uom_id"/>
                                            </td>
                                            <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                                <t t-if="o.x_hide_discount">
                                                    <span t-esc="'{0:,.2f}'.format(line.price_subtotal * o.amount_untaxed / o.x_amount_untaxed / line.quantity)"/>
                                                </t>
                                                <t t-else="">
                                                    <span t-esc="'{0:,.2f}'.format(line.price_subtotal * o.amount_untaxed / o.x_amount_untaxed / line.quantity / (1 - line.discount / 100))"/>
                                                </t>
                                            </td>
                                            <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                                <span t-field="line.discount"/>
                                            </td>
                                            <td class="text-right o_price_total">
                                                <span t-field="o.currency_id.symbol"/>
                                                <span t-esc="'{0:,.2f}'.format(line.price_subtotal * o.amount_untaxed / o.x_amount_untaxed)"/>
                                            </td>
                                        </t>
                                        <t t-if="line.display_type == 'line_section'">
                                            <td colspan="99">
                                                <span t-field="line.name"/>
                                            </td>
                                        </t>
                                        <t t-if="line.display_type == 'line_note'">
                                            <td colspan="99">
                                                <span t-field="line.name"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                    <div class="clearfix">
                        <div class="row">
                            <div class="col-7"/>
                            <div class="col-1"/>
                            <div class="col-4">
                                <table class="table table-sm">
                                    <tr class="o_subtotal">
                                        <td>Subtotal</td>
                                        <td class="text-right">
                                            <span t-field="o.currency_id.symbol"/>
                                            <span t-esc="'{0:,.2f}'.format(o.amount_untaxed)"/>
                                        </td>
                                    </tr>
                                    <tr class="o_total" style="color:#009999;">
                                        <td>Total</td>
                                        <td class="text-right">
                                            <span t-field="o.currency_id.symbol"/>
                                            <span t-esc="'{0:,.2f}'.format(o.amount_untaxed)"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                    <t t-if="o.x_hide_discount">
                        <div class="row">
                            <div class="col">
                                <t t-if="o.x_hide_discount">
                                    <span>Above prices are inclusive of discount.</span>
                                </t>
                            </div>
                        </div>
                    </t>
                    <div class="row mt16" style="display: block;" t-if="o.x_remarks">
                        <div class="col">
                            <span t-field="o.x_remarks"/>
                        </div>
                    </div>
                    <div class="row mt16" style="display: block;" t-if="o.x_appear_banking_details and o.x_bank">
                        <div class="col">
                            <span t-field="o.x_bank.x_report_msg"/>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="custom_report_invoice_banking">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.invoice_user_id.sudo().lang if o.type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
                    <t t-call="customizations.custom_report_invoice_banking_document" t-lang="lang"/>
                </t>
            </t>
        </template>
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--	Investment View-->
	<record id="view_investment_form" model="ir.ui.view">
		<field name="name">res.investment.form</field>
		<field name="model">res.investment</field>
		<field name="arch" type="xml">
			<form string="Investments">
				<sheet>
					<div class="oe_title">
						<h1>
							<field name="x_name"/>
						</h1>
					</div>
					<group>
						<group>
							<field name="x_date"/>
							<field name="x_currency_id"/>
						</group>
						<group>
							<field name="x_investment_required" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
							<field name="x_investment_raised" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
						</group>
					</group>
					<notebook>
						<page string="Products">
							<field name="x_product_ids">
								<tree editable="bottom">
									<field name="x_investment_id" invisible="1"/>
									<field name="x_currency_id" invisible="1"/>
									<field name="x_product_id" widget="many2one" attrs="{'readonly': [('id', '!=', False)]}"/>
									<field name="x_quantity"/>
									<field name="x_unit_cost" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
									<field name="x_adjustment" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
									<field name="x_subtotal" widget="monetary" options="{'currency_field': 'x_currency_id'}" sum="Total Required"/>
									<field name="x_note"/>
								</tree>
								<form>
									<sheet>
										<field name="x_investment_id" invisible="1"/>
										<field name="x_currency_id" invisible="1"/>
										<group>
											<field name="x_product_id"/>
											<field name="x_quantity"/>
											<field name="x_unit_cost" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
											<field name="x_adjustment" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
											<field name="x_subtotal" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
											<field name="x_note"/>
										</group>
									</sheet>
								</form>
							</field>
						</page>
						<page string="Investors">
							<field name="x_investor_ids">
								<tree editable="bottom">
									<field name="x_investment_id" invisible="1"/>
									<field name="x_date"/>
									<field name="x_partner_id"/>
									<field name="x_currency_id" invisible="1"/>
									<field name="x_investment_value" sum="Total Raised"/>
									<field name="x_invoice_id" widget="many2one"/>
								</tree>
							</field>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_investment_tree" model="ir.ui.view">
		<field name="name">res.investment.tree</field>
		<field name="model">res.investment</field>
		<field name="arch" type="xml">
			<tree string="Investments">
				<field name="x_name"/>
				<field name="x_date"/>
				<field name="x_currency_id" invisible="1"/>
				<field name="x_product_ids" widget="many2many_tags" optional="hide"/>
				<field name="x_investment_required"/>
				<field name="x_investor_ids" widget="many2many_tags" optional="hide"/>
				<field name="x_investment_raised"/>
			</tree>
		</field>
	</record>

	<record id="view_investment_filter" model="ir.ui.view">
		<field name="name">res.investment.select</field>
		<field name="model">res.investment</field>
		<field name="arch" type="xml">
			<search string="Investments">
				<field name="x_name"/>
			</search>
		</field>
	</record>

	<record id="action_view_investment" model="ir.actions.act_window">
		<field name="name">Investments</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">res.investment</field>
		<field name="view_mode">tree,form</field>
		<field name="search_view_id" ref="view_investment_filter"/>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">Create new Record</p>
		</field>
	</record>
</odoo>
<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_stock_quant_reserved_quantity" model="ir.ui.view">
            <field name="name">stock.quant.reserved.quantity</field>
            <field name="model">stock.quant.reserved.quantity</field>
            <field name="arch" type="xml">
                <form string="Stock Quant Reserved Quantity">
                    <group>
                        <field name="stock_quant_id" invisible="1"/>
                        <field name="reserved_quantity"/>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
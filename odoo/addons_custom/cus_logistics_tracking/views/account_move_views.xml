<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_cus_logistics_tracking" model="ir.ui.view">
            <field name="name">view_move_form_cus_logistics_tracking</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="ref" position="after">
                    <field name="x_operation_type"/>
                </field>
                <xpath expr="/form/sheet/group[1]/group[2]/div[@class='o_td_label']" position="before">
                    <field name="x_folder_name" attrs="{'invisible': ['|', ('x_folder_name', '=', False), ('type', 'not in', ('in_invoice', 'out_invoice'))]}"/>
                </xpath>
                <group name="payments_info_group" position="after">
                    <group name="customs_info" string="Customs Info" attrs="{'invisible':['|', ('company_id', '!=', 2), ('type', 'not in', ('in_invoice'))]}">
                        <field name="x_free_zone_operation_id" invisible="1"/>
                        <field name="x_attachment_name" invisible="1"/>
                        <label for="x_attachment"/>
                        <div class="o_row">
                            <field name="x_attachment" filename="x_attachment_name"/>
                            <button name="pull_form_data_from_picking" class="oe_highlight" type="object" string="Get Data" attrs="{'invisible': [('x_attachment', '!=', False)]}"/>
                        </div>
                        <field name="x_form_field_01"/>
                        <field name="x_form_field_11"/>
                        <field name="x_form_field_02"/>
                        <field name="x_form_field_03"/>
                        <field name="x_form_field_04"/>
                        <field name="x_form_field_05"/>
                        <field name="x_form_field_06"/>
                        <field name="x_form_field_09"/>
                        <label for="x_form_field_10"/>
                        <div class="o_row">
                            <field name="x_form_field_10"/>
                            <span>kg</span>
                        </div>
                        <label for="x_form_field_12"/>
                        <div class="o_row">
                            <field name="x_form_field_12"/>
                            <span>KAP</span>
                        </div>
                        <field name="x_form_field_13" invisible="1"/>
                        <field name="x_form_field_07" widget="monetary" options="{'currency_field': 'x_form_field_13'}"/>
                        <field name="x_form_field_14" invisible="1"/>
                        <field name="x_form_field_08" widget="monetary" options="{'currency_field': 'x_form_field_14'}"/>
                    </group>
                </group>
                <page id="other_tab_entry" position="inside">
                    <group name="customs_info" string="Customs Info" attrs="{'invisible':['|', ('company_id', '!=', 2), ('type', 'not in', ('entry'))]}">
                        <field name="x_attachment_name" invisible="1"/>
                        <label for="x_attachment"/>
                        <div class="o_row">
                            <field name="x_attachment" filename="x_attachment_name"/>
                            <button name="pull_form_data_from_picking" class="oe_highlight" type="object" string="Get Data" attrs="{'invisible': [('x_attachment', '!=', False)]}"/>
                        </div>
                        <field name="x_form_field_01"/>
                        <field name="x_form_field_11"/>
                        <field name="x_form_field_02"/>
                        <field name="x_form_field_03"/>
                        <field name="x_form_field_04"/>
                        <field name="x_form_field_05"/>
                        <field name="x_form_field_06"/>
                        <field name="x_form_field_09"/>
                        <label for="x_form_field_10"/>
                        <div class="o_row">
                            <field name="x_form_field_10"/>
                            <span>kg</span>
                        </div>
                        <label for="x_form_field_12"/>
                        <div class="o_row">
                            <field name="x_form_field_12"/>
                            <span>KAP</span>
                        </div>
                        <field name="x_form_field_13" invisible="1"/>
                        <field name="x_form_field_07" widget="monetary" options="{'currency_field': 'x_form_field_13'}"/>
                        <field name="x_form_field_14" invisible="1"/>
                        <field name="x_form_field_08" widget="monetary" options="{'currency_field': 'x_form_field_14'}"/>
                    </group>
                </page>
            </field>
        </record>

        <record id="cus_logistics_tracking_view_account_move_form_customization_0" model="ir.ui.view">
            <field name="name">cus_logistics_tracking_view_account_move_form_customization_0</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="customizations.view_account_move_form_customization_0"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-calendar" attrs="{'invisible': [('x_picking_count', '=', 0)]}">
                        <div class="o_stat_info">
                            <field name="x_picking_count" class="o_stat_value"/>
                            <span class="o_stat_text" attrs="{'invisible': [('x_picking_count', '&lt;', 2)]}">Related
                                ROs/DOs
                            </span>
                            <span class="o_stat_text" attrs="{'invisible': [('x_picking_count', '&gt;', 1)]}">Related
                                RO/DO
                            </span>
                        </div>
                    </button>
                </div>
                <field name="x_related_po_s" position="after">
                    <field name="x_attach_pickings" invisible="1"/>
                    <field name="x_picking_ids" widget="many2many_tags" attrs="{'invisible':['|', ('type','!=','in_invoice'), ('x_attach_pickings','=',False)]}"/>
                    <field name="x_consolidation_id"/>
                    <field name="x_consolidation_ref" attrs="{'invisible':['|', ('type','!=','in_invoice'), ('x_consolidation_ref','=',False)]}"/>
                    <field name="x_shipping_invoice_name" invisible="1"/>
                    <field name="x_shipping_invoice" filename="x_shipping_invoice_name" attrs="{'invisible':['|', ('type','!=','in_invoice'), ('x_shipping_invoice','=',False)]}"/>
                </field>
            </field>
        </record>

        <record id="view_picking_related_bills_action" model="ir.actions.act_window">
            <field name="name">Related Bills</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="cus_logistics_tracking_view_invoice_tree" model="ir.ui.view">
            <field name="name">cus_logistics_tracking_view_invoice_tree</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <field name="ref" position="after">
                    <field name="x_operation_type" optional="hide"/>
                </field>
                <field name="state" position="after">
                    <field name="x_landed_cost_state" widget="state_selection" optional="hide"/>
                    <field name="x_consolidation_id" widget="many2one" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="cus_logistics_tracking_view_account_invoice_filter" model="ir.ui.view">
            <field name="name">cus_logistics_tracking_view_account_invoice_filter</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <field name="date" position="after">
                    <field name="x_consolidation_id"/>
                </field>
                <filter name="due_date" position="after">
                    <separator/>
                    <filter name="free" string="FZ Operation" domain="[('x_operation_type', '=', 'free')]"/>
                    <filter name="otb" string="OTB Operation" domain="[('x_operation_type', '=', 'otb')]"/>
                </filter>
                <filter name="duedate" position="after">
                    <filter string="Consolidation" name="consolidation_id" context="{'group_by': 'x_consolidation_id'}"/>
                    <separator/>
                    <filter string="Operation (FZ/OTB)" name="operation_fz_otb" context="{'group_by': 'x_operation_type'}"/>
                </filter>
            </field>
        </record>

        <record id="cus_accounts_view_move_luca_tree" model="ir.ui.view">
            <field name="name">view_move_luca_tree</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="cus_accounts.view_move_luca_tree"/>
            <field name="arch" type="xml">
                <field name="state" position="after">
                    <field name="x_landed_cost_state" widget="state_selection" optional="hide"/>
                </field>
                <field name="x_related_purchase_id" position="after">
                    <field name="x_operation_type" optional="hide"/>
                    <field name="x_attachment_name" invisible="1"/>
                    <field name="x_attachment" filename="x_attachment_name" widget="download_link"/>
                    <field name="x_form_field_01" optional="hide"/>
                    <field name="x_form_field_11" optional="hide"/>
                    <field name="x_form_field_02" optional="hide"/>
                    <field name="x_form_field_03" optional="hide"/>
                    <field name="x_form_field_04" optional="hide"/>
                    <field name="x_form_field_05" optional="hide"/>
                    <field name="x_form_field_06" optional="hide"/>
                    <field name="x_form_field_09" optional="hide"/>
                    <field name="x_form_field_10" optional="hide"/>
                    <field name="x_form_field_12" optional="hide"/>
                    <field name="x_form_field_13" invisible="1"/>
                    <field name="x_form_field_07" widget="monetary" options="{'currency_field': 'x_form_field_13'}" optional="hide"/>
                    <field name="x_form_field_14" invisible="1"/>
                    <field name="x_form_field_08" widget="monetary" options="{'currency_field': 'x_form_field_14'}" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="cus_accounts_view_move_luca_search" model="ir.ui.view">
            <field name="name">view_move_luca_search</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="cus_accounts.view_move_luca_search"/>
            <field name="arch" type="xml">
                <field name="name" position="attributes">
                    <attribute name="filter_domain">['|', '|', '|', '|', '|', '|', '|',
                        ('name', 'ilike', self),
                        ('ref', 'ilike', self),
                        ('partner_id', 'ilike', self),
                        ('id', 'ilike', self),
                        ('x_account_id', 'ilike', self),
                        ('x_analytic_tag_ids', 'ilike', self),
                        ('x_consolidation_ref', 'ilike', self),
                        ('x_consolidation_id', 'ilike', self),
                        ]
                    </attribute>
                </field>
                <filter name="by_company" position="after">
                    <filter string="Landed Cost State" name="landed_cost_state" domain="[]" context="{'group_by': 'x_landed_cost_state'}" groups="base.group_multi_company"/>
                </filter>
            </field>
        </record>
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="ir_cron_logistics_tracking_dates" model="ir.cron">
            <field name="name">Logistics Tracking: Get Logistics Tracking Dates</field>
            <field name="model_id" ref="model_logistics_tracking"/>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="code">model.get_tracking_dates_from_url()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
        </record>

        <record id="ir_cron_update_picking_color" model="ir.cron">
            <field name="name">Logistics Tracking: Update Picking Color</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="code">model.update_picking_color()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>

        <record id="ir_cron_get_delivery_remaining_days" model="ir.cron">
            <field name="name">Logistics Tracking: Get Stock Picking Remaining Days</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="code">model.get_remaining_days()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>
    </data>
</odoo>

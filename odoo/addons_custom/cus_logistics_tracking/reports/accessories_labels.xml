<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_accessories_labels">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="doc">
                    <div class="page" style="font-family: Arial; font-size:12px;">
                        <t t-foreach="doc.x_shipping_invoice_lines" t-as="product">
                            <t t-if="not 'BOS' in product.product_id.name and not 'PACKING' in product.product_id.name and not 'Freight' in product.product_id.name">
                                <div class="row p-0" style="page-break-after:always;">
                                    <div class="col p-0">
                                        <table class="table table-sm table-bordered">
                                            <thead>
                                                <tr style="text-align: center;">
                                                    <th class="p-1">Accessory</th>
                                                    <th class="p-1">Quantity</th>
                                                    <th class="p-1">Done</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="product.product_id.x_accessory_ids" t-as="accessory">
                                                    <tr>
                                                        <td class="p-1">
                                                            <span t-field="accessory.x_short_description"/>
                                                        </td>
                                                        <td class="p-1" style="text-align: center;">
                                                            <span t-esc="'%.0f'%(accessory.x_quantity)"/>
                                                        </td>
                                                        <td class="p-1" style="text-align: center;">☐</td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
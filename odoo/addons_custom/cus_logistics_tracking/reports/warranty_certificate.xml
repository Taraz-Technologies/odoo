<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_warranty_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial; font-size:16px">
                        <div class="row">
                            <div class="col">
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <center>
                                    <b>
                                        <h1>Warranty Certificate</h1>
                                    </b>
                                </center>
                                <br/>
                                <span t-field="doc.x_body_warranty"/>
                            </div>
                        </div>
                        <div class="row" style="margin-top: 10px; margin-bottom: 10px">
                            <div class="col">
                                <strong>Sale Order #:</strong>
                                <br/>
                                <span t-field="doc.origin"/>
                            </div>
                        </div>
                        <table class="table table-bordered" style="border: 1px solid gray; border-collapse: collapse;">
                            <thead>
                                <tr>
                                    <th style="border: 1px solid gray;">
                                        <span>Product</span>
                                    </th>
                                    <th style="border: 1px solid gray;">
                                        <span>Description</span>
                                    </th>
                                    <th style="border: 1px solid gray; text-align: right;">
                                        <span>Quantity</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.x_shipping_invoice_lines" t-as="table_line">
                                    <t t-if="not 'BOS' in table_line.product_id.name and not 'PACKING' in table_line.product_id.name and not 'Freight' in table_line.product_id.name">
                                        <td style="border: 1px solid gray; width: 300px;">
                                            <span t-field="table_line.product_id"/>
                                        </td>
                                        <td style="border: 1px solid gray; width: 500px;">
                                            <span t-field="table_line.product_id.x_short_description"/>
                                        </td>
                                        <td style="border: 1px solid gray; width: 100px; text-align: right;">
                                            <span t-esc="'%.0f'%(table_line.quantity)"/>
                                        </td>
                                    </t>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-borderless" style="margin-top:50px;">
                            <tbody>
                                <tr>
                                    <td style="width: 500px;">
                                        <span t-field="doc.x_signatory_warranty"/>
                                    </td>
                                    <td style="width: 500px; text-align: right;">
                                        <span t-field="doc.x_date_certificate_warranty" t-options='{"widget": "date","format": "MMMM dd, yyyy"}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
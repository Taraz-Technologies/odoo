<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_certificate_of_origin_multi">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="doc">
                    <div class="page" style="font-family: Arial; font-size:15px">
                        <img class="card-img" src="/cus_sale/static/images/certificate-of-origin.jpg" style="width: 100%;"/>
                        <div class="card-img-overlay">
                            <!--                            Date-->
                            <div class="row" style="position: fixed; left: 590px; top: 37px">
                                <span t-field="doc.x_date_certificate" t-options='{"widget": "date","format": "MMMM dd, yyyy"}'/>
                            </div>
                            <!--                            Shipper Details-->
                            <div class="row" style="position: fixed; left: 45px; top: 90px">
                                <span>Shipper's Name and Address:</span>
                                <br/>
                                <br/>
                                <strong t-field="doc.company_id"/>
                                <br/>
                                <span t-field="doc.company_id.street"/>
                                <br/>
                                <span t-field="doc.company_id.street2"/>
                                <br/>
                                <span t-field="doc.company_id.city"/>
                                -
                                <span t-field="doc.company_id.zip"/>
                            </div>
                            <!--                            Consignee Details-->
                            <div class="row" style="position: fixed; left: 45px; top: 245px">
                                <span>Consignee's Name and Address:</span>
                                <br/>
                                <br/>
                                <t t-if="doc.partner_id.parent_id">
                                    <strong t-field="doc.partner_id.parent_id"/>
                                </t>
                                <t t-else="else">
                                    <strong t-field="doc.partner_id.name"/>
                                </t>
                                <t t-if="doc.partner_id.street">
                                    <br/>
                                    <span t-field="doc.partner_id.street"/>
                                </t>
                                <t t-if="doc.partner_id.street2">
                                    <br/>
                                    <span t-field="doc.partner_id.street2"/>
                                </t>
                                <t t-if="doc.partner_id.city or doc.partner_id.state_id or doc.partner_id.zip or doc.partner_id.country_id">
                                    <br/>
                                    <t t-if="doc.partner_id.city">
                                        <span t-field="doc.partner_id.city"/>,
                                    </t>
                                    <t t-if="doc.partner_id.state_id">
                                        <span t-field="doc.partner_id.state_id"/>,
                                    </t>
                                    <t t-if="doc.partner_id.zip">
                                        <span>P.O. Box</span>
                                        <span t-field="doc.partner_id.zip"/>,
                                    </t>
                                    <t t-if="doc.partner_id.country_id">
                                        <span t-field="doc.partner_id.country_id"/>
                                    </t>
                                </t>
                            </div>
                            <!--                            Customer-->
                            <div class="row" style="position: fixed; left: 45px; top: 450px; width: 210px;">
                                <t t-if="doc.partner_id.parent_id">
                                    <t t-esc="doc.partner_id.parent_id.name"/>
                                </t>
                                <t t-else="else">
                                    <t t-esc="doc.partner_id.name"/>
                                </t>
                            </div>
                            <!--                            Boxes-->
                            <div class="row" style="position:fixed; top: 450px; left: 255px; width: 115px;">
                                <span>0<t t-esc="doc.x_number_of_boxes"/> Box</span>
                            </div>
                            <!--                            Shipment Details-->
                            <table class="table table-borderless"
                                   style="position:fixed; top: 438px; left: 345px; width: 500px;">
                                <tbody>
                                    <tr t-foreach="doc.x_shipping_invoice_lines[0:5]" t-as="table_line">
<!--                                    <tr t-foreach="doc.x_shipping_invoice_lines" t-as="table_line">-->
                                        <t t-if="not 'BOS' in table_line.product_id.name and not 'PACKING' in table_line.product_id.name
                                        and not 'Freight' in table_line.product_id.name and not 'Down Payment' in table_line.product_id.name">
                                            <td style="width:260px; text-align: left;">
                                                <span t-field="table_line.product_id.name"/>
                                                <br/>
                                                <span t-field="table_line.product_id.x_short_description"/>
                                                <t t-if="doc.x_sample_unit and (doc.x_invoice_id.x_payment_method.id != 7 or doc.x_down_factor != 1)">
                                                    <br/>
                                                    <span>[Sample Unit]</span>
                                                </t>
                                            </td>
                                            <td style="width:120px; text-align: center;">
                                                <center>
                                                    <span t-esc="'%.0f'%(table_line.quantity)"/>
                                                    <span>Nos.</span>
                                                </center>
                                            </td>
                                            <td style="width:120px; text-align: center;">
                                                <span t-field="doc.x_sale_order_id.currency_id"/>
                                                <span t-esc="'{0:,.2f}'.format(table_line.amount)"/>
                                            </td>
                                        </t>
                                    </tr>
                                </tbody>
                            </table>
                            <!--                            Signatory Details-->
                            <div class="row" style="position: fixed; top: 985px; left: 180px">
                                <span t-field="doc.x_signatory_certificate"/>
                            </div>
                            <div class="row" style="position: fixed; top: 1008px; left: 180px">
                                <span t-field="doc.x_designation"/>
                            </div>
                            <div class="row" style="position: fixed; top: 1029px; left: 180px">
                                <span t-field="doc.company_id"/>
                            </div>
                            <div class="row" style="position: fixed; top: 1074px; left: 180px">
                                <span t-field="doc.company_id.city"/>
                            </div>
                            <div class="row" style="position: fixed; top: 1097px; left: 180px">
                                <span t-field="doc.x_date_certificate" t-options='{"widget": "date","format": "MMMM dd, yyyy"}'/>
                            </div>
                        </div>
                    </div>
                    <div class="page" style="font-family: Arial; font-size:15px"
                         t-if="len(doc.x_shipping_invoice_lines) &gt; 5">
                        <img class="card-img" src="/customizations/static/images/certificate-of-origin.jpg"
                             style="width: 100%;"/>
                        <div class="card-img-overlay">
                            <!--                            Date-->
                            <div class="row" style="position: fixed; left: 590px; top: 1287px">
                                <span t-field="doc.x_date_certificate" t-options='{"widget": "date","format": "MMMM dd, yyyy"}'/>
                            </div>
                            <!--                            Shipper Details-->
                            <div class="row" style="position: fixed; left: 45px; top: 1340px">
                                <span>Shipper's Name and Address:</span>
                                <br/>
                                <br/>
                                <strong t-field="doc.company_id"/>
                                <br/>
                                <span t-field="doc.company_id.street"/>
                                <br/>
                                <span t-field="doc.company_id.street2"/>
                                <br/>
                                <span t-field="doc.company_id.city"/>
                                -
                                <span t-field="doc.company_id.zip"/>
                            </div>
                            <!--                            Consignee Details-->
                            <div class="row" style="position: fixed; left: 45px; top: 1495px">
                                <span>Consignee's Name and Address:</span>
                                <br/>
                                <br/>
                                <t t-if="doc.partner_id.parent_id">
                                    <strong t-field="doc.partner_id.parent_id"/>
                                </t>
                                <t t-else="else">
                                    <strong t-field="doc.partner_id.name"/>
                                </t>
                                <t t-if="doc.partner_id.street">
                                    <br/>
                                    <span t-field="doc.partner_id.street"/>
                                </t>
                                <t t-if="doc.partner_id.street2">
                                    <br/>
                                    <span t-field="doc.partner_id.street2"/>
                                </t>
                                <t t-if="doc.partner_id.city or doc.partner_id.state_id or doc.partner_id.zip or doc.partner_id.country_id">
                                    <br/>
                                    <t t-if="doc.partner_id.city">
                                        <span t-field="doc.partner_id.city"/>,
                                    </t>
                                    <t t-if="doc.partner_id.state_id">
                                        <span t-field="doc.partner_id.state_id"/>,
                                    </t>
                                    <t t-if="doc.partner_id.zip">
                                        <span>P.O. Box</span>
                                        <span t-field="doc.partner_id.zip"/>,
                                    </t>
                                    <t t-if="doc.partner_id.country_id">
                                        <span t-field="doc.partner_id.country_id"/>
                                    </t>
                                </t>
                            </div>
                            <!--                            Shipment Details-->
                            <table class="table table-borderless"
                                   style="position:fixed; top: 1688px; left: 345px; width: 500px;">
                                <tbody>
                                    <tr t-foreach="doc.x_shipping_invoice_lines[5:10]" t-as="table_line">
                                        <t t-if="not 'BOS' in table_line.product_id.name and not 'PACKING' in table_line.product_id.name
                                        and not 'Freight' in table_line.product_id.name and not 'Down Payment' in table_line.product_id.name">
                                            <td style="width:260px; text-align: left;">
                                                <span t-field="table_line.product_id.name"/>
                                                <br/>
                                                <span t-field="table_line.product_id.x_short_description"/>
                                                <t t-if="doc.x_sample_unit and (doc.x_invoice_id.x_payment_method.id != 7 or doc.x_down_factor != 1)">
                                                    <br/>
                                                    <span>[Sample Unit]</span>
                                                </t>
                                            </td>
                                            <td style="width:120px; text-align: center;">
                                                <center>
                                                    <span t-esc="'%.0f'%(table_line.quantity)"/>
                                                    <span>Nos.</span>
                                                </center>
                                            </td>
                                            <td style="width:120px; text-align: center;">
                                                <span t-field="doc.x_sale_order_id.currency_id"/>
                                                <span t-esc="'{0:,.2f}'.format(table_line.amount)"/>
                                            </td>
                                        </t>
                                    </tr>
                                </tbody>
                            </table>
                            <!--                            Signatory Details-->
                            <div class="row" style="position: fixed; top: 2235px; left: 180px">
                                <span t-field="doc.x_signatory_certificate"/>
                            </div>
                            <div class="row" style="position: fixed; top: 2258px; left: 180px">
                                <span t-field="doc.x_designation"/>
                            </div>
                            <div class="row" style="position: fixed; top: 2279px; left: 180px">
                                <span t-field="doc.company_id"/>
                            </div>
                            <div class="row" style="position: fixed; top: 2344px; left: 180px">
                                <span t-field="doc.company_id.city"/>
                            </div>
                            <div class="row" style="position: fixed; top: 2347; left: 180px">
                                <span t-field="doc.x_date_certificate" t-options='{"widget": "date","format": "MMMM dd, yyyy"}'/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
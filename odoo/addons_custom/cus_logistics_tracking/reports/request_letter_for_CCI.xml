<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_request_letter_for_CCI">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial; font-size:16px; margin: 25px 25px 25px 25px;">
                        <p>
                            <br/>
                            <br/>Ref No: ___________________________
                            <br/>Date: <span t-field="doc.x_date_certificate_rl"/>
                            <br/>
                            <br/><span>The Secretary General</span>
                            <br/><span>Rawalpindi Chamber of Commerce &amp; Industry</span>
                            <br/><span>Rawalpindi</span>
                            <br/>
                            <br/><b>SUBJECT: REQUEST FOR ATTESTATION</b>
                            <br/>
                            <br/>Respected Sir,
                            <br/>
                            <br/><span t-field="doc.x_body_rl"/>
                            <br/>
                            <br/>Thank you,
                            <br/>
                            <br/><span t-field="doc.x_signatory_rl"/>
                            <br/><span t-field="doc.company_id"/>
                            <br/>Mobile: <span t-field="doc.x_signatory_rl.phone"/>
                            <br/>Email: <span t-field="doc.x_signatory_rl.work_email"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

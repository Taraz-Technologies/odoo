                            <tr>
                                <td style="border: solid black;">Ensure the Packing box is marked with stickers</td>
                                <td style="border: solid black; text-align: center;">☐</td>
                            </tr>
                            <tr>
                                <td style="border: solid black;">Ensure that the Equipment is wrapped in dust bag or ESD sheet</td>
                                <td style="border: solid black; text-align: center;">☐</td>
                            </tr>
                            <tr>
                                <td style="border: solid black;">Ensure the webbing straps are installed properly</td>
                                <td style="border: solid black; text-align: center;">☐</td>
                            </tr>

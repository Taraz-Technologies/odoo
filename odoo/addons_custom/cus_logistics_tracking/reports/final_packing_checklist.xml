                            </tr>
                            <tr>
                                <td style="border: solid black;">Ensure the Package is handed over to DHL personnel</td>
                                <td style="border: solid black; text-align: center;">☐</td>
                            </tr>
                            <tr>
                                <td style="border: solid black;">Intimate PRD once the shipment is picked by DHL (for Tracking Number)</td>
                                <td style="border: solid black; text-align: center;">☐</td>
                            </tr>
                        </tbody>
                    </table>

                    <br/>
                    <br/>
                    <p>SO Number: __________________</p>
                    <p>Filled by: ______________________</p>

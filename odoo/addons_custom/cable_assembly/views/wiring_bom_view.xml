<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--        Wiring BOM Views-->
    <record id="view_cable_assembly_bom_form" model="ir.ui.view">
        <field name="name">cable.assembly.bom.form</field>
        <field name="model">cable.assembly.bom</field>
        <field name="arch" type="xml">
            <form string="Wiring BOM">
                <group col="4">
                    <field name="x_name"/>
                    <field name="x_product_ids" widget="many2many_tags"/>
                    <field name="x_harness_ids" widget="many2many_tags" invisible="1"/>
                </group>
                <separator string="BOM Lines" colspan="4"/>
                <field name="x_bom_line_ids" context="{'search_default_not_used_in_bom': 1}">
                    <tree editable="bottom"
                          decoration-warning="x_wire_color == 'yellow'"
                          decoration-danger="x_wire_color == 'red'"
                          decoration-success="x_wire_color == 'green'"
                          decoration-info="x_wire_color == 'blue'"
                          decoration-bf="x_wire_color in ('grey', 'black')"
                          decoration-muted="x_wire_color == 'grey'"
                    >
                        <field name="x_wire_color" invisible="1"/>
                        <field name="x_start_product" optional="hide"/>
                        <field name="x_start_product_code_ids" widget="many2many_tags" invisible="1"/>
                        <field name="x_start_product_point_ids" widget="many2many_tags" invisible="1"/>
                        <field name="x_start_product_id"/>
                        <field name="x_start_point_id" optional="hide"/>
                        <field name="x_start_point_pin_ids" widget="many2many_tags" invisible="1"/>
                        <field name="x_start_pin_id" optional="hide"/>
                        <field name="x_start_connector" optional="hide"/>
                        <field name="x_start_heat_shrink_label" optional="hide"/>
                        <field name="x_end_product" optional="hide"/>
                        <field name="x_end_product_code_ids" widget="many2many_tags" invisible="1"/>
                        <field name="x_end_product_point_ids" widget="many2many_tags" invisible="1"/>
                        <field name="x_end_product_id"/>
                        <field name="x_end_point_id" optional="hide"/>
                        <field name="x_end_point_pin_ids" widget="many2many_tags" invisible="1"/>
                        <field name="x_end_pin_id" optional="hide"/>
                        <field name="x_end_connector" optional="hide"/>
                        <field name="x_end_heat_shrink_label" optional="hide"/>
                        <field name="x_name"/>
                        <field name="x_ref_des" optional="hide"/>
                        <field name="x_wire" optional="hide"/>
                        <field name="x_unit_length"/>
                        <field name="x_finished_length"/>
                        <field name="x_uom_id"/>
                        <field name="x_harness" optional="hide"/>
                        <field name="x_start_label" optional="hide"/>
                        <field name="x_end_label" optional="hide"/>
                        <field name="x_wire_label" optional="hide"/>
                        <field name="x_notes" optional="hide"/>
                    </tree>
                </field>
                <separator string="Capture Images" colspan="4"/>
                <field name="x_image_ids" mode="kanban"/>
            </form>
        </field>
    </record>

    <record id="view_cable_assembly_bom_tree" model="ir.ui.view">
        <field name="name">cable.assembly.bom.tree</field>
        <field name="model">cable.assembly.bom</field>
        <field name="arch" type="xml">
            <tree string="Wiring BOM">
                <field name="x_name"/>
                <field name="x_product_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_cable_assembly_bom_filter" model="ir.ui.view">
        <field name="name">cable.assembly.bom.select</field>
        <field name="model">cable.assembly.bom</field>
        <field name="arch" type="xml">
            <search string="Wiring BOM">
                <field name="x_name" string="Cable Assembly BOM" filter_domain="[('x_name','ilike',self)]"/>
            </search>
        </field>
    </record>

    <record id="action_cable_assembly_bom" model="ir.actions.act_window">
        <field name="name">Wiring BOM</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cable.assembly.bom</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cable_assembly_bom_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Record
            </p>
        </field>
    </record>
</odoo>
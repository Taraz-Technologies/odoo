<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--        Harness Views-->
    <record id="view_harness_form" model="ir.ui.view">
        <field name="name">harness.form</field>
        <field name="model">harness</field>
        <field name="arch" type="xml">
            <form string="Harness">
                <sheet>
                    <group>
                        <group>
                            <field name="x_name"/>
                            <field name="x_printer"/>
                            <field name="x_onenote_link" widget="url"/>
                            <field name="x_notes"/>
                        </group>
                        <group>
                            <field name="x_start_label"/>
                            <field name="x_end_label"/>
                            <field name="x_wire_label"/>
                            <field name="x_harness_label"/>
                            <field name="x_bom_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <field name="x_wiring_line_ids" nolabel="1"/>
                    </group>
                    <separator string="Capture Images" colspan="4"/>
                    <field name="x_image_ids" mode="kanban"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_harness_tree" model="ir.ui.view">
        <field name="name">harness.tree</field>
        <field name="model">harness</field>
        <field name="arch" type="xml">
            <tree string="Harness">
                <field name="x_name"/>
                <field name="x_notes"/>
                <field name="x_bom_ids" widget="many2many_tags"/>
                <field name="x_wiring_line_ids" widget="many2many_tags"/>
                <field name="x_start_label"/>
                <field name="x_end_label"/>
                <field name="x_wire_label"/>
                <field name="x_harness_label"/>
            </tree>
        </field>
    </record>

    <record id="view_harness_filter" model="ir.ui.view">
        <field name="name">harness.select</field>
        <field name="model">harness</field>
        <field name="arch" type="xml">
            <search string="Harness">
                <field name="x_name" string="Harness" filter_domain="[('x_name','ilike',self)]"/>
            </search>
        </field>
    </record>

    <record id="action_harness" model="ir.actions.act_window">
        <field name="name">Harness</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">harness</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_harness_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Record
            </p>
        </field>
    </record>
</odoo>
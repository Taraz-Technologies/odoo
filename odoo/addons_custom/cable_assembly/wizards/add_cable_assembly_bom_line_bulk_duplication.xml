<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record model="ir.ui.view" id="wizard_cable_assembly_bom_line_bulk_duplication_form_view">
            <field name="name">wizard.cable.assembly.bom.line.bulk.duplication.form.view</field>
            <field name="model">cable.assembly.bom.line.bulk.duplication</field>
            <field name="arch" type="xml">
                <form string="Bulk Duplication">
                    <group>
                        <field name="duplication_count"/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object" string="Duplicate" class="oe_highlight"/>
                        or
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action for the Wizard -->
        <act_window id="launch_cable_assembly_bom_line_bulk_duplication_wizard"
                    name="Bulk Duplication"
                    binding_model="cable.assembly.bom.line"
                    res_model="cable.assembly.bom.line.bulk.duplication"
                    view_mode="form"
                    target="new"/>
    </data>
</odoo>

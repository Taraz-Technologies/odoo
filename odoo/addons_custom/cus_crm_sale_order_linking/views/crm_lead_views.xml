<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--	CRM Lead Views-->
    <record id="crm_lead_view_kanban_custom_0" model="ir.ui.view">
        <field name="name">crm.lead.kanban.lead.custom.0</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <data>
                <field name="activity_ids" position="after">
                    <field name="x_sale_order_amount_ids"/>
                </field>
                <div class="text-muted o_kanban_record_subtitle" position="attributes">
                    <attribute name="invisible">1</attribute>
                </div>
                <div class="text-muted o_kanban_record_subtitle" position="after">
                    <div class="text-muted">
                        <t t-foreach="record.x_sale_order_amount_ids.raw_value" t-as="o">
                            <t t-if="o.x_amount_type != 'currency_loss'">
                                <t t-if="o.x_current_amount">
                                    <div style="color:#009999;">
                                        <span t-esc="o.display_name"/>
                                        <br/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <span t-esc="o.display_name"/>
                                    <br/>
                                </t>
                            </t>
                        </t>
                        <t t-foreach="record.x_sale_order_amount_ids.raw_value" t-as="o">
                            <t t-if="o.x_amount_type == 'currency_loss'">
                                <span t-esc="o.display_name"/>
                                <br/>
                            </t>
                        </t>
                    </div>
                </div>
            </data>
        </field>
    </record>

    <record id="crm_lead_view_form_custom_0" model="ir.ui.view">
        <field name="name">crm.lead.form.custom.0</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="/form/sheet/group" position="after">
                    <div class="o_row">
                        <button name="action_update_crm_lead_amount_lines"
                                string="Update Amount Lines"
                                type="object"
                                class="btn-primary"/>
                    </div>
                    <group>
                        <field name="x_sale_order_amount_ids" nolabel="1" readonly="0"/>
                    </group>
                </xpath>
            </data>
        </field>
    </record>

    <record id="view_crm_case_opportunities_filter_custom_0" model="ir.ui.view">
        <field name="name">crm.lead.search.opportunity.custom.0</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <data>
                <filter name="won" position="attributes">
                    <attribute name="string">Confirmed</attribute>
                </filter>
                <filter name="won" position="before">
                    <filter string="Active" name="active"
                            domain="['&amp;', ('active', '=', True), ('stage_id.x_is_done', '!=', True)]"/>
                </filter>
                <filter name="won" position="after">
                    <filter string="Done" name="done"
                            domain="['&amp;', ('active', '=', True), ('stage_id.x_is_done', '=', True)]"/>
                </filter>
            </data>
        </field>
    </record>

    <record model="ir.actions.act_window" id="crm.crm_lead_action_pipeline">
        <field name="domain">[('type', '=', 'opportunity')]</field>
        <field name="context">{
            'default_type': 'opportunity',
            'search_default_active': 1,
            }
        </field>
    </record>

    <!--	CRM Stage Views-->
    <record id="crm_stage_form_custom_0" model="ir.ui.view">
        <field name="name">crm.stage.form.custom.0</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_form"/>
        <field name="arch" type="xml">
            <data>
                <field name="is_won" position="after">
                    <field name="x_is_done"/>
                </field>
                <field name="team_id" position="after">
                    <field name="x_amount_type"/>
                </field>
            </data>
        </field>
    </record>

    <!--	CRM Sale Order Amounts-->
    <record id="sale_order_amounts_view_form" model="ir.ui.view">
        <field name="name">sale_order_amounts_view_form</field>
        <field name="model">sale.order.amounts</field>
        <field name="arch" type="xml">
            <form string="Sale Order Amount">
                <sheet>
                    <group col="4">
                        <field name="x_crm_lead_id"/>
                        <field name="x_invoice_id" widget="many2one" readonly="1"/>
                        <field name="x_invoice_payment_state"/>
                        <field name="x_date"/>
                        <field name="x_name"/>
                        <field name="x_amount_type"/>
                        <field name="x_compute_amount_status" invisible="1"/>
                        <field name="x_currency_id"/>
                        <field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                        <field name="x_current_amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_order_amounts_view_tree" model="ir.ui.view">
        <field name="name">sale_order_amounts_view_tree</field>
        <field name="model">sale.order.amounts</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="0" delete="0" decoration-success="x_current_amount != False">
                <field name="x_crm_lead_id" invisible="1"/>
                <field name="x_invoice_id" widget="many2one" readonly="1"/>
                <field name="x_invoice_payment_state"/>
                <field name="x_date"/>
                <field name="x_name" readonly="1"/>
                <field name="x_amount_type" readonly="0"/>
                <field name="x_compute_amount_status" invisible="1"/>
                <field name="x_currency_id" invisible="1"/>
                <field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}" readonly="1"/>
                <field name="x_current_amount" invisible="1"/>
                <field name="x_payment_count" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="sale_order_amounts_action" model="ir.actions.act_window">
        <field name="name">Sale Order Amounts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order.amounts</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="sale_order_amounts_menu"
              name="Sale Order Amounts"
              parent="crm.crm_menu_root"
              groups="crm.group_use_lead"
              action="sale_order_amounts_action"
              sequence="5"/>
</odoo>
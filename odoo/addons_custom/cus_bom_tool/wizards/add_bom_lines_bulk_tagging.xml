<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="wizard_base_bom_lines_bulk_tagging_form_view">
            <field name="name">wizard.base.bom.lines.bulk.tagging.form.view</field>
            <field name="model">base.bom.lines.bulk.tagging</field>
            <field name="arch" type="xml">
                <form string="Bulk Tagging">
                    <group>
                        <field name="x_add_tags" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <field name="x_remove_tags" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object" string="Confirm" class="oe_highlight"/>
                        or
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <act_window id="launch_base_bom_lines_bulk_tagging_wizard"
                    name="Bulk Tagging"
                    binding_model="base.bom.lines"
                    res_model="base.bom.lines.bulk.tagging"
                    view_mode="form"
                    target="new"/>
    </data>
</odoo>
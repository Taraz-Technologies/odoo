<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_bom_files_wizard_form" model="ir.ui.view">
        <field name="name">import.bom.files.wizard.form</field>
        <field name="model">import.bom.files</field>
        <field name="arch" type="xml">
            <form string="Import BoM &amp; PNP Files">
                <field name="x_bom_tool_id" invisible="1"/>
                <field name="x_base_product_id" invisible="1"/>
                <field name="x_product_type_fg" invisible="1"/>
                <field name="x_product_type_sfg" invisible="1"/>
                <group col="2" attrs="{'invisible': [('x_product_type_fg', '!=', 'pcb'), ('x_product_type_sfg', '!=', 'pcb')]}">
                    <label for="x_bom_file" string="BoM File Headers"/>
                    <div class="o_row">
                        <span>
                            File columns &amp; their sequence: RefDes | Value | Name | Quantity
                        </span>
                    </div>
                    <field name="x_bom_file"/>
                    <label for="x_pnp_file" string="PNP File Headers"/>
                    <div class="o_row">
                        <span>
                            File columns &amp; their sequence: RefDes | Name | Pattern | X (mm) | Y (mm) | Side | Rotate | Value | Hierarchy
                        </span>
                    </div>
                    <field name="x_pnp_file"/>
                    <field name="x_pcb_product_id" attrs="{'required': ['|', ('x_product_type_fg', '=', 'pcb'), ('x_product_type_sfg', '=', 'pcb')]}"/>
                    <field name="x_import_type" widget="radio" options="{'horizontal': true}"/>
                    <field name="x_base_bom_id" widget="selection" attrs="{'invisible': [('x_import_type', '=', 'raw_data')]}"/>
                </group>
                <group col="2" attrs="{'invisible': ['|', ('x_product_type_fg', '=', 'pcb'), ('x_product_type_sfg', '=', 'pcb')]}">
                    <label for="x_bom_file" string="BoM File Headers"/>
                    <div class="o_row">
                        <span>
                            <b>Product</b> and <b>Quantity</b> columns should be defined in BoM file!
                            <br/>
                            When importing with <b>RefDes</b> column quantity should be 1.
                            <br/>
                            Columns can be: RefDes | Product | Description | Quantity | UoM | Mounting Type | DNP | Critical | Variant | Notes | Investor Product?
                        </span>
                    </div>
                    <field name="x_bom_file" string="BoM File (.xlsx)"/>
                </group>
                <footer>
                    <button name="import_files" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window id="action_import_bom_files"
                name="Import BoM &amp; PNP Files"
                res_model="import.bom.files"
                binding_model="bom.tool"
                binding_views="from"
                view_mode="form"
                target="new"/>
</odoo>
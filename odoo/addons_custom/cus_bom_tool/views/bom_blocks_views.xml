<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="bom_blocks_form_view" model="ir.ui.view">
		<field name="name">bom.blocks.form.view</field>
		<field name="model">bom.blocks</field>
		<field name="arch" type="xml">
			<form string="BoM Blocks">
				<sheet>
					<field name="image_1920" widget="image" class="oe_avatar" options="{'zoom': true, 'zoom_delay': 1000}"/>
					<div class="oe_title">
						<h2>
							<field name="x_name"/>
						</h2>
					</div>
					<group col="4">
						<field name="x_description"/>
						<field name="x_block_file"/>
						<field name="x_variant"/>
					</group>
					<field name="x_comment" placeholder="Block Comment"/>
					<notebook>
						<page string="Block BoM Lines">
							<field name="x_bom_line_ids">
								<tree editable="bottom">
									<field name="x_block_id" invisible="1"/>
									<field name="image_128" widget="image" class="o_kanban_image_fill_left" optional="hide"/>

									<field name="x_name" optional="hide"/>
									<field name="x_part_description" optional="hide"/>
                  
									<field name="x_taraz_part_id" widget="many2one" optional="show"/>
									<field name="x_product_id" widget="many2one"/>
									<field name="x_description" optional="hide"/>

									<field name="x_real_quantity" invisible="1"/>
									<field name="x_quantity" sum="Total"/>
									<field name="x_uom_id"/>

									<field name="x_type" optional="hide"/>
									<field name="x_station_id" optional="hide"/>
									<field name="x_notes" optional="hide"/>
								</tree>
							</field>
						</page>
						<page string="Block Usage">
							<field name="x_bom_tool_ids"/>
						</page>
					</notebook>
				</sheet>
				<div class="oe_chatter">
					<field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
					<field name="message_ids" widget="mail_thread"/>
					<field name="activity_ids" widget="mail_activity"/>
				</div>
			</form>
		</field>
	</record>

	<record id="bom_blocks_tree_view" model="ir.ui.view">
		<field name="name">bom.blocks.tree.view</field>
		<field name="model">bom.blocks</field>
		<field name="arch" type="xml">
			<tree string="BoM Blocks">
				<field name="x_name"/>
				<field name="x_description"/>
				<field name="x_variant"/>
				<field name="x_comment"/>
			</tree>
		</field>
	</record>

	<record id="bom_blocks_search_view" model="ir.ui.view">
		<field name="name">bom.blocks.search.view</field>
		<field name="model">bom.blocks</field>
		<field name="arch" type="xml">
			<search string="BoM Blocks">
				<field name="x_name"/>
				<field name="x_comment"/>
			</search>
		</field>
	</record>

	<record id="action_view_bom_blocks" model="ir.actions.act_window">
		<field name="name">BoM Blocks</field>
		<field name="res_model">bom.blocks</field>
		<field name="view_mode">tree,form</field>
		<field name="search_view_id" ref="bom_blocks_search_view"/>
	</record>
</odoo>
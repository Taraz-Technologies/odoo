<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="base_bom_lines_form_view" model="ir.ui.view">
		<field name="name">base.bom.lines.form.view</field>
		<field name="model">base.bom.lines</field>
		<field name="arch" type="xml">
			<form string="BoM Lines">
				<sheet>
					<field name="image_128" widget="image" class="oe_avatar"/>
					<field name="x_line_select" invisible="1"/>
					<field name="x_aps_line_select" invisible="1"/>
					<field name="display_name" invisible="1"/>
					<field name="x_update_block_line" invisible="1"/>
					<field name="x_prd_investor_product" invisible="1"/>
					<field name="x_bom_tool_id" invisible="1"/>
					<field name="x_base_product_id" invisible="1"/>
					<field name="x_routing_id" invisible="1"/>
					<field name="x_station_id" invisible="1"/>
					<group col="4">
						<field name="x_ref_des"/>
						<field name="x_line_block_id" readonly="1"/>
						<field name="x_name"/>
						<field name="x_part_description"/>
						<field name="x_product_id"/>
						<field name="x_real_quantity"/>
						<field name="x_quantity"/>
						<field name="x_uom_id"/>
						<field name="x_description"/>
						<field name="x_taraz_part_id"/>
						<field name="x_notes"/>
						<field name="x_old_product_id"/>
						<field name="x_operation_id" options="{'no_quick_create':True,'no_create_edit':True}"/>
						<field name="x_type"/>
						<field name="x_dnp"/>
						<field name="x_critical"/>
						<field name="x_variant"/>
						<field name="x_investor_product"/>
						<field name="x_to_be_reviewed"/>
						<field name="x_design_new"/>
						<field name="x_new"/>
						<field name="x_design_modified"/>
						<field name="x_modified"/>
						<field name="x_design_deleted"/>
						<field name="x_deleted"/>
						<field name="x_base_bom_id"/>
						<field name="x_move_to_tool_id" options="{'no_quick_create': True, 'no_create_edit': True}"/>
						<field name="x_slave_bom_line_id"/>
						<field name="x_move_from_tool_id"/>
						<field name="x_master_bom_line_id"/>
						<field name="x_custom_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
					</group>
					<separator col="4" string="BoM Line Alt. &amp; Comp. Usage"/>
					<field name="x_usage_ids" readonly="1">
						<tree decoration-success="x_usage == 'auto_use'"
							  decoration-info="x_usage == 'use'"
							  decoration-danger="x_usage == 'not_use'">
							<field name="x_base_bom_line_id" invisible="1"/>
							<field name="x_product_id" invisible="1"/>
							<field name="x_alternate_id"/>
							<field name="x_compromised_id"/>
							<field name="x_type"/>
							<field name="x_usage"/>
						</tree>
					</field>
				</sheet>
			</form>
		</field>
	</record>

	<record id="base_bom_lines_tree_view" model="ir.ui.view">
		<field name="name">base.bom.lines.tree.view</field>
		<field name="model">base.bom.lines</field>
		<field name="arch" type="xml">
			<tree string="BoM Lines">
				<field name="x_bom_tool_id"/>
				<field name="x_base_product_id"/>
				<field name="x_routing_id" invisible="1"/>
				<field name="image_128" widget="image" class="o_kanban_image_fill_left" optional="hide"/>
				<field name="x_ref_des"/>
				<field name="x_name" optional="hide"/>
				<field name="x_part_description" optional="hide"/>
				<field name="x_old_product_id" optional="hide"/>
				<field name="x_taraz_part_id"/>
				<field name="x_product_id"/>
				<field name="x_active" optional="hide"/>
				<field name="x_description"/>
				<field name="x_line_block_id" readonly="1"/>
				<field name="x_notes"/>
				<field name="x_type"/>
				<field name="x_dnp"/>
				<field name="x_critical"/>
				<field name="x_variant"/>
				<field name="x_investor_product"/>
				<field name="x_custom_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
				<field name="x_operation_id" options="{'no_quick_create':True,'no_create_edit':True}" optional="hide"/>
				<field name="x_to_be_reviewed" optional="hide"/>
				<field name="x_design_new" optional="hide"/>
				<field name="x_new" optional="hide"/>
				<field name="x_design_modified" optional="hide"/>
				<field name="x_modified" optional="hide"/>
				<field name="x_design_deleted" optional="hide"/>
				<field name="x_deleted" optional="hide"/>
				<field name="x_base_bom_id" optional="hide"/>
				<field name="x_move_to_tool_id" options="{'no_quick_create': True, 'no_create_edit': True}" optional="hide"/>
				<field name="x_slave_bom_line_id" optional="hide"/>
				<field name="x_move_from_tool_id" optional="hide"/>
				<field name="x_master_bom_line_id" optional="hide"/>
			</tree>
		</field>
	</record>

	<record id="base_bom_lines_search_view" model="ir.ui.view">
		<field name="name">base.bom.lines.search.view</field>
		<field name="model">base.bom.lines</field>
		<field name="arch" type="xml">
			<search string="BoM Lines">
				<field name="x_product_id" filter_domain="['|', ('x_product_id', 'ilike', self), ('x_custom_tag_ids', 'ilike', self)]"/>
				<field name="x_description"/>
				<field name="x_custom_tag_ids"/>
				<separator/>
				<filter name="investor_product" string="Investor Product" domain="[('x_investor_product', '!=', False)]"/>
				<separator/>
				<filter name="active" string="Archived" domain="[('x_active', '=', False)]"/>
				<separator/>
				<filter name="smd" string="SMD" domain="[('x_type', '=', 'smd')]"/>
				<filter name="th" string="TH" domain="[('x_type', '=', 'th')]"/>
				<filter name="other" string="OTHER" domain="[('x_type', '=', 'other')]"/>
				<separator/>
				<filter name="dnp" string="DNP" domain="[('x_dnp', '!=', False)]"/>
				<filter name="critical" string="Critical" domain="[('x_critical', '!=', False)]"/>
				<filter name="variant" string="Variant" domain="[('x_variant', '!=', False)]"/>
				<separator/>
				<filter name="design_new" string="New (Design)" domain="[('x_design_new', '!=', False)]"/>
				<filter name="design_modified" string="Modified (Design)" domain="[('x_design_modified', '!=', False)]"/>
				<filter name="design_deleted" string="Deleted (Design)" domain="[('x_design_deleted', '!=', False)]"/>
				<separator/>
				<filter name="new" string="New (Odoo)" domain="[('x_new', '!=', False)]"/>
				<filter name="modified" string="Modified (Odoo)" domain="[('x_modified', '!=', False)]"/>
				<filter name="deleted" string="Deleted (Odoo)" domain="[('x_deleted', '!=', False)]"/>
				<separator/>
				<filter name="tagged" string="Tagged" domain="[('x_custom_tag_ids', '!=', False)]"/>
				<group expand="0" string="Group by">
					<filter name="bom" string="BoM" context="{'group_by': 'x_base_bom_id'}"/>
					<filter name="bom_tool" string="BoM Tool" context="{'group_by': 'x_bom_tool_id'}"/>
					<filter name="base_bom_product" string="Product" context="{'group_by': 'x_base_product_id'}"/>
					<filter name="block" string="Block" context="{'group_by': 'x_line_block_id'}"/>
					<filter name="moved_to" string="Moved to" context="{'group_by': 'x_move_to_tool_id'}"/>
					<filter name="moved_from" string="Moved from" context="{'group_by': 'x_move_from_tool_id'}"/>
					<filter name="part_number" string="Part #" context="{'group_by': 'x_product_id'}"/>
					<filter name="taraz_part" string="Taraz Part #" context="{'group_by': 'x_taraz_part_id'}"/>
					<filter name="investor_product" string="Investor Product" context="{'group_by': 'x_investor_product'}"/>
					<filter name="type" string="Type" context="{'group_by': 'x_type'}"/>
					<filter name="operation" string="Operation" context="{'group_by': 'x_operation_id'}"/>
					<filter name="dnp" string="DNP" context="{'group_by': 'x_dnp'}"/>
					<filter name="critical" string="Critical" context="{'group_by': 'x_critical'}"/>
					<filter name="variant" string="Variant" context="{'group_by': 'x_variant'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="action_view_base_bom_lines" model="ir.actions.act_window">
		<field name="name">BoM Lines</field>
		<field name="res_model">base.bom.lines</field>
		<field name="view_mode">tree,form</field>
		<field name="view_id" ref="base_bom_lines_tree_view"/>
		<field name="search_view_id" ref="base_bom_lines_search_view"/>
	</record>
<!--    Product Usage View-->
    <record id="view_component_usage_tree_inherit" model="ir.ui.view">
        <field name="name">component.usage.tree.inherit</field>
        <field name="model">component.usage</field>
        <field name="inherit_id" ref="cus_product_360_view.view_component_usage_tree"/>
        <field name="arch" type="xml">
            <data>
                <field name="x_product_id" position="after">
                	<field name="x_bom_tool_id" widget="many2one" readonly="1"/>
                	<field name="x_base_bom_id" string="BoM Version" readonly="1"/>
                	<field name="x_base_bom_line_id" readonly="1"/>
                	<field name="x_line_block_id" readonly="1"/>
                	<field name="x_type" readonly="1"/>
				</field>
            </data>
        </field>
    </record>
<!--    Product Mass Usage View-->
    <record id="view_mass_component_usage_tree_inherit" model="ir.ui.view">
        <field name="name">mass.component.usage.tree.inherit</field>
        <field name="model">mass.component.usage</field>
        <field name="inherit_id" ref="cus_product_360_view.view_mass_component_usage_tree"/>
        <field name="arch" type="xml">
            <data>
                <field name="x_line_select" position="after">
                	<field name="x_bom_tool_id" widget="many2one" readonly="1"/>
                	<field name="x_base_bom_id" string="BoM Version" readonly="1"/>
                	<field name="x_base_bom_line_id" readonly="1"/>
                	<field name="x_line_block_id" readonly="1"/>
                	<field name="x_type" readonly="1"/>
				</field>
            </data>
        </field>
    </record>
</odoo>
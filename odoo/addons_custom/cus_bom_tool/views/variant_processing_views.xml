<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_variant_attribute_lines_view_form" model="ir.ui.view">
        <field name="name">product.variant.attribute.lines.view.form</field>
        <field name="model">product.variant.attribute.lines</field>
        <field name="arch" type="xml">
            <form string="Variant Attribute">
                <group col="4">
                    <field name="x_attribute_id"/>
                </group>
                <separator col="4" string="Values"/>
                <field name="x_attribute_tag_ids">
                    <tree editable="bottom">
                        <field name="x_name"/>
                        <field name="x_description"/>
                    </tree>
                </field>
            </form>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="bom_line_rules_view_form" model="ir.ui.view">
        <field name="name">bom.line.rules.view.form</field>
        <field name="model">bom.line.rules</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="x_bom_tool_id" invisible="1"/>
                    <field name="x_line_ids" invisible="1"/>
                    <group col="4">
                        <field name="x_line_id" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                        <field name="x_line_block_id" widget="many2one"/>
                    </group>
                    <seprator string="Rule Lines" col="4"/>
                    <p>
                        If Master Line is configured then other lines will be replaced respectively. If
                        there is no configuration product then line product will not be replaced.
                    </p>
                    <field name="x_rule_line_ids">
                        <tree editable="bottom">
                            <field name="x_bom_line_rule_id" invisible="1"/>
                            <field name="x_line_ids" invisible="1"/>
                            <field name="x_master_line"/>
                            <field name="x_line_id"/>
                            <field name="x_config_product_id_1"/>
                            <field name="x_config_product_id_2" optional="hide"/>
                            <field name="x_config_product_id_3" optional="hide"/>
                            <field name="x_config_product_id_4" optional="hide"/>
                            <field name="x_config_product_id_5" optional="hide"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bom_line_rules_lines_view_form" model="ir.ui.view">
        <field name="name">bom.line.rules.lines.view.form</field>
        <field name="model">bom.line.rules.lines</field>
        <field name="arch" type="xml">
            <form string="Rule Line">
                <sheet>
                    <field name="x_bom_line_rule_id" invisible="1"/>
                    <field name="x_line_ids" invisible="1"/>
                    <group col="4">
                        <field name="x_master_line"/>
                        <field name="x_line_id"/>
                        <field name="x_config_product_id_1"/>
                        <field name="x_config_product_id_2"/>
                        <field name="x_config_product_id_3"/>
                        <field name="x_config_product_id_4"/>
                        <field name="x_config_product_id_5"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="report_product_template_qrcode">
            <t t-call="web.basic_layout">
                <div class="page">
                    <t t-foreach="docs" t-as="product">
                        <div style="width: 100%; display: inline-table; height: 10rem;">
                            <table class="table table-bordered mb-0" style="border: 2px solid black;">
                                <t t-if="len(str(product.description)) &lt; 95">
                                    <tr>
                                        <th class="table-active text-left" style="height: 4rem;">
                                            <strong t-field="product.name"/>
                                            [<span t-field="product.description"/>]
                                        </th>
                                    </tr>
                                    <tr>
                                        <td class="text-center align-middle" style="height: 6rem;">
                                            <t t-if="product.barcode">
                                                <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', product.barcode, 70, 70)"/>
                                                <div t-field="product.barcode"/>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted">No barcode available</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <th class="table-active text-left" style="height: 13rem;">
                                            <strong t-field="product.name"/>
                                            [<span t-field="product.description"/>]
                                        </th>
                                    </tr>
                                    <tr>
                                        <td class="text-center align-middle" style="height: 10rem;">
                                            <t t-if="product.barcode">
                                                <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', product.barcode, 70, 70)"/>
                                                <div t-field="product.barcode"/>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted">No barcode available</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </div>
                    </t>
                </div>
            </t>
        </template>


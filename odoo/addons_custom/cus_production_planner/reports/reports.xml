<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--        Picking Reports-->
        <report id="action_report_picklist"
                string="Picklist"
                model="stock.picking"
                report_type="qweb-pdf"
                file="cus_production_planner.report_picklist"
                name="cus_production_planner.report_picklist"
                print_report_name="'Picklist - %s - %s' % (object.origin, object.x_bom_id.product_id.name)"
                paperformat="base.paperformat_euro_borderless"/>

        <report id="action_report_picklist_landscape"
                string="Picklist (Landscape)"
                model="stock.picking"
                report_type="qweb-pdf"
                file="cus_production_planner.report_picklist_landscape"
                name="cus_production_planner.report_picklist_landscape"
                print_report_name="'Picklist - %s - %s' % (object.origin, object.x_bom_id.product_id.name)"
                paperformat="base.paperformat_euro_landscape_borderless"/>

        <!--        Workorder Reports-->
        <report id="action_report_picklist_landscape_workorder"
                string="Picklist (Landscape)"
                model="mrp.workorder"
                report_type="qweb-pdf"
                file="cus_production_planner.report_picklist_landscape_workorder"
                name="cus_production_planner.report_picklist_landscape_workorder"
                print_report_name="'Picklist - %s - %s' % (object.production_id.name, object.product_id.name)"
                paperformat="base.paperformat_euro_landscape_borderless"/>

        <report id="assembly_process_excel_report"
                model="mrp.workorder"
                string="Machine File"
                report_type="xlsx"
                name="cus_production_planner.assembly_process_excel_report"
                file="cus_production_planner.assembly_process_excel_report"
                print_report_name="'%s - ND4 Machine File' % (object.x_bom_tool_id.x_base_product_id.name)"/>

        <!--        Product Reports-->
        <report id="action_report_product_template_qrcode"
                string="Product QR Code (PDF)"
                model="product.template"
                report_type="qweb-pdf"
                name="cus_production_planner.report_product_template_qrcode"
                file="cus_production_planner.report_product_template_qrcode"
                print_report_name="'Product QR Code - %s' % (object.name)"
                paperformat="base.paperformat_label"/>

        <report id="action_report_product_template_qrcode_without_description"
                string="Product QR Code Without Description (PDF)"
                model="product.template"
                report_type="qweb-pdf"
                name="cus_production_planner.report_product_template_qrcode_without_description"
                file="cus_production_planner.report_product_template_qrcode_without_description"
                print_report_name="'Product QR Code Without Description - %s' % (object.name)"
                paperformat="base.paperformat_label"/>

        <report id="action_report_product_qrcode"
                string="Product QR Code (PDF)"
                model="product.product"
                report_type="qweb-pdf"
                name="cus_production_planner.report_product_product_qrcode"
                file="cus_production_planner.report_product_product_qrcode"
                print_report_name="'Products QR Code - %s' % (object.name)"
                paperformat="base.paperformat_label"/>

        <report id="action_report_product_qrcode_without_description"
                string="Product QR Code Without Description (PDF)"
                model="product.product"
                report_type="qweb-pdf"
                name="cus_production_planner.report_product_template_qrcode_without_description"
                file="cus_production_planner.report_product_template_qrcode_without_description"
                print_report_name="'Products QR Code Without Description - %s' % (object.name)"
                paperformat="base.paperformat_label"/>

    </data>
</odoo>

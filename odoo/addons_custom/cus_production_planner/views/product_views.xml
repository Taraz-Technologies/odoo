<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_view_custom_2" model="ir.ui.view">
        <field name="name">product.template.common.form.custom.2</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="customizations.product_template_only_form_view_customization_0"/>
        <field name="arch" type="xml">
            <data>
                <group name="warehousing" position="inside">
                    <field name="x_package_id"/>
                </group>
            </data>
        </field>
    </record>

    <record id="product_template_search_form_view_stock_custom" model="ir.ui.view">
        <field name="name">product.template.search.form.view.stock.custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_search_form_view_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='real_stock_available']" position="replace">
                <filter name="real_stock_on_hand" string="On Hand Products" domain="[('qty_available','&gt;',0)]"/>
                <filter name="real_stock_available" string="Available Products" domain="[('x_available_qty','&gt;',0)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_taraz_part_number_form_cus_production_planner" model="ir.ui.view">
        <field name="name">view_taraz_part_number_form_cus_production_planner</field>
        <field name="model">taraz.part.number</field>
        <field name="inherit_id" ref="cus_product_360_view.view_taraz_part_number_form"/>
        <field name="arch" type="xml">
            <data>
                <field name="x_category" position="before">
                    <field name="x_package_id" string="Pattern"/>
                </field>
            </data>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_bom_tree_view_cus_production_planner" model="ir.ui.view">
            <field name="name">mrp.bom.form.cus_production_planner</field>
            <field name="model">mrp.bom</field>
		    <field name="inherit_id" ref="mrp.mrp_bom_tree_view"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <data>
                    <field name="product_tmpl_id" position="before">
                        <field name="create_date"/>
                    </field>
                </data>
            </field>
        </record>

        <record id="mrp_bom_form_view_customization" model="ir.ui.view">
            <field name="name">mrp.bom.form.customization</field>
            <field name="model">mrp.bom</field>
		    <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <data>
                    <field name="product_tmpl_id" position="after">
                        <field name="x_bom_tool_id"/>
                    </field>
                    <field name="product_uom_id" position="after">
                        <button name="compute_bom_lines" string="Compute BoM" class="oe_highlight oe_edit_only"
                                type="object" attrs="{'invisible': [('x_bom_tool_id', '=', False)]}"/>
                    </field>
                    <field name="routing_id" position="before">
                        <label for="x_can_be_manufactured"/>
                        <div class="o_row">
                            <field name="x_can_be_manufactured" readonly="1"/>
                            <field name="product_uom_id" options="{'no_open':True,'no_create':True}" readonly="1"/>
                        </div>
                    </field>
                    <field name="type" position="after">
                        <field name="x_percentage_investor" widget="percentage"/>
                        <field name="x_percentage_taraz" widget="percentage"/>
                    </field>
                    <xpath expr="//field[@name='bom_line_ids']/tree[1]" position="attributes">
                        <attribute name="decoration-danger">x_part_status == 'short'</attribute>
                        <attribute name="decoration-success">x_part_status == 'alt'</attribute>
                        <attribute name="decoration-info">x_part_status == 'comp'</attribute>
                        <attribute name="decoration-warning">x_part_status in ('waiting', 'partially_available')</attribute>
                        <attribute name="decoration-muted">x_part_status in ('assigned', 'done')</attribute>
                    </xpath>
                    <xpath expr="//field[@name='bom_line_ids']/tree[1]//field[@name='product_id']" position="before">
                        <field name="x_ref_des" optional="hide"/>

                        <field name="x_product_id" invisible="1"/>
                        <field name="x_taraz_part_number_id" invisible="1"/>
                        <field name="x_alternate_ids" invisible="1"/>
                        <field name="x_compromise_ids" invisible="1"/>
                        <field name="x_product_ids" widget="many2many_tags" invisible="1"/>

                        <field name="x_mounting_type" optional="hide"/>
                        <field name="x_original_product_id" domain="[('id', '=', x_product_id)]" options="{'no_quick_create':True,'no_create_edit':True}" optional="hide"/>
                        <field name="x_taraz_part_id" domain="[('id', '=', x_taraz_part_number_id)]" options="{'no_quick_create':True,'no_create_edit':True}" optional="hide"/>
                    </xpath>
                    <xpath expr="//field[@name='bom_line_ids']/tree[1]//button[@name='action_see_attachments']" position="after">
                        <button name="action_duplicate_bom_line" type="object" icon="fa-clipboard" title="Create Duplicate Line" class="float-right oe_edit_only"/>
                    </xpath>
                    <xpath expr="//field[@name='bom_line_ids']/tree[1]//field[@name='product_uom_id']" position="after">
                        <field name="x_free_qty" string="Available" optional="hide"/>
                        <field name="x_uom_id" string="UoM (Available)" optional="hide"/>
                        <field name="x_part_status"/>
                        <field name="x_line_cost" optional="hide"/>
                    </xpath>
                    <xpath expr="//field[@name='bom_line_ids']/tree[1]//field[@name='bom_product_template_attribute_value_ids']" position="attributes">
                        <attribute name="optional">hide</attribute>
                    </xpath>
                    <xpath expr="//field[@name='bom_line_ids']/tree[1]//field[@name='operation_id']" position="attributes">
                        <attribute name="optional">hide</attribute>
                    </xpath>
                    <xpath expr="//page[1]" position="after">
                        <page string="BoM Tool Lines" name="bom_tool_lines">
                            <div class="o_row">
                                <button name="apply_automation_rules" string="Apply Automation Rules" type="object" class="btn-primary"/>
                            </div>
                            <field name="x_bom_tool_line_ids">
                                <tree editable="bottom">
                                    <field name="x_bom_id" invisible="1"/>
                                    <field name="x_line_id"/>
                                    <field name="x_base_line_id" optional="hide"/>
                                    <field name="x_ref_des"/>
                                    <field name="x_product_tmpl_id" invisible="1"/>
                                    <field name="x_product_id"/>
                                    <field name="x_quantity"/>
                                    <field name="x_uom_id"/>
                                    <field name="x_description" optional="hide"/>
                                    <field name="x_notes" optional="hide"/>
                                    <field name="x_replacement_rule_line_id" optional="hide"/>
                                    <field name="x_master_line" optional="hide"/>
                                    <field name="x_replacement_rule_id" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>

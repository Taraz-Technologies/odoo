<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="mrp_production_form_view_cus_production_planner_1" model="ir.ui.view">
            <field name="name">mrp.production.form.cus_production_planner_1</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="priority" eval="99"/>
            <field name="arch" type="xml">
                <data>
                    <div name="button_box" position="inside">
                        <button name="action_view_picking_lines" type="object"
                                class="oe_stat_button" icon="fa-align-justify"
                                attrs="{'invisible': [('state', 'in', ('draft'))]}"
                        >
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Short Parts</span>
                            </div>
                        </button>
                        <button name="action_view_manufacturing_raw_material" type="object"
                                class="oe_stat_button" icon="fa-align-justify"
                        >
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Raw Material</span>
                            </div>
                        </button>
                    </div>
                    <field name="date_deadline" position="before">
                        <field name="x_folder_name"/>
                        <field name="x_compute_date_deadline" invisible="1"/>
                        <field name="x_compute_date_planned_start" invisible="1"/>
                    </field>
                    <field name="date_start_wo" position="after">
                        <div class="o_row o_td_label">
                            <label for="x_planned_start_date" string="Planned Date"/>
                        </div>
                        <div class="o_row">
                            <field name="x_planned_start_date"/>
                            <label for="x_planned_finish_date" string="to"/>
                            <field name="x_planned_finish_date"/>
                        </div>
                    </field>
                    <label for="date_planned_start" position="attributes">
                        <attribute name="string">Effective Date</attribute>
                    </label>
                    <field name="bom_id" position="attributes">
                        <attribute name="context">
                            {
                            'default_product_tmpl_id': product_tmpl_id,
                            'default_code': name,
                            'default_product_qty': product_qty,
                            }
                        </attribute>
                    </field>
                    <field name="bom_id" position="before">
                        <field name="x_manufacturing_type"/>
                        <label for="x_bom_tool_id" attrs="{'invisible': [('x_bom_tool_id', '=', False)]}"/>
                        <div class="o_row" attrs="{'invisible': [('x_bom_tool_id', '=', False)]}">
                            <field name="x_bom_tool_id"/>
                            <field name="x_goods_type"/>
                            <button string="Compute Manufacturing BoM" name="compute_bom_lines" type="object"
                                    class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        </div>
                    </field>
                    <field name="bom_id" position="after">
                        <field name="x_bom_tool_status" invisible="1"/>
                        <field name="x_production_status"/>
                    </field>
                    <xpath expr="//page[1]" position="attributes">
                        <attribute name="string">Manufacturing Lines</attribute>
                    </xpath>
                    <xpath expr="//page[1]" position="before">
                        <page name="bom_lines" string="BoM Lines">
                            <field name="x_compute_bom_line_status" invisible="1"/>
                            <group col="4">
                                <field name="x_type" widget="radio"/>
                            </group>
                            <div class="o_row">
                                <button string="1. Update BoM Lines Status" name="compute_bom_line_status" type="object"
                                        class="btn-primary"
                                        attrs="{'invisible': ['|', ('bom_id', '=', False), ('state', 'in', ('draft', 'done', 'cancel'))]}"/>
                                <button string="2. Update Manufacturing Lines" name="update_move_raw_ids"
                                        type="object" class="btn-primary"
                                        attrs="{'invisible': ['|', ('bom_id', '=', False), ('state', 'in', ('draft', 'done', 'cancel'))]}"/>
                            </div>
                            <field name="x_bom_line_ids">
                                <tree string="BoM Lines" editable="bottom"
                                      decoration-danger="x_part_status == 'short'"
                                      decoration-success="x_part_status == 'alt'"
                                      decoration-info="x_part_status == 'comp'"
                                      decoration-warning="x_part_status in ('waiting', 'partially_available')"
                                      decoration-muted="x_part_status in ('assigned', 'done')"
                                >
                                    <field name="company_id" invisible="1"/>
                                    <field name="routing_id" invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="x_ref_des" optional="hide"/>

                                    <field name="x_product_id" invisible="1"/>
                                    <field name="x_taraz_part_number_id" invisible="1"/>
                                    <field name="x_alternate_ids" invisible="1"/>
                                    <field name="x_compromise_ids" invisible="1"/>
                                    <field name="x_product_ids" widget="many2many_tags" invisible="1"/>

                                    <field name="x_mounting_type" optional="hide"/>
                                    <field name="x_original_product_id" domain="[('id', '=', x_product_id)]"
                                           options="{'no_quick_create':True,'no_create_edit':True}" optional="hide"/>
                                    <field name="x_taraz_part_id" domain="[('id', '=', x_taraz_part_number_id)]"
                                           options="{'no_quick_create':True,'no_create_edit':True}" optional="hide"/>

                                    <field name="product_id" context="{'default_type': 'product'}"/>
                                    <field name="product_tmpl_id" invisible="1"/>
                                    <button name="action_see_attachments" type="object" icon="fa-files-o"
                                            aria-label="Product Attachments" title="Product Attachments"
                                            class="float-right oe_read_only"/>

                                    <button name="action_duplicate_bom_line" type="object" icon="fa-clipboard"
                                            title="Create Duplicate Line" class="float-right oe_edit_only"/>

                                    <field name="attachments_count" class="text-left oe_read_only" string=" "/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_category_id" invisible="1"/>
                                    <field name="parent_product_tmpl_id" invisible="1"/>
                                    <field name="possible_bom_product_template_attribute_value_ids" invisible="1"/>
                                    <field name="product_uom_id" options="{'no_open':True,'no_create':True}"
                                           groups="uom.group_uom"/>

                                    <field name="x_free_qty" string="Available" optional="hide"/>
                                    <field name="x_uom_id" string="UoM (Available)" optional="hide"/>
                                    <field name="x_part_status"/>
                                    <field name="x_line_cost" optional="hide"/>

                                    <field name="bom_product_template_attribute_value_ids" optional="hide"
                                           widget="many2many_tags" options="{'no_create': True}"
                                           attrs="{'column_invisible': [('parent.product_id', '!=', False)]}"
                                           groups="product.group_product_variant"/>
                                    <field name="operation_id" groups="mrp.group_mrp_routings" optional="hide"
                                           attrs="{'column_invisible': [('parent.x_type','not in', ('normal', 'phantom'))]}"
                                           options="{'no_quick_create':True,'no_create_edit':True}"/>
                                </tree>
                            </field>
                        </page>
                    </xpath>
                    <xpath expr="//page[2]" position="after">
                        <page name="demand_details" string="Demand Details">
                            <field name="x_manufacture_components" invisible="1"/>
                            <group>
                                <group>
                                    <label for="x_demand_batch_id"/>
                                    <div class="o_row">
                                        <field name="x_demand_batch_id"/>
                                        <button string="Compute Child MOs"
                                                name="action_compute_child_manufacturing_orders" type="object"
                                                class="btn-primary"
                                                attrs="{'invisible': [('x_manufacture_components', '=', False)]}"/>
                                    </div>
                                </group>
                                <group>
                                    <field name="x_master_order_id"/>
                                </group>
                            </group>
                            <separator colspan="4" string="Demand List Details"/>
                            <field name="x_mrp_demand_ids">
                                <tree editable="bottom" style="width:100%">
                                    <field name="x_manufacturing_id" invisible="1"/>
                                    <field name="x_child_product_id" invisible="1"/>
                                    <field name="x_demand_type"/>
                                    <field name="x_sale_id" widget="many2one"
                                           attrs="{
										   		'required': [('x_demand_type', '=', 'sale')],
										   		'readonly': [('x_demand_type', '!=', 'sale')]
										   }"
                                    />
                                    <field name="x_folder_name" string="Sale Order Details" optional="hide"/>
                                    <field name="x_picking_id" widget="many2one"/>
                                    <field name="x_do_state" optional="show"/>
                                    <field name="x_deadline" optional="show"/>
                                    <field name="x_master_order_id" widget="many2one"/>
                                    <button name="update_child_orders" type="object" icon="fa-repeat"
                                            title="Update Child MOs" class="float-right"/>
                                    <field name="x_product_id"/>
                                    <field name="x_product_category" string="Category" optional="hide"/>
                                    <field name="x_free_qty" string="Available"/>
                                    <field name="x_demand" sum="Total Demand"/>
                                    <field name="x_reserved" sum="Total Reserved"/>
                                    <field name="x_quantity" sum="Total Required"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="x_sale_id" widget="many2one"/>
                                                <field name="x_folder_name" string="Sale Order Details"/>
                                                <field name="x_deadline"/>
                                                <field name="x_quantity"/>
                                            </group>
                                            <group>
                                                <field name="x_master_order_id" widget="many2one"/>
                                                <field name="x_product_id"/>
                                                <field name="x_product_category"/>
                                                <field name="x_demand_type"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                            <field name="x_compute_serial_numbers" invisible="1"/>
                            <separator colspan="4" string="Products with Serial Numbers"/>
                            <field name="x_serial_numbers">
                                <tree editable="bottom">
                                    <field name="x_manufacturing_id" invisible="1"/>
                                    <field name="x_product_id" widget="many2one"/>
                                    <field name="x_serial_number" force_save="1"/>
                                    <field name="x_sale_order_number" widget="many2one"/>
                                    <field name="x_mega_mo_number" widget="many2one"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="x_serial_number"/>
                                            <field name="x_sale_order_number"/>
                                            <field name="x_mega_mo_number"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="mrp_production_tree_view_customization_1" model="ir.ui.view">
            <field name="name">mrp.production.tree.customization</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
            <field name="arch" type="xml">
                <data>
                    <field name="date_planned_start" position="after">
                        <field name="date_planned_finished" optional="show"/>
                        <!--						<field name="x_duration_expected" optional="show"/>-->
                    </field>
                    <field name="product_id" position="before">
                        <field name="x_manufacturing_type" optional="show"/>
                        <field name="x_production_status" optional="show"/>
                        <field name="x_goods_type" optional="show"/>
                    </field>
                    <field name="product_qty" position="after">
                        <field name="x_demand_batch_id" optional="show"/>
                        <field name="x_mrp_demand_ids" widget="many2many_tags" optional="show"/>
                    </field>
                    <field name="product_uom_id" position="before">
                        <field name="product_qty" position="move"/>
                    </field>
                    <field name="state" position="after">
                        <field name="reservation_state" position="move"/>
                    </field>
                </data>
            </field>
        </record>

        <record id="mrp_production_search_view_customization_1" model="ir.ui.view">
            <field name="name">mrp.production.search.customization</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
            <field name="arch" type="xml">
                <data>
                    <field name="name" position="attributes">
                        <attribute name="filter_domain">
                            ['|', '|', '|',
                            ('name', 'ilike', self),
                            ('origin', 'ilike', self),
                            ('x_mrp_demand_ids', 'ilike', self),
                            ('x_demand_batch_id', 'ilike', self),
                            ]
                        </attribute>
                    </field>
                    <filter name="scheduled_date" position="after">
                        <separator/>
                        <filter string="Production Status" name="production_status"
                                context="{'group_by': 'x_production_status'}"/>
                        <filter string="Demand Batch" name="demand_batch" domain="[]"
                                context="{'group_by': 'x_demand_batch_id'}"/>
                        <filter string="Order Type" name="manufacturing_type" domain="[]"
                                context="{'group_by': 'x_manufacturing_type'}"/>
                        <filter string="Manufacturing Order" name="manufacturing_order" domain="[]"
                                context="{'group_by': 'name'}"/>
                    </filter>
                </data>
            </field>
        </record>

        <record id="mrp.mrp_production_action" model="ir.actions.act_window">
            <field name="context">
                {'search_default_todo': True, 'default_company_id': allowed_company_ids[0]}
            </field>
        </record>

        <record id="production_order_merge_server_action" model="ir.actions.server">
            <field name="name">Mrp: Merge Production Orders</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="binding_model_id" ref="mrp.model_mrp_production"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.action_merge_manufacturing_orders()</field>
        </record>

        <record id="production_order_cancel_server_action" model="ir.actions.server">
            <field name="name">Mrp: Cancel Production Orders</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="binding_model_id" ref="mrp.model_mrp_production"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.action_cancel_manufacturing_orders()</field>
        </record>

        <record id="view_production_calendar_cus_production_planner" model="ir.ui.view">
            <field name="name">mrp.production.calendar</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.view_production_calendar"/>
            <field name="arch" type="xml">
                <xpath expr="/calendar" position="attributes">
                    <attribute name="date_start">x_planned_start_date</attribute>
                    <attribute name="date_stop">x_planned_finish_date</attribute>
                </xpath>
            </field>
        </record>

        <record id="production_order_cancel_and_reserve_stock_server_action" model="ir.actions.server">
            <field name="name">Mrp: Cancel Production Orders &amp; Reserve Cancelled Stock</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="binding_model_id" ref="mrp.model_mrp_production"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.action_cancel_manufacturing_orders_and_reserve_stock()</field>
        </record>


        <record model="ir.actions.act_window" id="mrp_pick_components_report">
            <field name="name">Pick Components</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">tree,form,kanban,calendar</field>
            <field name="search_view_id" ref="stock.view_picking_internal_search"/>
            <field name="domain">
                [('picking_type_id.name', '=', 'Pick Components')]
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Pick component
                </p>
            </field>
        </record>

        <menuitem id="menu_mrp_pick_components_report"
                  name="Pick Components"
                  sequence="10"
				  action="mrp_pick_components_report"
				  parent="mrp.menu_mrp_manufacturing"
        />

    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
<!--        Scrum Task Stages-->
        <record id="scrum_task_stage_0" model="scrum.task.type">
            <field name="x_name">New</field>
            <field name="x_description">New project tasks are created here by default</field>
            <field name="sequence">0</field>
            <field name="fold">1</field>
            <field name="x_last_stage">0</field>
        </record>

        <record id="scrum_task_stage_icebox" model="scrum.task.type">
            <field name="x_name">IceBox</field>
            <field name="x_description">Delayed tasks will be pushed to this stage</field>
            <field name="sequence">1</field>
            <field name="fold">1</field>
            <field name="x_last_stage">0</field>
        </record>

        <record id="scrum_task_stage_1" model="scrum.task.type">
            <field name="x_name">Backlog</field>
            <field name="x_description">To do tasks will be pushed to this stage</field>
            <field name="sequence">1</field>
            <field name="fold">0</field>
            <field name="x_last_stage">0</field>
        </record>

        <record id="scrum_task_stage_2" model="scrum.task.type">
            <field name="x_name">Next Sprint</field>
            <field name="x_description">Sprint planning will be done in this stage</field>
            <field name="sequence">2</field>
            <field name="fold">0</field>
            <field name="x_last_stage">0</field>
        </record>

        <record id="scrum_task_stage_3" model="scrum.task.type">
            <field name="x_name">Sprint Backlog</field>
            <field name="x_description">Current sprint tasks will be listed in this stage</field>
            <field name="sequence">3</field>
            <field name="fold">0</field>
            <field name="x_last_stage">0</field>
        </record>

        <record id="scrum_task_stage_4" model="scrum.task.type">
            <field name="x_name">In Development</field>
            <field name="x_description">In progress (development) tasks will be listed in this stage</field>
            <field name="sequence">4</field>
            <field name="fold">0</field>
            <field name="x_last_stage">0</field>
        </record>

        <record id="scrum_task_stage_5" model="scrum.task.type">
            <field name="x_name">Code Review</field>
            <field name="x_description">In progress (code review) tasks will be listed in this stage</field>
            <field name="sequence">5</field>
            <field name="fold">0</field>
            <field name="x_last_stage">0</field>
        </record>

        <record id="scrum_task_stage_6" model="scrum.task.type">
            <field name="x_name">Testing</field>
            <field name="x_description">In progress (testing) tasks will be listed in this stage</field>
            <field name="sequence">6</field>
            <field name="fold">0</field>
            <field name="x_last_stage">0</field>
        </record>

        <record id="scrum_task_stage_7" model="scrum.task.type">
            <field name="x_name">Done</field>
            <field name="x_description">Completed tasks will be listed in this stage</field>
            <field name="sequence">7</field>
            <field name="x_fold">0</field>
            <field name="x_last_stage">1</field>
        </record>
    </data>
</odoo>
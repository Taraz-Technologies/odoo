<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Project Types-->
    <record id="scrum_project_type_view_form" model="ir.ui.view">
        <field name="name">scrum_project_type_view_form</field>
        <field name="model">scrum.project.type</field>
        <field name="arch" type="xml">
            <form string="Project Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="x_name"/>
                            <field name="x_stage_id"/>
                        </group>
                        <group>
                            <field name="fold"/>
                            <field name="x_default_stage"/>
                            <field name="x_last_stage"/>
                        </group>
                    </group>
                    <group string="Stage Description">
                        <p class="text-muted" colspan="2">
                            You can also add a description to help your coworkers understand the meaning and purpose of the stage.
                        </p>
                        <field name="x_description" placeholder="Add a description..." nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="scrum_project_type_view_tree" model="ir.ui.view">
        <field name="name">scrum_project_type_view_tree</field>
        <field name="model">scrum.project.type</field>
        <field name="arch" type="xml">
            <tree string="Project Stage">
                <field name="sequence" widget="handle"/>
                <field name="x_name"/>
                <field name="x_description"/>
                <field name="x_stage_id"/>
                <field name="fold"/>
                <field name="x_default_stage"/>
                <field name="x_last_stage"/>
            </tree>
        </field>
    </record>

    <record id="scrum_project_type_view_search" model="ir.ui.view">
       <field name="name">scrum_project_type_view_search</field>
       <field name="model">scrum.project.type</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="x_name"/>
                <field name="x_description"/>
                <field name="x_stage_id"/>
            </search>
       </field>
    </record>

    <record id="scrum_project_type_action" model="ir.actions.act_window">
        <field name="name">Project Stage</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">scrum.project.type</field>
        <field name="view_mode">tree,form</field>
    </record>
<!--    Projects-->
    <record id="scrum_project_view_kanban" model="ir.ui.view">
        <field name="name">scrum_project_view_kanban</field>
        <field name="model">scrum.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="x_stage_id" class="o_kanban_small_column">
                <field name="x_priority"/>
                <field name="x_name"/>
                <field name="x_stage_id" options='{"group_by_tooltip": {"x_description": "Description"}, "fold_field": "fold"}'/>
                <field name="x_user_id"/>
                <field name="x_user_ids"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="x_name"/></strong>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown" t-if="!selection_mode" groups="base.group_user">
                                        <a role="button" class="dropdown-toggle o-no-caret btn" data-toggle="dropdown" data-display="static" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a t-if="widget.editable" role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                            <a name="copy" role="menuitem" type="object" class="dropdown-item">Duplicate</a>
                                            <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom" t-if="!selection_mode">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="x_priority" widget="priority"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right" t-if="!selection_mode">
                                        <img t-att-src="kanban_image('res.users', 'image_128', record.x_user_id.raw_value)" t-att-title="user_id" t-att-alt="record.x_user_id.raw_value" class="oe_kanban_avatar"/>
                                        <t t-foreach="record.x_user_ids.raw_value" t-as="user_id">
                                            <img t-att-src="kanban_image('res.users', 'image_128', user_id)" t-att-title="user_id" t-att-alt="user_id" class="oe_kanban_avatar"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="oe_clear"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="scrum_project_view_form" model="ir.ui.view">
        <field name="name">scrum_project_view_form</field>
        <field name="model">scrum.project</field>
        <field name="arch" type="xml">
            <form string="Projects">
                <header>
                    <field name="x_stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="x_sequence" invisible="1"/>
                    <field name="x_task_stage_id" invisible="1"/>
                    <field name="x_compute_project_stage_id" invisible="1"/>
                    <field name="x_compute_tasks_stage_id" invisible="1"/>
                    <div class="oe_title pr-0">
                        <h1 class="d-flex flex-row justify-content-between">
                            <field name="x_priority" widget="priority" class="mr-3"/>
                            <field name="x_name" placeholder="Project Title..."
                                   style="max-width: 688px; margin-right: auto; overflow: hidden;
                                   text-overflow: ellipsis; white-space: nowrap;"/>
                        </h1>
                    </div>
                    <group>
                        <field name="x_department_id"/>
                        <field name="x_user_id"/>
                        <field name="x_user_ids" widget="many2many_tags"/>
                    </group>
                    <field name="x_description" placeholder="Add a description..." nolabel="1" colspan="2"/>
                    <notebook>
                        <page string="Development Tasks">
                            <field name="x_task1_ids"
                                   context="{'default_x_stage_id': x_task_stage_id, 'default_x_user_id': x_user_id, 'default_x_user_ids': x_user_ids}"
                            />
<!--                                <tree>-->
<!--                                    <field name="x_priority"/>-->
<!--                                    <field name="x_task_weightage"/>-->
<!--                                    <field name="x_name"/>-->
<!--                                    <field name="x_description"/>-->
<!--                                    <field name="x_department_id"/>-->
<!--                                    <field name="x_user_id"/>-->
<!--                                    <field name="x_user_ids"/>-->
<!--                                    <field name="x_stage_id"/>-->
<!--                                </tree>-->
<!--                            </field>-->
                        </page>
                        <page string="Ready Tasks">
                            <field name="x_task2_ids" options="{'no_create': True, 'no_create_edit': True}" readonly="1"
                                   context="{'default_x_stage_id': x_task_stage_id, 'default_x_user_id': x_user_id, 'default_x_user_ids': x_user_ids}"
                            >
                                <tree>
                                    <field name="x_priority"/>
                                    <field name="x_task_weightage"/>
                                    <field name="x_name"/>
                                    <field name="x_description"/>
                                    <field name="x_department_id"/>
                                    <field name="x_user_id"/>
                                    <field name="x_user_ids"/>
                                    <field name="x_stage_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Completed Tasks">
                            <field name="x_task3_ids" options="{'no_create': True, 'no_create_edit': True}" readonly="1"
                                   context="{'default_x_stage_id': x_task_stage_id, 'default_x_user_id': x_user_id, 'default_x_user_ids': x_user_ids}"
                            >
                                <tree>
                                    <field name="x_priority"/>
                                    <field name="x_task_weightage"/>
                                    <field name="x_name"/>
                                    <field name="x_description"/>
                                    <field name="x_department_id"/>
                                    <field name="x_user_id"/>
                                    <field name="x_user_ids"/>
                                    <field name="x_stage_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Delayed Tasks">
                            <field name="x_task4_ids"
                                   context="{'default_x_stage_id': x_task_stage_id, 'default_x_user_id': x_user_id, 'default_x_user_ids': x_user_ids}"
                            >
                                <tree>
                                    <field name="x_priority"/>
                                    <field name="x_task_weightage"/>
                                    <field name="x_name"/>
                                    <field name="x_description"/>
                                    <field name="x_department_id"/>
                                    <field name="x_user_id"/>
                                    <field name="x_user_ids"/>
                                    <field name="x_stage_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="scrum_project_view_tree" model="ir.ui.view">
        <field name="name">scrum_project_view_tree</field>
        <field name="model">scrum.project</field>
        <field name="arch" type="xml">
            <tree string="Projects">
                <field name="x_sequence" widget="handle"/>
                <field name="x_name"/>
                <field name="x_description"/>
                <field name="x_department_id"/>
                <field name="x_user_id"/>
                <field name="x_user_ids" widget="many2many_tags"/>
                <field name="x_priority" widget="priority" class="mr-3"/>
            </tree>
        </field>
    </record>

    <record id="scrum_project_view_search" model="ir.ui.view">
       <field name="name">scrum_project_view_search</field>
       <field name="model">scrum.project</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="x_name"/>
                <field name="x_department_id"/>
                <field name="x_user_id"/>
                <field name="x_user_ids"/>
                <separator/>
                <filter name="my_projects" string="My Projects" domain="[('x_user_id', '=', uid)]"/>
                <filter name="my_participation" string="My Participation" domain="[('x_user_ids', 'ilike', uid)]"/>
                <separator/>
                <filter name="low_priority" string="Low priority" domain="[('x_priority', '=', 0)]"/>
                <filter name="medium_priority" string="Medium priority" domain="[('x_priority', '=', 1)]"/>
                <filter name="high_priority" string="High priority" domain="[('x_priority', '=', 2)]"/>
                <filter name="very_high_priority" string="Very High priority" domain="[('x_priority', '=', 3)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Stage" name="stage" context="{'group_by': 'x_stage_id'}"/>
                </group>
            </search>
       </field>
    </record>

    <record id="scrum_project_action" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">scrum.project</field>
        <field name="context">{"search_default_my_projects": 1}</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
</odoo>

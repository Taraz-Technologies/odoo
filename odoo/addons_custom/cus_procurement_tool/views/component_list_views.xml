<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--        Short Part Details-->
        <record id="component_list_view_form" model="ir.ui.view">
            <field name="name">component_list_view_form</field>
            <field name="model">component.list</field>
            <field name="arch" type="xml">
                <form string="Short Part Details">
                    <sheet>
                        <field name="x_proc_cycle_id" invisible="1"/>
                        <field name="x_mergeable_lines" invisible="1"/>
                        <group>
                            <group>
                                <field name="x_product_id"/>
                                <field name="x_categ_id"/>
                                <field name="x_taraz_part_id"/>
                                <label for="x_consider_compromised" string="Stock Calculation"/>
                                <div class="o_row" style="white-space: nowrap;">
                                    <button name="compute_safety_stock" string="Calculate Stock" class="btn-primary"
                                            type="object"/>
                                    <field name="x_consider_compromised"/>
                                    <label for="x_consider_compromised" string="Include Compromised"/>
                                </div>
                                <field name="x_remaining_days"/>
                            </group>
                            <group>
                                <field name="image_128" widget='image' class="oe_avatar"
                                       options='{"preview_image": "image_128"}' nolabel="1"/>
                            </group>
                        </group>
                        <field name="x_description"/>
                        <separator colspan="4" string="Alternates"/>
                        <field name="x_mergeable_line_warning"
                               attrs="{'invisible': [('x_mergeable_line_warning', '=', False)]}"
                               style="color:red;"/>
                        <field name="x_alternate_ids">
                            <tree>
                                <field name="x_product_id" widget="many2one"/>
                                <field name="x_description"/>
                                <field name="x_qty_available" sum="Total"/>
                                <field name="x_to_consume_qty" sum="Total"/>
                                <field name="x_tray_out_qty" sum="Total"/>
                                <field name="x_available_qty" sum="Total"/>
                                <field name="x_incoming_qty" sum="Total"/>
                                <field name="x_backorder_qty" sum="Total"/>
                                <field name="x_outgoing_qty" sum="Total"/>
                                <field name="x_virtual_available" sum="Total"/>
                            </tree>
                        </field>
                        <separator colspan="4" string="Compromised"/>
                        <field name="x_compromised_ids">
                            <tree>
                                <field name="x_compromised_id" widget="many2one"/>
                                <field name="x_description"/>
                                <field name="x_tz_qty_available" sum="Total"/>
                                <field name="x_tz_to_consume_qty" sum="Total"/>
                                <field name="x_tz_tray_out_qty" sum="Total"/>
                                <field name="x_tz_available_qty" sum="Total"/>
                                <field name="x_tz_incoming_qty" sum="Total"/>
                                <field name="x_tz_backorder_qty" sum="Total"/>
                                <field name="x_tz_outgoing_qty" sum="Total"/>
                                <field name="x_tz_virtual_available" sum="Total"/>
                            </tree>
                        </field>
                        <group col="6">
                            <field name="x_uom_id"/>
                            <field name="x_mounting_type"/>
                            <field name="x_status"/>
                            <field name="x_required_qty" string="Demand"/>
                            <field name="x_missing_qty"/>
                            <field name="x_incoming_qty"/>
                            <field name="x_qty_available"/>
                            <field name="x_safety_stock"/>
                            <field name="x_reorder_point"/>
                            <field name="x_moq" readonly="1"/>
                            <field name="x_roq" readonly="1"/>
                            <field name="x_broq" readonly="1"/>
                        </group>
                        <separator colspan="4" string="Cart Lines"/>
                        <div class="o_row">
                            <field name="x_default_qty" widget="radio" options="{'horizontal': true}"
                                   class="oe_inline"/>
                            <label for="x_manual_qty" class="oe_inline"
                                   attrs="{'invisible': [('x_default_qty', '!=', 'manual')]}"/>
                            <field name="x_manual_qty" class="oe_inline"
                                   attrs="{'invisible': [('x_default_qty', '!=', 'manual')]}"/>
                        </div>
                        <h6>
                            <field name="x_vendor_type" widget="radio" options="{'horizontal': true}"/>
                            <span>(To define preferred vendor define "Vendor Code" in "Contacts")</span>
                        </h6>
                        <div class="o_row">
                            <button name="compute_cart_lines" string="Compute Cart Lines" class="btn-primary"
                                    type="object"/>
                        </div>
                        <field name="x_quantities_ids"/>
                        <separator colspan="4" string="Carts Details"/>
                        <field name="x_cart_ids"/>
                        <separator colspan="4" string="Budget Details"/>
                        <field name="x_budget_ids"/>
                        <separator colspan="4" string="Demand Details"/>
                        <field name="x_demand_detail_ids">
                            <tree editable="bottom">
                                <field name="x_component_id" invisible="1"/>
                                <field name="x_safety_stock_line_id" invisible="1"/>
                                <field name="x_manufacturing_id"/>
                                <field name="x_type"/>
                                <field name="x_internal_demand_id"/>
                                <field name="x_user_id" optional="hide"/>
                                <field name="x_url" widget="url" optional="hide"/>
                                <field name="x_note" optional="hide"/>
                                <field name="x_sale_id"/>
                                <field name="x_deadline" optional="hide"/>
                                <field name="x_remaining_days" min="Minimum" optional="hide"/>
                                <field name="x_product_id"/>
                                <field name="x_quantity" sum="Total"/>
                                <field name="x_uom_id"/>
                            </tree>
                        </field>
                        <separator colspan="4" string="Purchase History"/>
                        <field name="x_purchase_history_ids" readonly="1">
                            <tree>
                                <field name="x_component_id" invisible="1"/>
                                <field name="x_relation"/>
                                <field name="x_product_id"/>
                                <field name="x_vendor_id"/>
                                <field name="x_order_date"/>
                                <field name="x_purchase_id"/>
                                <field name="x_quantity" sum="Total"/>
                                <field name="x_uom_id"/>
                                <field name="x_currency_id" invisible="1"/>
                                <field name="x_unit_price" widget="monetary"
                                       options="{'currency_field': 'x_currency_id'}"/>
                                <field name="x_subtotal" widget="monetary"
                                       options="{'currency_field': 'x_currency_id'}"/>
                            </tree>
                        </field>
                        <separator colspan="4" string="Quarterly Consumption"/>
                        <field name="x_quarterly_consumption_ids" readonly="1"/>
                        <separator colspan="4" string="Usage Details"/>
                        <field name="x_consumption_ids" readonly="1">
                            <tree>
                                <field name="x_component_id" invisible="1"/>
                                <field name="x_product_id"/>
                                <field name="x_quantity"/>
                                <field name="x_uom_id"/>
                            </tree>
                        </field>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                        <field name="activity_ids" widget="mail_activity"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="component_list_view_tree" model="ir.ui.view">
            <field name="name">component_list_view_tree</field>
            <field name="model">component.list</field>
            <field name="arch" type="xml">
                <tree string="Short Part Details"
                      decoration-info="x_status == False"
                      decoration-danger="x_status == 'urgent'"
                      decoration-muted="x_status == 'ignore'"
                      decoration-success="x_status == 'cart_ordered'"
                      decoration-warning="x_status == 'cart_partially_ordered'"
                >
                    <field name="x_proc_cycle_id" invisible="1"/>
                    <field name="x_compute_sale_ids" invisible="1"/>

                    <field name="image_128" widget="image" class="o_kanban_image_fill_left" optional="show"/>
                    <field name="x_product_id"/>

                    <field name="x_remaining_days" optional="hide"/>

                    <field name="x_uom_id" optional="show"/>
                    <field name="x_mounting_type" optional="show"/>
                    <field name="x_country_id" optional="show"/>

                    <field name="x_categ_id" optional="show"/>
                    <field name="x_description" optional="show"/>

                    <field name="x_sale_ids" widget="many2many_tags" optional="show"/>

                    <field name="x_required_qty" optional="hide"/>
                    <field name="x_missing_qty" optional="hide"/>
                    <field name="x_incoming_qty" string="Incoming" optional="hide"/>

                    <field name="x_status" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="component_list_view_search" model="ir.ui.view">
            <field name="name">component_list_view_search</field>
            <field name="model">component.list</field>
            <field name="arch" type="xml">
                <search string="Short Part Details">
                    <field name="x_product_id" string="Product" filter_domain="
                    ['|', '|', '|', '|', '|', '|',
                    ('x_product_id', 'ilike', self),
                    ('x_taraz_part_id', 'ilike', self),
                    ('x_taraz_part_id.x_alternate_ids', 'ilike', self),
                    ('x_taraz_part_id.x_compromised_ids', 'ilike', self),
                    ('x_description', 'ilike', self),
                    ('x_categ_id', 'ilike', self),
                    ('x_sale_ids', 'ilike', self),
                    ]"
                    />
                    <field name="x_product_id" string="And Product" filter_domain="
                    ['|', '|', '|', '|', '|', '|',
                    ('x_product_id', 'ilike', self),
                    ('x_taraz_part_id', 'ilike', self),
                    ('x_taraz_part_id.x_alternate_ids', 'ilike', self),
                    ('x_taraz_part_id.x_compromised_ids', 'ilike', self),
                    ('x_description', 'ilike', self),
                    ('x_categ_id', 'ilike', self),
                    ('x_sale_ids', 'ilike', self),
                    ]"
                    />
                    <field name="x_demand_detail_ids"/>
                    <field name="x_purchase_history_ids"/>
                    <separator/>
                    <filter name="draft" string="New Lines" domain="[('x_status', '=', 'draft')]"/>
                    <filter name="review" string="Reviewed" domain="[('x_status', '=', 'review')]"/>
                    <filter name="urgent" string="Urgent" domain="[('x_status', '=', 'urgent')]"/>
                    <filter name="ignore" string="Ignore" domain="[('x_status', '=', 'ignore')]"/>
                    <filter name="new_demand" string="Updated Lines" domain="[('x_status', '=', 'new_demand')]"/>
                    <filter name="cart_defined" string="Cart Defined" domain="[('x_status', '=', 'cart_defined')]"/>
                    <filter name="cart_on_hold" string="Cart on Hold" domain="[('x_status', '=', 'cart_on_hold')]"/>
                    <filter name="cart_ordered" string="Cart Ordered" domain="[('x_status', '=', 'cart_ordered')]"/>
                    <filter name="cart_partially_ordered" string="Cart Partially Ordered"
                            domain="[('x_status', '=', 'cart_partially_ordered')]"/>
                    <filter name="shipped" string="Shipped" domain="[('x_status', '=', 'shipped')]"/>
                    <filter name="partially_shipped" string="Partially Shipped"
                            domain="[('x_status', '=', 'partially_shipped')]"/>
                    <filter name="received" string="Received" domain="[('x_status', '=', 'received')]"/>
                    <filter name="no_status" string="No Status" domain="[('x_status', '=', False)]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter name="category" string="Product Category" context="{'group_by': 'x_categ_id'}"/>
                        <filter name="status" string="Status" context="{'group_by': 'x_status'}"/>
                        <filter name="mergeable_lines" string="Mergeable Lines"
                                context="{'group_by': 'x_mergeable_lines'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_view_component_list" model="ir.actions.act_window">
            <field name="name">PRC Lines</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">component.list</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="component_list_view_search"/>
            <field name="view_id" ref="component_list_view_tree"/>
        </record>

        <record id="action_view_all_component_list" model="ir.actions.act_window">
            <field name="name">Procurement Cycle Lines</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">component.list</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="component_list_view_search"/>
            <field name="view_id" ref="component_list_view_tree"/>
        </record>

        <!--        Components List Quantities-->
        <record id="component_list_quantities_view_tree" model="ir.ui.view">
            <field name="name">component_list_quantities_view_tree</field>
            <field name="model">component.list.quantities</field>
            <field name="arch" type="xml">
                <tree editable="bottom"
                      decoration-success="x_cart_status == 'cart_ordered'"
                      decoration-warning="x_cart_status == 'cart_partially_ordered'"
                >
                    <field name="x_component_id" optional="hide"/>
                    <field name="x_proc_cycle_id" invisible="1"/>
                    <field name="x_cart_status" invisible="1"/>
                    <field name="x_compute_sale_ids" invisible="1"/>

                    <field name="x_relation"/>
                    <field name="x_product_id" widget="many2one"/>
                    <field name="x_description" optional="show"/>
                    <field name="x_mounting_type" optional="show"/>

                    <field name="x_quantity" sum="Total"/>
                    <field name="x_uom_id"/>

                    <field name="x_octopart_connector_id" optional="show"/>
                    <field name="x_seller_ids" invisible="1"/>
                    <field name="x_seller_id"/>
                    <field name="x_partner_id" optional="show"/>
                    <field name="x_prc_cart_id" optional="show" attrs="{'required': [('x_partner_id', '!=', False)]}"/>
                    <field name="x_sale_ids" widget="many2many_tags" optional="show"/>

                    <field name="x_eoq" sum="Total"/>
                    <field name="x_unit_price"/>
                    <field name="x_ext_price" sum="Total"/>
                    <field name="x_actual_unit_price" optional="show"/>
                    <field name="x_actual_ext_price" sum="Total" optional="show"/>
                    <field name="x_overspent" widget="percentage" readonly="1" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="component_list_quantities_view_search" model="ir.ui.view">
            <field name="name">component_list_quantities_view_search</field>
            <field name="model">component.list.quantities</field>
            <field name="arch" type="xml">
                <search>
                    <field name="x_component_id" string="Component" filter_domain="[
                    '|','|','|','|','|',
                    ('x_component_id', 'ilike', self),
                    ('x_product_id', 'ilike', self),
                    ('x_description', 'ilike', self),
                    ('x_partner_id', 'ilike', self),
                    ('x_prc_cart_id', 'ilike', self),
                    ('x_sale_ids', 'ilike', self),
                    ]"/>
                    <separator/>
                    <filter name="cart_defined" string="Cart Defined"
                            domain="[('x_component_id.x_status', '=', 'cart_defined'), ('x_prc_cart_id', '!=', False)]"
                    />
                    <filter name="cart_ordered" string="Cart Ordered"
                            domain="[('x_component_id.x_status', '=', 'cart_ordered'), ('x_prc_cart_id', '!=', False)]"
                    />
                    <filter name="cart_ordered" string="Cart On Hold"
                            domain="[('x_component_id.x_status', '=', 'cart_on_hold'), ('x_prc_cart_id', '!=', False)]"
                    />
                    <separator/>
                    <filter name="smt" string="SMT" domain="[('x_mounting_type', '=', 'smd')]"/>
                    <filter name="tht" string="THT" domain="[('x_mounting_type', '=', 'th')]"/>
                    <filter name="other" string="OTHER" domain="[('x_mounting_type', '=', 'other')]"/>
                    <group expand="0" string="Group By">
                        <filter name="component" string="Component" context="{'group_by': 'x_component_id'}"/>
                        <filter name="vendor" string="Vendor" context="{'group_by': 'x_partner_id'}"/>
                        <filter name="cart" string="Cart" context="{'group_by': 'x_prc_cart_id'}"/>
                        <filter name="cart_status" string="Cart Status" context="{'group_by': 'x_cart_status'}"/>
                        <filter name="mounting_type" string="Mounting Type" context="{'group_by': 'x_mounting_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="component_list_quantities_action" model="ir.actions.act_window">
            <field name="name">Cart Lines</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">component.list.quantities</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="component_list_quantities_view_search"/>
            <field name="view_id" ref="component_list_quantities_view_tree"/>
        </record>

        <record id="component_list_all_quantities_action" model="ir.actions.act_window">
            <field name="name">Cart Lines</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">component.list.quantities</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="component_list_quantities_view_search"/>
            <field name="view_id" ref="component_list_quantities_view_tree"/>
        </record>
    </data>
</odoo>

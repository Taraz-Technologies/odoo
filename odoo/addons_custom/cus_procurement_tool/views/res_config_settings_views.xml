<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_cus_procurement_tool_1" model="ir.ui.view">
            <field name="name">res_config_settings_view_form_cus_procurement_tool_1</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="99"/>
            <field name="inherit_id" ref="stock.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@data-key='stock']/div[hasclass('o_settings_container')][2]/div[hasclass('o_setting_box')][3]" position="after">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="x_bulk_stock_months"/>
                            <div class="text-muted">
                                Stock to maintain in Bulk (months)
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="x_bulk_stock_months" class="o_light_label"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="x_cost_overhead"/>
                            <div class="text-muted">
                                Overspent to adjust stock quantity(%)
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="x_cost_overhead" class="o_light_label" widget="percentage"/>
                                </div>
                            </div>
                        </div>
                    </div>
<!--                    <div class="col-12 col-lg-6 o_setting_box">-->
<!--                        <div class="o_setting_right_pane">-->
<!--                            <label for="x_preferred_partner_ids"/>-->
<!--                            <div class="text-muted">-->
<!--                                Preferred Suppliers to order from-->
<!--                            </div>-->
<!--                            <div class="content-group">-->
<!--                                <div class="mt16">-->
<!--                                    <field name="x_preferred_partner_ids" class="o_light_label" widget="many2many_tags"/>-->
<!--                                </div>-->
<!--                            </div>-->
<!--                        </div>-->
<!--                    </div>-->
                </xpath>
            </field>
        </record>
    </data>
</odoo>

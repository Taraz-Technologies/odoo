<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

<!--	Procurement Cycle Cart Details-->
	<record id="procurement_cycle_cart_details_view_form" model="ir.ui.view">
	    <field name="name">procurement_cycle_cart_details_view_form</field>
	    <field name="model">procurement.cycle.cart.details</field>
	    <field name="arch" type="xml">
	        <form string="Procurement Cycle Cart Details">
	            <sheet>
	                <group>
						<group>
							<field name="x_name"/>
							<field name="x_partner_id"/>
	            			<field name="x_proc_cycle_id" readonly="1"/>
							<field name="x_journal_id"/>
							<field name="x_currency_id"/>
							<field name="x_cart_url" widget="url"/>
							<field name="x_tag_ids" widget="many2many_tags"/>
							<field name="x_comment"/>
							<field name="x_line_count"/>
						</group>
						<group>
							<field name="x_route_id"/>
							<field name="x_purchase_type"/>
							<field name="x_item_type"/>
							<field name="x_amount"/>
							<field name="x_actual_value"/>
							<field name="x_other_charges"/>
							<field name="x_total_value"/>
							<label for="x_purchase_id"/>
							<div class="o_row">
								<field name="x_purchase_id" widget="many2one"/>
								<button name="create_purchase_order" type="object" string="Create Purchase Order"
										class="oe_highlight" attrs="{'invisible': [('x_purchase_id', '!=', False)]}"/>
							</div>
							<field name="x_consolidation_ids" widget="many2many_tags"/>
							<field name="x_status"/>
						</group>
	                </group>
					<notebook>
						<page string="Cart Lines">
							<div class="o_row">
								<button name="download_cart_xlsx" string="Download Cart (xlsx)" type="object" class="oe_highlight"/>
								<button name="remove_cart_lines" string="Remove Cart Lines"
										type="object" class="oe_highlight"
										confirm="Are you sure you want to remove cart lines?"/>
							</div>
							<field name="x_update_component_status" invisible="1"/>
							<field name="x_component_ids">
								<tree editable="bottom" create="0" delete="0">
									<field name="x_component_id" optional="hide"/>
									<field name="x_proc_cycle_id" invisible="1"/>

									<field name="x_relation"/>
									<field name="x_product_id" widget="many2one"/>
									<field name="x_mounting_type" optional="hide"/>
									<field name="x_description" optional="show"/>

									<field name="x_quantity" sum="Total"/>
									<field name="x_uom_id"/>

									<field name="x_octopart_connector_id" optional="show"/>
									<field name="x_seller_ids" invisible="1"/>
									<field name="x_seller_id"/>
									<field name="x_partner_id"/>
									<field name="x_prc_cart_id"/>

									<field name="x_eoq" sum="Total" readonly="0"/>
									<field name="x_unit_price" optional="show"/>
									<field name="x_ext_price" sum="Total" optional="show"/>
									<field name="x_actual_unit_price"/>
									<field name="x_actual_ext_price" sum="Total"/>
									<field name="x_overspent" widget="percentage" readonly="1" optional="show"/>
								</tree>
							</field>
						</page>
						<page string="Budget Details">
							<field name="x_budget_ids"/>
						</page>
					</notebook>
	            </sheet>
	        </form>
	    </field>
	</record>

	<record id="procurement_cycle_cart_details_view_tree" model="ir.ui.view">
	    <field name="name">procurement_cycle_cart_details_view_tree</field>
	    <field name="model">procurement.cycle.cart.details</field>
	    <field name="arch" type="xml">
	        <tree string="Procurement Cycle Cart Details">
	            <field name="x_proc_cycle_id" invisible="1"/>
	            <field name="x_partner_id"/>
	            <field name="x_name"/>
				<field name="x_journal_id"/>
				<field name="x_route_id"/>
				<field name="x_purchase_type"/>
				<field name="x_item_type"/>
	            <field name="x_purchase_id" widget="many2one"/>
	            <field name="x_amount" sum="Total Amount"/>
				<field name="x_actual_value" sum="Total Amount"/>
				<field name="x_other_charges" sum="Total Amount"/>
				<field name="x_total_value" sum="Total Amount"/>
				<field name="x_consolidation_ids" widget="many2many_tags" optional="hide"/>
	            <field name="x_status" optional="show"/>
	            <field name="x_comment" optional="hide"/>
	            <field name="x_line_count" optional="hide"/>
				<field name="x_tag_ids" widget="many2many_tags" optional="hide"/>
				<field name="x_cart_url" widget="url" optional="hide"/>
	        </tree>
	    </field>
	</record>

	<record id="procurement_cycle_cart_details_view_search" model="ir.ui.view">
	   <field name="name">procurement_cycle_cart_details_view_search</field>
	   <field name="model">procurement.cycle.cart.details</field>
	    <field name="arch" type="xml">
	        <search string="Procurement Cycle Cart Details">
	            <field name="x_name"/>
	            <field name="x_partner_id"/>
				<field name="x_journal_id"/>
	            <field name="x_purchase_id"/>
				<field name="x_consolidation_ids"/>
	            <field name="x_comment"/>
				<field name="x_tag_ids"/>
				<separator/>
				<filter name="cart_on_hold" string="Cart on Hold" domain="[('x_status', '=', 'cart_on_hold')]"/>
				<filter name="cart_ordered" string="Cart Ordered" domain="[('x_status', '=', 'cart_ordered')]"/>
				<filter name="shipped" string="Shipped" domain="[('x_status', '=', 'shipped')]"/>
				<filter name="partially_shipped" string="Partially Shipped" domain="[('x_status', '=', 'partially_shipped')]"/>
				<filter name="received" string="Received" domain="[('x_status', '=', 'received')]"/>
				<group expand="0" string="Group By">
					<filter name="status" string="Status" context="{'group_by': 'x_status'}"/>
					<filter name="purchase_type" string="Purchase Type" context="{'group_by': 'x_purchase_type'}"/>
					<filter name="item_type" string="Item Type" context="{'group_by': 'x_item_type'}"/>
					<filter name="proc_cycle" string="Procurement Cycle" context="{'group_by': 'x_proc_cycle_id'}"/>
				</group>
			</search>
	   </field>
	</record>

	<record id="action_procurement_cycle_cart_details" model="ir.actions.act_window">
	    <field name="name">Cart Details</field>
	    <field name="type">ir.actions.act_window</field>
	    <field name="res_model">procurement.cycle.cart.details</field>
	    <field name="view_mode">tree,form</field>
		<field name="search_view_id" ref="procurement_cycle_cart_details_view_search"/>
		<field name="view_id" ref="procurement_cycle_cart_details_view_tree"/>
	</record>

<!--	Procurement Cycle Budget Details-->
	<record id="procurement_cycle_budget_details__view_form" model="ir.ui.view">
	    <field name="name">procurement_cycle_budget_details__view_form</field>
	    <field name="model">procurement.cycle.budget.details</field>
	    <field name="arch" type="xml">
	        <form string="Procurement Cycle Budget Details">
	            <sheet>
	            	<field name="x_proc_cycle_id" invisible="1"/>
	                <group col="4">
						<field name="x_journal_id"/>
						<field name="x_cart_ids" widget="many2many_tags"/>
						<field name="x_budget"/>
						<field name="x_consumed"/>
						<field name="x_balance"/>
	                </group>
	            </sheet>
	        </form>
	    </field>
	</record>

	<record id="procurement_cycle_budget_details_view_tree" model="ir.ui.view">
	    <field name="name">procurement_cycle_budget_details_view_tree</field>
	    <field name="model">procurement.cycle.budget.details</field>
	    <field name="arch" type="xml">
	        <tree string="Procurement Cycle Budget Details" editable="bottom">
	            <field name="x_proc_cycle_id" invisible="1"/>
				<field name="x_journal_id"/>
				<field name="x_cart_ids" widget="many2many_tags"/>
				<field name="x_budget" sum="Total"/>
				<field name="x_consumed" sum="Total"/>
				<field name="x_balance" sum="Total"/>
	        </tree>
	    </field>
	</record>

<!--	Procurement Cycle-->
	<record id="procurement_cycle_view_form" model="ir.ui.view">
		<field name="name">procurement.cycle.view.form</field>
		<field name="model">procurement.cycle</field>
		<field name="arch" type="xml">
			<form string="Procurement Cycles">
				<header>
					<button name="mark_as_new" type="object" string="Set to New" class="oe_highlight" states="completed,cancel"/>
					<button name="mark_as_done" type="object" string="Mark as Done" class="oe_highlight" states="in_progress"/>
					<button name="mark_as_cancel" type="object" string="Cancel" states="new,in_progress,completed"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,completed"/>
				</header>
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button name="action_view_demand_mos" type="object" class="oe_stat_button" icon="fa-list">
							<span>Manufacturing Orders</span>
						</button>
						<button name="action_view_component_list" type="object" class="oe_stat_button" icon="fa-list">
							<span>PRC Lines</span>
						</button>
						<button name="action_procurement_cycle_cart_details" type="object" class="oe_stat_button" icon="fa-list">
							<span>Carts</span>
						</button>
						<button name="component_list_quantities_action" type="object" class="oe_stat_button" icon="fa-list">
							<span>Cart Lines</span>
						</button>
						<button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="fa-list">
							<span>Purchase Orders</span>
						</button>
						<button name="action_view_receipts" type="object" class="oe_stat_button" icon="fa-list">
							<span>Receipts</span>
						</button>
						<button name="action_view_consolidations" type="object" class="oe_stat_button" icon="fa-list">
							<span>Consolidations</span>
						</button>
					</div>
					<div class="oe_title">
						<h1>
							<field name="x_name" readonly="0"/>
						</h1>
					</div>
					<group col="4">
						<field name="x_tag_ids" widget="many2many_tags"/>
						<field name="x_demand_batch_ids" widget="many2many_tags"/>
						<field name="x_company_id"/>
                        <div class="o_row o_td_label">
                            <label for="x_planned_start_date" string="Planned Date"/>
                        </div>
                        <div class="o_row">
                            <field name="x_planned_start_date"/>
                            <label for="x_planned_finish_date" string="to"/>
                            <field name="x_planned_finish_date"/>
                        </div>
					</group>
					<notebook>
					    <page name="manufacturing_orders" string="Manufacturing Order">
							<div class="o_row">
								<button name="get_demand_batch_mos" type="object" string="Get Demand Batch MOs" class="oe_highlight"/>
							</div>
							<field name="x_manufacturing_ids">
								<tree>
									<field name="name"/>
									<field name="product_id" readonly="1"/>
									<field name="product_qty" sum="Total Qty" string="Quantity" readonly="1"/>
									<field name="x_demand_batch_id"/>
									<field name="x_mrp_demand_ids" widget="many2many_tags"/>
								</tree>
							</field>
					    </page>
						<page name="manual_proc_demand_lines" string="Internal Demand (RM)">
							<div class="o_row">
								<button name="get_manual_proc_demand_lines" type="object" string="Get Internal Demand (RM)" class="oe_highlight"/>
							</div>
							<field name="x_manual_proc_demand_lines_ids">
								<tree create="0" editable="bottom">
									<field name="x_procurement_cycle_id" invisible="1"/>
									<field name="x_manual_proc_demand_id" invisible="1"/>
									<field name="x_user_id"/>
									<field name="x_product_id"/>
									<field name="x_product_qty"/>
									<field name="x_uom_id"/>
									<field name="x_date"/>
									<field name="x_url" widget="url"/>
									<field name="x_note"/>
									<field name="x_status"/>
								</tree>
							</field>
						</page>
						<page name="safety_stock_input" string="Safety Stock">
							<div class="o_row">
								<button name="get_safety_stock_input" type="object"
										string="Get Safety Stock" class="oe_highlight"/>
								<button name="remove_safety_stock_input" type="object"
										string="Remove Safety Stock" class="oe_highlight"
								        confirm="Are you sure you want to remove safety stock?"/>
								<button name="export_safety_stock_input_xlsx" type="object" string="Export List (xlsx)" class="oe_highlight"/>
							</div>
							<group>
								<field name="x_safety_stock_total_price"/>
							</group>
							<field name="x_safety_stock_input_ids">
								<form>
									<sheet>
										<group>
											<group>
												<field name="x_procurement_cycle_id" invisible="1"/>
												<field name="x_taraz_part_id" readonly="1"/>
												<field name="x_description" readonly="1"/>
												<field name="x_product_purchase_packaging_id"/>
												<field name="x_alternate_ids" widget="many2many_tags"/>
												<field name="x_compromised_ids" widget="many2many_tags"/>
												<field name="x_product_id"/>
												<field name="x_product_description"/>
												<field name="x_unit_price"/>
												<field name="x_subtotal"/>
												<field name="x_tag_ids" widget="many2many_tags"/>
											</group>
											<group>
												<field name="x_virtual_available"/>
												<field name="x_backorder_qty"/>
												<field name="x_qty_available"/>
												<field name="x_quantity_buffer"/>
												<field name="x_safety_stock"/>
												<field name="x_reorder_point"/>
												<field name="x_order_quantity" string="Reorder Qty"/>
												<field name="x_roq" string="Bulk Reorder Qty"/>
												<field name="x_quantity"/>
												<field name="x_uom_id"/>
											</group>
										</group>
									</sheet>
								</form>
								<tree editable="bottom">
									<field name="x_procurement_cycle_id" invisible="1"/>
									<field name="x_taraz_part_id"/>
									<field name="x_consider_compromised" optional="hide"/>
									<field name="x_description" optional="hide"/>
									<field name="x_product_purchase_packaging_id" optional="hide"/>
									<field name="x_virtual_available" optional="hide"/>
									<field name="x_backorder_qty" optional="hide"/>
									<field name="x_qty_available" optional="hide"/>
									<field name="x_quantity_buffer" optional="hide"/>
									<field name="x_safety_stock" optional="hide"/>
									<field name="x_reorder_point" optional="hide"/>
									<field name="x_order_quantity" string="Reorder Qty" optional="show"/>
									<field name="x_roq" string="Bulk Reorder Qty" optional="hide"/>
									<field name="x_alternate_ids" widget="many2many_tags" optional="show"/>
									<field name="x_compromised_ids" widget="many2many_tags" optional="show"/>
									<field name="x_product_ids" widget="many2many_tags" optional="hide"/>
									<field name="x_product_id"/>
									<field name="x_product_description" optional="hide"/>
									<field name="x_quantity"/>
									<field name="x_uom_id" optional="hide"/>
									<field name="x_unit_price" optional="hide"/>
									<field name="x_subtotal" sum="Total" optional="hide"/>
									<field name="x_tag_ids" widget="many2many_tags"/>
								</tree>
							</field>
						</page>
						<page name="short_components" string="PRC Lines">
							<div class="o_row">
								<button name="get_short_part_details" type="object" string="Get PRC Lines (Manufacturing)" class="oe_highlight"/>
								<button name="get_short_part_details_im" type="object" string="Get PRC Lines (Internal Demand)" class="oe_highlight"/>
								<button name="get_short_part_details_ss" type="object" string="Get PRC Lines (Safety Stock)" class="oe_highlight"/>
							</div>
							<field name="x_short_component_ids"/>
						</page>
						<page name="cart_details" string="Cart &amp; Budget Details">
							<field name="x_cart_ids" context="{'default_x_proc_cycle_id': active_id}"/>
							<separator colspan="4" string="Budget Details"/>
							<field name="x_budget_ids"/>
						</page>
					</notebook>
				</sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                    <field name="activity_ids" widget="mail_activity"/>
                </div>
			</form>
		</field>
	</record>

	<record id="procurement_cycle_view_list" model="ir.ui.view">
		<field name="name">procurement.cycle.view.list</field>
		<field name="model">procurement.cycle</field>
		<field name="arch" type="xml">
			<tree string="Procurement Cycles">
				<field name="create_date"/>
				<field name="x_name"/>
				<field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
				<field name="x_demand_batch_ids" widget="many2many_tags"/>
				<field name="state"/>
			</tree>
		</field>
	</record>

	<record id="procurement_cycle_view_search" model="ir.ui.view">
		<field name="name">procurement.cycle.view.search</field>
		<field name="model">procurement.cycle</field>
		<field name="arch" type="xml">
			<search string="Procurement Cycles">
				<field name="x_name"/>
				<field name="x_tag_ids"/>
				<field name="x_demand_batch_ids"/>
			</search>
		</field>
	</record>

    <record id="action_procurement_cycle" model="ir.actions.act_window">
		<field name="name">Procurement Cycles</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">procurement.cycle</field>
		<field name="view_mode">tree,form</field>
		<field name="search_view_id" ref="procurement_cycle_view_search"/>
		<field name="view_id" ref="procurement_cycle_view_list"/>
    </record>

	<record id="action_view_procurement_cycle_carts" model="ir.actions.act_window">
		<field name="name">Procurement Cycles Carts</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">procurement.cycle.cart.details</field>
		<field name="view_mode">tree,form</field>
		<field name="context">{"search_default_proc_cycle": 1}</field>
		<field name="domain">[]</field>
		<field name="search_view_id" ref="procurement_cycle_cart_details_view_search"/>
		<field name="view_id" ref="procurement_cycle_cart_details_view_tree"/>
    </record>
</odoo>















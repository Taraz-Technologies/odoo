<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_investors_form" model="ir.ui.view">
		<field name="name">res.investors.form</field>
		<field name="model">res.investors</field>
		<field name="arch" type="xml">
			<form string="Investments">
				<sheet>
                    <field name="x_investment_id" invisible="1"/>
                    <field name="x_currency_id" invisible="1"/>
					<group>
                        <field name="x_date"/>
                        <field name="x_partner_id"/>
                        <field name="x_investment_value" sum="Total Raised"/>
                        <field name="x_invoice_id" widget="many2one"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_investors_tree" model="ir.ui.view">
		<field name="name">res.investors.tree</field>
		<field name="model">res.investors</field>
		<field name="arch" type="xml">
			<tree string="Investments">
                <field name="x_investment_id" invisible="1"/>
                <field name="x_currency_id" invisible="1"/>
                <field name="x_date"/>
                <field name="x_partner_id"/>
                <field name="x_investment_value"/>
                <field name="x_invoice_id"/>
			</tree>
		</field>
	</record>

	<record id="view_investors_filter" model="ir.ui.view">
		<field name="name">res.investors.filter</field>
		<field name="model">res.investors</field>
		<field name="arch" type="xml">
			<search string="Investments">
				<field name="x_partner_id"/>
				<group expand="0" string="Group By">
					<filter string="Investor" name="investor" context="{'group_by': 'x_partner_id'}"/>
					<filter string="Investment" name="investment" context="{'group_by': 'x_investment_id'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="action_view_investors" model="ir.actions.act_window">
		<field name="name">Investors</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">res.investors</field>
		<field name="view_mode">tree,form</field>
		<field name="search_view_id" ref="view_investors_filter"/>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">Create new Record</p>
		</field>
	</record>
</odoo>
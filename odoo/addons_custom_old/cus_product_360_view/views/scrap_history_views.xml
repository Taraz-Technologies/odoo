<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_scrap_tree_view_custom_0" model="ir.ui.view">
        <field name="name">stock.scrap.tree.custom.0</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_tree_view"/>
        <field name="arch" type="xml">
            <data>
                <field name="state" position="before">
                    <field name="x_currency_id" invisible="1"/>
                    <field name="x_cost" widget="monetary" sum="Total" options="{'currency_field': 'x_currency_id'}"/>
                </field>
            </data>
        </field>
    </record>
</odoo>
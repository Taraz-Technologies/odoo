<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!--    Quarterly Consumption Views-->
    <record id="view_quarterly_consumption_form" model="ir.ui.view">
        <field name="name">quarterly.consumption.form</field>
        <field name="model">quarterly.consumption</field>
        <field name="arch" type="xml">
            <form string="Quarterly Consumption">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="x_product_id"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="x_date"/>
                            <label for="x_date_from" string="Period"/>
                            <div class="d-flex">
                                <field name="x_date_from" class="oe_inline"/>
                                -
                                <field name="x_date_to" class="oe_inline"/>
                            </div>
                        </group>
                        <group>
                            <field name="x_quarter"/>
                            <field name="x_quantity"/>
                        </group>
                    </group>
                    <separator colspan="4" string="Consumption History"
                               attrs="{'invisible': [('x_consumption_history_ids', '=', [])]}"/>
                    <field name="x_consumption_history_ids" attrs="{'invisible': [('x_consumption_history_ids', '=', [])]}">
                        <tree>
                            <field name="x_order_id"/>
                            <field name="x_date"/>
                            <field name="x_master_product_id"/>
                            <field name="x_component_id" invisible="1"/>
                            <field name="x_product_uom_qty" sum="Total"/>
                            <field name="x_reserved_availability" sum="Total"/>
                            <field name="x_quantity_done" sum="Total"/>
                            <field name="x_product_uom"/>
                            <field name="x_currency_id" invisible="1"/>
                            <field name="x_unit_cost" widget="monetary" avg="Average"/>
                            <field name="x_cost" widget="monetary" sum="Total" options="{'currency_field': 'x_currency_id'}"/>
                        </tree>
                    </field>
                    <separator colspan="4" string="Sale History"
                               attrs="{'invisible': [('x_sale_order_history_ids', '=', [])]}"/>
                    <field name="x_sale_order_history_ids" attrs="{'invisible': [('x_sale_order_history_ids', '=', [])]}"/>
                    <separator colspan="4" string="Scrap History"
                               attrs="{'invisible': [('x_scrap_history_ids', '=', [])]}"/>
                    <field name="x_scrap_history_ids" attrs="{'invisible': [('x_scrap_history_ids', '=', [])]}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_quarterly_consumption_tree" model="ir.ui.view">
        <field name="name">quarterly.consumption.tree</field>
        <field name="model">quarterly.consumption</field>
        <field name="arch" type="xml">
            <tree string="Quarterly Consumption">
                <field name="x_quarter"/>
                <field name="x_date_from"/>
                <field name="x_date_to"/>
                <field name="x_product_id"/>
                <field name="x_date" invisible="1"/>
                <field name="x_quantity" avg="Average"/>
            </tree>
        </field>
    </record>

    <record id="view_quarterly_consumption_graph" model="ir.ui.view">
        <field name="name">quarterly.consumption.graph</field>
        <field name="model">quarterly.consumption</field>
        <field name="arch" type="xml">
            <graph string="Quarterly Consumption">
                <field name="x_quarter"/>
                <field name="x_quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_quarterly_consumption_search" model="ir.ui.view">
        <field name="name">quarterly.consumption.search</field>
        <field name="model">quarterly.consumption</field>
        <field name="arch" type="xml">
            <search string="Quarterly Consumption">
                <field name="x_product_id"/>
                <field name="x_quarter"/>
				<group col="4" colspan="4" expand="0" string="Group By">
                    <filter string="Products" name="product_id" context="{'group_by':'x_product_id'}"/>
                    <filter string="Quarter" name="quarter" context="{'group_by':'x_quarter'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_quarterly_consumption" model="ir.actions.act_window">
		<field name="name">Quarterly Consumption</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">quarterly.consumption</field>
		<field name="view_mode">tree,form,graph</field>
		<field name="context">{'search_default_quarter': 1}</field>
		<field name="domain">{}</field>
		<field name="search_view_id" ref="view_quarterly_consumption_search"/>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				No History to Show
			</p>
		</field>
    </record>

    <menuitem id="menu_quarterly_consumption"
              name="Quarterly Consumption"
              parent="cus_product_360_view.menu_product_360"
              action="cus_product_360_view.action_quarterly_consumption"
              sequence="1"/>
</odoo>
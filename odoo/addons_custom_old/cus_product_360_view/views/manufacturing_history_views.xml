<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!--    Manufacturing Order Views-->
    <record id="view_mrp_production_form_custom_0" model="ir.ui.view">
        <field name="name">mrp.production.form.custom</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <data>
                <field name="location_dest_id" position="after">
                    <fieds name="x_update_history" invisible="1"/>
                </field>
            </data>
        </field>
    </record>
<!--    Manufacturing History Views-->
    <record id="view_manufacturing_history_form" model="ir.ui.view">
        <field name="name">manufacturing.history.form</field>
        <field name="model">manufacturing.history</field>
        <field name="arch" type="xml">
            <form string="Manufacturing History">
                <sheet>
                    <field name="x_tzp_type" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="x_component_id" attrs="{'invisible': [('x_type', '!=', 'consumption')]}"/>
                            <field name="x_product_id" attrs="{'invisible': [('x_type', '!=', 'manufacturing')]}"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="x_type" invisible="1"/>
                            <field name="x_order_id" widget="many2one"/>
                            <field name="x_date"/>
                            <field name="x_master_product_id" attrs="{'invisible': [('x_type', '!=', 'consumption')]}"/>
                            <field name="x_currency_id" invisible="1"/>
                            <field name="x_unit_cost"/>
                            <field name="x_cost" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                        </group>
                        <group>
                            <field name="x_product_uom_qty" attrs="{'invisible': [('x_type', '!=', 'consumption')]}"/>
                            <field name="x_product_uom_qty" string="Quantity"
                                   attrs="{'invisible': [('x_type', '!=', 'manufacturing')]}"/>
                            <field name="x_reserved_availability" attrs="{'invisible': [('x_type', '!=', 'consumption')]}"/>
                            <field name="x_quantity_done" attrs="{'invisible': [('x_type', '!=', 'consumption')]}"/>
                            <field name="x_product_uom"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_manufacturing_history_tree" model="ir.ui.view">
        <field name="name">manufacturing.history.tree</field>
        <field name="model">manufacturing.history</field>
        <field name="arch" type="xml">
            <tree string="Manufacturing History">
                <field name="x_type" invisible="1"/>
                <field name="x_order_id"/>
                <field name="x_date"/>
                <field name="x_product_id"/>
                <field name="x_master_product_id"/>
                <field name="x_component_id"/>
                <field name="x_currency_id" invisible="1"/>
                <field name="x_product_uom_qty" sum="Total"/>
                <field name="x_reserved_availability" sum="Total"/>
                <field name="x_quantity_done" sum="Total"/>
                <field name="x_product_uom"/>
                <field name="x_unit_cost" avg="Average"/>
                <field name="x_cost" widget="monetary" options="{'currency_field': 'x_currency_id'}" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="view_manufacturing_history_graph" model="ir.ui.view">
        <field name="name">manufacturing.history.graph</field>
        <field name="model">manufacturing.history</field>
        <field name="arch" type="xml">
            <graph string="Manufacturing History">
                <field name="x_order_id"/>
                <field name="x_product_uom_qty" type="measure"/>
                <field name="x_reserved_availability" type="measure"/>
                <field name="x_quantity_done" type="measure"/>
                <field name="x_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_manufacturing_history_search" model="ir.ui.view">
        <field name="name">manufacturing.history.search</field>
        <field name="model">manufacturing.history</field>
        <field name="arch" type="xml">
            <search string="Manufacturing History">
                <field name="x_product_id" string="Product/Component"
                       filter_domain="['|', ('x_product_id', 'ilike', self), ('x_component_id', 'ilike', self)]"/>
                <field name="x_master_product_id"/>
                <field name="x_order_id"/>
                <separator/>
                <filter name="type_1"  string="Consumption" domain="[('x_type', '=', 'consumption')]"/>
                <filter name="type_2"  string="Manufacturing" domain="[('x_type', '=', 'manufacturing')]"/>
				<group col="4" colspan="4" expand="0" string="Group By">
                    <filter string="TZP Type" name="tzp_type" context="{'group_by':'x_tzp_type'}"/>
                    <filter string="Type" name="type" context="{'group_by':'x_type'}"/>
                    <filter string="Products" name="product_id" context="{'group_by':'x_product_id'}"/>
                    <filter string="Master Products" name="master_product_id" context="{'group_by':'x_master_product_id'}"/>
                    <filter string="Components" name="component_id" context="{'group_by':'x_component_id'}"/>
                    <filter string="Manufacturing Order" name="order_id" context="{'group_by':'x_order_id'}"/>
                    <filter string="Date" name="date" context="{'group_by':'x_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_manufacturing_history" model="ir.actions.act_window">
		<field name="name">Manufacturing History</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">manufacturing.history</field>
		<field name="view_mode">tree,form,graph</field>
		<field name="context">{'search_default_type': 1}</field>
		<field name="domain">{}</field>
		<field name="search_view_id" ref="view_manufacturing_history_search"/>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				No History to Show
			</p>
		</field>
    </record>

    <menuitem id="menu_manufacturing_history"
              name="Manufacturing History"
              parent="cus_product_360_view.menu_product_360"
              action="cus_product_360_view.action_manufacturing_history"
              sequence="1"/>
</odoo>
<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--    Weight Database-->
    <record id="view_weight_database_form" model="ir.ui.view">
        <field name="name">weight.database.form</field>
        <field name="model">weight.database</field>
        <field name="arch" type="xml">
            <form string="Weight Database">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name"/>
                        </h1>
                    </div>
                    <group col="6">
                        <field name="x_quantity"/>
                        <field name="x_weight"/>
                        <field name="x_unit_weight"/>
                        <field name="x_description_keyword_01"/>
                        <field name="x_description_keyword_02"/>
                        <field name="x_description_keyword_03"/>
                        <field name="x_description_keyword_04"/>
                        <field name="x_description_keyword_05"/>
                        <field name="x_description_keyword_06"/>
                        <field name="x_description_keyword_07"/>
                        <field name="x_description_keyword_08"/>
                        <field name="x_description_keyword_09"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_weight_database_tree" model="ir.ui.view">
        <field name="name">weight.database.tree</field>
        <field name="model">weight.database</field>
        <field name="arch" type="xml">
            <tree string="Weight Database">
                <field name="display_name"/>
                <field name="x_quantity"/>
                <field name="x_weight"/>
                <field name="x_unit_weight"/>
            </tree>
        </field>
    </record>

    <record id="view_weight_database_search" model="ir.ui.view">
        <field name="name">weight.database.search</field>
        <field name="model">weight.database</field>
        <field name="arch" type="xml">
            <search string="Weight Database">
                <field name="display_name"/>
            </search>
        </field>
    </record>

    <record id="action_weight_database" model="ir.actions.act_window">
		<field name="name">Weight Database</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">weight.database</field>
		<field name="view_mode">tree,form</field>
		<field name="context">{}</field>
		<field name="domain">{}</field>
		<field name="search_view_id" ref="view_weight_database_search"/>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				No content to Show
			</p>
		</field>
    </record>

    <menuitem id="menu_weight_database"
              name="Weight Database"
              parent="stock.menu_product_in_config_stock"
              action="cus_product_360_view.action_weight_database"
              sequence="11"/>
</odoo>
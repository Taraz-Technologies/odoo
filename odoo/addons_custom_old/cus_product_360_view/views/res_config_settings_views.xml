<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_cus_product_360_1" model="ir.ui.view">
            <field name="name">res_config_settings_view_form_cus_product_360_1</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="26"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="Digi-Key API" string="Digi-Key Connector" data-key="digikey_connector">
                        <h2>Digi-Key Connector</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="o_setting_left_pane">
                                <label for="x_authorization_code"/>
                                <span class="text-muted"><br/>Authorization Code expiration time is 1 minutes</span>
                                <field name="x_authorization_code"/>
                                <label for="x_access_token"/>
                                <span class="text-muted"><br/>Access Token expiration time is 30 minutes</span>
                                <field name="x_access_token"/>
                                <label for="x_refresh_token"/>
                                <span class="text-muted"><br/>Refresh Token expiration time is 90 days</span>
                                <field name="x_refresh_token"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
        
        <record id="res_config_settings_view_form_cus_product_360_2" model="ir.ui.view">
            <field name="name">res_config_settings_view_form_cus_product_360_2</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="99"/>
            <field name="inherit_id" ref="stock.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@data-key='stock']/div[hasclass('o_settings_container')]" position="after">
                    <h2>Procurement</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="x_target_rate"/>
                                <div class="text-muted">
                                    Target Rate to maintain Safety Stock (percentage)
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="x_target_rate" class="o_light_label" widget="percentage"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="x_average_lead_time"/>
                                <div class="text-muted">
                                    Average Lead Time to purchase stock (months)
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="x_average_lead_time" class="o_light_label"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="x_calculated_with"/>
                                <div class="text-muted">
                                    Months to calculate Safety Stock
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="x_calculated_with" class="o_light_label"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

                                    <td class="text-right">
                                        <span t-field="o.x_currency_id.symbol"/>
                                        <t t-set="str_value" t-value="str('{0:,.2f}'.format(export_value))"/>
                                        <t t-set="str_value" t-value="str_value.replace('.', '_')"/>
                                        <t t-set="str_value" t-value="str_value.replace(',', '.')"/>
                                        <t t-set="str_value" t-value="str_value.replace('_', ',')"/>

                                            <t t-set="str_value" t-value="str('{0:,.2f}'.format(data_line['column_5']))"/>
                                            <t t-set="str_value" t-value="str_value.replace('.', '_')"/>
                                            <t t-set="str_value" t-value="str_value.replace(',', '.')"/>
                                            <t t-set="str_value" t-value="str_value.replace('_', ',')"/>
                                            <t t-esc="str_value"/>
                                        </td>
                                    </tr>
                                    <t t-set="export_qty" t-value="export_qty + data_line['column_4']"/>
                                    <t t-set="export_value" t-value="export_value + data_line['column_5']"/>
                                </t>
                                <tr style="border-bottom: 0.25px solid black;">
                                    <td class="text-left" colspan="2">
                                        <strong>Total</strong>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="export_qty"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="o.x_currency_id.symbol"/>
                                        <t t-set="str_value" t-value="str('{0:,.2f}'.format(export_value))"/>
                                        <t t-set="str_value" t-value="str_value.replace('.', '_')"/>
                                        <t t-set="str_value" t-value="str_value.replace(',', '.')"/>
                                        <t t-set="str_value" t-value="str_value.replace('_', ',')"/>
                                        <t t-esc="str_value"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <span t-field="o.x_manufacturing_table_text"/>
                    </div>
                    <div name="sales_data_lines">
                        <h4 class="text-right" style="page-break-before:always;"><strong>Annexure-A</strong></h4>
                        <div class="row">
                            <div class="col text-center">
                                <h5>Section XII: Explanations Related to Activity in the Free Zone</h5>
                            </div>
                        </div>
                        <t t-set="sales_data" t-value="report_data['sales_data']"/>
                        <table style="width:100%;margin-top:20px;margin-bottom:20px;">
                            <thead>
                                <tr style="border-bottom: 0.25px solid black; page-break-inside: avoid;">
                                    <th class="text-left" style="font-size: 24px" colspan="2">Goods to be Sold</th>
                                    <th class="text-center" colspan="2">Turkey</th>
                                    <th class="text-center" colspan="2">Abroad</th>
                                </tr>
                                <tr style="border-bottom: 0.25px solid black; page-break-inside: avoid;">
                                    <th class="text-left" style="width:45%;">Name of the Good</th>
                                    <th class="text-left" style="width:15%;">Tariff Number</th>
                                    <th class="text-right" style="width:8%;">Qty</th>
                                    <th class="text-right" style="width:12%;">Value</th>
                                    <th class="text-right" style="width:8%;">Qty</th>
                                    <th class="text-right" style="width:12%;">Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="local_qty" t-value="0"/>
                                <t t-set="local_value" t-value="0"/>
                                <t t-set="export_qty" t-value="0"/>
                                <t t-set="export_value" t-value="0"/>
                                <t t-foreach="sales_data" t-as="data_line">
                                    <tr style="border-bottom: 0.25px solid black;">
                                        <td class="text-left">
                                            <strong t-esc="data_line['column_1']"/><br/>
                                            <t t-esc="data_line['column_2']"/>
                                        </td>
                                        <td class="text-left">
                                            <t t-esc="data_line['column_3']"/>
                                        </td>
                                        <td class="text-right">
                                            <t t-esc="data_line['column_4']"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="o.x_currency_id.symbol"/>
                                            <t t-set="str_value" t-value="str('{0:,.2f}'.format(data_line['column_5']))"/>
                                            <t t-set="str_value" t-value="str_value.replace('.', '_')"/>
                                            <t t-set="str_value" t-value="str_value.replace(',', '.')"/>
                                            <t t-set="str_value" t-value="str_value.replace('_', ',')"/>
                                            <t t-esc="str_value"/>
                                        </td>

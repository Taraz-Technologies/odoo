                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <span t-field="o.x_sale_table_text"/>
                    </div>
                </div>
            </t>
        </template>

        <template id="report_inventory_sale_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="cus_product_360_view.report_inventory_sale_report_document"/>
                </t>
            </t>
        </template>

        <template id="report_inventory_sale_report_products_document">
            <t t-call="web.external_layout">
                <div class="page">
                    <div id="textbox">
                        <h3 style="float: left;"><nobr><strong>Products Portfolio</strong></nobr></h3>
                        <h4 style="float: right;"><strong>Annexure-B</strong></h4><br/>
                    </div>
                    <div style="clear: both;"/>
                    <t t-foreach="o.x_portfolio_products_ids" t-as="product">
                        <div class="row mt16" name="product_info"
                             style="border-bottom: 1px solid gray;page-break-inside: avoid;">
                            <div class="col-8 text-left">
                                <h4><span t-field="product.x_product_id.name"/></h4>
                                <h6>
                                    <strong>Product Description: </strong><br/>
                                    <span t-field="product.x_product_id.description_sale"/><br/>
                                    <strong>HS Code: </strong>
                                    <span t-field="product.x_product_id.x_hs_code_tr_id.x_hs_code"/><br/>
                                    <strong>Sale Price: </strong>
                                    <span t-field="o.x_currency_id.symbol"/>
                                    <t t-set="str_value" t-value="str('{0:,.0f}'.format(product.x_product_id.lst_price))"/>
                                    <t t-set="str_value" t-value="str_value.replace('.', '_')"/>
                                    <t t-set="str_value" t-value="str_value.replace(',', '.')"/>
                                    <t t-set="str_value" t-value="str_value.replace('_', ',')"/>
                                    <span t-esc="str_value"/><br/><br/>
                                </h6>
                            </div>
                            <div class="mb8 col-4 text-right">
                                <image t-field="product.x_product_id.image_1920" t-options='{"widget": "image"}'/>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </template>

        <template id="report_inventory_sale_report_products">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="cus_product_360_view.report_inventory_sale_report_products_document"/>
                </t>
            </t>
        </template>
	</data>
</odoo>
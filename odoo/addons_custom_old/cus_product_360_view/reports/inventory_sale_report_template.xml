                                            <t t-set="str_value" t-value="str('{0:,.2f}'.format(data_line['column_7']))"/>
                                            <t t-set="str_value" t-value="str_value.replace('.', '_')"/>
                                            <t t-set="str_value" t-value="str_value.replace(',', '.')"/>
                                            <t t-set="str_value" t-value="str_value.replace('_', ',')"/>
                                            <t t-esc="str_value"/>
                                        </td>
                                    </tr>
                                    <t t-set="local_qty" t-value="local_qty + data_line['column_4']"/>
                                    <t t-set="local_value" t-value="local_value + data_line['column_5']"/>
                                    <t t-set="export_qty" t-value="export_qty + data_line['column_6']"/>
                                    <t t-set="export_value" t-value="export_value + data_line['column_7']"/>
                                </t>
                                <tr style="border-bottom: 0.25px solid black;">
                                    <td class="text-left" colspan="2">
                                        <strong>Total</strong>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="local_qty"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="o.x_currency_id.symbol"/>
                                        <t t-set="str_value" t-value="str('{0:,.2f}'.format(local_value))"/>
                                        <t t-set="str_value" t-value="str_value.replace('.', '_')"/>
                                        <t t-set="str_value" t-value="str_value.replace(',', '.')"/>
                                        <t t-set="str_value" t-value="str_value.replace('_', ',')"/>

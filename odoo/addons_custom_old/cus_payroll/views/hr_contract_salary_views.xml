<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_contract_salary_view_tree" model="ir.ui.view">
            <field name="name">hr_contract_salary_view_tree</field>
            <field name="model">hr.contract.salary</field>
            <field name="arch" type="xml">
                <tree string="Salary Details" editable="top">
                    <field name="x_contract_id" invisible="1"/>
                    <field name="x_effective_date"/>
                    <field name="x_working_hours_company" widget="float_time" />
                    <field name="x_working_hours_employee" widget="float_time" />
                    <field name="x_currency_id"/>
                    <field name="x_target" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                    <field name="x_factor" widget="percentage"/>
                    <field name="x_wage" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>

<!--                    <field name="x_trans_allowance" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>-->
<!--                    <field name="x_rnd_allowance" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>-->
<!--                    <field name="x_total_salary" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>-->

                    <field name="x_note"/>
                </tree>
            </field>
        </record>

        <record id="hr_contract_salary_view_search" model="ir.ui.view">
           <field name="name">hr_contract_salary_view_search</field>
           <field name="model">hr.contract.salary</field>
            <field name="arch" type="xml">
                <search string="Salary Details">
                    <field name="x_contract_id"/>
                    <field name="x_effective_date"/>
                </search>
           </field>
        </record>

        <record id="salary_details_view_tree" model="ir.ui.view">
            <field name="name">salary_details_view_tree</field>
            <field name="model">salary.details</field>
            <field name="arch" type="xml">
                <tree string="Salary Details">
                    <field name="x_slip_id" invisible="1"/>
                    <field name="x_name"/>
                    <field name="x_category"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="x_amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total"/>
                    <field name="x_currency_id" invisible="1"/>
                    <field name="x_amount_currency" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>
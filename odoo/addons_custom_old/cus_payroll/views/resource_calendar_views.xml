<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="resource_calendar_form_inherit_cus_0" model="ir.ui.view">
        <field name="name">resource.calendar.form.inherit.cus.0</field>
        <field name="model">resource.calendar</field>
		<field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
			<data>
				<group name="resource_details" position="inside">
					<group>
						<field name="x_currency_id" invisible="1"/>
						<field name="x_fine_by"/>
						<label for="x_late_coming_fine"/>
						<div class="d-flex">
							<field name="x_late_coming_fine"/>

							<span class="oe_form_label mx-2" style="white-space:nowrap;"
								  attrs="{'invisible': ['|',('x_late_coming_fine', '=', False),('x_fine_by', '!=', 'amount')]}">Amount</span>
							<field name="x_late_coming_fine_amount" widget="monetary"
								   options="{'currency_field': 'x_currency_id'}"
								   attrs="{'invisible':['|',('x_late_coming_fine', '=', False),('x_fine_by', '!=', 'amount')]}"/>

							<span class="oe_form_label mx-2" style="white-space:nowrap;"
								  attrs="{'invisible': ['|',('x_late_coming_fine', '=', False),('x_fine_by', '!=', 'percentage')]}">Percentage</span>
							<field name="x_late_coming_fine_percentage" widget="percentage"
								   attrs="{'invisible':['|',('x_late_coming_fine', '=', False),('x_fine_by', '!=', 'percentage')]}"/>

							<span class="oe_form_label mx-2" style="white-space:nowrap;"
								  attrs="{'invisible':['|',('x_late_coming_fine', '=', False),('x_fine_by', '=', False)]}">Threshold (Min.)</span>
							<field name="x_minutes" attrs="{'invisible':['|',('x_late_coming_fine', '=', False),('x_fine_by', '=', False)]}"/>
						</div>
						<label for="x_early_going_fine"/>
						<div class="d-flex">
							<field name="x_early_going_fine"/>

							<span class="oe_form_label mx-2" style="white-space:nowrap;"
								  attrs="{'invisible':['|',('x_early_going_fine', '=', False),('x_fine_by', '!=', 'amount')]}">Amount</span>
							<field name="x_early_going_fine_amount" widget="monetary"
								   options="{'currency_field': 'x_currency_id'}"
								   attrs="{'invisible':['|',('x_early_going_fine', '=', False),('x_fine_by', '!=', 'amount')]}"/>

							<span class="oe_form_label mx-2" style="white-space:nowrap;"
								  attrs="{'invisible':['|',('x_early_going_fine', '=', False),('x_fine_by', '!=', 'percentage')]}">Percentage</span>
							<field name="x_early_going_fine_percentage" widget="percentage"
								   attrs="{'invisible':['|',('x_early_going_fine', '=', False),('x_fine_by', '!=', 'percentage')]}"/>
						</div>
					</group>
				</group>
			</data>
		</field>
	</record>

    <record id="view_resource_calendar_tree_inherit_cus_0" model="ir.ui.view">
        <field name="name">resource.calendar.tree.inherit.cus.0</field>
        <field name="model">resource.calendar</field>
		<field name="inherit_id" ref="resource.view_resource_calendar_tree"/>
        <field name="arch" type="xml">
			<data>
				<field name="name" position="after">
					<field name="x_currency_id" invisible="1"/>
					<field name="x_fine_by"/>
					<field name="x_late_coming_fine"/>
					<field name="x_early_going_fine"/>
				</field>
			</data>
		</field>
	</record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_form_cus_payroll" model="ir.ui.view">
            <field name="name">view_employee_form_cus_payroll</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <field name="parent_id" position="before">
                    <field name="x_job_title_id"/>
                    <field name="x_job_level_id"/>
                </field>
                <field name="pin" position="before">
                    <field name="x_leave_allocation"/>
                </field>
                <xpath expr="/form/sheet/notebook/page[2]/div/div/group[4]" position="after">
                    <field name="x_resource_calendar_id" invisible="1"/>
                    <group string="Schedule Log">
                        <field name="x_employee_schedule_log" nolabel="1">
                            <tree>
                                <field name="x_employee_id" invisible="1"/>
                                <field name="x_start_date"/>
                                <field name="x_resource_calendar_id"/>
                            </tree>
                        </field>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="view_employee_tree_customization_0" model="ir.ui.view">
            <field name="name">hr.employee.tree.customization</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="arch" type="xml">
                <data>
                    <field name="work_phone" position="before">
                        <field name="x_leave_allocation"/>
                    </field>
                </data>
            </field>
        </record>
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_contract_form_inherit_cus_payroll" model="ir.ui.view">
            <field name="name">hr.contract.view.form.cus_payroll</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="om_hr_payroll_account.hr_contract_form_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='struct_id']" position="after">
                    <field name="x_loan_structure" required="1"/>
                    <field name="x_bonus_structure" required="1"/>
                </xpath>
                <xpath expr="//field[@name='date_start']" position="after">
                    <field name="x_prohibition_date"/>
                </xpath>
                <xpath expr="//field[@name='advantages']" position="before">
                    <label for="x_skill_increment"/>
                    <div class="o_row">
                        <field name="x_skill_increment"/><span>/ month</span>
                    </div>
                    <label for="x_allowances"/>
                    <div class="o_row">
                        <field name="x_allowances"/><span>/ month</span>
                    </div>
                    <label for="x_increments"/>
                    <div class="o_row">
                        <field name="x_increments"/><span>/ month</span>
                    </div>
                    <label for="x_gross"/>
                    <div class="o_row">
                        <field name="x_gross"/><span>/ month</span>
                    </div>
                    <field name="x_deductions"/>
                    <field name="x_bonus"/>
                </xpath>
                <field name="department_id" position="after">
                    <field name="x_custom_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </field>
                <field name="name" position="attributes">
                    <attribute name="placeholder">Contract Reference = Short Name Code-Date of Joining Code</attribute>
                </field>
                <group name="main_info" position="after">
                    <separator string="Basic Wage Log" colspan="4"/>
                    <field name="x_salary_detail_ids"/>
                    <separator string="Position Level Increments" colspan="4"/>
                    <div class="o_row">
                        <button name="get_job_skill_increment" string="Get Job Skills" type="object" class="oe_highlight"/>
                    </div>
                    <field name="x_skill_increment_ids" context="{'default_x_currency_id': currency_id}"/>
                    <separator string="Allowances" colspan="4"/>
                    <field name="x_allowance_ids" context="{'default_x_currency_id': currency_id}"/>
                    <separator string="Other Increments" colspan="4"/>
                    <field name="x_increment_ids" context="{'default_x_currency_id': currency_id}"/>
                </group>
            </field>
        </record>

        <record id="cus_payroll_hr_contract_view_kanban" model="ir.ui.view">
            <field name="name">cus.payroll.hr.contract.view.kanban</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_kanban"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <br/>
                    <field name="employee_id"/>
                </field>
            </field>
        </record>

        <record id="hr_contract_view_tree" model="ir.ui.view">
            <field name="name">hr.contract.tree</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_tree"/>
            <field name="arch" type="xml">
                <field name="wage" position="replace">
                    <field name="x_gross" sum="total"/>
                </field>
                <field name="kanban_state" position="after">
                    <field name="x_custom_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </field>
            </field>
        </record>

        <record id="hr_contract_view_search_cus_payroll" model="ir.ui.view">
            <field name="name">hr_contract_view_search_cus_payroll</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_search"/>
            <field name="arch" type="xml">
                <data>
                    <field name="name" position="attributes">
                        <attribute name="filter_domain">['|',
                            ('name', 'ilike', self),
                            ('x_custom_tag_ids', 'ilike', self)]
                        </attribute>
                    </field>
                    <filter name="inactive" position="after">
                        <filter name="tagged" string="Tagged" domain="[('x_custom_tag_ids', '!=', False)]"/>
                    </filter>
                    <filter name="group_by_state" position="after">
                        <filter string="Department" name="group_by_dept" domain="[]" context="{'group_by': 'department_id'}"/>
                    </filter>
                </data>
            </field>
        </record>
    </data>
</odoo>
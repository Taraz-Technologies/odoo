<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<menuitem id="menu_hr_bonuses"
			  name="Employee Bonus"
			  action="action_view_hr_bonus"
			  parent="om_hr_payroll.menu_hr_payroll_root"
			  groups="om_hr_payroll.group_hr_payroll_user"
			  sequence="50"/>
<!--	Employee Bonus-->
	<record id="hr_bonus_form_view" model="ir.ui.view">
		<field name="name">hr.bonus.form.view</field>
		<field name="model">hr.bonus</field>
		<field name="arch" type="xml">
			<form string="Employee Bonus">
				<header>
					<field name="x_state" widget="statusbar" statusbar_visible="not_paid,paid"/>
				</header>
				<sheet>
					<widget name="web_ribbon" title="Paid" attrs="{'invisible': [('x_state', '!=', 'paid')]}"/>
					<group col="4">
						<field name="x_employee_id"/>
						<field name="x_payslip_id" readonly="1"/>
						<field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
						<field name="x_currency_id"/>
						<field name="x_due_date"/>
						<field name="x_batch_id"/>
						<field name="x_note"/>
					</group>
					<field name="x_percentage" invisible="1"/>
					<field name="x_salary" invisible="1"/>
					<field name="x_hours" invisible="1"/>
				</sheet>
				<div class="oe_chatter">
					<field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
					<field name="message_ids" widget="mail_thread"/>
					<field name="activity_ids" widget="mail_activity"/>
				</div>
			</form>
		</field>
	</record>

	<record id="hr_bonus_tree_view" model="ir.ui.view">
		<field name="name">hr.bonus.tree.view</field>
		<field name="model">hr.bonus</field>
		<field name="arch" type="xml">
			<tree string="Employee Bonus">
				<field name="x_due_date"/>
				<field name="x_employee_id"/>
				<field name="x_note"/>
				<field name="x_currency_id" invisible="1"/>
				<field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}" sum="Total"/>
				<field name="x_state"/>
				<field name="x_payslip_id"/>
			</tree>
		</field>
	</record>

	<record id="hr_bonus_search_view" model="ir.ui.view">
		<field name="name">hr.bonus.search.view</field>
		<field name="model">hr.bonus</field>
		<field name="arch" type="xml">
			<search string="Employee Bonus">
				<filter name="not_paid" string="Not Paid" domain="[('x_state', '=', 'not_paid')]"/>
				<filter name="paid" string="Paid" domain="[('x_state', '=', 'paid')]"/>
				<group expand="0" string="Group by">
					<filter name="employee" string="Employee" context="{'group_by': 'x_employee_id'}"/>
					<filter name="status" string="Status" context="{'group_by': 'x_state'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="hr_bonus_graph_view" model="ir.ui.view">
		<field name="name">hr.bonus.search.view</field>
		<field name="model">hr.bonus</field>
        <field name="arch" type="xml">
            <graph string="Employee Bonus">
                <field name="x_employee_id"/>
                <field name="x_amount" type="measure"/>
            </graph>
        </field>
    </record>

	<record id="action_view_hr_bonus" model="ir.actions.act_window">
		<field name="name">Employee Bonus</field>
		<field name="res_model">hr.bonus</field>
		<field name="view_mode">tree,graph,form</field>
		<field name="context">{'search_default_employee': 1}</field>
		<field name="search_view_id" ref="hr_bonus_search_view"/>
	</record>

	<menuitem id="menu_hr_bonus"
			  name="Employee Bonus"
			  action="action_view_hr_bonus"
			  parent="cus_payroll.menu_hr_bonuses"
			  groups="om_hr_payroll.group_hr_payroll_user"
			  sequence="1"/>
<!--	Bonus Batch-->
	<record id="hr_bonus_batch_form_view" model="ir.ui.view">
		<field name="name">hr.bonus.batch.form.view</field>
		<field name="model">hr.bonus.batch</field>
		<field name="arch" type="xml">
			<form string="Bonus Batches">
				<header>
					<button name="action_batch_done" string="Mark as Done" type="object" states="draft" class="oe_highlight"/>
					<button name="action_batch_draft" string="Set to Draft" type="object" states="cancel,done"/>
					<button name="action_batch_cancel" string="Cancel" type="object" states="draft"/>
					<field name="state" widget="statusbar" statusbar_visible="draft,done"/>
				</header>
				<sheet>
					<div class="oe_title">
						<label for="x_name" class="oe_edit_only"/>
						<h1>
							<field name="x_name"/>
						</h1>
					</div>
					<group>
						<group>
							<field name="x_payment_date"/>
							<field name="x_split"/>
							<field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
							<label for="x_date_from" attrs="{'invisible': [('x_split', '!=', 'hours')]}"/>
							<div class="d-flex" attrs="{'invisible': [('x_split', '!=', 'hours')]}">
								<field name="x_date_from" string="Period" class="oe_inline" attrs="{'required': [('x_split', '=', 'hours')]}"/>
								<span class="mx-2">-</span>
								<field name="x_date_to" class="oe_inline" attrs="{'required': [('x_split', '=', 'hours')]}"/>
							</div>
							<field name="x_working_hours" widget="float_time" attrs="{'invisible': [('x_split', '!=', 'hours')]}"/>
						</group>
						<group>
							<field name="x_currency_id"/>
							<field name="x_note"/>
							<field name="x_company_id" invisible="1"/>
						</group>
					</group>
					<group col="4">
						<field name="x_bank_id"/>
						<field name="x_cheque_number"/>
						<field name="x_letter_head_report"/>
						<field name="x_amount_in_words"/>
                		<field name="x_date"/>
					</group>
					<separator col="4" string="Bonuses"/>
					<field name="x_bonus_ids" context="{'default_x_due_date': x_payment_date, 'default_x_currency_id': x_currency_id, }">
						<tree editable="bottom">
							<field name="x_due_date"/>
							<field name="x_employee_id"/>
							<field name="x_note"/>
							<field name="x_percentage" attrs="{'column_invisible': [('parent.x_split', '!=', 'percentage')]}"/>
							<field name="x_salary"
								   widget="monetary"
								   options="{'currency_field': 'x_currency_id'}"
								   attrs="{'column_invisible': [('parent.x_split', 'not in', ('salary', 'hours'))]}"
								   sum="Total Salary"/>
							<field name="x_hours" widget="float_time" attrs="{'column_invisible': [('parent.x_split', '!=', 'hours')]}"/>
							<field name="x_currency_id"/>
							<field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}" sum="Total Bonus"/>
							<field name="x_state"/>
						</tree>
					</field>
				</sheet>
				<div class="oe_chatter">
					<field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
					<field name="message_ids" widget="mail_thread"/>
					<field name="activity_ids" widget="mail_activity"/>
				</div>
			</form>
		</field>
	</record>

	<record id="hr_bonus_batch_tree_view" model="ir.ui.view">
		<field name="name">hr.bonus.batch.tree.view</field>
		<field name="model">hr.bonus.batch</field>
		<field name="arch" type="xml">
			<tree string="Bonus Batches">
				<field name="x_payment_date"/>
				<field name="x_name"/>
				<field name="x_currency_id" invisible="1"/>
				<field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}" sum="Total"/>
				<field name="x_note"/>
				<field name="x_split"/>
				<field name="state"/>
			</tree>
		</field>
	</record>

	<record id="hr_bonus_batch_search_view" model="ir.ui.view">
		<field name="name">hr.bonus.batch.search.view</field>
		<field name="model">hr.bonus.batch</field>
		<field name="arch" type="xml">
			<search string="Bonus Batches">
				<filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
				<filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
				<filter name="cancel" string="Cancel" domain="[('state', '=', 'cancel')]"/>
				<group expand="0" string="Group by">
					<filter name="payment_date" string="Payment Date" context="{'group_by': 'x_payment_date'}"/>
					<filter name="status" string="Status" context="{'group_by': 'state'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="action_view_hr_bonus_batch" model="ir.actions.act_window">
		<field name="name">Bonus Batches</field>
		<field name="res_model">hr.bonus.batch</field>
		<field name="view_mode">tree,form</field>
		<field name="search_view_id" ref="hr_bonus_batch_search_view"/>
	</record>

	<menuitem id="menu_hr_bonus_batch"
			  name="Bonus Batches"
			  action="action_view_hr_bonus_batch"
			  parent="cus_payroll.menu_hr_bonuses"
			  groups="om_hr_payroll.group_hr_payroll_user"
			  sequence="2"/>
</odoo>

















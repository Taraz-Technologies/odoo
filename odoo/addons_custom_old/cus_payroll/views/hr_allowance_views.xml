<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
<!--        HR Allowances-->
        <record id="hr_allowance_view_form" model="ir.ui.view">
            <field name="name">hr_allowance_view_form</field>
            <field name="model">hr.allowances</field>
            <field name="arch" type="xml">
                <form string="Allowances">
                    <sheet>
                        <group>
                            <field name="x_date"/>
                            <field name="x_name"/>
                            <field name="x_currency_id"/>
                            <label for="x_target"/>
                            <div class="o_row">
                                <field name="x_target" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                                <span>/ month</span>
                            </div>
                            <field name="x_factor" widget="percentage"/>
                            <label for="x_amount"/>
                            <div class="o_row">
                                <field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                                <span>/ month</span>
                            </div>
                            <field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_allowance_view_tree" model="ir.ui.view">
            <field name="name">hr_allowance_view_tree</field>
            <field name="model">hr.allowances</field>
            <field name="arch" type="xml">
                <tree string="Allowances">
                    <field name="x_date"/>
                    <field name="x_name"/>
                    <field name="x_currency_id"/>
                    <field name="x_target" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                    <field name="x_factor" widget="percentage"/>
                    <field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                    <field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </tree>
            </field>
        </record>

        <record id="hr_allowance_view_search" model="ir.ui.view">
           <field name="name">hr_allowance_view_search</field>
           <field name="model">hr.allowances</field>
            <field name="arch" type="xml">
                <search string="Allowances">
                    <field name="x_name"/>
                    <group expand="0" string="Group By">
                        <filter name="name" string="Name" context="{'group_by': 'x_name'}"/>
                    </group>
                </search>
           </field>
        </record>

        <record id="hr_allowance_action" model="ir.actions.act_window">
            <field name="name">Allowances</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.allowances</field>
            <field name="view_mode">tree,form</field>
        </record>

<!--        HR Increments-->
        <record id="hr_increments_view_form" model="ir.ui.view">
            <field name="name">hr_increments_view_form</field>
            <field name="model">hr.increments</field>
            <field name="arch" type="xml">
                <form string="Increments">
                    <sheet>
                        <group>
                            <field name="x_name"/>
                            <field name="x_description"/>
                            <field name="x_currency_id"/>
                            <field name="x_target" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                            <field name="x_factor" widget="percentage"/>
                            <field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                            <field name="x_status"/>
                            <field name="x_passed_on"/>
                        </group>
                        <separator string="Skills" colspan="4"/>
                        <field name="x_skill_ids">
                            <tree editable="bottom">
                                <field name="x_name"/>
                                <field name="x_description"/>
                                <field name="x_level"/>
                                <field name="x_status"/>
                            </tree>
                            <form>
                                <sheet>
                                    <group col="4">
                                        <field name="x_name"/>
                                        <field name="x_status"/>
                                        <field name="x_level"/>
                                        <field name="x_description"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_increment_view_tree" model="ir.ui.view">
            <field name="name">hr_increment_view_tree</field>
            <field name="model">hr.increments</field>
            <field name="arch" type="xml">
                <tree string="Increments">
                    <field name="x_job_id" invisible="1"/>
                    <field name="x_contract_id" invisible="1"/>
                    <field name="x_name"/>
                    <field name="x_description"/>
                    <field name="x_currency_id"/>
                    <field name="x_target" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                    <field name="x_factor" widget="percentage"/>
                    <field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                    <field name="x_status"/>
                    <field name="x_passed_on"/>
                    <field name="x_skill_ids" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

        <record id="hr_increment_view_search" model="ir.ui.view">
            <field name="name">hr_increment_view_search</field>
            <field name="model">hr.increments</field>
            <field name="arch" type="xml">
                <search string="Increments">
                    <field name="x_name"/>
                    <field name="x_description"/>
                    <group expand="0" string="Group By">
                        <filter name="name" string="Name" context="{'group_by': 'x_name'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="hr_increment_action" model="ir.actions.act_window">
            <field name="name">Increments</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.increments</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
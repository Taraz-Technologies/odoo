<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--        HR Deductions-->
        <record id="hr_deduction_view_form" model="ir.ui.view">
            <field name="name">hr_deduction_view_form</field>
            <field name="model">hr.deductions</field>
            <field name="arch" type="xml">
                <form string="Deductions">
                    <sheet>
                        <group>
                            <group>
                                <field name="x_date"/>
                                <label for="x_date_from" string="Bills Date Range"/>
                                <div class="o_row">
                                    <field name="x_date_from"/>
                                    <span>-</span>
                                    <field name="x_date_to"/>
                                </div>
                                <field name="x_split"/>
                                <field name="x_currency_id"/>
                                <field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                            </group>
                            <group>
                                <field name="x_note"/>
                            </group>
                        </group>
                        <separator colspan="4" string="Residence Bills"/>
                        <field name="x_bill_ids" context="{'search_default_item_type_11': 1}"/>
                        <separator colspan="4" string="Employees"/>
                        <field name="x_compute_deductions" invisible="1"/>
                        <field name="x_deduction_ids">
                            <tree string="Deduction Details" editable="bottom">
                                <field name="x_deduction_id" invisible="1"/>
                                <field name="x_date"/>
                                <field name="x_split"/>
                                <field name="x_bill_ids" widget="many2many_tags"/>
                                <field name="x_employee_id"/>
                                <field name="x_percentage" sum="Total" widget="percentage" attrs="{'column_invisible': [('parent.x_split', '!=', 'percentage')]}"/>
                                <field name="x_share" sum="Total" attrs="{'column_invisible': [('parent.x_split', '!=', 'share')]}"/>
                                <field name="x_gross_salary" sum="Total" attrs="{'column_invisible': [('parent.x_split', '!=', 'salary')]}"/>
                                <field name="x_currency_id" invisible="1"/>
                                <field name="x_deduction_amount" sum="Total" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="x_deduction_id" invisible="1"/>
                                        <field name="x_date"/>
                                        <field name="x_split"/>
                                        <field name="x_bill_ids" widget="many2many_tags"/>
                                        <field name="x_employee_id"/>
                                        <field name="x_gross_salary"/>
                                        <field name="x_percentage" widget="percentage"/>
                                        <field name="x_share"/>
                                        <field name="x_currency_id" invisible="1"/>
                                        <field name="x_deduction_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                        <field name="activity_ids" widget="mail_activity"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="hr_deduction_view_tree" model="ir.ui.view">
            <field name="name">hr_deduction_view_tree</field>
            <field name="model">hr.deductions</field>
            <field name="arch" type="xml">
                <tree string="Deductions">
                    <field name="x_date"/>
                    <field name="x_date_from"/>
                    <field name="x_date_to"/>
                    <field name="x_currency_id" invisible="1"/>
                    <field name="x_amount" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                    <field name="x_bill_ids" widget="many2many_tags"/>
                    <field name="x_deduction_ids" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

        <record id="hr_deduction_view_search" model="ir.ui.view">
            <field name="name">hr_deduction_view_search</field>
            <field name="model">hr.deductions</field>
            <field name="arch" type="xml">
                <search string="Deductions">
                    <field name="x_date"/>
                    <field name="x_bill_ids"/>
                    <field name="x_deduction_ids"/>
                    <group expand="0" string="Group By">
                        <filter name="date" string="Date" context="{'group_by': 'x_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="hr_deduction_action" model="ir.actions.act_window">
            <field name="name">Deductions</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.deductions</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="hr_deduction_menu"
                  name="Employee Deductions"
                  parent="om_hr_payroll.menu_hr_payroll_root"
                  groups="om_hr_payroll.group_hr_payroll_user"
                  action="hr_deduction_action"
                  sequence="49"/>
    </data>
</odoo>
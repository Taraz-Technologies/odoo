<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_wht_return_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: Times New Roman; font-size:16px;font-stretch: expanded;">
                    <t t-esc="doc.compute_fiscal_year_income()"/>
                    <div class="row">
                        <br/>
                        <br/>
                        <br/>
                        <br/>
                        <br/>
                        <br/>
                        <br/>
                        <center><b><h2>TO WHOM IT MAY CONCERN</h2></b></center>
                        <br/>
                        <span>
                            This is to certify that a Withholding Tax has been deducted for the fiscal year
                            <span t-field="doc.x_fiscal_year_start"/> to <span t-field="doc.x_fiscal_year_end"/>
                            against salary of Mr. <span t-field="doc.employee_id.name"/> (CNIC #
                            <span t-field="doc.employee_id.identification_id"/>), the Employee, as detailed below:
                        </span>
                        <style>
                            table, th, td {
                                border: 1px solid black;
                                border-collapse: collapse;
                            }
                        </style>
                        <table class="table table-sm" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th class="text-left"><span>WHT Category</span></th>
                                    <th class="text-left"><span>Taxable Income</span></th>
                                    <th class="text-left"><span>WHT Deducted</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-left"><span t-field="doc.x_wht_category"/></td>
                                    <td class="text-left"><span t-field="doc.x_taxable_income" t-options='{"widget": "monetary", "display_currency": doc.x_currency_id}'/></td>
                                    <td class="text-left"><span t-field="doc.x_wht_deducted" t-options='{"widget": "monetary", "display_currency": doc.x_currency_id}'/></td>
                                </tr>
                            </tbody>
                        </table>
                        <br/>
                        <span>
                            We further certify the timely payment of deducted tax to FBR.
                        </span>
                        <br/>
                        <br/>
                        <br/>
                        <span>
                            <span t-esc="doc.env.user.name"/>
                            <br/>Taraz Technologies (Private) limited
                        </span>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
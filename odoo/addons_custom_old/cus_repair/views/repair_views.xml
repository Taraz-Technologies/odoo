<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_repair_order_form_inherited" model="ir.ui.view">
            <field name="name">view.repair.order.form.inherited</field>
            <field name="model">repair.order</field>
            <field name="inherit_id" ref="repair.view_repair_order_form"/>
            <field name="arch" type="xml">
                <header>
<!--                    <button name="action_create_delivery"  type="object" string="Create DO" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'done')]}"/>-->
                    <button name="%(stock.act_stock_return_picking)d"  type="action" string="Create DO" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'done')]}"/>
                </header>
                <field name="product_id" position="replace">
                    <field name="x_repair_type" widget="radio" string="Repair Type"/>
                    <field name="product_id" string="Product" domain="[('type', 'in', ['product', 'consu'])]"
                           attrs="{'invisible': [('x_repair_type', '!=', 'single')]}"/>
                    <field name="x_product_ids" string="Products" attrs="{'invisible': [('x_repair_type', '!=', 'multiple')]}" widget="many2many_tags"/>
                    <field name="x_sale_order_id" string="Sale Order"/>
<!--                    <field name="x_compute_pickings" invisible="1"/>-->
                </field>
                <xpath expr="/form/sheet/notebook" position="before">
                    <separator string="Returns" attrs="{'invisible': [('x_sale_order_id', '=', False)]}"/>
                        <field name="x_stock_picking_ids" attrs="{'invisible': [('x_sale_order_id', '=', False)]}"/>
                    <separator string="Products" attrs="{'invisible': [('x_sale_order_id', '=', False)]}"/>
                        <field name="x_move_line_ids" attrs="{'invisible': [('x_sale_order_id', '=', False)]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
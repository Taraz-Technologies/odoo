<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="view_sale_order_form_cus_0" model="ir.ui.view">
		<field name="name">sale.order.form.cus.0</field>
		<field name="model">sale.order</field>
		<field name="inherit_id" ref="sale.view_order_form"/>
		<field name="arch" type="xml">
			<data>
				<xpath expr="//button[@name='action_confirm'][1]" position="before">
					<button name="create_crm_lead" string="Create CRM Lead" type="object" class="btn-primary"
							attrs="{'invisible': [('opportunity_id', '!=', False)]}"/>
				</xpath>
				<div class="oe_title" position="before">
					<widget name="web_ribbon" title="Invalid" bg_color="bg-danger"
							attrs="{'invisible': ['|',('x_show_invalid_flag', '=', False),
							('state', 'not in', ['draft', 'sent'])]}"/>
					<field name="x_show_invalid_flag" invisible="1"/>
				</div>
				<field name="payment_term_id" position="after">
					<field name="x_crm_stage_id"/>
				</field>
				<field name="opportunity_id" position="after">
					<field name="x_update_crm_lead_stage" invisible="1"/>
					<field name="x_update_crm_lead_name" invisible="1"/>
					<field name="x_update_crm_lead_values" invisible="1"/>
				</field>
				<field name="pricelist_id" position="after">
					<label for="x_currency_rate" string="Currency Rate"
						   attrs="{'invisible':[('pricelist_id', 'in', [1, 2])]}"/>
					<div attrs="{'invisible':[('pricelist_id', 'in', [1, 2])]}" class="d-flex">
						<field name="x_currency_symbol" class="oe_inline"/>
						<field name="x_currency_rate" class="oe_inline" readonly="0"/>
						at
						<field name="x_currency_date" class="oe_inline"/>
					</div>
					<field name="x_fluctuation_limit" attrs="{'invisible':[('pricelist_id', 'in', [1, 2])]}"/>
				</field>
				<xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='price_unit']"
					   position="before">
					<field name="x_unit_price_usd"
						   attrs="{'column_invisible': [('parent.pricelist_id', 'in', [1, 2])]}"/>
					<field name="x_subtotal_usd" optional="hide"/>
				</xpath>
			</data>
		</field>
	</record>

	<record id="view_sale_order_form_cus_1" model="ir.ui.view">
		<field name="name">sale.order.form.cus.1</field>
		<field name="model">sale.order</field>
		<field name="inherit_id" ref="customizations.view_sale_order_form_customization"/>
		<field name="arch" type="xml">
			<data>
				<field name="x_attach_short_terms" position="before">
					<field name="x_show_fluctuation_remark" readonly="0"/>
					<field name="x_fluctuation_remark" invisible="1"/>
				</field>
				<field name="x_estimated_profit_margin" position="after">
					<field name="x_total_amount_usd" attrs="{'invisible':[('pricelist_id', 'in', [1, 2])]}"/>
					<field name="x_fluctuated_amount_usd" attrs="{'invisible':[('pricelist_id', 'in', [1, 2])]}"/>
					<field name="x_fluctuated_amount_per" attrs="{'invisible':[('pricelist_id', 'in', [1, 2])]}"/>
				</field>
			</data>
		</field>
	</record>

	<record model="ir.actions.act_window" id="crm_lead_action_pipeline_sale_order">
		<field name="name">Pipeline</field>
		<field name="res_model">crm.lead</field>
		<field name="view_mode">kanban,tree,graph,pivot,form,calendar,activity</field>
		<field name="domain">[('type','=','opportunity')]</field>
		<field name="context">{
				'default_type': 'opportunity',
				'search_default_active': 1,
		}</field>
		<field name="search_view_id" ref="crm.view_crm_case_opportunities_filter"/>
	</record>

	<menuitem id="menu_sale_order_crm_lead"
			  name="CRM Leads"
			  parent="sale.sale_menu_root"
			  action="cus_crm_sale_order_linking.crm_lead_action_pipeline_sale_order"
			  sequence="8"/>

	<menuitem id="menu_sale_order_crm_lead"
			  name="CRM Leads"
			  parent="base.menu_board_root"
			  action="cus_crm_sale_order_linking.crm_lead_action_pipeline_sale_order"
			  sequence="5"/>

	<menuitem id="menu_sale_order_project_task"
			  name="SO Tracking"
			  parent="base.menu_board_root"
			  action="customizations.act_sale_order_project_task_all"
              groups="sales_team.group_sale_salesman"
			  sequence="5"/>
</odoo>

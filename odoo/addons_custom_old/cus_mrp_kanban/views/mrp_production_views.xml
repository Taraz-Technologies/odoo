<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_production_tree_view_cus_mrp_kanban" model="ir.ui.view">
            <field name="name">mrp_production_tree_view_cus_mrp_kanban</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="default_order">date_deadline</attribute>
                </xpath>
                <field name="date_planned_start" position="before">
                    <field name="x_need_attention" invisible="1"/>
                    <field name="date_deadline"/>
                </field>
            </field>
        </record>

        <record id="mrp_production_kanban_view_cus_mrp_kanban" model="ir.ui.view">
            <field name="name">mrp_production_kanban_view_cus_mrp_kanban</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_kanban_view"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban" position="attributes">
                    <attribute name="default_group_by">x_stage_id</attribute>
                    <attribute name="default_order">date_deadline</attribute>
                </xpath>
                <xpath expr="//field[@name='activity_state']" position="after">
                    <field name="x_stage_id" options='{"group_by_tooltip": {"x_description": "Description"}, "fold_field": "fold"}'/>
                    <field name="x_bom_tool_id"/>
                    <field name="x_bom_tool_status"/>
                    <field name="workorder_ids"/>
                    <field name="user_id"/>
                    <field name="x_need_attention"/>
                    <field name="x_bom_tool_days_not_defined"/>
                    <field name="x_bom_tool_days_to_be_review"/>
                    <field name="x_bom_tool_days_defined"/>
                    <field name="x_mrp_demand_ids"/>
                </xpath>
                <xpath expr="//div[@class='o_kanban_record_top']" position="after">
                    <div class="o_kanban_record_body">
                        <table style="width:100%;">
                            <tr style="width:100%; border-bottom: 1px solid black;">
                                <td style="width:30%;text-align:left;"><t t-esc="record.x_bom_tool_id.value"/></td>
                                <td style="width:10%;text-align:right;"><t t-esc="record.x_bom_tool_days_not_defined.value"/></td>
                                <td style="width:10%;text-align:right;"><t t-esc="record.x_bom_tool_days_to_be_review.value"/></td>
                                <td style="width:10%;text-align:right;"><t t-esc="record.x_bom_tool_days_defined.value"/></td>
                                <td style="width:40%;text-align:right;"><t t-esc="record.x_bom_tool_status.value"/></td>
                            </tr>
                        </table>
                        <table style="width:100%;">
                            <t t-foreach="record.workorder_ids.raw_value" t-as="order">
                                <tr style="width:100%; border-bottom: 1px solid black;">
                                    <td style="width:25%;text-align:left;"><t t-esc="order.x_code"/></td>
                                    <td style="width:15%;text-align:right;"><t t-esc="order.x_duration_expected_days"/></td>
                                    <td style="width:15%;text-align:right;"><t t-esc="order.x_duration_days"/></td>
                                    <td style="width:20%;text-align:right;"><t t-esc="order.state"/></td>
                                    <td style="width:13%;text-align:right;">
                                        <t t-if="order.user_id">
                                            <img t-att-src="kanban_image('res.users', 'image_128', order.user_id)"
                                                 t-att-title="order.user_id.value"
                                                 t-att-alt="order.user_id.value"
                                                 class="oe_kanban_avatar"
                                                 style="width: 20px;height: auto;"/>
                                        </t>
                                    </td>
                                    <td style="width:12%;text-align:right;">
                                        <t t-if="order.x_need_attention">
                                            <span class="fa fa-exclamation-triangle" style="color: orange;"/>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </table>
                        <field name="x_mrp_demand_ids" widget="form.many2many_tags"/>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="view_mrp_production_filter_cus_mrp_kanban" model="ir.ui.view">
            <field name="name">view_mrp_production_filter_cus_mrp_kanban</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
            <field name="arch" type="xml">
                <filter name="filter_cancel" position="after">
                    <separator/>
                    <filter string="BoM is Defined" name="bom_defined" domain="[('x_bom_tool_status', '=', 'defined')]"/>
                    <filter string="BoM not Defined" name="bom_not_defined" domain="[('x_bom_tool_status', '=', 'not_defined')]"/>
                    <filter string="BoM to be review" name="bom_to_be_reviewed" domain="[('x_bom_tool_status', '=', 'to_be_review')]"/>
                    <separator/>
                    <filter string="Need Attention!" name="need_attention" domain="[('x_need_attention', '!=', False)]"/>
                </filter>
            </field>
        </record>

        <record id="action_mrp_production_kanban_view_cus_mrp_kanban" model="ir.actions.act_window">
            <field name="name">Manufacturing Orders</field>
            <field name="res_model">mrp.production</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="view_id" ref="mrp_production_kanban_view_cus_mrp_kanban"/>
            <field name="context">{
                "search_default_group_by_x_stage_id": 1,
                "search_default_todo": 1,
            }</field>
        </record>

        <menuitem id="menu_mrp_production_kanban_cus_mrp_kanban"
                  name="MO Kanban"
                  parent="mrp.menu_mrp_root"
                  action="action_mrp_production_kanban_view_cus_mrp_kanban"
                  sequence="100"/>
    </data>
</odoo>
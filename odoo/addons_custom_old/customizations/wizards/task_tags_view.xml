<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_tags_wizard_form" model="ir.ui.view">
        <field name="name">task.tags.wizard.form</field>
        <field name="model">task.tags</field>
        <field name="arch" type="xml">
            <form string="Task Tags">
                <group>
                    <field name="x_task_id"/>
                    <field name="x_tag_ids" widget="form.many2many_tags" options="{'color_field': 'color'}"/>
                </group>
                <footer>
                    <button name="update_task_tags" string="Save" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window id="action_update_task_tags"
                name="Update Task Tags"
                res_model="task.tags"
                binding_model="project.task"
                binding_views="list"
                view_mode="form"
                target="new"/>
</odoo>
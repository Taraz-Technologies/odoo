<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_order_shipping_view_form" model="ir.ui.view">
        <field name="name">purchase.order.shipping.form</field>
        <field name="model">purchase.order.shipping</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="x_order_id" invisible="1"/>
                        <field name="x_carrier_id"/>
                        <field name="x_shipping_cost"/>
                        <field name="x_product_id"/>
                    </group>
                </group>
                <footer>
                    <button name="button_confirm" type="object" string="Update" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mailing_list_contact_wizard_form" model="ir.ui.view">
        <field name="name">mailing.list.contact.wizard.form</field>
        <field name="model">mailing.list.contact</field>
        <field name="arch" type="xml">
            <form string="Recipients">
                <group>
                    <field name="x_mailing_list_id"/>
                    <field name="x_mailing_list_contact_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_add_contact_to_mailing_list" string="Add" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window id="mailing_list_contact_add_action"
                name="Add Recipients in Recipient List"
                res_model="mailing.list.contact"
                binding_model="mailing.contact"
                binding_views="list"
                view_mode="form"
                target="new"/>
</odoo>
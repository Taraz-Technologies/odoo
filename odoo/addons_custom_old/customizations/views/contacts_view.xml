<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_partner_form_customization_0">
        <field name="name">res.partner.form.customization</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="1000"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="x_region" invisible="1"/>
                    <field name="x_subregion" invisible="1"/>
                    <field name="x_partner_type"/>
                    <field name="x_distributor"
                           attrs="{'invisible': [('x_partner_type','!=', 'Customer')]}"/>
                    <field name="x_define_vendor_code"
                           attrs="{'invisible': [('x_partner_type','!=', 'Vendor')]}"/>
                    <field name="x_vendor_code" placeholder="e.g. DK for Digikey"
                           attrs="{'invisible': [('x_define_vendor_code','=', False)],'required': [('x_define_vendor_code','=', True)]}"/>
                    <field name="x_vendor_counter"
                           attrs="{'invisible': [('x_define_vendor_code','=', False)],'required': [('x_define_vendor_code','=', True)]}"/>
                    <field name="x_vendor_type"
                           attrs="{'invisible': [('x_define_vendor_code','=', False)],'required': [('x_define_vendor_code','=', True)]}"/>
                </xpath>
                <xpath expr="/form/sheet/group" position="after">
                    <group attrs="{'invisible': ['|',('x_partner_type','!=', 'Customer'),('company_type','!=', 'company')]}">
                        <group>
                            <field name="x_customer_status"/>
                            <field name="x_company_type"/>
                            <field name="x_company_revenue" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="x_company_size" placeholder="No. of employees"/>
                        </group>
                        <group>
                            <field name="total_invoiced" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="x_interest_ids" widget="many2many_tags"/>
                            <field name="x_update_company_data" invisible="1"/>
                            <field name="x_interested_product_ids" widget="many2many_tags"/>
                            <field name="x_purchased_product_ids" widget="many2many_tags"/>
                            <field name="x_logo_added"/>
                        </group>
                    </group>
                    <group attrs="{'invisible': ['|',('x_partner_type','!=', 'Customer'),('company_type','!=', 'person')]}">
                        <separator string="Company's Data" colspan="4"/>
                        <group attrs="{'invisible': [('parent_id','=', False)]}">
                            <field name="x_customer_status_comp"/>
                            <field name="x_distributor_comp"/>
                            <field name="x_company_type_comp"/>
                            <field name="x_company_revenue_comp" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="x_company_size_comp"/>
                        </group>
                        <group attrs="{'invisible': [('parent_id','=', False)]}">
                            <field name="x_total_invoiced_comp" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="x_interest_ids_comp" widget="many2many_tags"/>
                            <field name="x_interested_product_ids_comp" widget="many2many_tags"/>
                            <field name="x_purchased_product_ids_comp" widget="many2many_tags"/>
                            <field name="x_logo_added_comp"/>
                        </group>
                        <separator string="Person's Data" colspan="4"/>
                        <group>
                            <field name="x_mailing_contact_id"/>
                            <field name="x_exclude_from_newsletter"/>
                            <field name="x_customer_status"/>
                            <field name="x_customer_group_id"/>
                            <field name="x_team_lead_id" placeholder="Team Lead" attrs="{'invisible': [('x_team_member_ids','!=', [])]}"/>
                            <field name="x_team_lead_text" attrs="{'invisible': ['|',('x_team_lead_id','!=', False),('x_team_member_ids','=', [])]}"/>
                            <field name="x_team_member_ids" invisible="1"/>
                            <field name="x_engagement"/>
                        </group>
                        <group>
                            <field name="total_invoiced" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="x_interest_ids" widget="many2many_tags"/>
                            <field name="x_interested_product_ids" widget="many2many_tags"/>
                            <field name="x_purchased_product_ids" widget="many2many_tags"/>
                            <field name="x_mailing_list_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//field[@name='function']" position="before">
                    <field name="x_contact_name" invisible="1"/>
                    <field name="x_quickbooks_name"/>
                </xpath>
                <xpath expr="//field[@name='phone']" position="attributes">
                    <attribute name="attrs">{'invisible': [('company_type','=', 'company')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='mobile']" position="attributes">
                    <attribute name="attrs">{'invisible': [('company_type','=', 'company')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='email']" position="attributes">
                    <attribute name="attrs">{'invisible': [('company_type','=', 'company')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='type']" position="after">
                    <field name="x_company" attrs="{'invisible': ['|', ('company_type','=','company'), ('type','!=', 'delivery')]}"/>
                </xpath>
                <xpath expr="//field[@name='child_ids']/form[1]/sheet[1]/group[1]/group[1]/field[@name='name']" position="after">
                    <field name="x_company" attrs="{'invisible': [('type','!=', 'delivery')]}"/>
                </xpath>
                <xpath expr="//field[@name='child_ids']/form[1]/sheet[1]/group[1]/group[1]/field[@name='name']" position="after">
                    <field name="title" attrs="{'invisible': [('type','=', 'contact')]}"/>
                    <field name="function" attrs="{'invisible': [('type','=', 'contact')]}"/>
                </xpath>
                <xpath expr="//field[@name='child_ids']/form[1]/sheet[1]/group[1]/group[2]/field[@name='mobile']" position="after">
                    <field name="x_partner_type"/>
                    <field name="x_customer_group_id"/>
                    <field name="x_team_lead_id" placeholder="Team Lead" attrs="{'invisible': [('x_team_member_ids','!=', [])]}"/>
                    <field name="x_team_lead_text" attrs="{'invisible': [('x_team_lead_id','!=', False)]}"/>
                    <field name="x_team_member_ids" invisible="1"/>
                    <field name="x_engagement"/>
                    <field name="x_interest_ids" widget="many2many_tags"/>
                    <field name="x_interested_product_ids" widget="many2many_tags"/>
                    <field name="x_purchased_product_ids" widget="many2many_tags"/>
                </xpath>
                <page name="internal_notes" position="after">
                    <page name="testimonials" string="Testimonials">
                        <field name="x_testimonial_ids">
                            <form>
                                <sheet>
                                    <group>
                                        <field name="x_partner_id"/>
                                        <field name="x_date"/>
                                        <field name="x_product_id"/>
                                        <field name="x_url" widget="url"/>
                                        <field name="x_attachment"/>
                                        <field name="x_description"/>
                                        <field name="x_quotes"/>
                                    </group>
                                </sheet>
                            </form>
                            <tree editable="bottom">
                                <field name="x_partner_id" invisible="1"/>
                                <field name="x_date"/>
                                <field name="x_product_id"/>
                                <field name="x_url" widget="url"/>
                                <field name="x_attachment"/>
                                <field name="x_description"/>
                                <field name="x_quotes"/>
                            </tree>
                        </field>
                    </page>
                    <page name="customers" string="Customers" attrs="{'invisible': [('x_distributor','=', False)]}">
                        <field name="x_customer_ids">
                            <tree>
                                <field name="name"/>
                                <field name="parent_id" string="Company"/>
                                <field name="country_id"/>
                                <field name="x_customer_status"/>
                            </tree>
                        </field>
                    </page>
                </page>
            </data>
        </field>
    </record>

    <record model="ir.ui.view" id="view_partner_tree_customization">
        <field name="name">res.partner.tree.customization</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='country_id']" position="after">
                    <field name="x_contact_name" invisible="1"/>
                    <field name="x_region" optional="hide"/>
                    <field name="x_subregion" optional="hide"/>
                    <field name="x_customer_group_id" optional="hide"/>
                    <field name="x_team_lead_id" optional="hide"/>
                    <field name="function" optional="hide"/>
                    <field name="x_customer_status" optional="hide"/>
                    <field name="x_company_type" optional="hide"/>
                    <field name="x_company_revenue" optional="hide"/>
                    <field name="x_company_size" optional="hide"/>
                    <field name="website" optional="hide"/>
                    <field name="x_interest_ids" widget="many2many_tags" optional="hide"/>
                    <field name="x_interested_product_ids" widget="many2many_tags" optional="hide"/>
                    <field name="x_purchased_product_ids" widget="many2many_tags" optional="hide"/>
                    <field name="x_interest_ids_comp" widget="many2many_tags" optional="hide"/>
                    <field name="x_interested_product_ids_comp" widget="many2many_tags" optional="hide"/>
                    <field name="x_purchased_product_ids_comp" widget="many2many_tags" optional="hide"/>
                    <field name="x_logo_added" optional="hide"/>
                    <field name="x_mailing_list_ids" widget="many2many_tags" optional="hide"/>
                    <field name="x_engagement" optional="hide"/>
                </xpath>
            </data>
        </field>
    </record>

    <record model="ir.ui.view" id="view_res_partner_filter_customization">
        <field name="name">res.partner.select.customization</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="x_interested_product_ids"
                           filter_domain="['|', ('x_interested_product_ids', 'ilike', self), ('x_interested_product_ids_comp', 'ilike', self)]"/>
                    <field name="x_purchased_product_ids"
                           filter_domain="['|', ('x_purchased_product_ids', 'ilike', self), ('x_purchased_product_ids_comp', 'ilike', self)]"/>
                </xpath>
                <filter name="inactive" position="after">
                    <separator/>
                    <filter string="Excluded from Newsletter" name="excluded_from_newsletter" domain="[('x_exclude_from_newsletter', '=', True)]"/>
                    <separator/>
                    <filter string="Distributor" name="distributor" domain="[('x_distributor', '=', True)]"/>
                </filter>
                <xpath expr="//filter[@name='group_country']" position="after">
                    <filter name="customer_group" string="Customer Department" context="{'group_by': 'x_customer_group_id'}"/>
                    <filter name="customer_status" string="Customer Status" context="{'group_by': 'x_customer_status'}"/>
                    <filter name="customer_region" string="Customer Region" context="{'group_by': 'x_region'}"/>
                    <filter name="customer_subregion" string="Customer Sub-region" context="{'group_by': 'x_subregion'}"/>
                </xpath>
            </data>
        </field>
    </record>

    <record model="ir.ui.view" id="view_res_country_tree_customization_0">
        <field name="name">res.country.tree.customization</field>
        <field name="model">res.country</field>
        <field name="inherit_id" ref="base.view_country_tree"/>
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='code']" position="after">
                    <field name="x_region"/>
                    <field name="x_subregion"/>
                    <field name="x_dhl_import_zone"/>
                    <field name="x_dhl_export_zone"/>
                    <field name="x_ups_import_zone"/>
                    <field name="x_ups_export_zone"/>
                </xpath>
            </data>
        </field>
    </record>

    <record model="ir.ui.view" id="view_res_country_form_customization_0">
        <field name="name">res.country.form.customization</field>
        <field name="model">res.country</field>
        <field name="inherit_id" ref="base.view_country_form"/>
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='code']" position="after">
                    <field name="x_region"/>
                    <field name="x_subregion"/>
                    <field name="x_currency_id" invisible="1"/>
                    <field name="x_emergency_situation_surcharge" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                </xpath>
                <xpath expr="//field[@name='vat_label']" position="after">
                    <field name="x_dhl_import_zone"/>
                    <field name="x_dhl_export_zone"/>
                    <field name="x_ups_import_zone"/>
                    <field name="x_ups_export_zone"/>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
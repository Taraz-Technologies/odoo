<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_line_form_customization_0" model="ir.ui.view">
        <field name="name">account.move.line.form.customization</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <data>
                <field name="account_id" position="after">
                    <field name="x_account_tags" widget="many2many_tags"/>
                    <field name="x_account_type" invisible="1"/>
                    <field name="x_account_group" invisible="1"/>
                    <field name="x_account_group_name" invisible="1"/>
                    <field name="x_deprecated" invisible="1"/>
                    <field name="x_quickbooks_name" invisible="1"/>
                    <field name="x_exclude_from_dashboard" invisible="1"/>
                    <field name="x_date_dashboard" invisible="1"/>
                </field>
                <field name="date_maturity" position="after">
                    <field name="x_fiscal_year"/>
                    <field name="x_move_journal_id"/>
                    <field name="x_invoice_journal_id"/>
                </field>
                <field name="product_id" position="after">
                    <field name="sale_line_ids" widget="many2many_tags" readonly="False"/>
                </field>
                <field name="move_id" position="after">
                    <field name="payment_id" readonly="1"/>
                </field>
                <xpath expr="//page[2]" position="after">
                    <page string="Product Details">
                        <group col="4">
                            <field name="product_id"/>
                            <field name="x_product_group"/>
                            <field name="x_product_series_code"/>
                            <field name="x_product_series"/>
                            <field name="x_product_division_code"/>
                            <field name="x_product_division"/>
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="view_move_tree_customization_0" model="ir.ui.view">
        <field name="name">account.move.tree.customization</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <data>
                <field name="name" position="before">
                    <button name="open_record" string="Edit" type="object" icon="fa-edit"/>
                </field>
                <xpath expr="//field[@name='amount_total_signed']" position="after">
                    <field name="amount_total" string="Amount Currency" optional="show" sum="Total Amount"/>
                </xpath>
            </data>
        </field>
    </record>

    <record id="view_account_move_line_filter_customization_0" model="ir.ui.view">
        <field name="name">account.move.line.filter.customization</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//filter[@name='groupby_date']" position="before">
                    <filter string="Fiscal Year" name="groupby_fiscal_year" context="{'group_by': 'x_fiscal_year'}"/>
                    <filter string="Quickbook Data" name="groupby_quickbook_name"
                            context="{'group_by': 'x_quickbooks_name'}"/>
                </xpath>
                <xpath expr="//filter[@name='date']" position="after">
                    <separator/>
<!--                    After July-->
<!--                    <filter string="Current Fiscal Year" name="current_fiscal_year"-->
<!--                            domain="[('date', '&lt;', (context_today() + relativedelta(years=1)).strftime('%%Y-07-01')), ('date','&gt;=', time.strftime('%%Y-07-01'))]"/>-->
<!--                    <filter string="Previous Fiscal Year" name="previous_fiscal_year"-->
<!--                            domain="[('date', '&gt;=', (context_today() - relativedelta(years=1)).strftime('%%Y-07-01')), ('date', '&lt;', time.strftime('%%Y-07-01'))]"/>-->
<!--                    Before July-->
                    <filter string="Current Fiscal Year" name="current_fiscal_year"
                            domain="[('date', '&gt;=', (context_today() - relativedelta(years=1)).strftime('%%Y-07-01')), ('date','&lt;', time.strftime('%%Y-07-01'))]"/>
                    <filter string="Previous Fiscal Year" name="previous_fiscal_year"
                            domain="[('date', '&gt;=', (context_today() - relativedelta(years=2)).strftime('%%Y-07-01')), ('date', '&lt;', (context_today() - relativedelta(years=1)).strftime('%%Y-07-01'))]"/>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
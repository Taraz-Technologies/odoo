<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="mrp_production_form_view_customization_0" model="ir.ui.view">
		<field name="name">mrp.production.form.customization</field>
		<field name="model">mrp.production</field>
		<field name="inherit_id" ref="mrp.mrp_production_form_view"/>
		<field name="priority" eval="99" />
		<field name="arch" type="xml">
			<data>
				<xpath expr="//div[hasclass('oe_button_box')]" position="inside">
					<field name="x_task_id" invisible="1"/>
					<button string="Task"
							name="action_view_task"
							type="object"
							class="oe_stat_button"
							icon="fa-tasks"
							attrs="{'invisible': [('x_task_id', '=', False)]}"/>
				</xpath>
				<xpath expr="//field[@name='bom_id']" position="after">
					<field name="x_stencil"/>
				</xpath>
				<field name="origin" position="after">
					<field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
				</field>
				<xpath expr="//page[3]" position="after">
					<page string="Manufacturing Task" name="manufacturing_task" invisible="1">
						<div class="o_row">
							<button string="Refresh" name="update_task_data" type="object" class="oe_highlight" groups="base.group_user"/>
						</div>
						<group>
							<group>
								<field name="x_task_name"/>
								<field name="x_start_task_on"/>
								<field name="x_deadline"/>
								<field name="x_notes"/>
								<field name="x_processes" widget="many2many_tags"/>
							</group>
							<group>
								<field name="x_user_responsible"/>
								<field name="x_user_participants" widget="many2many_tags"/>
								<field name="x_user_observers" widget="many2many_tags"/>
							</group>
						</group>
						<group>
							<group string="Task Conditions">
								<field name="x_pcb_sides"/>
								<field name="x_assembly_type"/>
								<field name="x_placement_type"/>
								<field name="x_acrylic_exist"/>
								<field name="x_local_procurement"/>
								<field name="x_outdoor_fabrication"/>
								<field name="x_product_group"/>
								<field name="x_product_series"/>
								<field name="x_product_division"/>
								<field name="x_product_category"/>
							</group>
							<group string="Task Fields">
								<field name="x_task_name"/>
								<field name="x_project"/>
								<field name="x_description"/>
								<field name="x_checklist"/>
								<field name="x_responsible_person"/>
								<field name="x_participants" widget="many2many_tags"/>
								<field name="x_observers" widget="many2many_tags"/>
								<field name="x_start_task_on"/>
								<field name="x_deadline"/>
								<field name="x_processes" widget="many2many_tags"/>
							</group>
						</group>
						<group string="Sub Tasks">
							<field name="x_tasks" nolabel="1"/>
						</group>
						<group string="Checklist">
							<field name="x_checklist_items" nolabel="1"/>
						</group>
					</page>
					<page string="Journal Entries" name="journal_entries">
						<group>
							<field name="x_unit_cost"/>
						</group>
						<separator string="Product Journal Entry" colspan="4"/>
						<field name="x_product_journal_entry"/>
						<separator string="Raw Material Journal Entries" colspan="4"/>
						<field name="x_raw_journal_entries"/>
					</page>
				</xpath>
			</data>
		</field>
	</record>

	<record id="mrp_production_tree_view_customization_0" model="ir.ui.view">
		<field name="name">mrp.production.tree.customization</field>
		<field name="model">mrp.production</field>
		<field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
		<field name="arch" type="xml">
			<data>
				<field name="origin" position="before">
					<field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
				</field>
			</data>
		</field>
	</record>

	<record id="mrp_production_search_view_customization_0" model="ir.ui.view">
		<field name="name">mrp.production.search.customization</field>
		<field name="model">mrp.production</field>
		<field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
		<field name="arch" type="xml">
			<data>
				<field name="origin" position="after">
					<field name="x_tag_ids"/>
				</field>
				<filter name="activities_exception" position="after">
					<separator/>
					<filter name="categ_03"  string="Semi Finished Goods [SFG]" domain="[('product_id.categ_id','ilike','Inventory / Semi Finished Goods')]"/>
					<filter name="categ_04"  string="Finished Goods-IP-TypeA" domain="[('product_id.categ_id','=','Inventory / Finished Goods-IP-TypeA (20% , 5%) [FG]')]"/>
					<filter name="categ_05"  string="Finished Goods-IP-TypeB" domain="[('product_id.categ_id','=','Inventory / Finished Goods-IP-TypeB (10% , 3%) [FG]')]"/>
					<filter name="categ_06"  string="Finished Goods-IP-TypeC" domain="[('product_id.categ_id','=','Inventory / Finished Goods-IP-TypeC (5% , 1%) [FG]')]"/>
					<filter name="categ_07"  string="Finished Goods-TP-TypeA" domain="[('product_id.categ_id','=','Inventory / Finished Goods-TP-TypeA (0% , 5%) [FG]')]"/>
					<filter name="categ_08"  string="Finished Goods-TP-TypeB" domain="[('product_id.categ_id','=','Inventory / Finished Goods-TP-TypeB (0% , 3%) [FG]')]"/>
					<filter name="categ_09"  string="Finished Goods-TP-TypeC" domain="[('product_id.categ_id','=','Inventory / Finished Goods-TP-TypeC (0% , 1%) [FG]')]"/>
					<filter name="categ_10"  string="Finished Goods-TP-TypeD" domain="[('product_id.categ_id','=','Inventory / Finished Goods-TP-TypeD (0% , 0%) [FG]')]"/>
				</filter>
			</data>
		</field>
	</record>
</odoo>
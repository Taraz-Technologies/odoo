<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_company_form_customization_0" model="ir.ui.view">
                <field name="name">res.company.form.customization</field>
                <field name="model">res.company</field>
                <field name="inherit_id" ref="base.view_company_form"/>
                <field name="priority" eval="99" />
                <field name="arch" type="xml">
                        <data>
                                <xpath expr="//group[@name='social_media']" position="before">
                                        <group name="settings" string="Company Setting">
                                                <field name="resource_calendar_id"/>
                                                <field name="resource_calendar_ids" widget="many2many_tags"/>
                                                <field name="transfer_account_id"/>
                                                <field name="anglo_saxon_accounting"/>
                                        </group>
                                </xpath>
                        </data>
                </field>
        </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_customization_0" model="ir.ui.view">
        <field name="name">account.move.form.customization</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <data>
                <button name='action_post' position="before">
                    <button name="generate_invoice_number" string="Generate" class="oe_highlight" type="object"
                            attrs="{'invisible': ['|', '|', ('type', '!=', 'out_invoice'), ('x_sale_tax_invoice_number', '!=', False), ('company_id', '!=', 1)]}"/>
                </button>
                <button name="action_post" position="attributes">
                    <attribute name="attrs">{'invisible': ['|',('state', '!=', 'draft'),'&amp;','&amp;',('x_sale_tax_invoice_number', '=', False),('type', '=', 'out_invoice'),('company_id', '=', 1)]}</attribute>
                </button>
                <button name="preview_invoice" position="attributes">
                    <attribute name="attrs">{'invisible': ['|','&amp;',('type', 'not in', ('out_invoice', 'out_refund')),('x_sale_tax_invoice_number', '=', False),('company_id', '=', 1)]}</attribute>
                </button>
                <field name="id" position="before">
                    <field name="x_medical_limit_exceed" invisible="1"/>
                    <widget name="web_ribbon" title="Exceeded" bg_color="bg-danger" attrs="{'invisible': [('x_medical_limit_exceed', '!=', True)]}"/>
                </field>
                <field name='name' position="after">
                    <div>
                        <h1>
                            <field name="x_sale_tax_invoice_number" readonly="1" attrs="{'invisible': ['|', ('type', '!=', 'out_invoice'), ('company_id', '!=', 1)]}"/>
                        </h1>
                    </div>
                </field>
                <div class='o_td_label' position="before">
                    <field name="x_customer_id" attrs="{'invisible': ['|',('x_sale_type', '=', 'Investment'),('type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>
                </div>
                <field name='partner_shipping_id' position="after">
                    <field name="x_end_user_id" attrs="{'invisible': ['|',('x_sale_type', '=', 'Investment'),('type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>
                    <field name="x_update_partner_data" invisible="1"/>
                </field>
                <field name='ref' position="attributes">
                    <attribute name="nolabel">1</attribute>
                </field>
                <field name='ref' position="before">
                    <div class="o_td_label">
                        <label for="ref" string="Customer Reference"
                               attrs="{'invisible': [('type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>
                        <label for="ref" string="Vendor Reference"
                               attrs="{'invisible': [('type', 'not in', ('in_invoice', 'in_refund', 'in_receipt'))]}"/>
                        <label for="ref" string="Reference" attrs="{'invisible': [('type', 'not in', ('entry'))]}"/>
                    </div>
                </field>
                <field name='ref' position="after">
                    <field name="x_web_order_number"
                           attrs="{'invisible': ['|',('x_sale_type', '=', 'Investment'),('type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>
<!--                    <field name="purchase_id" attrs="{'invisible': ['|',-->
<!--                                                ('purchase_id','=', False),-->
<!--                                                ('type', 'not in', ('in_invoice', 'in_refund', 'in_receipt'))-->
<!--                                                ]}"/>-->
                    <field name="x_sale_order" readonly="1" attrs="{'invisible': [('x_sale_order','=', False)]}"/>
                    <field name="x_so_payment_state" invisible="1"/>
                    <field name="x_so_pt_id" attrs="{'invisible': [('x_sale_order','=', False)]}"/>
                    <field name="x_purchase_type"
                           attrs="{
                                               'invisible': ['|', ('type', 'not in', ('in_invoice', 'in_refund', 'in_receipt')), ('company_id', '!=', 1)],
                                               'required': [('type', 'in', ('in_invoice', 'in_refund')), ('company_id', '=', 1)]
                                               }"/>
                    <field name="x_item_type"
                           attrs="{
                                               'invisible': ['|', ('type', 'not in', ('in_invoice', 'in_refund', 'in_receipt')), ('company_id', '!=', 1)],
                                               'required': [('type', 'in', ('in_invoice', 'in_refund')), ('company_id', '=', 1)]
                                               }"/>
                    <field name="x_related_so_s" widget="many2many_tags" force_save="1" readonly="0"
                           attrs="{
                                               'invisible':[('x_purchase_type','!=','Shipping (Export)')],
                                               'required':[('x_purchase_type','=','Shipping (Export)')]
                                               }"/>
                    <field name="x_related_po_s" widget="many2many_tags"
                           attrs="{'invisible':[('x_item_type','!=','Landed Cost'), ('company_id', '=', 1)]}"/>
                    <field name="x_import_method"
                           attrs="{
                                               'invisible': ['|', ('type', 'not in', ('in_invoice', 'in_refund', 'in_receipt')), ('x_purchase_type','!=','Clearing')],
                                               'required':[('x_purchase_type','=','Clearing')]
                                               }"/>
                    <field name="x_weboc_gd"
                           attrs="{'invisible': ['|','|', ('type', 'not in', ('in_invoice', 'in_refund', 'in_receipt')), ('x_purchase_type','=','Imported Goods'), ('x_import_method','!=','WeBoc')]}"/>
                    <field name="x_assessed_value"
                           attrs="{'invisible': ['|','|', ('type', 'not in', ('in_invoice', 'in_refund', 'in_receipt')), ('x_purchase_type','=','Imported Goods'), ('x_import_method','=',False)]}"/>
                    <field name="x_employee"
                           attrs="{
                                               'invisible': ['|',('x_item_type', '!=', 'Medical'),('type', 'not in', ('in_invoice', 'in_refund', 'in_receipt'))],
                                               'required': ['&amp;',('type', 'in', ('in_invoice', 'in_refund')),('x_item_type', '=', 'Medical')]
                                               }"/>
                    <field name="x_medical_bill_type"
                           attrs="{
                                               'invisible': ['|',('x_item_type', '!=', 'Medical'),('type', 'not in', ('in_invoice', 'in_refund', 'in_receipt'))],
                                               'required': ['&amp;',('type', 'in', ('in_invoice', 'in_refund')),('x_item_type', '=', 'Medical')]
                                               }"/>
                    <field name="x_relation"
                           attrs="{
                                               'invisible': ['|',('x_item_type', '!=', 'Medical'),('type', 'not in', ('in_invoice', 'in_refund', 'in_receipt'))],
                                               'required': ['&amp;',('type', 'in', ('in_invoice', 'in_refund')),('x_item_type', '=', 'Medical')]
                                               }"/>
                    <field name="x_support_doc"
                           attrs="{
                                                'invisible': ['|', ('company_id', '=', 2), ('type', 'not in', ('in_invoice', 'in_refund', 'in_receipt'))],
                                                'required': ['&amp;',('type', 'in', ('in_invoice', 'in_refund')),('x_item_type', '=', 'Medical')]
                                                }"/>
                    <field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </field>
                <field name="invoice_date" position="attributes">
                    <attribute name="attrs">{'invisible': [('type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))],
                        'required': [('type', 'in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}</attribute>
                </field>
                <field name='date' position="after">
                    <field name="invoice_incoterm_id" position="move"/>
                </field>
                <field name='invoice_incoterm_id' position="attributes">
                    <attribute name="attrs">{'invisible': ['|',
                        ('type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))
                        ]}</attribute>
                </field>
                <field name='currency_id' position="after">
                    <field name="x_payment_method"
                           attrs="{'invisible': [('type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}"/>
                    <field name="x_sale_type_turkey"
                           attrs="{'invisible': ['|', ('type', 'not in', ('out_invoice', 'out_refund', 'out_receipt')), ('company_id','!=',2)],
                           'required': [('type', 'in', ('out_invoice', 'out_refund', 'out_receipt')), ('company_id','=',2)]}"/>
                    <field name="x_sale_type"
                           attrs="{'invisible': ['|', ('type', 'not in', ('out_invoice', 'out_refund', 'out_receipt')), ('company_id','!=',1)],
                           'required': [('type', 'in', ('out_invoice', 'out_refund', 'out_receipt')), ('company_id','=',1)]}"/>
                    <field name="x_gst_return_filed"
                           attrs="{'invisible': ['|', '|', ('type', 'not in', ('out_invoice', 'out_refund', 'out_receipt')),
                           ('x_sale_type','not in', ('Domestic Goods / Official', 'Domestic Services / Official')), ('company_id','!=',1)]}"/>
                    <field name="x_export"
                           attrs="{'invisible': ['|', '|', ('x_sale_type', '=', 'Investment'),
                           ('type', 'not in', ('out_invoice', 'out_refund', 'out_receipt')), ('company_id','!=',1)]}"/>
                    <field name="x_comments"
                           attrs="{'invisible': [('type', 'not in', ('in_invoice', 'in_refund', 'in_receipt'))]}"/>
                    <field name="x_delivery_method"
                           attrs="{'invisible': ['|',('x_sale_type', '=', 'Investment'),('type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>
                    <field name="x_registered_payments"
                           attrs="{'invisible': [('type', 'not in', ('in_invoice', 'in_refund', 'in_receipt','out_invoice', 'out_refund', 'out_receipt'))]}"/>
                    <field name="x_tracking_reference"
                           attrs="{'invisible': ['|',('x_sale_type', '=', 'Investment'),('type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>
                </field>
                <field name='invoice_cash_rounding_id' position="after">
                    <field name="x_fiscal_year"/>
                    <field name="x_old_number" attrs="{'invisible': [('type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>
                </field>
                <page id='other_tab' position="inside">
                    <group>
                        <group>
                            <field name="x_exclude_from_dashboard" groups="base.group_erp_manager"/>
                            <field name="x_date_dashboard" groups="base.group_erp_manager"/>
                        </group>
                    </group>
                </page>
                <page id='other_tab_entry' position="inside">
                    <group>
                        <group>
                            <field name="x_exclude_from_dashboard" groups="base.group_erp_manager"/>
                            <field name="x_date_dashboard" groups="base.group_erp_manager"/>
                        </group>
                    </group>
                </page>
                <page id='other_tab' position="after">
                    <page string="Invoices" name="invoices_tab"
                          attrs="{'invisible': ['|',('x_sale_type', '=', 'Investment'),('type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}">
                        <div class="o_row">
                            <button string="Refresh" name="update_invoice_data" type="object" class="oe_highlight"/>
                        </div>
                        <group>
                            <group>
                                <field name="x_show_bill_to"/>
                                <field name="x_show_customer"/>
                                <field name="x_is_invoice" attrs="{'invisible': [('company_id', '!=', 2)]}"/>
                                <field name="x_hide_customer"/>
                                <field name="x_hide_product"/>
                                <field name="x_hide_discount"/>
                                <field name="x_hide_gst"/>
                                <field name="x_letter_head_report"/>
                                <field name="x_partial_weboc"/>
                                <field name="x_show_first_invoice"/>
                            </group>
                            <group>
                                <field name="x_show_ship_to"/>
                                <field name="x_show_end_user"/>
                                <field name="x_invoice_docs_number" attrs="{'invisible': [('company_id', '!=', 2)]}"/>
                                <field name="x_attach_short_terms"/>
                                <field name="x_attach_long_terms"/>
                                <field name="x_hs_code_and_coo"/>
                                <field name="x_distributor_order"/>
                                <field name="x_appear_taraz_invoice_number"/>
                                <field name="x_appear_payment_method"/>
                                <field name="x_invoice_id"/>
                                <field name="x_landed_cost_line_exist" invisible="1"/>
<!--                                <field name="x_compute_invoice_lines" invisible="1"/>-->
                            </group>
                        </group>
                        <div class="o_row">
	                        <button string="Banking Invoice"
                                    name="%(customizations.action_custom_report_invoice_banking)d"
                                    type="action" class="oe_highlight"
	                                attrs="{'invisible': [('x_partial_weboc', '=', False)]}"/>
                        </div>
                        <field name="x_invoice_lines" widget="section_and_note_one2many" mode="tree">
                            <tree string="Invoice Line" editable="bottom">
                                <control>
                                    <create name="add_line_control" string="Add a line"/>
                                    <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                    <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                                </control>
                                <field name="display_type" invisible="1"/>
                                <field name="product_id"/>
                                <field name="name" widget="section_and_note_text"/>
                                <field name="quantity"/>
                                <field name="product_uom_id"/>
                                <field name="unit_price"/>
                                <field name="discount"/>
                                <field name="tax_ids" widget="many2many_tags"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="price_subtotal" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </tree>
                        </field>
                        <!-- Totals (only invoices / receipts) -->
                        <group name="note_group" col="6">
                            <group colspan="4">
                                <field name="x_remarks" nolabel="1" placeholder="Terms and conditions..."/>
                            </group>
                            <group class="oe_subtotal_footer oe_right" colspan="2" name="invoice_total">
                                <field name="x_amount_untaxed"/>
                                <field name="x_amount_gst" colspan="2" attrs="{'invisible': [('x_amount_gst', '=', 0)]}"/>
                                <field name="x_amount_gst_withheld" colspan="2" attrs="{'invisible': [('x_amount_gst_withheld', '=', 0)]}"/>
                                <field name="x_amount_it_withheld" colspan="2" attrs="{'invisible': [('x_amount_it_withheld', '=', 0)]}"/>
                                <field name="x_amount_receivable" colspan="2" invisible="1"/>
                                <field name="x_amount_total" class="oe_subtotal_footer_separator"/>
                                <field name="x_invoice_payments_widget" colspan="2" nolabel="1" widget="payment"/>
                                <field name="x_amount_residual" class="oe_subtotal_footer_separator" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                            </group>
                            <div class="oe_clear"/>
                        </group>
                        <field name="invoice_outstanding_credits_debits_widget"
                            class="oe_invoice_outstanding_credits_debits"
                            colspan="2" nolabel="1" widget="payment"
                            attrs="{'invisible': ['|', ('state', '!=', 'posted'), ('type', 'in', ('out_receipt', 'in_receipt'))]}"/>
                        <group>
                            <group>
                                <field name="x_appear_pt_table"/>
                                <field name="x_appear_paypal_link"/>
                                <field name="x_appear_banking_details"/>
                                <field name="x_bank"/>
                            </group>
                            <group>
                                <field name="x_hide_payable"/>
                                <field name="x_appear_gst_withheld"/>
                                <field name="x_appear_it_withheld"/>
                                <field name="x_with_payments"/>
                                <field name="x_payment_number"/>
                            </group>
                        </group>
                        <!-- Internal note -->
                        <field name="narration" placeholder="Add an internal note..." nolabel="1" height="50"/>
                    </page>
                    <page string="Sale Tax Invoice" name="sale_tax_invoice_tab"
                          attrs="{'invisible': ['|',('type', 'not in', ('out_invoice', 'out_refund', 'out_receipt')),
                          ('x_sale_type', 'not in', ('Domestic Goods / Official', 'Domestic Services / Official'))]}">
                        <group>
                            <group>
                                <field name="x_hide_sti_product"/>
                                <field name="x_hide_sti_description"/>
                                <field name="x_hide_sti_remarks"/>
                                <field name="x_hide_sti_gst_breakup"/>
                                <field name="x_hide_sti_total_breakup"/>
                            </group>
                            <group>
                                <field name="x_sti_date"/>
                                <field name="x_sti_remarks"/>
                            </group>
                        </group>
                        <button string="Refresh" name="on_change_invoice_line_ids" type="object" class="oe_highlight"/>
                        <field name="x_sale_tax_invoice_line_ids" nolabel="1">
                            <tree create="0" editable="bottom">
                                <field name="invoice_id" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="product_id"/>
                                <field name="name"/>
                                <field name="quantity"/>
                                <field name="product_uom_id"/>
                                <field name="price_unit" widget="monetary"/>
                                <field name="discount"/>
                                <field name="tax_ids" widget="many2many_tags"/>
                                <field name="price_subtotal" widget="monetary"/>
                            </tree>
                        </field>
                        <group class="oe_subtotal_footer" attrs="{'invisible': [('type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}">
                            <field name="amount_untaxed"/>
                            <field name="amount_by_group" widget="tax-group-custom-field" nolabel="1" colspan="2"/>
                            <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            <field name="amount_residual" class="oe_subtotal_footer_separator" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                        </group>
                    </page>
                </page>
            </data>
        </field>
    </record>

    <record id="view_invoice_graph" model="ir.ui.view">
        <field name="name">account.invoice.graph</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <graph string="Invoices">
                <field name="partner_id"/>
                <field name="amount_total_signed" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_invoice_tree_customization_0" model="ir.ui.view">
        <field name="name">account.invoice.tree.customization</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <data>
                <field name="name" position="before">
                    <button name="open_record" string="Edit" type="object" icon="fa-edit"/>
                </field>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="x_sale_type" optional="show"
                           invisible="context.get('default_type') not in ('out_invoice', 'out_refund','out_receipt')"/>
                </xpath>
                <xpath expr="//field[@name='invoice_origin']" position="before">
                    <field name="x_purchase_type" optional="show"
                           invisible="context.get('default_type') not in ('in_invoice', 'in_refund','in_receipt')"/>
                    <field name="x_item_type" optional="show"
                           invisible="context.get('default_type') not in ('in_invoice', 'in_refund','in_receipt')"/>
                    <field name="x_related_po_s" widget="many2many_tags" optional="show"
                           invisible="context.get('default_type') not in ('in_invoice', 'in_refund','in_receipt')"/>
                    <field name="x_related_so_s" widget="many2many_tags" optional="show"
                           invisible="context.get('default_type') not in ('in_invoice', 'in_refund','in_receipt')"/>
                </xpath>
                <xpath expr="//field[@name='invoice_origin']" position="after">
                    <field name="x_sale_tax_invoice_number" optional="show"
                           invisible="context.get('default_type') not in ('out_invoice', 'out_refund','out_receipt')"/>
                    <field name="x_payment_method" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='state']" position="before">
                    <field name="x_assessed_value" optional="show" sum="Total Assessed Value"
                           invisible="context.get('default_type') not in ('in_invoice', 'in_refund','in_receipt')"/>
                </xpath>
                <xpath expr="//field[@name='amount_total_signed']" position="after">
                    <field name="amount_untaxed" string="Untaxed Amount" sum="Total" optional="show"/>
                    <field name="amount_tax" string="Tax" sum="Total" optional="hide"/>
                    <field name="amount_total" string="Total" sum="Total" optional="show"/>
                    <field name="amount_residual" string="Amount Due" sum="Amount Due" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='state']" position="after">
                    <field name="x_registered_payments" optional="show"/>
                    <field name="x_export" optional="show"/>
                </xpath>
            </data>
        </field>
    </record>

    <record id="view_account_invoice_filter_customization_0" model="ir.ui.view">
        <field name="name">account.invoice.filter.customization</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <data>
                <field name="name" position="attributes">
                    <attribute name="filter_domain">[
                                '|', '|' , '|', '|', '|', '|',
                                ('name', 'ilike', self),
                                ('invoice_origin', 'ilike', self),
                                ('ref', 'ilike', self),
                                ('invoice_payment_ref', 'ilike', self),
                                ('partner_id', 'child_of', self),
                                ('x_sale_tax_invoice_number', 'ilike', self),
                                ('x_tag_ids', 'ilike', self),
                        ]</attribute>
                </field>
                <field name="partner_id" position="after">
                    <field name="x_tag_ids"/>
                    <field name="x_product_id"/>
                    <field name="x_analytic_account_id"/>
                    <field name="x_analytic_tag_ids"/>
                </field>
                <xpath expr="//filter[@name='status']" position="after">
                    <filter string="Fiscal Year" name="groupby_fiscal_year" domain="[]" context="{'group_by': 'x_fiscal_year'}"/>
                    <filter string="Sale Type" name="groupby_sale_type" domain="[]" context="{'group_by': 'x_sale_type'}"/>
                    <filter string="Currency" name="groupby_currency" domain="[]" context="{'group_by': 'currency_id'}"/>
                </xpath>
                <xpath expr="//filter[@name='late']" position="after">
                    <separator/>
<!--                    After July-->
<!--                    <filter string="Current Fiscal Year" name="current_fiscal_year"-->
<!--                            domain="[('invoice_date', '&lt;', (context_today() + relativedelta(years=1)).strftime('%%Y-07-01')), ('invoice_date','&gt;=', time.strftime('%%Y-07-01'))]"/>-->
<!--                    <filter string="Previous Fiscal Year" name="previous_fiscal_year"-->
<!--                            domain="[('invoice_date', '&gt;=', (context_today() - relativedelta(years=1)).strftime('%%Y-07-01')), ('invoice_date', '&lt;', time.strftime('%%Y-07-01'))]"/>-->
<!--                    Before July-->
                    <filter string="Current Fiscal Year" name="current_fiscal_year"
                            domain="[('invoice_date', '&gt;=', (context_today() - relativedelta(years=1)).strftime('%%Y-07-01')), ('invoice_date','&lt;', time.strftime('%%Y-07-01'))]"/>
                    <filter string="Previous Fiscal Year" name="previous_fiscal_year"
                            domain="[('invoice_date', '&gt;=', (context_today() - relativedelta(years=2)).strftime('%%Y-07-01')), ('invoice_date', '&lt;', (context_today() - relativedelta(years=1)).strftime('%%Y-07-01'))]"/>
                    <separator/>
                    <filter name="sale_type_1" string="Investment" domain="[('x_sale_type', '=', 'Investment')]"/>

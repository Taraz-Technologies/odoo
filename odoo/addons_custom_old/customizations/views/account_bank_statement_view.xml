<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_statement_form_customization_0" model="ir.ui.view">
        <field name="name">account.bank.statement.form.customization</field>
        <field name="model">account.bank.statement</field>
        <field name="inherit_id" ref="account.view_bank_statement_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//button[@name='action_bank_reconcile_bank_statements']" position="after">
                    <button name="update_general_ledger_items" string="Update GL Balance" type="object"/>
                </xpath>
                <xpath expr="//field[@name='accounting_date']" position="after">
                    <field name="x_status" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='line_ids']/tree[1]" position="attributes">
                    <attribute name="decoration-danger">x_date_mismatch</attribute>
                </xpath>
                <xpath expr="//field[@name='line_ids']/tree[1]/field[@name='journal_entry_ids']" position="after">
                    <field name="x_date_mismatch" invisible="1"/>
                </xpath>
                <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='statement_line_ids']/field[@name='line_ids']/tree[1]"
                       position="after">
                    <form string="Statement Line" create="false">
                        <group>
                            <group>
                                <field name="statement_id" invisible="1"/>
                                <field name="partner_id"/>
                                <field name="journal_currency_id" invisible="1"/>
                                <field name="note"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="ref"/>
                                <field name="amount"/>
                                <field name="sequence" invisible="1"/>
                                <field name="transaction_type"/>
                            </group>
                        </group>
                        <field name="name"/>
                        <separator colspan="4" string="Invoices / Bills"/>
                        <field name="x_invoice_ids" force_save="1"/>
                        <separator colspan="4" string="Payments / Internal Transfers"/>
                        <field name="x_payment_ids" force_save="1" nolabel="1">
                            <tree>
                                <button name="open_record" string="Edit" type="object" icon="fa-edit"/>
                                <field name="payment_date"/>
                                <field name="name" optional="hide"/>
                                <field name="journal_id" optional="hide"/>
                                <field name="destination_journal_id" optional="hide"/>
                                <field name="communication"/>
                                <field name="partner_id" optional="hide"/>
                                <field name="amount" sum="Total"/>
                                <field name="state" invisible="1"/>
                            </tree>
                        </field>
                        <separator colspan="4" string="Journal Entries"/>
                        <field name="x_journal_entries" force_save="1"/>
                    </form>
                </xpath>
                <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='statement_line_ids']" position="after">
                    <page name="general_ledger_items" string="General Ledger">
                        <group>
                            <group>
                                <field name="x_gl_starting_balance" string="GL Starting Balance"/>
                                <field name="x_gl_ending_balance" string="GL Ending Balance"/>
                            </group>
                            <group>
                                <label for="x_date_from" string="Period"/>
                                <div>
                                    <field name="x_date_from" class="oe_inline"/>
                                    -
                                    <field name="x_date_to" class="oe_inline"/>
                                </div>
                                <field name="x_difference" string="Difference with GL"/>
                            </group>
                        </group>
                        <field name="x_general_ledger_item_ids">
                            <tree decoration-muted="x_payment_status" limit="500">
                                <field name="date" optional="hide"/>
                                <field name="move_id" optional="hide"/>
                                <field name="partner_id"/>
                                <field name="name" optional="hide"/>
                                <field name="amount_currency" string="Balance [PKR]" sum="Total Balance"/>
                                <field name="debit" sum="Total Debit"/>
                                <field name="credit" sum="Total Credit"/>
                                <field name="balance" sum="Balance"/>
                                <field name="x_payment_status" invisible="1"/>
                            </tree>
                        </field>
                    </page>
                    <page name="unreconciled_payments" string="Unreconciled Payments">
                        <field name="x_payment_ids">
                            <tree limit="500">
                                <button name="open_record" string="Edit" type="object" icon="fa-edit"/>
                                <field name="payment_date"/>
                                <field name="name"/>
                                <field name="move_name"/>
                                <field name="journal_id" optional="hide"/>
                                <field name="destination_journal_id" optional="hide"/>
                                <field name="communication"/>
                                <field name="payment_method_id" optional="hide"/>
                                <field name="create_uid" optional="hide"/>
                                <field name="cheque_reference" optional="hide"/>
                                <field name="partner_id" optional="hide"/>
                                <field name="amount" sum="Total"/>
                                <field name="state" optional="hide"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="view_bank_statement_tree_customization_0" model="ir.ui.view">
        <field name="name">account.bank.statement.tree.customization</field>
        <field name="model">account.bank.statement</field>
        <field name="inherit_id" ref="account.view_bank_statement_tree"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="x_date_from"/>
                    <field name="x_date_to"/>
                </xpath>
                <field name="balance_start" position="before">
                    <field name="x_gl_starting_balance" string="GL Starting Balance"/>
                    <field name="x_gl_ending_balance" string="GL Ending Balance"/>
                </field>
                <field name="balance_end_real" position="after">
                    <field name="x_difference"/>
                </field>
                <xpath expr="//field[@name='state']" position="after">
                    <field name="x_status"/>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_payment_tree_customization" model="ir.ui.view">
            <field name="name">account.payment.tree.customization</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_tree"/>
            <field name="priority" eval="99"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='payment_date']" position="before">
                        <button name="open_record" string="Edit" type="object" icon="fa-edit"/>
                    </xpath>
                    <xpath expr="//field[@name='name']" position="after">
                        <field name="move_name"/>
                    </xpath>
                    <xpath expr="//field[@name='journal_id']" position="after">
                        <field name="destination_journal_id"/>
                        <field name="communication"/>
                    </xpath>
                    <xpath expr="//field[@name='payment_method_id']" position="after">
                        <field name="create_uid"/>
                        <field name="create_date" optional="hide"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="view_account_payment_form_customization" model="ir.ui.view">
            <field name="name">account.payment.form.customization</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="priority" eval="99"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='payment_method_code']" position="after">
                        <field name="x_linked_with_bill" attrs="{'invisible': [('partner_type', '!=', 'supplier')]}"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record id="account_payment_term_form_view_cus_0" model="ir.ui.view">
            <field name="name">account.payment.term.form.view.cus.0</field>
            <field name="model">account.payment.term</field>
            <field name="inherit_id" ref="account.view_payment_term_form"/>
            <field name="priority" eval="99"/>
            <field name="arch" type="xml">
                <data>
                    <field name="line_ids" position="after">
                        <separator string="Sale Orders"/>
                        <p class="text-muted">
                            Following Sale Orders will be affected if this payment term is changed.
                        </p>
                        <field name="x_order_ids"/>
                    </field>
                </data>
            </field>
        </record>

        <record id="action_account_payment_method" model="ir.actions.act_window">
            <field name="name">Payment Method</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.payment.method</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="domain">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create new Payment Method
                </p>
            </field>
        </record>

        <menuitem id="menu_account_payment_method" name="Payment Method" sequence="3"
                  parent="account.account_account_menu" action="action_account_payment_method"/>
    </data>
</odoo>
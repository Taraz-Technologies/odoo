<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_customization_0" model="ir.ui.view">
        <field name="name">purchase.order.form.customization</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='partner_ref']" position="after">
                    <field name="x_purchase_type" attrs="{'required':[('x_old_bill','=',False)]}"/>
                    <field name="x_item_type" attrs="{'required':[('x_old_bill','=',False)]}"/>
                    <field name="x_weight_kg" attrs="{'invisible':[('x_item_type','!=','Cost of Freight Sold')]}"/>
                    <field name="x_weight_type" attrs="{'invisible':[('x_item_type','!=','Cost of Freight Sold')]}"/>
                    <field name="x_related_so_s" widget="many2many_tags"
                           attrs="{
                                               'invisible':[('x_purchase_type','!=','Shipping (Export)')]
                                               }"/>
                    <field name="x_related_po_s" widget="many2many_tags" invisible="1"/>
                    <field name="x_show_forwarder_ref" invisible="1"/>
                    <field name="x_forwarder_ref" attrs="{'invisible': ['|',
					('x_purchase_type', '!=', 'Imported Goods'),
					('x_show_forwarder_ref', '=', False)
					]}"/>
                    <field name="x_import_method"
                           attrs="{
                                               'invisible':[('x_purchase_type','!=','Clearing')],
                                               'required':[('x_purchase_type','=','Clearing')]
                                               }"/>
                    <field name="x_weboc_gd"
                           attrs="{
                                               'invisible': ['|',('x_purchase_type','=','Imported Goods'),('x_import_method','!=','WeBoc')],
                                               'required': ['&amp;',('x_purchase_type','=','Clearing'),('x_import_method','=','WeBoc')]
                                               }"/>
                    <field name="x_assessed_value"
                           attrs="{
                                               'invisible': ['|',('x_purchase_type','=','Imported Goods'),('x_import_method','=',False)],
                                               'required': ['&amp;',('x_purchase_type','=','Clearing'),('x_import_method','!=',False)]
                                               }"/>
                    <field name="x_purchase_order_status"/>
                    <field name="x_attachment"/>
                </xpath>
                <xpath expr="//field[@name='date_approve']" position="before">
                    <field name="x_folder_name"/>
                </xpath>
                <xpath expr="//field[@name='company_id']" position="after">
                    <field name="currency_id" position="move"/>
                    <field name="incoterm_id" position="move"/>
                    <field name="payment_term_id" position="move"/>
                    <field name="x_payment_method"/>
                    <field name="x_comments" placeholder="Comments for Accounts Dept."/>
                    <field name="x_picking_type_ids" widget="many2many_tags"/>
                </xpath>
                <xpath expr="//field[@name='requisition_id']" position="replace"/>
                <xpath expr="//group[@name='planning']" position="inside">
                    <field name="x_port_of_shipment"/>
                    <field name="x_port_of_discharge"/>
                    <field name="x_old_bill"/>
                    <field name="x_letter_head_report"/>
                </xpath>
                <field name="fiscal_position_id" position="after">
                    <field name="x_exclude_from_dashboard" groups="base.group_erp_manager"/>
                    <field name="x_date_dashboard" groups="base.group_erp_manager"/>
                </field>
                <xpath expr="//field[@name='order_line']/tree[1]/field[@name='name']" position="after">
                    <field name="x_product_categ_id" attrs="{'readonly': [('state', 'in', ('purchase', 'to approve','done', 'cancel'))]}"/>
                    <field name="x_is_shipping" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree[1]/field[@name='taxes_id']" position="after">
                    <field name="x_discount" optional="show"/>
                </xpath>
                <xpath expr="//page[@name='purchase_delivery_invoice']" position="after">
                    <page string="Product Details">
                        <field name="x_compute_products" invisible="1"/>
                        <field name="x_product_ids">
                            <kanban>
                                <field name="id"/>
                                <field name="name"/>
                                <field name="description"/>
                                <templates>
                                    <t t-name="kanban-box">
                                        <div class="oe_kanban_global_click">
                                            <div class="o_kanban_image">
                                                <img t-att-src="kanban_image('product.product', 'image_1920', record.id.raw_value)"
                                                     alt="Product" class="o_image_64_contain"/>
                                            </div>
                                            <div class="oe_kanban_details">
                                                <strong class="o_kanban_record_title">
                                                    <field name="name"/>
                                                </strong>
                                                <div name="tags"/>
                                                <ul>
                                                    <li>
                                                        <field name="description"/>
                                                    </li>
                                                </ul>
                                                <div name="tags"/>
                                            </div>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="view_purchase_order_tree_customization_0" model="ir.ui.view">
        <field name="name">purchase.order.tree.customization</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='date_order']" position="after">
                    <field name="partner_id" position="move"/>
                    <field name="name" position="move"/>
                    <field name="partner_ref" position="move"/>
                    <field name="x_purchase_type" optional="show"/>
                    <field name="x_item_type" optional="show"/>
                    <field name="x_related_so_s" widget="many2many_tags" optional="show"/>
                    <field name="x_related_po_s" widget="many2many_tags" optional="show"/>
                </xpath>
            </data>
        </field>
    </record>

    <record id="purchase_order_view_tree_customizations" model="ir.ui.view">
        <field name="name">purchase_order_view_tree_customizations</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='date_order']" position="after">
                    <field name="partner_id" position="move"/>
                    <field name="name" position="move"/>
                    <field name="partner_ref" position="move"/>
                    <field name="x_purchase_type" optional="show"/>
                    <field name="x_item_type" optional="show"/>
                    <field name="x_related_so_s" widget="many2many_tags" optional="show"/>
                    <field name="x_related_po_s" widget="many2many_tags" optional="show"/>
                </xpath>
            </data>
        </field>
    </record>

    <record id="view_purchase_order_search_customization_0" model="ir.ui.view">
        <field name="name">purchase.order.select.customization</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='activities_exception']" position="after">
                <separator/>
                <filter string="Previous Year" name="previous_year"
                        domain="[('date_order', '&gt;=', (context_today() - relativedelta(years=1)).strftime('%%Y-01-01')), ('date_order', '&lt;', time.strftime('%%Y-01-01'))]"/>
                <filter string="Current Year" name="current_year"
                        domain="[('date_order', '&lt;', (context_today() + relativedelta(years=1)).strftime('%%Y-01-01')), ('date_order','&gt;=', time.strftime('%%Y-01-01'))]"/>
                <filter string="Local" name="local_purchase"
                        domain="['&amp;', ('x_purchase_order_status', '=', 'Valid'), ('x_purchase_type', '=', 'Local'),]"/>
                <filter string="Clearing" name="clearing_purchase"
                        domain="['&amp;', ('x_purchase_order_status', '=', 'Valid'), ('x_purchase_type', '=', 'Clearing')]"/>
                <filter string="Forwarding" name="forwarding_purchase"
                        domain="['&amp;', ('x_purchase_order_status', '=', 'Valid'), ('x_purchase_type', '=', 'Forwarding')]"/>
                <filter string="Imported Goods" name="imported_goods_purchase"
                        domain="['&amp;', ('x_purchase_order_status', '=', 'Valid'), ('x_purchase_type', '=', 'Imported Goods')]"/>
                <filter string="Shipping (Export)" name="shipping_export_purchase"
                        domain="['&amp;', ('x_purchase_order_status', '=', 'Valid'), ('x_purchase_type', '=', 'Shipping (Export)')]"/>
                <filter string="Shipping (Self Pickup)" name="shipping_self_pickup_purchase"
                        domain="['&amp;', ('x_purchase_order_status', '=', 'Valid'), ('x_purchase_type', '=', 'Shipping (Self Pickup)')]"/>
            </xpath>
        </field>
    </record>

    <record id="view_currency_rate_tree_customization" model="ir.ui.view">
        <field name="name">res.currency.rate.tree.customization</field>
        <field name="model">res.currency.rate</field>
        <field name="inherit_id" ref="base.view_currency_rate_tree"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="currency_id" widget="selection"/>
            </xpath>
        </field>
    </record>

    <act_window id="act_view_currency_rates"
                name="Currency Rates"
                view_mode='tree,form'
                view_id='base.view_currency_rate_tree'
                res_model="res.currency.rate"/>

    <menuitem id="menu_purchase_currency_rates"
              name="Currency Rates"
              parent="purchase.menu_purchase_root"
              action="act_view_currency_rates"
              groups="purchase.group_purchase_manager"
              sequence="110"/>

    <menuitem id="menu_purchase_shipping_rates"
              name="Shipping Rates"
              parent="purchase.menu_purchase_root"
              action="action_shipping_rates"
              groups="purchase.group_purchase_manager"
              sequence="111"/>

    <menuitem id="menu_purchase_fuel_surcharge"
              name="Fuel Surcharge"
              parent="purchase.menu_purchase_root"
              action="action_fuel_surcharge"
              groups="purchase.group_purchase_manager"
              sequence="110"/>

    <record id="act_purchase_order_project_task_all" model="ir.actions.act_window">
        <field name="name">Purchase Order Tracking Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,tree,form,calendar,pivot,graph,activity</field>
        <field name="context">{
            'pivot_row_groupby': ['user_id'],
            'search_default_project_id': [3],
            'search_default_trackbot_task': 1,
            'search_default_pending_task': 1,
            'search_default_normal_task': 1,
            'search_default_blocked_task': 1,
            'default_project_id': 3,
            'default_user_id': uid,
            }
        </field>
        <field name="domain">[('project_id', '=', 3),('user_id', '=', 28)]</field>
        <field name="search_view_id" ref="project.view_task_search_form"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click <i>Create</i> to start a new task.
            </p>
            <p>
                To get things done, use activities and status on tasks.
                <br/>
                Chat in real time or by email to collaborate efficiently.
            </p>
        </field>
    </record>

    <menuitem id="menu_purchase_order_project_task"
              name="Project"
              parent="purchase.menu_purchase_root"
              action="act_purchase_order_project_task_all"
              groups="purchase.group_purchase_manager"
              sequence="120"/>


    <record id="view_purchase_order_form_with_carrier" model="ir.ui.view">
        <field name="name">purchase.order.form.view.with_carrier</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='note_group']" position="before">
                    <div class="oe_right">
                        <button string="Add discount" name="action_open_add_discount_wizard" type="object"/>
                        <button string="Add shipping" name="action_open_add_shipping_wizard" type="object"/>
                        <button string="Remove shipping" name="action_open_remove_shipping_wizard" type="object"
                                confirm="Are you sure to remove shipping from this Purchase Order?"/>
                    </div>
                </xpath>
            </data>
        </field>
    </record>

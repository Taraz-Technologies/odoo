<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_sale_order_form_customization" model="ir.ui.view">
		<field name="name">sale.order.form.customization</field>
		<field name="model">sale.order</field>
		<field name="inherit_id" ref="sale.view_order_form"/>
		<field name="priority" eval="99" />
		<field name="arch" type="xml">
			<data>
				<xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d']" position="after">
					<button name="create_delivery" string="Create Delivery" type="object" class="btn-primary"
							attrs="{'invisible': ['|', ('delivery_count', '!=', 0), ('state', 'not in', ('sale', 'done'))]}"/>
				</xpath>
				<xpath expr="//button[@name='action_confirm'][1]" position="before">
					<button name="upcoming_order" string="Upcoming Order" type="object" class="btn-primary" attrs="{'invisible': [('x_upcoming', '=', False)]}"/>
				</xpath>
				<xpath expr="//button[@name='action_confirm'][1]" position="attributes">
					<attribute name="attrs">{'invisible': ['|',('x_upcoming', '=', True),('state', 'not in', ['sent'])]}</attribute>
				</xpath>
				<xpath expr="//button[@name='action_confirm'][2]" position="attributes">
					<attribute name="attrs">{'invisible': ['|',('x_upcoming', '=', True),('state', 'not in', ['draft'])]}</attribute>
				</xpath>
				<xpath expr="//button[@name='action_view_invoice']" position="after">
					<field name="x_task_id" invisible="1"/>
					<button string="Task"
							name="action_view_task"
							type="object"
							class="oe_stat_button"
							icon="fa-tasks"
							attrs="{'invisible': [('x_task_id', '=', False)]}"/>
				</xpath>
				<field name='partner_shipping_id' position="after">
					<field name="x_end_user"/>
					<field name="x_update_partner_data" invisible="1"/>
					<field name='client_order_ref' position="move"/>
					<field name="x_customer_po"/>
					<field name="x_web_order_number"/>
					<field name="x_lead_time"/>
				</field>
				<field name='validity_date' position="before">
					<field name="x_folder_name"/>
				</field>
				<field name="date_order" position="attributes">
					<attribute name="readonly">0</attribute>
				</field>
				<field name='payment_term_id' position="after">
					<field name='incoterm' position="move"/>
					<field name="x_upcoming" invisible="1"/>
					<field name="x_sale_type_turkey" attrs="{'invisible':['|', ('state','not in',('sale', 'done')), ('company_id','!=',2)],
					'required':[('state','in',('sale', 'done')), ('company_id','=',2)]}"/>
					<field name="x_sale_type" attrs="{'invisible':['|', ('state','not in',('sale', 'done')), ('company_id','!=',1)],
					'required':[('state','in',('sale', 'done')), ('company_id','=',1)]}"/>
					<field name="x_payment_method" attrs="{'invisible':['|', ('state','not in',('sale', 'done')), ('company_id','!=',1)],
					'required':[('state','in',('sale', 'done')), ('company_id','=',1)]}"/>
					<field name="carrier_id" invisible="1"/>
					<field name="x_tracking_reference" attrs="{'invisible': [('state','not in',('sale', 'done'))]}"/>
					<field name="x_contain_pelab" attrs="{'invisible': [('x_contain_pelab','=', False)]}"/>
					<field name="x_deadline"/>
					<field name="x_production_deadline"/>
				</field>
				<xpath expr="//field[@name='order_line']/tree[1]//field[@name='name']" position="after">
					<field name="x_internal_notes"/>
				</xpath>
				<field name="name" position="before">
					<div style="padding-bottom: 15px;">
                    	<field name="x_internal_notes" placeholder="Internal Notes" style="border-radius: 5px; border: 1px solid black; font-style: italic; padding:5px; font-size: 15px;"/>
					</div>
				</field>
                <xpath expr="//group[@name='note_group']" position="before">
                    <div class="oe_right">
                        <button string="Add BOS" name="add_bos_products" type="object"/>
                    </div>
                </xpath>
				<field name='amount_total' position="after">
					<field name="x_ui_value" readonly="1"/>
					<field name="x_total_without_discount"/>
					<field name="x_total_discount"/>
					<field name="x_total_cgs"/>
					<field name="x_total_profit"/>
					<field name="x_estimated_profit" invisible="1"/>
					<field name="x_profit_margin" widget="percentage"/>
					<field name="x_estimated_profit_margin" widget="percentage" invisible="1"/>
				</field>
				<page name="order_lines" position="inside">
					<group>
						<group>
							<field name="x_show_bill_to"/>
							<field name="x_show_customer"/>
							<field name="x_letter_head_report"/>
							<field name="x_hs_code_and_coo"/>
							<field name="x_distributor_order"/>
							<field name="x_hide_customer"/>
							<field name="x_hide_product"/>
							<field name="x_hide_discount"/>
							<field name="x_hide_discount_description"/>
							<field name="x_hide_gst"/>
							<field name="x_show_sale_person"/>
							<field name="x_remove_proforma"/>
							<field name="x_date_docs"/>
						</group>
						<group>
							<field name="x_show_ship_to"/>
							<field name="x_show_end_user"/>
							<field name="x_appear_payment_method"/>
							<field name="x_appear_pt_table"/>
							<field name="x_attach_short_terms"/>
							<field name="x_attach_long_terms"/>
							<field name="x_appear_gst_withheld"/>
							<field name="x_appear_it_withheld"/>
							<field name="x_appear_paypal_link"/>
							<field name="x_appear_banking_details"/>
							<field name="x_bank" readonly="0"
								   attrs="{'required':[('x_appear_banking_details', '=', True)]}"/>
						</group>
					</group>
<!--					<field name="x_internal_notes" placeholder="Internal Notes"/>-->
				</page>
				<page name='order_lines' position="after">
					<page string="Freight Calculation" name="freight_calculation">
						<button name="compute_shipment_product" string="Refresh" type="object" class="oe_highlight"/>
						<field name="x_sale_order_product_ids" options="{'create_edit': false}">
							<tree editable="bottom">
								<field name="x_sale_order_id" invisible="1"/>
								<field name="x_product_id"/>
								<field name="x_short_description"/>
								<field name="x_gross_weight"/>
								<field name="x_quantity"/>
								<field name="x_total_weight" sum="Total Weight"/>
							</tree>
						</field>
						<group>
							<group>
								<field name="x_currency_id" invisible="1"/>
								<field name="x_shipment_weight"/>
								<field name="x_dhl_export_zone"/>
	                            <label for="x_weight_from" string="DHL Range (kg)"/>
	                            <div>
	                                <field name="x_dhl_weight_from" class="oe_inline"/>
	                                -
	                                <field name="x_dhl_weight_to" class="oe_inline"/>
	                            </div>
								<field name="x_dhl_shipping_rate" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
							</group>
							<group>
								<field name="x_delivery_country"/>
								<field name="x_ups_export_zone"/>
	                            <label for="x_weight_from" string="UPS Range (kg)"/>
	                            <div>
	                                <field name="x_ups_weight_from" class="oe_inline"/>
	                                -
	                                <field name="x_ups_weight_to" class="oe_inline"/>
	                            </div>
								<field name="x_ups_shipping_rate" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
							</group>
							<group string="DHL Charges">
								<field name="x_dhl_charges" nolabel="1">
									<tree editable="bottom">
										<field name="x_sale_order_id" invisible="1"/>
										<field name="x_name"/>
										<field name="currency_id" invisible="1"/>
										<field name="x_amount" sum="Total Freight" widget="monetary" options="{'currency_field': 'currency_id'}"/>
									</tree>
								</field>
							</group>
							<group string="UPS Charges">
								<field name="x_ups_charges" nolabel="1">
									<tree editable="bottom">
										<field name="x_sale_order_id" invisible="1"/>
										<field name="x_name"/>
										<field name="currency_id" invisible="1"/>
										<field name="x_amount" sum="Total Freight" widget="monetary" options="{'currency_field': 'currency_id'}"/>
									</tree>
								</field>
							</group>
						</group>
						<field name="x_total_dhl" invisible="1"/>
						<field name="x_total_ups" invisible="1"/>
					</page>
					<page string="CGS Analysis" name="cgs_analysis">
						<button name="get_settings" string="Refresh" type="object" class="oe_highlight"/>
						<group string="Settings" invisible="1">
							<group>
								<field name="x_inclusive_of_bonus"/>
								<field name="x_inclusive_of_currency"/>
							</group>
							<group>
								<field name="x_inclusive_of_investor_profit"/>
								<field name="x_inclusive_of_other_costs"/>
							</group>
						</group>
						<group col="6" name="cgs_analysis" string="CGS Analysis" class="mb0">
							<group colspan="2">
								<field name="x_price" widget="monetary"/>
							</group>
							<group colspan="2">
								<field name="x_cost" widget="monetary"/>
								<field name="x_cost_percentage" widget="percentage"/>
								<field name="x_cost_multiplier"/>
							</group>
							<group colspan="2">
								<field name="x_profit" widget="monetary"/>
								<field name="x_profit_percentage" widget="percentage"/>
								<field name="x_markup" widget="percentage"/>
							</group>
						</group>
						<group col="6" class="mt0">
							<group colspan="2" class="mb0">
							</group>
							<group colspan="1" class="mb0" string="Sale Price">
							</group>
							<group colspan="1" class="mb0" string="Cost">
							</group>
							<group colspan="1" class="mb0" string="Profit">
							</group>
							<group colspan="2" class="mt0 mb0">
								<field name="x_product"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_product_price" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_product_cost" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_product_profit" nolabel="1"/>
							</group>
							<group colspan="2" class="mt0 mb0">
								<field name="x_freight"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_freight_price" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_freight_cost" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_freight_profit" nolabel="1"/>
							</group>
							<group colspan="2" class="mt0 mb0">
								<field name="x_discount"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_discount_price" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_discount_cost" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_discount_profit" nolabel="1"/>
							</group>
							<group colspan="2" class="mt0 mb0">
								<field name="x_fees"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_fees_price" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_fees_cost" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_fees_profit" nolabel="1"/>
							</group>
							<group colspan="2" class="mt0 mb0">
								<field name="x_other_real"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_other_real_price" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_other_real_cost" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_other_real_profit" nolabel="1"/>
							</group>
							<group colspan="2" class="mt0 mb0">
								<field name="x_other_estimated"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_other_estimated_price" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_other_estimated_cost" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_other_estimated_profit" nolabel="1"/>
							</group>
							<group colspan="2" class="mt0 mb0">
								<field name="x_bonus"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_bonus_price" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_bonus_cost" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_bonus_profit" nolabel="1"/>
							</group>
							<group colspan="2" class="mt0 mb0">
								<field name="x_investor_share"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_investor_share_price" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_investor_share_cost" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_investor_share_profit" nolabel="1"/>
							</group>
							<group colspan="2" class="mt0 mb0">
								<field name="x_currency"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_currency_price" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_currency_cost" nolabel="1"/>
							</group>
							<group colspan="1" class="mt0 mb0">
								<field name="x_currency_profit" nolabel="1"/>
							</group>
						</group>
						<button type="action" name="%(customizations.act_sale_order_cgs_graph)d" string="Pie Graph" class="oe_highlight"/>
						<field name="x_costing_complete" invisible="1"/>
						<field name="x_cgs_line_ids"/>
					</page>
					<page string="Attachment Doc" name="attachment_doc">
						<group col="4">
							<field name="x_content_title" placeholder="Report content title"/>
							<field name="x_content_show"/>
						</group>
						<field name="x_content_text" placeholder="Report content text"/>
					</page>
				</page>
				<field name='user_id' position="before">
					<field name="x_team_member_ids" widget="many2many_tags"/>
				</field>
				<field name='analytic_account_id' position="after">
					<field name="x_sale_tax_invoice_number" attrs="{'invisible': [('company_id', '!=', 1)]}"/>
					<field name="x_so_payment_state" states="sale,done"/>
				</field>
				<field name='effective_date' position="after">
					<field name="x_update_freight"/>
					<field name="x_total_freight"/>
					<field name="x_total_weight"/>
					<field name="x_freight_per_kg"/>
				</field>
				<field name='source_id' position="after">
					<field name="x_exclude_from_dashboard" groups="base.group_erp_manager"/>
					<field name="x_date_dashboard" groups="base.group_erp_manager"/>
				</field>
				<page name='customer_signature' position="after">
					<page string="Stock Level" id="stock_level">
						<group>
							<group>
								<field name="x_stock_status"/>
							</group>
							<group>
								<field name="x_packing_type"/>
							</group>
						</group>
						<button string="Check Stock" name="update_stock_level" type="object" class="oe_highlight" groups="base.group_user"/>
						<group>
							<field name="x_stock_level" readonly="1" force_save="1" nolabel="1">
								<tree>
									<field name="name"/>
									<field name="qty_available"/>
									<field name="virtual_available"/>
								</tree>
							</field>
						</group>
					</page>
					<page string="Sale Order Task" id="sale_order_task">
						<button name="create_project_task" string="Create task" type="object" class="oe_highlight"
								attrs="{'invisible': [('x_task_id', '!=', False)]}"/>
						<group>
							<group>
								<field name="x_task_name"/>
								<field name="x_user_responsible"/>
								<field name="x_user_participants" widget="many2many_tags"/>
								<field name="x_user_observers" widget="many2many_tags"/>
								<field name="x_processes" widget="many2many_tags"/>
							</group>
							<group>
								<field name="x_start_task_on"/>
								<field name="x_notes"/>
								<field name="x_update_tags" invisible="1"/>
								<field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
							</group>
						</group>
						<separator string="Tasks" colspan="4"/>
						<field name="x_tasks">
							<tree>
								<field name="x_name"/>
								<field name="x_description"/>
								<field name="x_user_responsible"/>
								<field name="x_user_participants" widget="many2many_tags"/>
								<field name="x_user_observers" widget="many2many_tags"/>
								<field name="x_checklist_items" widget="many2many_tags"/>
								<field name="x_project_stage_id"/>
							</tree>
						</field>
					</page>
				</page>
			</data>
		</field>
	</record>

	<record id="view_sale_order_tree_customization" model="ir.ui.view">
		<field name="name">sale.order.tree.customization</field>
		<field name="model">sale.order</field>
		<field name="inherit_id" ref="sale.view_quotation_tree"/>
		<field name="priority" eval="99" />
		<field name="arch" type="xml">
			<data>
				<xpath expr="//field[@name='name']" position="after">
					<field name="x_web_order_number" optional="show"/>
					<field name="x_sale_type" optional="show"/>
				</xpath>
				<xpath expr="//field[@name='partner_id']" position="after">
					<field name="x_end_user" optional="show"/>
					<field name="x_country" optional="show"/>
					<field name="x_payment_method" optional="show"/>
				</xpath>
				<xpath expr="//field[@name='state']" position="after">
					<field name="x_is_commented" invisible="1"/>
					<button name="action_show_notes" type="object" icon="fa-comment" string="Show Notes"
                                    attrs="{'invisible': [('x_is_commented', '=', False)]}"/>
					<field name="x_total_cgs" optional="hide"/>
					<field name="x_total_profit" optional="hide"/>
					<field name="x_estimated_profit" optional="hide"/>
					<field name="x_profit_margin" widget="percentage" optional="hide"/>
					<field name="x_estimated_profit_margin" widget="percentage" optional="hide"/>
					<field name="x_total_freight" optional="hide" sum="Total Freight"/>
					<field name="x_total_weight" optional="hide" sum="Total Weight"/>
					<field name="x_freight_per_kg" optional="hide" sum="Freight per KG"/>
					<field name="x_tracking_reference" optional="show"/>
				</xpath>
			</data>
		</field>
	</record>

	<record id="view_sales_order_filter_customization" model="ir.ui.view">
		<field name="name">sale.order.list.select.customization</field>
		<field name="model">sale.order</field>
		<field name="inherit_id" ref="sale.view_sales_order_filter"/>
		<field name="priority" eval="99" />
		<field name="arch" type="xml">
			<data>
				<filter name="my_sale_orders_filter" position="after">
					<separator/>
                    <filter string="Costing Available" name="costing_available" domain="[('x_costing_complete', '=', True)]"/>
				</filter>
			</data>
		</field>
	</record>

	<record id="view_order_line_tree_customization" model="ir.ui.view">
		<field name="name">sale.order.line.tree.customization</field>
		<field name="model">sale.order.line</field>
		<field name="inherit_id" ref="sale.view_order_line_tree"/>
		<field name="priority" eval="99" />
		<field name="arch" type="xml">
			<data>
				<field name="name" position="after">
					<field name="x_internal_notes"/>
				</field>
			</data>
		</field>
	</record>

	<record id="act_sale_order_project_task_all" model="ir.actions.act_window">
		<field name="name">Sale Order Tracking Tasks</field>
		<field name="res_model">project.task</field>
		<field name="view_mode">kanban,tree,form,calendar,pivot,graph,activity</field>
		<field name="context">{
			'pivot_row_groupby': ['user_id'],
			'search_default_project_id': [2],
			'search_default_trackbot_task': 1,
			'search_default_pending_task': 1,
			'search_default_normal_task': 1,
			'search_default_blocked_task': 1,
			'default_project_id': 2,
			'default_user_id': uid,
			}</field>
		<field name="domain">[('project_id', '=', 2),('user_id', '=', 28)]</field>
		<field name="search_view_id" ref="project.view_task_search_form"/>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				Click <i>Create</i> to start a new task.
			</p><p>
			To get things done, use activities and status on tasks.<br/>
			Chat in real time or by email to collaborate efficiently.
		</p>
		</field>
	</record>

    <record id="view_sale_order_cgs_graph_view" model="ir.ui.view">
        <field name="name">sale.order.cgs.graph</field>
        <field name="model">sale.order.cgs</field>
        <field name="arch" type="xml">
            <graph string="Sales Order CGS" type="pie">
                <field name="x_sale_order_id"/>
                <field name="x_price_subtotal" type="measure"/>
            </graph>
        </field>
    </record>

	<record id="act_sale_order_cgs_graph" model="ir.actions.act_window">
		<field name="name">CGS Analysis</field>
		<field name="res_model">sale.order.cgs</field>
		<field name="view_mode">graph,tree,form,pivot</field>
		<field name="context">{
			'search_default_real': 1,
			'search_default_products': 1,
			'search_default_freight': 1,
			'search_default_fees': 1,
			'search_default_other_real': 1,
			'search_default_type': 1,

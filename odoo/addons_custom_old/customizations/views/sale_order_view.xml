    <record id="view_sale_order_cgs_pivot" model="ir.ui.view">
        <field name="name">sale.order.cgs.pivot</field>
        <field name="model">sale.order.cgs</field>
        <field name="arch" type="xml">
            <pivot string="Sales Order CGS">
                <field name="x_sale_order_id" type="row"/>
                <field name="x_price_subtotal" type="measure"/>
            </pivot>
        </field>
    </record>

	<record id="view_sale_order_cgs_search" model="ir.ui.view">
		<field name="name">sale.order.cgs.search</field>
		<field name="model">sale.order.cgs</field>
		<field name="arch" type="xml">
			<search string="Search CGS">
                <field name="x_sale_order_id"/>
                <field name="x_product_id"/>
                <field name="x_journal_entry_id"/>
				<separator/>
				<filter string="Real" name="real" domain="[('x_calculation_type', '=', 'real')]"/>
				<filter string="Estimated" name="estimated" domain="[('x_calculation_type', '=', 'estimated')]"/>
				<separator/>
				<filter string="Price" name="price" domain="[('x_type', '=', 'price')]"/>
				<filter string="Cost" name="cost" domain="[('x_type', '=', 'cost')]"/>
				<filter string="Profit" name="profit" domain="[('x_type', '=', 'profit')]"/>
				<filter string="Loss" name="loss" domain="[('x_type', '=', 'loss')]"/>
				<separator/>
				<filter string="Products" name="products" domain="[('x_product_type', '=', 'products')]"/>
				<filter string="Freight" name="freight" domain="[('x_product_type', '=', 'freight')]"/>
				<filter string="Discount" name="discount" domain="[('x_product_type', '=', 'discount')]"/>
				<filter string="Fees" name="fees" domain="[('x_product_type', '=', 'fees')]"/>
				<filter string="Other Real" name="other_real" domain="[('x_product_type', '=', 'other_real')]"/>
				<filter string="Other Estimated" name="other_estimated" domain="[('x_product_type', '=', 'other_estimated')]"/>
				<filter string="Bonus" name="bonus" domain="[('x_product_type', '=', 'bonus')]"/>
				<filter string="Investor Share" name="investor_profit" domain="[('x_product_type', '=', 'investor_profit')]"/>
				<filter string="Currency" name="currency" domain="[('x_product_type', '=', 'currency')]"/>
                <separator/>
<!--                    After July-->
<!--                <filter string="Current Fiscal Year" name="current_fiscal_year"-->
<!--                        domain="[('x_date_order', '&lt;', (context_today() + relativedelta(years=1)).strftime('%%Y-07-01')), ('x_date_order','&gt;=', time.strftime('%%Y-07-01'))]"/>-->
<!--                <filter string="Previous Fiscal Year" name="previous_fiscal_year"-->
<!--                        domain="[('x_date_order', '&gt;=', (context_today() - relativedelta(years=1)).strftime('%%Y-07-01')), ('x_date_order', '&lt;', time.strftime('%%Y-07-01'))]"/>-->
<!--                    Before July-->
                <filter string="Current Fiscal Year" name="current_fiscal_year"
                        domain="[('x_date_order', '&gt;=', (context_today() - relativedelta(years=1)).strftime('%%Y-07-01')), ('x_date_order','&lt;', time.strftime('%%Y-07-01'))]"/>
                <filter string="Previous Fiscal Year" name="previous_fiscal_year"
                        domain="[('x_date_order', '&gt;=', (context_today() - relativedelta(years=2)).strftime('%%Y-07-01')), ('x_date_order', '&lt;', (context_today() - relativedelta(years=1)).strftime('%%Y-07-01'))]"/>
                <group col="8" colspan="4" expand="0" string="Group By">
                    <filter string="Sale Order" name="sale_order" context="{'group_by':'x_sale_order_id'}"/>
                    <filter string="Customer" name="customer" context="{'group_by':'x_partner_id'}"/>
                    <filter string="Order Date" name="date_order" context="{'group_by':'x_date_order'}"/>
                    <filter string="Product" name="product" context="{'group_by':'x_product_id'}"/>
                    <filter string="Type" name="type" context="{'group_by':'x_type'}"/>
                    <filter string="Sub-type" name="product_type" context="{'group_by':'x_product_type'}"/>
                </group>
			</search>
		</field>
	</record>

	<record id="act_sale_order_cgs" model="ir.actions.act_window">
		<field name="name">CGS Analysis</field>
		<field name="res_model">sale.order.cgs</field>
		<field name="view_mode">graph,tree,form,pivot</field>
		<field name="context">{
			'search_default_real': 1,
			'search_default_products': 1,
			'search_default_freight': 1,
			'search_default_fees': 1,
			'search_default_other_real': 1,
			'search_default_date_order': 1,
			'search_default_type': 1,
			}</field>
		<field name="domain">[]</field>
		<field name="limit">800</field>
		<field name="search_view_id" ref="view_sale_order_cgs_search"/>
	</record>

	<menuitem id="menu_sale_order_cgs"

	<record id="view_sale_order_cgs_form" model="ir.ui.view">
		<field name="name">sale.order.cgs.form</field>
		<field name="model">sale.order.cgs</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<group>
							<field name="x_journal_entry_id" attrs="{'invisible':[('x_journal_entry_id', '=', False)]}" widget="many2one"/>
							<field name="x_bos_move_id" attrs="{'invisible':[('x_bos_move_id', '=', False)]}" widget="many2one"/>
							<field name="x_sale_order_id"/>
							<field name="x_date_order"/>
							<field name="x_partner_id"/>
							<field name="x_product_id"/>
							<field name="x_calculation_type"/>
							<field name="x_type"/>
							<field name="x_product_type"/>
							<field name="x_line_code"/>
						</group>
						<group>
							<field name="x_quantity"/>
							<field name="x_uom_id" invisible="1"/>
							<field name="x_currency_id" invisible="1"/>
							<field name="x_price_unit" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
							<field name="x_discount" widget="percentage"/>
							<field name="x_price_subtotal" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
							<field name="x_profit_margin" widget="percentage"/>
							<field name="x_markup" widget="percentage"/>
							<field name="x_cost_multiplier"/>
							<field name="x_pkr_currency_id" invisible="1"/>
							<field name="x_cgs_unit_pkr" widget="monetary" options="{'currency_field': 'x_pkr_currency_id'}"/>
							<field name="x_cgs_subtotal_pkr" widget="monetary" options="{'currency_field': 'x_pkr_currency_id'}"/>
						</group>
					</group>
					<field name="x_note" placeholder="Notes"/>
					<field name="x_description" attrs="{'invisible':[('x_description', '=', False)]}"/>
					<label for="x_move_line_ids"/>
					<field name="x_move_line_ids"/>
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_sale_order_cgs_tree" model="ir.ui.view">
		<field name="name">sale.order.cgs.tree</field>
		<field name="model">sale.order.cgs</field>
		<field name="arch" type="xml">
			<tree>
				<field name="x_journal_entry_id" attrs="{'invisible':[('x_journal_entry_id', '=', False)]}" widget="many2one" optional="hide"/>
				<field name="x_bos_move_id" attrs="{'invisible':[('x_bos_move_id', '=', False)]}" widget="many2one" optional="hide"/>
				<field name="x_date_order" optional="hide"/>
				<field name="x_sale_order_id" optional="hide"/>
				<field name="x_partner_id" optional="hide"/>
				<field name="x_product_id"/>
				<field name="x_quantity"/>
				<field name="x_uom_id" optional="hide"/>
				<field name="x_calculation_type" optional="hide"/>
				<field name="x_type" optional="hide"/>
				<field name="x_product_type" optional="hide"/>
				<field name="x_currency_id" invisible="1"/>
				<field name="x_price_unit" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
				<field name="x_discount" widget="percentage" optional="hide"/>
				<field name="x_price_subtotal" widget="monetary" options="{'currency_field': 'x_currency_id'}" sum="Total Price"/>
				<field name="x_profit_margin" widget="percentage" optional="hide"/>
				<field name="x_markup" widget="percentage" optional="hide"/>
				<field name="x_cost_multiplier" optional="hide"/>
				<field name="x_pkr_currency_id" invisible="1"/>
				<field name="x_cgs_unit_pkr" widget="monetary" options="{'currency_field': 'x_pkr_currency_id'}" optional="hide"/>
				<field name="x_cgs_subtotal_pkr" widget="monetary" options="{'currency_field': 'x_pkr_currency_id'}" optional="hide" sum="Total Cost PKR"/>
			</tree>
		</field>
	</record>

    <record id="view_sale_order_cgs_graph" model="ir.ui.view">
        <field name="name">sale.order.cgs.graph</field>
        <field name="model">sale.order.cgs</field>
        <field name="arch" type="xml">
            <graph string="Sales Order CGS" type="line">
                <field name="x_sale_order_id"/>
                <field name="x_price_subtotal" type="measure"/>
            </graph>
        </field>

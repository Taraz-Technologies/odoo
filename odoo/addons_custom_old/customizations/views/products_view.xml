	<record id="view_product_group_form" model="ir.ui.view">
		<field name="name">product.group.form</field>
		<field name="model">product.group</field>
		<field name="arch" type="xml">
			<form string="Product Group">
				<sheet>
					<group col="4">
						<field name="name"/>
						<field name="series"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_product_group_search" model="ir.ui.view">
		<field name="name">product.group.search</field>
		<field name="model">product.group</field>
		<field name="arch" type="xml">
			<search string="Search Product Group">
                <field name="name"/>
                <field name="series"/>
				<group col="8" colspan="4" expand="0" string="Group By">
                    <filter string="Series" name="series" context="{'group_by':'series'}"/>
                </group>
			</search>
		</field>
	</record>

	<record id="action_product_group" model="ir.actions.act_window">
		<field name="name">Product Group</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">product.group</field>
		<field name="view_mode">tree,form</field>
		<field name="context">{}</field>
		<field name="domain">{}</field>
		<field name="search_view_id" ref="view_product_group_search"/>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				Create new Product Group
			</p>
		</field>
	</record>

	<menuitem id="menu_product_group"
			  name="Product Group"
			  sequence="4"
			  parent="stock.menu_product_in_config_stock"
			  action="action_product_group"/>
	<!-- Product Tags -->
	<record id="view_product_tags_tree" model="ir.ui.view">
		<field name="name">product.tags.tree</field>
		<field name="model">product.tags</field>
		<field name="arch" type="xml">
			<tree string="Product Tags" editable="bottom">
				<field name="x_name"/>
			</tree>
		</field>
	</record>

	<record id="view_product_tags_search" model="ir.ui.view">
		<field name="name">product.tags.search</field>
		<field name="model">product.tags</field>
		<field name="arch" type="xml">
			<search string="Search Product Tags">
                <field name="x_name"/>
			</search>
		</field>
	</record>

	<record id="action_product_tags" model="ir.actions.act_window">
		<field name="name">Product Tags</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">product.tags</field>
		<field name="view_mode">tree</field>
		<field name="search_view_id" ref="view_product_tags_search"/>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				Create new Product Tags
			</p>
		</field>
	</record>

	<menuitem id="menu_product_tags"
			  name="Product Tags"
			  sequence="5"
			  parent="stock.menu_product_in_config_stock"
			  action="action_product_tags"/>
</odoo>
								context="{'default_product_tmpl_id': id}" class="oe_stat_button" icon="fa-cubes">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="x_backorder_qty" widget="statinfo" nolabel="1" class="mr4"/>
                                    <field name="uom_name"/>
                                </span>
                                <span class="o_stat_text">Backorder</span>
                            </div>
						</button>
                        <button type="object" name="action_view_product_tmpl_manufacturing_to_consume"
								attrs="{'invisible':['|', ('type', '!=', 'product'),('x_to_consume_qty', '=', 0)]}"
								context="{'default_product_id': id}" class="oe_stat_button" icon="fa-cubes">

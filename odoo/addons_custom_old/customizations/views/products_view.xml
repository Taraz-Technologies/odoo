                                <span class="o_stat_value">
                                    <field name="x_to_consume_qty" widget="statinfo" nolabel="1" class="mr4"/>
                                    <field name="uom_name"/>
                                </span>
                                <span class="o_stat_text">To Consume</span>
                            </div>
						</button>
                        <button type="object" name="action_view_product_tmpl_manufacturing_tray_out"
								attrs="{'invisible':['|', ('type', '!=', 'product'),('x_tray_out_qty', '=', 0)]}"
								context="{'default_product_id': id}" class="oe_stat_button" icon="fa-cubes">

	<record id="product_template_only_form_view_customization_0" model="ir.ui.view">
		<field name="name">product.template.common.form.customization</field>
		<field name="model">product.template</field>
		<field name="inherit_id" ref="product.product_template_form_view"/>
		<field name="priority" eval="99" />
		<field name="arch" type="xml">
			<data>
				<group name='group_general' position="inside">
					<field name="x_product_tag" widget="many2many_tags"/>
					<field name="x_critical"/>
				</group>
				<field name="uom_po_id" position="after">
					<field name="x_taraz_part_number" invisible="1"/>
					<field name="x_bos_product" attrs="{'invisible':[('type', '=', 'service')]}"/>
					<field name="x_main_product_id" widget="many2one" attrs="{'invisible':[('x_bos_product', '=', False)],'required':[('x_bos_product', '=', True)]}"/>
				</field>
				<xpath expr="//group[@name='description']" position="after">
					<group string="Description for Distributor" name="description_for_distributor"
						   attrs="{'invisible': [('categ_id', 'not in', (262, 263, 264, 265, 266, 267, 268, 275))]}">
						<field name="x_description_for_distributor" nolabel="1"
							   placeholder="This note appear in description of product when sale is for distributor"/>
					</group>
				</xpath>
				<xpath expr="//group[@name='invoicing']" position="after">
					<group string="Product Details" name="product_details"
						   attrs="{'invisible': [('categ_id', 'not in', (262, 263, 264, 265, 266, 267, 268, 275))],
						            'required': [('categ_id', 'in', (262, 263, 264, 265, 266, 267, 268, 275))]}">
						<field name="x_product_group"/>
						<field name="x_product_series"/>
						<field name="x_product_division"/>
					</group>
				</xpath>
				<xpath expr="//group[@name='bill']" position="after">
					<group string="Purchase History" name="purchase_history"
						   attrs="{'invisible': [('categ_id', 'in', (262, 263, 264, 265, 266, 267, 268, 275))]}">
						<field name="x_source"/>
						<field name="x_route" />
					</group>
				</xpath>
				<xpath expr="//group[@name='group_lots_and_weight']" position="inside">
					<field name="x_packaging_info" attrs="{'invisible': [('categ_id', 'not in', (262, 263, 264, 265, 266, 267, 268, 275))]}"/>
					<field name="x_package_weight" attrs="{'invisible': [('categ_id', 'not in', (262, 263, 264, 265, 266, 267, 268, 275))]}"/>
					<field name="x_package_volume" attrs="{'invisible': [('categ_id', 'not in', (262, 263, 264, 265, 266, 267, 268, 275))]}"/>
					<field name="x_lc_factor" attrs="{'invisible': [('categ_id', 'in', (262, 263, 264, 265, 266, 267, 268, 275))]}"/>
					<field name="x_add_in_landed_cost"/>
				</xpath>
				<xpath expr="//group[@name='group_lots_and_weight']" position="after">
					<group name="warehousing" string="Warehousing">
						<field name="x_wh_rules"/>
						<field name="x_short_name"/>
						<field name="x_short_description"/>
					</group>
					<group name="hs_code_info" string="HS Code Info">
						<field name="hs_code" invisible="1"/>
						<field name="x_hs_code_category" invisible="1"/>
						<field name="x_hs_code_description" invisible="1"/>
						<field name="x_custom_duty" invisible="1"/>
						<field name="x_additional_custom_duty" invisible="1"/>
						<field name="x_regulatory_duty" invisible="1"/>
						<field name="x_country_of_origin" invisible="1"/>
						<label for="x_country_id"/>
						<div class="o_row">
							<field name="x_country_id"/>
						</div>
						<field name="x_hs_code_vendor" invisible="1"/>
					</group>
				</xpath>
				<field name='landed_cost_ok' position="after">
					<field name="x_split_method" attrs="{'required': [('landed_cost_ok', '=', True)]}"/>
				</field>
				<page name='invoicing' position="after">
					<page name="manufacturing" string="Manufacturing">
						<group col="6"
							   attrs="{'invisible': [('categ_id', 'not in', (262, 263, 264, 265, 266, 267, 268, 275))]}">
							<field name="x_ao_mo_instructions"/>
							<field name="x_part_level_comments"/>
							<field name="x_qc_checklist"/>
						</group>
					</page>
				</page>
			</data>
		</field>
	</record>

	<record id="product_template_tree_view_customization" model="ir.ui.view">
		<field name="name">product.template.product.tree.customization</field>
		<field name="model">product.template</field>
		<field name="inherit_id" ref="product.product_template_tree_view"/>
		<field name="priority">99</field>
		<field name="arch" type="xml">
			<data>
				<field name="qty_available" position="attributes">
					<attribute name="string">On Hand</attribute>
				</field>
				<field name="virtual_available" position="before">
					<field name="incoming_qty" optional="show" string="On Order"/>
					<field name="outgoing_qty" optional="show" string="Reserved"/>
				</field>
				<field name="virtual_available" position="attributes">
					<attribute name="string">Forecasted</attribute>
				</field>
				<field name="virtual_available" position="after">
					<field name="x_incoming_qty" optional="show" string="Incoming"/>
					<field name="x_backorder_qty" optional="show" string="Backorder"/>
				</field>
				<xpath expr="//field[@name='name']" position="after">
					<field name="description" optional="show"/>
				</xpath>
			</data>
		</field>
	</record>

	<record id="product_template_only_form_view_customization_1" model="ir.ui.view">
		<field name="name">product.template.common.form.customization</field>
		<field name="model">product.template</field>
		<field name="inherit_id" ref="delivery.product_template_hs_code"/>
		<field name="priority" eval="99" />
		<field name="arch" type="xml">
			<data>
				<field name="hs_code" position="replace"/>
			</data>
		</field>
	</record>

	<record id="product_template_search_view_customization" model="ir.ui.view">
		<field name="name">product.template.search.customization</field>
		<field name="model">product.template</field>
		<field name="inherit_id" ref="product.product_template_search_view"/>
		<field name="priority" eval="99" />
		<field name="arch" type="xml">
			<data>
				<field name="categ_id" position="after">
					<field name="x_product_tag" filter_domain="[('x_product_tag', 'ilike', self)]"/>
				</field>
				<filter name="consumable" position="after">
					<separator/>
					<filter name="in_il_coo"  string="COO in IN &amp; IL" domain="[('x_country_id','in', [104, 66])]"/>
					<separator/>
					<filter name="critical"  string="Critical Products" domain="[('x_critical','!=', False)]"/>
					<filter name="backorder_products"  string="Backorder Products" domain="[('x_backorder_qty','!=', 0)]"/>
					<separator/>
					<filter name="categ_01"  string="Raw Material Imported" domain="[('categ_id','=','Inventory / Raw Material Imported')]"/>
					<filter name="categ_02"  string="Raw Material Local" domain="[('categ_id','=','Inventory / Raw Material Local')]"/>
					<filter name="categ_03"  string="Semi Finished Goods [SFG]" domain="[('categ_id','ilike','Inventory / Semi Finished Goods')]"/>
					<filter name="categ_04"  string="Finished Goods-IP-TypeA" domain="[('categ_id','=','Inventory / Finished Goods-IP-TypeA (20% , 5%) [FG]')]"/>
					<filter name="categ_05"  string="Finished Goods-IP-TypeB" domain="[('categ_id','=','Inventory / Finished Goods-IP-TypeB (10% , 3%) [FG]')]"/>
					<filter name="categ_06"  string="Finished Goods-IP-TypeC" domain="[('categ_id','=','Inventory / Finished Goods-IP-TypeC (5% , 1%) [FG]')]"/>
					<filter name="categ_07"  string="Finished Goods-TP-TypeA" domain="[('categ_id','=','Inventory / Finished Goods-TP-TypeA (0% , 5%) [FG]')]"/>
					<filter name="categ_08"  string="Finished Goods-TP-TypeB" domain="[('categ_id','=','Inventory / Finished Goods-TP-TypeB (0% , 3%) [FG]')]"/>
					<filter name="categ_09"  string="Finished Goods-TP-TypeC" domain="[('categ_id','=','Inventory / Finished Goods-TP-TypeC (0% , 1%) [FG]')]"/>
					<filter name="categ_10"  string="Finished Goods-TP-TypeD" domain="[('categ_id','=','Inventory / Finished Goods-TP-TypeD (0% , 0%) [FG]')]"/>
				</filter>
                <filter name="categ_id" position="after">
                    <filter string="Product Division" name="x_product_division" context="{'group_by':'x_product_division'}"/>
                    <filter string="Product Series" name="x_product_series" context="{'group_by':'x_product_series'}"/>
                    <filter string="Product Group" name="x_product_group" context="{'group_by':'x_product_group'}"/>
                </filter>
			</data>
		</field>
	</record>
	<!-- Product Categories -->
	<record id="product_category_list_view_customization" model="ir.ui.view">
		<field name="name">product.category.list.customization</field>
		<field name="model">product.category</field>
		<field name="inherit_id" ref="product.product_category_list_view"/>
		<field name="priority">99</field>
		<field name="arch" type="xml">
			<data>
				<xpath expr="//field[@name='display_name']" position="after">

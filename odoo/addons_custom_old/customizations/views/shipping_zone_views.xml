<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shipping_zone_form" model="ir.ui.view">
        <field name="name">shipping.zone.form</field>
        <field name="model">shipping.zone</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="x_name" placeholder="Zone Name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shipping_zone_tree" model="ir.ui.view">
        <field name="name">shipping.zone.tree</field>
        <field name="model">shipping.zone</field>
        <field name="arch" type="xml">
            <tree string="Shipping Zone">
                <field name="x_name"/>
            </tree>
        </field>
    </record>

    <record id="action_shipping_zone" model="ir.actions.act_window">
        <field name="name">Shipping Zones</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">shipping.zone</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Shipping Zone
            </p>
        </field>
    </record>

    <menuitem id="menu_shipping_zone"
              name="Shipping Zones"
              parent="contacts.menu_localisation"
              action="action_shipping_zone"
              sequence="4"/>

    <record id="view_shipping_rates_form" model="ir.ui.view">
        <field name="name">shipping.rates.form</field>
        <field name="model">shipping.rates</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="x_name" invisible="1"/>
                            <field name="x_carrier"/>
                            <field name="x_zone"/>
                            <field name="x_shipping"/>
                            <field name="x_multiplier"/>
                        </group>
                        <group>
                            <label for="x_date_from" string="Period"/>
                            <div>
                                <field name="x_date_from" class="oe_inline"/>
                                -
                                <field name="x_date_to" class="oe_inline"/>
                            </div>
                            <label for="x_weight_from" string="Weight Range (kg)"/>
                            <div>
                                <field name="x_weight_from" class="oe_inline"/>
                                -
                                <field name="x_weight_to" class="oe_inline"/>
                            </div>
                            <field name="currency_id" invisible="1"/>
                            <field name="x_rate" widget='monetary'/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shipping_rates_tree" model="ir.ui.view">
        <field name="name">shipping.rates.tree</field>
        <field name="model">shipping.rates</field>
        <field name="arch" type="xml">
            <tree string="Shipping Zone">
                <field name="x_carrier"/>
                <field name="x_zone"/>
                <field name="x_shipping"/>
                <field name="x_multiplier"/>
                <field name="x_date_from"/>
                <field name="x_date_to"/>
                <field name="x_weight_from"/>
                <field name="x_weight_to"/>
                <field name="currency_id" invisible="1"/>
                <field name="x_rate" widget='monetary'/>
            </tree>
        </field>
    </record>

    <record id="view_shipping_rates_filter" model="ir.ui.view">
        <field name="name">shipping.rates.select</field>
        <field name="model">shipping.rates</field>
        <field name="arch" type="xml">
            <search string="Search Shipping Rates">
                <field name="x_name" string="Name"/>
                <field name="x_carrier" string="Carrier"/>
                <field name="x_zone" string="Shipping Zone"/>
                <filter string="DHL Rates" name="dhl_rates" domain="[('x_carrier', '=', 2)]"/>
                <filter string="UPS Rates" name="ups_rates" domain="[('x_carrier', '=', 6)]"/>
                <group expand="0" string="Group By">
                    <filter string="Carrier" name="Carrier" context="{'group_by': 'x_carrier'}"/>
                    <filter string="Shipping Zone" name="Shipping Zone" context="{'group_by': 'x_zone'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_shipping_rates" model="ir.actions.act_window">
        <field name="name">Shipping Rates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">shipping.rates</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Shipping Rates
            </p>
        </field>
    </record>

    <menuitem id="menu_shipping_rates"
              name="Shipping Rates"
              parent="contacts.menu_localisation"
              action="action_shipping_rates"
              sequence="4"/>

    <record id="view_fuel_surcharge_form" model="ir.ui.view">
        <field name="name">fuel.surcharge.form</field>
        <field name="model">fuel.surcharge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="x_name"/>
                            <field name="x_carrier"/>
                        </group>
                        <group>
                            <field name="x_date_from"/>
                            <field name="x_rate" widget="percentage"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fuel_surcharge_tree" model="ir.ui.view">
        <field name="name">fuel.surcharge.tree</field>
        <field name="model">fuel.surcharge</field>
        <field name="arch" type="xml">
            <tree string="Fuel Surcharge">
                <field name="x_name"/>
                <field name="x_carrier"/>
                <field name="x_date_from"/>
                <field name="x_rate" widget="percentage"/>
            </tree>
        </field>
    </record>

    <record id="view_fuel_surcharge_filter" model="ir.ui.view">
        <field name="name">fuel.surcharge.select</field>
        <field name="model">fuel.surcharge</field>
        <field name="arch" type="xml">
            <search string="Search Fuel Surcharge">
                <field name="x_name"/>
                <field name="x_carrier"/>
                <field name="x_date_from"/>
                <group expand="0" string="Group By">
                    <filter string="Carrier" name="Carrier" context="{'group_by': 'x_carrier'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fuel_surcharge" model="ir.actions.act_window">
        <field name="name">Fuel Surcharge</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fuel.surcharge</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Fuel Surcharge
            </p>
        </field>
    </record>

    <menuitem id="menu_fuel_surcharge"
              name="Fuel Surcharge"
              parent="contacts.menu_localisation"
              action="action_fuel_surcharge"
              sequence="4"/>

    <act_window id="action_carrier_shipping_rates"
                name="Shipping Rates"
                view_mode='tree,form'
                view_id='view_shipping_rates_tree'
                domain="[('x_carrier','=', active_id)]"
                context="{'default_x_carrier': active_id}"
                res_model="shipping.rates"/>

    <act_window id="action_carrier_fuel_surcharge"
                name="Fuel Surcharge"
                view_mode='tree,form'
                view_id='view_fuel_surcharge_tree'
                domain="[('x_carrier','=', active_id)]"
                context="{'default_x_carrier': active_id}"
                res_model="fuel.surcharge"/>

    <record id="view_delivery_carrier_form_customization_0" model="ir.ui.view">
        <field name="name">delivery.carrier.form.customization</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//button[@name='toggle_debug'][1]" position="after">
                    <button class="oe_stat_button" string="Shipping Rates" type="action" name="%(action_carrier_shipping_rates)d" icon="fa-money" widget="statinfo"/>
                    <button class="oe_stat_button" string="Fuel Surcharge" type="action" name="%(action_carrier_fuel_surcharge)d" icon="fa-money" widget="statinfo"/>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
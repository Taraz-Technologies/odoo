<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sale Order Reports -->
        <report id="action_report_end_user_document"
            string="End-uer Document"
            model="sale.order"
            report_type="qweb-pdf"
            file="customizations.report_end_user_document"
            name="customizations.report_end_user_document"
            print_report_name="'End-user Document - %s' % (object.name)"
            paperformat="base.paperformat_euro_borderless"/>
        <!-- Invoice Reports -->
        <report id="action_custom_report_invoice"
            string="Invoice"
            model="account.move"
            report_type="qweb-pdf"
            file="customizations.custom_report_invoice"
            name="customizations.custom_report_invoice"
            print_report_name="'%s - %s' % (object.x_invoice_docs_number or object.name, object.x_sale_order.name)"/>

        <report id="action_report_sales_tax_invoice"
            string="Invoice Sale Tax"
            model="account.move"
            report_type="qweb-pdf"
            file="customizations.report_sales_tax_invoice"
            name="customizations.report_sales_tax_invoice"
            print_report_name="'Sales Tax Invoice - %s' % (object.x_sale_order.name)"/>

        <report id="action_custom_report_invoice_banking"
            string="Invoice Banking"
            model="account.move"
            menu="False"
            report_type="qweb-pdf"
            file="customizations.custom_report_invoice_banking"
            name="customizations.custom_report_invoice_banking"
            print_report_name="'Banking Invoice - %s (%s)' % (object.x_sale_tax_invoice_number, object.x_sale_order.name)"/>
    </data>
</odoo>

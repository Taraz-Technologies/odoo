<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_stock_move_line_detailed_operation_tree_cus_stock" model="ir.ui.view">
            <field name="name">stock.move.line.operations.tree.cus_stock</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
            <field name="priority">1000</field>
            <field name="arch" type="xml">
                <data>
                    <field name="product_uom_qty" position="before">
                        <field name="x_location_ids" widget="many2many_tags" optional="show"
                               attrs="{'column_invisible': [('parent.x_show_recommended_locations', '=', False)]}"/>
                    </field>
                </data>
            </field>
        </record>

        <record id="view_move_tree_receipt_picking_cus_stock" model="ir.ui.view">
            <field name="name">view_move_tree_receipt_picking_cus_stock</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="customizations.view_move_tree_receipt_picking_customization"/>
            <field name="priority">1000</field>
            <field name="arch" type="xml">
                <data>
                    <field name="x_finished_product_id" position="after">
                        <field name="x_custom_tag_ids" widget="many2many_tags" optional="hide"
                               options="{'color_field': 'color'}"/>
                        <field name="x_notes" optional="hide"/>
                    </field>
                </data>
            </field>
        </record>

        <record id="view_move_search_cus_stock" model="ir.ui.view">
            <field name="name">view.move.search.cus.stock</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_move_search"/>
            <field name="arch" type="xml">
                <filter name="outgoing" position="after">
                    <separator/>
                    <filter string="Tagged" name="tagged" domain="[('x_custom_tag_ids', '!=', False)]"/>
                </filter>
                <field name="origin" position="replace">
                    <field name="origin"
                           filter_domain="['|', '|', '|', ('x_custom_tag_ids', 'ilike', self), ('origin', 'ilike', self), ('name', 'ilike', self), ('picking_id', 'ilike', self)]"
                           string="Reference"/>
                </field>
            </field>
        </record>

        <!-- Inherit Form View to Modify it -->
        <record id="view_move_line_form_cus_logistics_tracking" model="ir.ui.view">
            <field name="name">view_move_line_form_cus_logistics_tracking</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_form"/>
            <field name="arch" type="xml">
                <field name="origin" position="after">
                    <field name="x_source_manufacturing_id"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
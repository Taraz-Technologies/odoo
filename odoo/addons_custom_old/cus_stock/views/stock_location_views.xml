<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<data>
		<record id="view_location_form_cus_stock" model="ir.ui.view">
			<field name="name">stock.location.form.cus_stock</field>
			<field name="model">stock.location</field>
			<field name="inherit_id" ref="stock.view_location_form"/>
			<field name="arch" type="xml">
				<data>
					<label for="name" position="before">
						<field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
					</label>
					<field name="removal_strategy_id" position="after">
						<field name="x_product_type_id"/>
						<field name="x_product_sub_type_id"/>
						<field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
					</field>
				</data>
			</field>
		</record>

		<record id="view_location_tree2_cus_stock" model="ir.ui.view">
			<field name="name">stock.location.tree.cus_stock</field>
			<field name="model">stock.location</field>
			<field name="inherit_id" ref="stock.view_location_tree2"/>
			<field name="arch" type="xml">
				<data>
					<field name="usage" position="before">
						<field name="comment"/>
					</field>
					<field name="usage" position="after">
						<field name="x_product_type_id"/>
						<field name="x_product_sub_type_id"/>
						<field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
					</field>
				</data>
			</field>
		</record>

		<record id="view_location_search_cus_stock" model="ir.ui.view">
			<field name="name">stock.location.search.cus_stock</field>
			<field name="model">stock.location</field>
			<field name="inherit_id" ref="stock.view_location_search"/>
			<field name="arch" type="xml">
				<data>
					<field name="location_id" position="after">
						<field name="x_product_type_id"/>
						<field name="x_product_sub_type_id"/>
						<field name="x_tag_ids" widget="many2many_tags"/>
					</field>
				</data>
			</field>
		</record>
	</data>
</odoo>
	<record id="bom_tool_search_view" model="ir.ui.view">
		<field name="name">bom.tool.search.view</field>
		<field name="model">bom.tool</field>
		<field name="arch" type="xml">
			<search string="BoM Tool">
				<field name="x_name" string="BoM Tool" filter_domain="['|', '|', ('x_name', 'ilike', self), ('x_base_product_id', 'ilike', self), ('x_variant_ids', 'ilike', self),]"/>
				<field name="x_tag_ids"/>
				<separator/>
				<filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
				<filter name="to_be_review" string="To be Reviewed" domain="[('state', '=', 'to_be_review')]"/>
				<filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
				<filter name="inactive" string="Inactive" domain="[('state', '=', 'inactive')]"/>
				<separator/>
				<filter name="finished_good" string="Finished Goods" domain="[('x_finished_good', '=', 'finished')]"/>
				<filter name="semi_finished_good" string="Semi-Finished Goods" domain="[('x_finished_good', '=', 'semi_finished')]"/>
				<separator/>
                <filter name="enable_safety_stock" string="Safety Stock Enabled" domain="[('x_enable_safety_stock', '=', True)]"/>
                <filter name="disable_safety_stock" string="Safety Stock Disabled" domain="[('x_enable_safety_stock', '=', False)]"/>
                <separator/>
				<filter name="system" string="Systems" domain="[('x_product_type_fg', '=', 'system')]"/>
				<filter name="pcb" string="PCB Module" domain="['|', ('x_product_type_fg', '=', 'pcb'), ('x_product_type_sfg', '=', 'pcb')]"/>
				<filter name="cable" string="CBL Assembly" domain="[('x_product_type_sfg', '=', 'cable')]"/>
				<filter name="mechanical" string="MECH Assembly" domain="[('x_product_type_sfg', '=', 'mechanical')]"/>
				<filter name="other" string="Other Assembly" domain="[('x_product_type_sfg', '=', 'other')]"/>
				<filter name="inductor" string="Inductor" domain="[('x_product_type_sfg', '=', 'inductor')]"/>
				<filter name="transformer" string="Transformer" domain="[('x_product_type_sfg', '=', 'transformer')]"/>
				<group col="4" colspan="4" string="Group By" expand="0">
                    <filter string="Product Type" name="product_type" context="{'group_by':'x_finished_good'}"/>
                    <filter string="FG Type" name="product_type_fg" context="{'group_by':'x_product_type_fg'}"/>
                    <filter string="SFG Type" name="product_type_sfg" context="{'group_by':'x_product_type_sfg'}"/>
				</group>
			</search>
		</field>
	</record>


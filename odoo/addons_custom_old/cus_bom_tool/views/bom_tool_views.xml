<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--	BoM Tool Views-->
	<record id="bom_tool_form_view" model="ir.ui.view">
		<field name="name">bom.tool.form.view</field>
		<field name="model">bom.tool</field>
		<field name="arch" type="xml">
			<form string="BoM Tool">
				<header>
					<button name="change_state_to_draft" string="Set to draft" type="object" class="btn-primary" states="active,inactive"/>
					<button name="change_state_to_review" string="To Review" type="object" class="btn-primary" states="draft"/>
					<button name="change_state_to_active" string="Reviewed" type="object" class="btn-success" states="to_be_review"/>
					<button name="change_state_to_inactive" string="Mark as Inactive" type="object" class="btn-danger" states="active"/>
					<field name="state" widget="statusbar"/>
				</header>
				<div name="button_box" class="oe_button_box">
					<button name="action_view_note" type="object" string="Help" class="oe_stat_button" icon="fa-question"/>
					<button type="object" name="action_view_base_bom_lines" class="oe_stat_button" icon="fa-align-justify">
						<div class="o_field_widget o_stat_info">
							<span class="o_stat_value">
								<field name="x_base_bom_line_count" widget="statinfo" nolabel="1" class="mr4"/>
							</span>
							<span class="o_stat_text">BoM Lines</span>
						</div>
					</button>
					<field name="x_task_id" invisible="1"/>
					<button string="Task"
							name="action_view_task"
							type="object"
							class="oe_stat_button"
							icon="fa-tasks"
							attrs="{'invisible': [('x_task_id', '=', False)]}"/>
				</div>
				<div class="oe_title mb-0">
					<h2><field name="x_name"/></h2>
				</div>
				<group col="3" class="mt-0 mb-0">
					<group>
						<field name="x_finished_good" attrs="{'readonly': [('x_base_bom_id', '!=', False)]}"/>
						<label for="x_product_type_fg" attrs="{'invisible': [('x_finished_good', '!=', 'finished')]}"/>
						<div class="o_row" style="white-space: nowrap;" attrs="{'invisible': [('x_finished_good', '!=', 'finished')]}">
							<field name="x_product_type_fg"/>
							<field name="x_product_variants"/><span>Variants?</span>
							<field name="x_enable_safety_stock"/><span>Enable Safety Stock?</span>
						</div>
						<label for="x_product_type_sfg" attrs="{'invisible': [('x_finished_good', '!=', 'semi_finished')]}"/>
						<div class="o_row" style="white-space: nowrap;" attrs="{'invisible': [('x_finished_good', '!=', 'semi_finished')]}">
							<field name="x_product_type_sfg"/>
							<field name="x_product_variants"/><span>Variants?</span>
							<field name="x_enable_safety_stock"/><span>Enable Safety Stock?</span>
						</div>
						<label for="x_base_product_name" string="Base Product (SFG)" attrs="{'invisible': [('x_product_variants', '=', False)]}"/>
						<div class="o_row" style="white-space: nowrap;" attrs="{'invisible': [('x_product_variants', '=', False)]}">
							<field name="x_base_product_prefix" attrs="{'invisible': [('x_product_variants', '=', False)]}"/>
							<field name="x_base_product_name" placeholder="Product Name"/>
							<field name="x_base_product_id"/>
						</div>
						<label for="x_base_product_name" string="Product Name (FG)" attrs="{'invisible': [('x_product_variants', '!=', False)]}"/>
						<div class="o_row" style="white-space: nowrap;" attrs="{'invisible': [('x_product_variants', '!=', False)]}">
							<field name="x_base_product_name" placeholder="Product Name"/>
							<field name="x_base_product_id"/>
						</div>
						<field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
					</group>
					<group/>
					<group>
						<field name="image_1920" widget="image" class="oe_avatar" options="{'zoom': true, 'zoom_delay': 1000}" nolabel="1"/>
					</group>
				</group>
				<notebook>
					<page name="bom_tool" string="General Info">
						<div class="row" style="padding-left: 15px; padding-right: 15px;">
							<div class="col-8 p-1">
								<group col="4">
									<field name="x_team_lead_id"/>
									<field name="x_team_member_ids" widget="many2many_tags"/>
								</group>
								<group col="2">
									<field name="x_bom_tool_description"/>
								</group>
								<field name="x_compute_bom_tool_boms" invisible="1"/>
								<separator col="4" string="BoM Versions"/>
								<field name="x_bom_tool_bom_ids">
									<tree editable="bottom" create="0" delete="0">
										<field name="x_name" readonly="1"/>
										<field name="x_bom_comment"/>
									</tree>
								</field>
								<separator col="4" string="Task List"/>
								<field name="x_bom_tool_checklist">
									<tree editable="bottom"
										  decoration-danger="x_state == 'todo'"
										  decoration-success="x_state == 'done'">
										<button name="create_task"
												string="Create Task"
												type="object"
												icon="fa-hand-o-right"
												attrs="{'invisible': [('x_task_id', '!=',False)]}"/>
										<field name="x_description"/>
										<field name="x_user_id"/>
										<field name="x_deadline"/>
										<field name="x_state" readonly="1"/>
										<field name="x_task_id" widget="many2one" readonly="1"/>
										<field name="x_user_stage_id" invisible="1"/>
										<button name="change_state_to_done"
												string="Change state to DONE"
												type="object"
												icon="fa-check"
												attrs="{'invisible': [('x_state', 'in',['done', 'cancelled'])]}"/>
										<button name="change_state_to_todo"
												string="Change state to TODO"
												type="object"
												icon="fa-caret-square-o-right"
												attrs="{'invisible': [('x_state', '=', 'todo')]}"/>
									</tree>
									<form>
										<sheet>
											<group col="2">
												<field name="x_description" />
											</group>
											<group col="4">
												<field name="x_user_id"/>
												<field name="x_state"/>
											</group>
										</sheet>
									</form>
								</field>
							</div>
							<div class="col-4 p-1">
								<div class="oe_chatter">
									<field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
									<field name="message_ids" widget="mail_thread"/>
									<field name="activity_ids" widget="mail_activity"/>
								</div>
							</div>
						</div>
					</page>
					<page name="base_bom" string="BoM Processing">
						<div class="row" style="padding-left: 15px; padding-right: 15px;">
							<div class="col-8 p-1">
								<group col="2" class="mt-0 mb-0">
									<group class="mt-0 mb-0">
										<label for="x_base_bom_id"/>
										<div class="o_row" style="white-space: nowrap;">
											<field name="x_base_bom_id"/>
											<button name="create_base_bom" string="Create" type="object" class="btn-primary oe_edit_only"
													attrs="{'invisible': ['|', ('x_product_type_fg', '=', 'pcb'), ('x_product_type_sfg', '=', 'pcb')]}"/>
											<button name="open_import_file_wizard" string="Import" type="object" class="btn-primary oe_edit_only"/>
											<button name="duplicate_bom" string="Duplicate" type="object" class="btn-primary oe_edit_only"
													confirm="Are you sure you want to duplicate BoM?"/>
											<button name="download_bom" type="object" class="btn-secondary" icon="fa-download"/>
										</div>
									</group>
									<group class="mt-0 mb-0">
										<field name="x_routing_id"/>
									</group>
									<group class="mt-0 mb-0 oe_edit_only">
										<field name="x_search_base_bom_lines" placeholder="Search Lines (Attached BoMs, RefDes, Part, Description, Notes)"/>
										<label for="x_search_base_bom_lines" string="Update Data"/>
										<div class="o_row" style="white-space: nowrap;">
											<field name="x_select_base_bom_lines"/>
											<label for="x_select_base_bom_lines"/>
											<field name="x_compute_base_selection" invisible="1"/>
											<button name="clear_base_all_filters" string="Clear All Filters" type="object" class="btn-primary"/>
										</div>
									</group>
									<group class="mt-0 mb-0 oe_edit_only">
										<div class="o_row mb-1" style="white-space: nowrap;">
											<button name="base_bom_lines_dnp" string="... DNP ...." type="object" class="btn-primary"/>
											<button name="base_bom_lines_critical" string="... CRITICAL ...." type="object" class="btn-danger"/>
											<button name="base_bom_lines_variant" string="... VAR ...." type="object" class="btn-warning" attrs="{'invisible': [('x_product_variants', '=', False)]}"/>
											<button name="base_bom_lines_investment_part" string="... IP ...." type="object" class="btn-info"/>
											<button name="base_bom_lines_smd" string="SMD" type="object" class="btn-dark"/>
											<button name="base_bom_lines_th" string="TH" type="object" class="btn-dark"/>
											<button name="add_base_bom_lines" string=".. Add BoM Lines .." type="object" class="btn-warning"/>
										</div>
										<br/>
										<div class="o_row mb-1" style="white-space: nowrap;">
											<button name="base_bom_lines_non_dnp" string="NON DNP" type="object" class="btn-primary"/>
											<button name="base_bom_lines_non_critical" string="NON CRITICAL" type="object" class="btn-danger"/>
											<button name="base_bom_lines_non_variant" string="NON VAR" type="object" class="btn-warning" attrs="{'invisible': [('x_product_variants', '=', False)]}"/>
											<button name="base_bom_lines_non_investment_part" string="NON IP" type="object" class="btn-info"/>
											<button name="base_bom_lines_other" string="... OTHER ...." type="object" class="btn-dark"/>
											<button name="delete_base_bom_lines" string="Delete" type="object" class="btn-danger"/>
											<button name="restore_base_bom_lines" string="Restore" type="object" class="btn-success"/>
										</div>
									</group>
									<group class="mt-0 mb-0 oe_edit_only">
										<field name="x_filter_base_bom_lines" widget="radio" options="{'horizontal': true}"/>
										<label for="x_undefined_base_bom_lines" string="Filter All Lines"/>
										<div class="o_row" style="white-space: nowrap;">
											<field name="x_undefined_base_bom_lines"/>
											<label for="x_undefined_base_bom_lines"/>
											<field name="x_dnp_base_bom_lines"/>
											<label for="x_dnp_base_bom_lines"/>
											<field name="x_non_dnp_base_bom_lines"/>
											<label for="x_non_dnp_base_bom_lines"/>
											<field name="x_critical_base_bom_lines"/>
											<label for="x_critical_base_bom_lines"/>
											<field name="x_variant_base_bom_lines" attrs="{'invisible': [('x_product_variants', '=', False)]}"/>
											<label for="x_variant_base_bom_lines" attrs="{'invisible': [('x_product_variants', '=', False)]}"/>
											<field name="x_investor_base_bom_lines"/>
											<label for="x_investor_base_bom_lines"/>
										</div>
									</group>
									<group class="mt-0 mb-0 oe_edit_only">
										<label for="x_new_design_base_bom_lines" string="Filter Design" attrs="{'invisible': [('x_product_type_fg', '!=', 'pcb'), ('x_product_type_sfg', '!=', 'pcb')]}"/>
										<div class="o_row" style="white-space: nowrap;" attrs="{'invisible': [('x_product_type_fg', '!=', 'pcb'), ('x_product_type_sfg', '!=', 'pcb')]}">
											<field name="x_new_design_base_bom_lines"/>
											<label for="x_new_design_base_bom_lines"/>
											<field name="x_modified_design_base_bom_lines"/>
											<label for="x_modified_design_base_bom_lines"/>
											<field name="x_deleted_design_base_bom_lines"/>
											<label for="x_deleted_design_base_bom_lines"/>
										</div>
										<label for="x_new_base_bom_lines" string="Filter Odoo"/>
										<div class="o_row" style="white-space: nowrap;">
											<field name="x_new_base_bom_lines"/>
											<label for="x_new_base_bom_lines"/>
											<field name="x_modified_base_bom_lines"/>
											<label for="x_modified_base_bom_lines"/>
											<field name="x_deleted_base_bom_lines"/>
											<label for="x_deleted_base_bom_lines"/>
											<field name="x_moved_base_bom_lines"/>
											<label for="x_moved_base_bom_lines"/>
										</div>
									</group>
								</group>
							</div>
							<div class="col-4 p-1">
								<group class="mt-0 mb-0 oe_edit_only">
									<label for="x_bom_line_product_id"/>
									<div class="o_row">
										<field name="x_bom_line_product_id"/>
										<button name="update_bom_line_products" string="Update" type="object" class="btn-primary"/>
									</div>
									<label for="x_operation_id"/>
									<div class="o_row">
										<field name="x_operation_id" options="{'no_quick_create':True,'no_create_edit':True}"/>
										<button name="update_bom_line_operation" string="Update" type="object" class="btn-primary"/>
									</div>
									<label for="x_bom_line_notes"/>
									<div class="o_row">
										<field name="x_bom_line_notes"/>
										<button name="update_bom_line_notes" string="Update" type="object" class="btn-primary"/>
									</div>
									<label for="x_move_to_bom_tool_id"/>
									<div class="o_row">
										<field name="x_move_to_bom_tool_id" options="{'no_quick_create': True, 'no_create_edit': True}"/>
										<button name="update_bom_line_move_to" string="Move .." type="object" class="btn-primary"/>
									</div>
									<label for="x_attached_block_ids"/>
									<div class="o_row">
										<field name="x_attached_block_ids" widget="many2many_tags" readonly="1"/>
										<button name="open_block_update_wizard" string="Update" type="object" class="btn-primary"/>
									</div>
								</group>
							</div>
						</div>
						<field name="x_bom_line_ids">
							<tree editable="bottom" create="0" delete="0" decoration-success="x_line_select == True" decoration-muted="x_line_select == False" decoration-danger="x_master_bom_line_id != False">
								<field name="x_base_bom_id" invisible="1"/>
								<field name="x_master_bom_line_id" invisible="1"/>
								<field name="x_bom_tool_id" invisible="1"/>
								<field name="x_base_product_id" invisible="1"/>
								<field name="x_line_select" invisible="1"/>
								<field name="x_routing_id" invisible="1"/>
								<button name="select_bom_line" icon="fa-check" string="Select / Unselect Line" type="object" class="oe_edit_only"/>
								<field name="image_128" widget="image" class="o_kanban_image_fill_left" optional="hide"/>
								<field name="x_name" optional="show"/>
								<field name="x_part_description" optional="hide"/>
								<field name="x_ref_des"/>
								<field name="x_old_product_id" optional="hide"/>
								<field name="x_taraz_part_id" optional="show"/>
								<field name="x_enable_safety_stock" optional="show"/>
								<field name="x_product_id"/>
								<field name="x_active" optional="hide"/>
								<field name="x_quantity" optional="hide"/>
								<field name="x_uom_id" optional="hide"/>
								<field name="x_description" optional="hide"/>
								<field name="x_line_block_id" readonly="1" widget="many2one" optional="hide"/>
								<field name="x_operation_id" options="{'no_quick_create':True,'no_create_edit':True}" optional="hide"/>
								<field name="x_notes" optional="hide"/>
								<field name="x_move_to_tool_id" options="{'no_quick_create': True, 'no_create_edit': True}" widget="many2one" optional="hide"/>
								<field name="x_move_from_tool_id" widget="many2one" optional="hide"/>
								<field name="x_type"/>
								<field name="x_dnp"/>
								<field name="x_critical"/>
								<field name="x_variant" attrs="{'column_invisible': [('parent.x_product_variants', '=', False)]}"/>
								<field name="x_investor_product" optional="hide"/>
							</tree>
						</field>
					</page>
					<page name="product_variants" string="Product Variants Creation" attrs="{'invisible': [('x_product_variants', '=', False)]}">
						<div class="row oe_edit_only" style="padding-left: 15px; padding-right: 15px; border-bottom: 1px solid gray;">
							<div class="col-4 p-1">
								<group col="2">
									<field name="x_product_categ_id" options="{'no_quick_create': True, 'no_create_edit': True}"/>
									<field name="x_product_tag_id"/>
								</group>
								<separator col="4" string="Variant Attributes"/>
								<field name="x_variant_attribute_line_ids">
									<tree>
										<field name="x_bom_tool_id" invisible="1"/>
										<field name="sequence" widget="handle"/>
										<field name="x_attribute_id"/>
										<field name="x_attribute_tag_ids" widget="many2many_tags"/>
									</tree>
								</field>
								<div class="o_row oe_right" style="white-space: nowrap;">
									<button name="compute_product_variants" string="Compute Variant Names" type="object" class="oe_highlight"/>
								</div>
							</div>
							<div class="col-8 p-1">
								<group>
									<group class="mt0 mb0" string="Product Details">
										<field name="x_base_product_id" readonly="1"/>
										<field name="x_product_group" options="{'no_quick_create': True, 'no_create_edit': True}"/>
										<field name="x_product_series" options="{'no_quick_create': True, 'no_create_edit': True}"/>
										<field name="x_product_division" options="{'no_quick_create': True, 'no_create_edit': True}"/>
										<field name="dk_hs_code" options="{'no_quick_create': True, 'no_create_edit': True}"/>
										<field name="x_hs_code_tr_id" options="{'no_quick_create': True, 'no_create_edit': True}"/>
										<field name="x_country_id" options="{'no_quick_create': True, 'no_create_edit': True}"/>
									</group>
									<group class="mt0 mb0" string="Update Descriptions">
										<label for="x_base_description"/>
										<div class="o_row" style="white-space: nowrap;">
											<field name="x_base_description"
												   placeholder="Add {ATTRIBUTE} like that to apply attribute value in description."/>
											<button name="update_description" string="Update" type="object" class="btn-primary"/>
										</div>
										<label for="x_base_description_sale"/>
										<div class="o_row" style="white-space: nowrap;">
											<field name="x_base_description_sale"
												   placeholder="Add {ATTRIBUTE} like that to apply attribute value in description."/>
											<button name="update_description_sale" string="Update" type="object" class="btn-primary"/>
										</div>
										<label for="x_base_short_description"/>
										<div class="o_row" style="white-space: nowrap;">
											<field name="x_base_short_description"
												   placeholder="Add {ATTRIBUTE} like that to apply attribute value in description."/>
											<button name="update_short_description" string="Update" type="object" class="btn-primary"/>
										</div>
										<label for="x_base_description_pickingout"/>
										<div class="o_row" style="white-space: nowrap;">
											<field name="x_base_description_pickingout"
												   placeholder="Add {ATTRIBUTE} like that to apply attribute value in description."/>
											<button name="update_description_pickingout" string="Update" type="object" class="btn-primary"/>
										</div>
									</group>
								</group>
							</div>
						</div>
						<group col="8" class="oe_edit_only">
							<group colspan="2">
								<label for="x_search_product_variant"/>
								<div class="o_row" style="white-space: nowrap;">
									<field name="x_search_product_variant" placeholder="Variant Contains"/>
								</div>
							</group>
							<group colspan="2">
								<field name="x_currency_id" invisible="1"/>
								<label for="x_list_price" string="Sale Price - Weight"/>
								<div class="o_row" style="white-space: nowrap;">
									<field name="x_list_price" placeholder="Sale Price" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
									<field name="x_weight" placeholder="Weight"/>
									<button name="update_variant_data" string="Update" type="object" class="btn-primary"/>
								</div>
							</group>
							<group colspan="2">
								<label for="x_variant_categ_id"/>
								<div class="o_row" style="white-space: nowrap;">
									<field name="x_variant_categ_id" placeholder="Select Category" options="{'no_quick_create': True, 'no_create_edit': True}"/>
									<button name="update_variant_categ_id" string="Update" type="object" class="btn-primary"/>
								</div>
							</group>
						</group>
						<separator col="4" string="Product Variants"/>
						<field name="x_product_variant_ids">
							<tree editable="bottom" create="0">
								<field name="x_bom_tool_id" invisible="1"/>
								<field name="x_description" invisible="1"/>
								<field name="x_short_description" invisible="1"/>
								<field name="x_description_pickingout" invisible="1"/>
								<field name="x_description_sale" invisible="1"/>
								<field name="x_currency_id" invisible="1"/>

								<field name="x_name"/>
								<button name="create_product" icon="fa-play" string="Create Product" type="object"/>
								<field name="x_product_id" widget="many2one" readonly="1"/>
								<field name="x_list_price" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
								<field name="x_weight" string="Weight (kg)"/>
								<field name="x_categ_id" options="{'no_quick_create': True, 'no_create_edit': True}"/>

								<field name="x_var_description" optional="show"/>
								<field name="x_var_description_sale" optional="show"/>
								<field name="x_var_short_description" optional="show"/>
								<field name="x_var_description_pickingout" optional="show"/>
							</tree>
							<form>
								<sheet>
									<group col="4">
										<field name="x_name"/>
										<field name="x_product_id" widget="many2one"/>
										<field name="x_bom_tool_id"/>
									</group>
								</sheet>
							</form>
						</field>
					</page>
					<page name="variant_bom" string="Variants BoM Processing" attrs="{'invisible': [('x_product_variants', '=', False)]}">
						<div class="row" style="padding-left: 15px; padding-right: 15px;">
							<div class="col-4 p-1">

	<record id="bom_tool_kanban_view" model="ir.ui.view">
		<field name="name">bom.tool.kanban.view</field>
		<field name="model">bom.tool</field>
		<field name="arch" type="xml">
			<kanban default_group_by="state" class="o_kanban_small_column">
				<field name="x_name"/>
				<field name="x_finished_good"/>
				<field name="x_product_type_fg"/>
				<field name="x_product_type_sfg"/>
				<field name="x_base_bom_id"/>
				<field name="state"/>
				<templates>
					<t t-name="kanban-box">
						<div class="oe_kanban_card oe_kanban_global_click">
							<div class="oe_kanban_content">
								<div class="o_kanban_record_headings" style="font-size:15pt;">
									<field name="x_name"/>
								</div>
								<div class="o_kanban_record_body">
									<field name="x_finished_good"/>
									<t t-if="record.x_finished_good.raw_value == 'finished'">
										<br/><field name="x_product_type_fg"/>
									</t>
									<t t-else="">
										<br/><field name="x_product_type_sfg"/>
									</t>
									<br/><field name="x_base_bom_id"/>
								</div>
							</div>
                            <div class="oe_clear"/>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<record id="bom_tool_tree_view" model="ir.ui.view">
		<field name="name">bom.tool.tree.view</field>
		<field name="model">bom.tool</field>

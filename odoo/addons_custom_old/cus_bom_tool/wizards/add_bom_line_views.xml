<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bom_line_addition_wizard_form" model="ir.ui.view">
        <field name="name">bom.line.addition.wizard.wizard.form</field>
        <field name="model">bom.line.addition.wizard</field>
        <field name="arch" type="xml">
            <form string="Add BoM Lines">
                <field name="x_bom_tool_id" invisible="1"/>
                <group col="4">
                    <field name="x_product_id" attrs="{'required': [('x_import_file', '=', False)]}"/>
                    <field name="x_taraz_part_id"/>
                    <label for="x_bom_lines" string="Ref Des - BoM Lines"/>
                    <div class="o_row">
                        <field name="x_ref_des" placeholder="Ref Des" attrs="{'required': [('x_import_file', '=', False)]}"/>
                        -
                        <field name="x_bom_lines" placeholder="BoM Lines" attrs="{'required': [('x_import_file', '=', False)]}"/>
                    </div>
                    <field name="x_critical"/>
                    <label for="x_quantity"/>
                    <div class="o_row">
                        <field name="x_quantity" attrs="{'required': [('x_import_file', '=', False)]}"/>
                        -
                        <field name="x_uom_id" attrs="{'required': [('x_import_file', '=', False)]}"/>
                    </div>
                    <field name="x_variant"/>
                    <field name="x_notes"/>
                    <field name="x_investor_product"/>
                    <field name="x_import_file" filename="x_file_name"/>
                    <field name="x_file_name" invisible="1"/>
                </group>
                <p>
                    Import Files Headers should be <b>RefDes | Part # | BoM Lines | Quantity | UoM</b>
                    <br/>
                    <b>BoM Lines</b> will decide how many lines should be created.
                </p>
                <footer>
                    <button name="add_bom_lines" string="Add Lines" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window id="action_bom_line_addition"
                name="Add BoM Lines"
                res_model="bom.line.addition.wizard"
                binding_model="bom.tool"
                binding_views="from"
                view_mode="form"
                target="new"/>
</odoo>
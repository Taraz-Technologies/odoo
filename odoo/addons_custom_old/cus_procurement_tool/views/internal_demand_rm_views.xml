<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="manual_proc_demand_view_form" model="ir.ui.view">
            <field name="name">manual_proc_demand_view_form</field>
            <field name="model">manual.proc.demand</field>
            <field name="arch" type="xml">
                <form string="Procurement Demand">
                    <sheet>
                        <group>
                            <field name="x_user_id"/>
                            <field name="x_product_id"/>
                            <field name="x_free_qty"/>
                            <field name="x_uom_id"/>
                            <field name="x_date"/>
                            <field name="x_product_qty"/>
                            <field name="x_delay_days"/>
                            <field name="x_url" widget="url"/>
                            <field name="x_note"/>
                            <field name="x_status"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="manual_proc_demand_view_tree" model="ir.ui.view">
            <field name="name">manual_proc_demand_view_tree</field>
            <field name="model">manual.proc.demand</field>
            <field name="arch" type="xml">
                <tree string="Procurement Demand" editable="top">
                    <field name="x_user_id" readonly="1"/>
                    <field name="x_product_id" attrs="{'readonly': [('x_status', '!=', 'draft')]}"/>
                    <field name="x_free_qty"/>
                    <field name="x_uom_id"/>
                    <field name="x_date" attrs="{'readonly': [('x_status', '!=', 'draft')]}"/>
                    <field name="x_delay_days" attrs="{'readonly': [('x_status', '!=', 'draft')]}"/>
                    <field name="x_product_qty" attrs="{'readonly': [('x_status', '!=', 'draft')]}"/>
                    <field name="x_url" widget="url"/>
                    <field name="x_note"/>
                    <field name="x_status" attrs="{'readonly': [('x_status', '!=', 'draft')]}"/>
                    <field name="x_company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <record id="manual_proc_demand_view_search" model="ir.ui.view">
           <field name="name">manual_proc_demand_view_search</field>
           <field name="model">manual.proc.demand</field>
            <field name="arch" type="xml">
                <search string="Procurement Demand">
                    <field name="x_product_id"/>
                    <field name="x_note"/>
                    <separator/>
                    <filter name="my_demand" string="My Demand" domain="[('x_user_id', '=', uid)]"/>
                    <separator/>
                    <filter name="draft" string="Draft" domain="[('x_status', '=', 'draft')]"/>
                    <filter name="in_progress" string="In Progress" domain="[('x_status', '=', 'in_progress')]"/>
                    <filter name="in_stock" string="In Stock" domain="[('x_status', '=', 'in_stock')]"/>
                    <group expand="0" colspan="4">
                        <filter string="Status" name="status" domain="[]" context="{'group_by': 'x_status'}"/>
                        <filter name="user_id" string="Demand from" context="{'group_by': 'x_user_id'}"/>
                        <filter name="company_id" string="Company" context="{'group_by': 'x_company_id'}"/>
                    </group>
                </search>
           </field>
        </record>

        <record id="manual_proc_demand_action" model="ir.actions.act_window">
            <field name="name">Procurement Demand</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">manual.proc.demand</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{"search_default_my_demand": 1}</field>
            <field name="domain">[]</field>
        </record>
    </data>
</odoo>
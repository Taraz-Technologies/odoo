<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_form_cus_procurement_tool" model="ir.ui.view">
            <field name="name">view_picking_form_cus_procurement_tool</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="/form/sheet/notebook/page[3]" position="after">
                    <page name="demand_details" string="Demand Details" attrs="{'invisible':[('picking_type_code','!=','incoming')]}">
                        <group col="4">
                            <field name="x_proc_cycle_id"/>
                        </group>
                        <field name="x_demand_list_ids">
                            <tree editable="bottom">
                                <field name="x_component_id"/>
                                <field name="x_manufacturing_id"/>
                                <field name="x_type"/>
                                <field name="x_sale_id"/>
                                <field name="x_deadline"/>
                                <field name="x_product_id"/>
                                <field name="x_quantity" sum="Total"/>
                                <field name="x_uom_id"/>
                            </tree>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="x_component_id"/>
                                        <field name="x_manufacturing_id"/>
                                        <field name="x_type"/>
                                        <field name="x_sale_id"/>
                                        <field name="x_deadline"/>
                                        <field name="x_product_id"/>
                                        <field name="x_quantity"/>
                                        <field name="x_uom_id"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="stock_picking_kanban_cus_procurement_tool" model="ir.ui.view">
            <field name="name">stock.picking.kanban</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="cus_logistics_tracking.stock_picking_kanban_logistics_tracking"/>
            <field name="arch" type="xml">
				<field name="purchase_id" position="after">
                    <field name="x_proc_cycle_id"/>
                </field>
                <xpath expr="//div[@class='o_kanban_record_body']//field[@name='x_consolidation_ids']" position="before">
					<span attrs="{'invisible': [('x_proc_cycle_id', '=', False)]}">
						<strong>Proc. Cycle: </strong><t t-esc="record.x_proc_cycle_id.value"/><br/>
					</span>
                </xpath>
            </field>
        </record>

        <record id="view_picking_internal_search_cus_procurement_tool" model="ir.ui.view">
            <field name="name">view_picking_internal_search_cus_procurement_tool</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_internal_search"/>
            <field name="arch" type="xml">
                <field name="picking_type_id" position="after">
                    <field name="purchase_id"/>
                    <field name="x_proc_cycle_id"/>
                    <field name="x_demand_list_ids"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
		<field name="res_model">logistics.tracking</field>
		<field name="view_mode">tree,form</field>
		<field name="context">{
			'search_default_type': 1,
			'search_default_state_1': 1,
			'search_default_state_2': 1,
			}</field>
		<field name="domain">[]</field>
		<field name="view_id" ref="logistics_tracking_view_list"/>
		<field name="search_view_id" ref="logistics_tracking_view_search"/>

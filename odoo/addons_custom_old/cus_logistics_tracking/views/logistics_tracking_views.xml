<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="logistics_tracking_view_form" model="ir.ui.view">
		<field name="name">logistics.tracking.view.form</field>
		<field name="model">logistics.tracking</field>
		<field name="arch" type="xml">
			<form string="Logistics Tracking">
				<header>
                    <field name="x_state" widget="statusbar" statusbar_visible="pending,in_transit,done"/>
				</header>
				<sheet>
					<field name="x_type" invisible="1"/>
					<field name="x_sub_route_ids" invisible="1"/>
					<field name="x_country_from" invisible="1"/>
					<field name="x_country_to" invisible="1"/>
					<field name="x_is_forwarder" invisible="1"/>
					<field name="x_currency_id" invisible="1"/>
					<group>
						<group>
							<field name="x_route_id"/>
							<field name="x_sub_route_id" options="{'no_create_edit': True}"/>
							<field name="x_shipping_type"/>
							<field name="x_carrier_id"/>
							<field name="x_shipment_type"/>
							<label for="x_tracking_ref"/>
							<div class="o_row">
								<field name="x_tracking_ref"/>
								<button name="open_url" string="Tracking" type="object" icon="fa-truck" class="btn-warning" attrs="{'invisible': ['|', ('x_carrier_id', '=', False), ('x_tracking_ref', '=', False)]}"/>
							</div>
							<label for="x_shipping_date" string="Shipping - Delivery"/>
							<div class="o_row d-inflex">
								<field name="x_shipping_date"/>
								-
								<field name="x_delivery_date"/>
							</div>
							<label for="x_length" string="Dimension: L x W x H"/>
							<div class="o_row">
								<field name="x_length"/><span>cm</span><span>x</span>
								<field name="x_width"/><span>cm</span><span>x</span>
								<field name="x_height"/><span>cm</span>
							</div>
							<label for="x_weight"/>
							<div class="o_row">
								<field name="x_weight"/><span>kg</span>
							</div>
							<label for="x_freight" string="Freight (Real - Est.)"/>
							<div class="o_row d-inflex">
								<field name="x_freight" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
								-
								<field name="x_estimated_freight" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
							</div>
							<field name="x_paid_by"/>
						</group>
						<group>
							<field name="x_company_from"/>
							<field name="x_company_to"/>
							<field name="x_consolidation_id" attrs="{
							'required': [('x_type', '=', 'incoming'), ('x_is_forwarder', '!=', False)],
							'invisible': ['|', ('x_type', '!=', 'incoming'), ('x_is_forwarder', '=', False)],
							}"/>
							<field name="x_forwarder_ref" attrs="{
							'invisible': ['|', ('x_type', '!=', 'incoming'), ('x_is_forwarder', '=', False)]
							}"/>
							<field name="x_picking_id" attrs="{
							'required': [('x_is_forwarder', '=', False)],
							'invisible': [('x_is_forwarder', '!=', False)],
							}"/>
							<field name="x_purchase_order_id" attrs="{'invisible': ['|', ('x_type', '!=', 'incoming'), ('x_is_forwarder', '!=', False)]}"/>
							<field name="x_sale_order_id" attrs="{'invisible': [('x_type', '!=', 'outgoing')]}"/>
							<label for="x_average_delivery_days"/>
							<div class="o_row">
								<field name="x_average_delivery_days"/><span>Days</span>
							</div>
							<label for="x_delivery_days"/>
							<div class="o_row">
								<field name="x_delivery_days"/><span>Days</span>
							</div>
							<label for="x_volume"/>
							<div class="o_row">
								<field name="x_volume"/><span>cm<sup>3</sup></span>
							</div>

							<field name="x_detained"/>
							<field name="x_clearing_agent"/>
							<field name="x_actual_value" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
							<field name="x_declared_value" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>

							<label for="x_total_weight" attrs="{'invisible': [('x_type', '!=', 'outgoing')]}"/>
							<div class="o_row" attrs="{'invisible': [('x_type', '!=', 'outgoing')]}">
								<field name="x_total_weight"/><span>kg</span>
							</div>
							<field name="x_total_freight" widget="monetary" options="{'currency_field': 'x_currency_id'}" attrs="{'invisible': [('x_type', '!=', 'outgoing')]}"/>
							<field name="x_freight_per_kg" widget="monetary" options="{'currency_field': 'x_currency_id'}" attrs="{'invisible': [('x_type', '!=', 'outgoing')]}"/>
						</group>
					</group>
					<field name="x_notes" placeholder="Internal Notes"/>
				</sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                    <field name="activity_ids" widget="mail_activity"/>
                </div>
			</form>
		</field>
	</record>

	<record id="logistics_tracking_view_list" model="ir.ui.view">
		<field name="name">logistics.tracking.view.list</field>
		<field name="model">logistics.tracking</field>
		<field name="arch" type="xml">
			<tree string="Logistics Tracking" decoration-info="x_state == 'in_transit'" decoration-danger="x_state == 'pending'" >
				<field name="x_type"/>
				<field name="x_carrier_id"/>
				<field name="x_tracking_ref"/>
				<field name="x_picking_type_id" optional="show"/>
				<field name="x_forwarder_ref"/>
				<field name="x_shipping_date" optional="show"/>
				<field name="x_delivery_date" optional="show"/>
				<field name="x_delivery_days" optional="hide"/>
				<field name="x_volume" optional="hide"/>
				<field name="x_weight" optional="hide"/>
				<field name="x_total_weight" optional="hide"/>
				<field name="x_currency_id" invisible="1"/>
				<field name="x_actual_value" optional="hide" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
				<field name="x_declared_value" optional="hide" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
				<field name="x_total_freight" optional="hide" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
				<field name="x_freight_per_kg" optional="hide" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
				<field name="x_company_from" optional="show"/>
				<field name="x_company_to" optional="show"/>
				<field name="x_clearing_agent" optional="hide"/>
				<field name="x_country_from" optional="show"/>
				<field name="x_country_to" optional="show"/>
				<field name="x_detained" optional="hide"/>
				<field name="x_picking_id" widget="many2one"/>
				<field name="x_consolidation_id" widget="many2one"/>
				<field name="x_sale_order_id" widget="many2one"/>
				<field name="x_purchase_order_id" widget="many2one"/>
				<field name="x_shipment_type"/>
				<field name="x_paid_by" optional="show"/>
				<field name="x_notes" placeholder="Internal Notes"/>
				<button name="open_url" string="Tracking URL" type="object" icon="fa-truck"/>
				<field name="x_state"/>
			</tree>
		</field>
	</record>


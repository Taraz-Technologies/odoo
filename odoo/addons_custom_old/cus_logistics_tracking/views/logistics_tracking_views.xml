	<record id="logistics_tracking_view_search" model="ir.ui.view">
		<field name="name">logistics.tracking.view.search</field>
		<field name="model">logistics.tracking</field>
		<field name="arch" type="xml">
			<search string="Logistics Tracking (Sale)">
				<field name="x_tracking_ref"/>
				<field name="x_picking_id"/>
				<field name="x_sale_order_id"/>
				<field name="x_purchase_order_id"/>
				<field name="x_consolidation_id"/>
				<field name="x_forwarder_ref"/>
				<field name="x_clearing_agent"/>
                <separator/>
                <filter name="state_1"  string="Pending" domain="[('x_state', '=', 'pending')]"/>
                <filter name="state_2"  string="In Transit" domain="[('x_state', '=', 'in_transit')]"/>
                <filter name="state_3"  string="Done" domain="[('x_state', '=', 'done')]"/>
                <separator/>
                <filter name="type_1"  string="Incoming" domain="[('x_type', '=', 'incoming')]"/>
                <filter name="type_2"  string="Outgoing" domain="[('x_type', '=', 'outgoing')]"/>
                <separator/>
                <filter name="shipment_type_1"  string="Clearing" domain="[('x_shipment_type', '=', 'clear')]"/>
                <filter name="shipment_type_2"  string="Forwarding" domain="[('x_shipment_type', '=', 'forward')]"/>
                <filter name="shipment_type_3"  string="Shipping (Self Pickup)" domain="[('x_shipment_type', '=', 'self')]"/>
                <filter name="shipment_type_4"  string="Shipping (Export)" domain="[('x_shipment_type', '=', 'export')]"/>
                <separator/>
                <filter name="end_country"  string="End Country" domain="[('x_sub_route_id.x_name', 'ilike', '>>PK')]"/>
                <separator/>
				<filter name="detained" string="Detained" domain="[('x_detained', '!=', False)]"/>
				<separator />
                <filter name="paid_by_1"  string="Paid by Sender" domain="[('x_paid_by', '=', 'sender')]"/>
                <filter name="paid_by_2"  string="Paid by Receiver" domain="[('x_paid_by', '=', 'receiver')]"/>
				<group col="4" colspan="4" expand="0" string="Group By">
                    <filter string="Type" name="type" context="{'group_by':'x_type'}"/>
                    <filter string="Carrier" name="carrier_id" context="{'group_by':'x_carrier_id'}"/>
                    <filter string="Delivery Date" name="delivery_date" context="{'group_by':'x_delivery_date'}"/>
                    <filter string="Paid by" name="paid_by" context="{'group_by':'x_paid_by'}"/>
					<filter string="Detained" name="detained" context="{'group_by':'x_detained'}"/>
					<filter string="Clearing Agent" name="clearing_agent" context="{'group_by':'x_clearing_agent'}"/>
                </group>
			</search>
		</field>
	</record>


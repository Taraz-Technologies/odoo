<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="free_zone_operations_view_form" model="ir.ui.view">
            <field name="name">free_zone_operations_view_form</field>
            <field name="model">free.zone.operations</field>
            <field name="arch" type="xml">
                <form string="Free Zone Operations">
                    <header>
                        <button name="action_create_landed_cost_bill" string="Create Landed Cost Bill" type="object" class="oe_highlight"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button string="Landed Costs" type="object" name="action_view_landed_costs"
                                    class="oe_stat_button" icon="fa-plus-square"/>
                            <button string="Bills" name="action_view_bills"
                                    type="object" class="oe_stat_button" icon="fa-bars"/>
                            <button string="Receipt" name="action_view_picking"
                                    type="object" class="oe_stat_button" icon="fa-bars"/>
                        </div>
                        <field name="x_bill_ids" invisible="1"/>
                        <div class="oe_title">
                            <label for="x_form_field_01" class="oe_edit_only"/>
                            <h1>
                                <field name="x_form_field_01" class="oe_inline"/>
                            </h1>
                            <h3 style="color:orange;">
                                <field name="x_value_mismatch_warning" class="oe_inline"
                                       attrs="{'invisible': [('x_value_mismatch_warning', '=', False)]}"/>
                            </h3>
                        </div>
                        <group>
                            <group>
                                <field name="x_operation_type" widget="radio" options="{'horizontal': true}"/>
                                <field name="x_type" widget="radio" options="{'horizontal': true}"
                                       attrs="{'invisible': [('x_operation_type', '!=', 'import')]}"/>
                                <label for="x_purchase_ids" attrs="{'invisible': ['|', ('x_operation_type', '!=', 'import'), ('x_type', '!=', 'purchase')]}"/>
                                <div class="o_row" attrs="{'invisible': ['|', ('x_operation_type', '!=', 'import'), ('x_type', '!=', 'purchase')]}">
                                    <field name="x_purchase_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <button name="update_receipt_list" string="Update Receipts" type="object" class="oe_highlight oe_edit_only"/>
                                </div>
                                <label for="x_consolidation_ids" attrs="{'invisible': ['|', ('x_operation_type', '!=', 'import'), ('x_type', '!=', 'consolidation')]}"/>
                                <div class="o_row" attrs="{'invisible': ['|', ('x_operation_type', '!=', 'import'), ('x_type', '!=', 'consolidation')]}">
                                    <field name="x_consolidation_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <button name="update_receipt_list" string="Update Receipts" type="object" class="oe_highlight oe_edit_only"/>
                                </div>
                                <label for="x_attachment_id" attrs="{'invisible': [('x_type', '=', False)]}"/>
                                <div class="o_row" attrs="{'invisible': [('x_type', '=', False)]}">
                                    <field name="x_attachment_id"/>
                                    <button name="get_pdf_data" string="Get PDF Data" type="object" class="oe_highlight oe_edit_only"/>
                                </div>
                                <field name="x_currency_id"/>
                                <field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                <field name="x_folder_name"/>
                                <field name="x_partner_id"/>
                            </group>
                            <group>
                                <field name="x_form_field_11"/>
                                <field name="x_form_field_02"/>
                                <field name="x_form_field_03"/>
                                <field name="x_form_field_04"/>
                                <field name="x_form_field_05"/>
                                <field name="x_form_field_06"/>
                                <field name="x_form_field_09"/>
                                <label for="x_form_field_10"/>
                                <div class="o_row">
                                    <field name="x_form_field_10"/><span>kg</span>
                                </div>
                                <label for="x_form_field_12"/>
                                <div class="o_row">
                                    <field name="x_form_field_12"/><span>KAP</span>
                                </div>
                                <field name="x_form_field_13" invisible="1"/>
                                <field name="x_form_field_07" widget="monetary" options="{'currency_field': 'x_form_field_13'}"/>
                                <field name="x_form_field_14" invisible="1"/>
                                <field name="x_form_field_08" widget="monetary" options="{'currency_field': 'x_form_field_14'}"/>
                            </group>
                        </group>
                        <separator string="Receipts" colspan="4"/>
                        <field name="x_receipt_ids">
                            <tree editable="bottom" create="0">
                                <field name="x_operation_id" invisible="1"/>
                                <field name="x_consolidation_id" widget="many2one"
                                       attrs="{'column_invisible': [('parent.x_type', '!=', 'consolidation')]}"/>
                                <field name="x_purchase_id" widget="many2one" string="Purchase Order"/>
                                <field name="x_picking_id" widget="many2one"/>
                                <field name="x_priority"/>
                                <field name="x_status"/>
                                <field name="x_tracking_id" widget="many2one"/>
                                <button name="open_url" string="Tracking" type="object" icon="fa-truck"/>
                                <field name="x_volume" string="Volume (cm3)" sum="Total"/>
                                <field name="x_weight" string="Weight (kg)" sum="Total"/>
                            </tree>
                            <form>
                                <sheet>
                                    <field name="x_operation_id" invisible="1"/>
                                    <group col="4">
                                        <field name="x_consolidation_id"/>
                                        <field name="x_purchase_id" string="Purchase Order"/>
                                        <field name="x_picking_id"/>
                                        <field name="x_priority"/>
                                        <field name="x_status"/>
                                        <field name="x_tracking_id"/>
                                        <field name="x_volume"/>
                                        <field name="x_weight"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                        <separator string="Cost Lines" colspan="4"/>
                        <div class="o_row">
                            <button name="compute_landed_cost_lines" string="Get Landed Cost Lines" type="object" class="oe_highlight"/>
                        </div>
                        <field name="x_cost_lines_ids">
                            <form string="Cost Lines">
                                <field name="x_operation_id" invisible="1"/>
                                <field name="x_cost_line_id" invisible="1"/>
                                <group col="6">
                                    <field name="x_product_id"/>
                                    <field name="x_split_method"/>
                                    <field name="x_unit_price"/>
                                </group>
                            </form>
                            <tree editable="bottom">
                                <field name="x_operation_id" invisible="1"/>
                                <field name="x_cost_line_id" invisible="1"/>
                                <field name="x_product_id"/>
                                <field name="x_split_method"/>
                                <field name="x_unit_price" sum="Total"/>
                            </tree>
                        </field>
                        <separator string="Products List" colspan="4"/>
                        <group>
                            <label for="x_form_field_03"/>
                            <div class="o_row">
                                <field name="x_form_field_03"/>
                                <field name="x_ignore_subject_of_transaction"/>
                                <span>Ignore</span>
                                <button name="update_product_list" string="Fetch Products" type="object" class="oe_highlight"/>
                                <button name="compute_landed_cost" string="Add Landed Cost" type="object" class="oe_highlight"/>
                            </div>
                        </group>
                        <field name="x_product_ids">
                            <tree editable="bottom" create="0">
                                <field name="x_operation_id" invisible="1"/>
                                <field name="x_currency_id" invisible="1"/>
                                <field name="x_picking_id" optional="hide"/>
                                <field name="x_tracking_id" optional="hide"/>
                                <field name="x_product_id"/>
                                <field name="x_description" optional="hide"/>
                                <field name="x_form_field_03" optional="show"/>
                                <field name="x_country_id" string="Menşei" optional="show"/>
                                <field name="x_description_translation" optional="show"/>
                                <field name="x_hs_code_tr_id" string="GTIP" optional="show"/>
                                <field name="x_unit_weight" optional="hide" sum="Total"/>
                                <field name="x_volume" optional="hide" sum="Total"/>
                                <field name="x_quantity" optional="show"/>
                                <field name="x_uom_id" optional="show"/>
                                <field name="x_unit_price" optional="show"/>
                                <field name="x_subtotal" optional="show" sum="Total" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                                <field name="x_new_unit" optional="show"/>
                                <field name="x_new_subtotal" optional="show" sum="Total" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                            </tree>
                            <form>
                                <sheet>
                                    <field name="x_operation_id" invisible="1"/>
                                    <field name="x_currency_id" invisible="1"/>
                                    <group col="4">
                                        <field name="x_picking_id"/>
                                        <field name="x_tracking_id"/>
                                        <field name="x_product_id"/>
                                        <field name="x_description"/>
                                        <field name="x_form_field_03" optional="show"/>
                                        <field name="x_country_id" string="Menşei"/>
                                        <field name="x_description_translation"/>
                                        <field name="x_hs_code_tr_id" string="GTIP"/>
                                        <field name="x_unit_weight"/>
                                        <label for="x_quantity"/>
                                        <div class="o_row">
                                            <field name="x_quantity"/>
                                            <field name="x_uom_id"/>
                                        </div>
                                        <field name="x_unit_price"/>
                                        <field name="x_subtotal" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                                        <field name="x_new_unit"/>
                                        <field name="x_new_subtotal" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                        <field name="activity_ids" widget="mail_activity"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="free_zone_operations_view_tree" model="ir.ui.view">
            <field name="name">free_zone_operations_view_tree</field>
            <field name="model">free.zone.operations</field>
            <field name="arch" type="xml">
                <tree string="Free Zone Operations">
                    <field name="x_form_field_01"/>
                    <field name="x_operation_type"/>
                    <field name="x_type"/>
                    <field name="x_partner_id"/>
                    <field name="x_form_field_02"/>
                    <field name="x_form_field_03"/>
                    <field name="x_form_field_04"/>
                    <field name="x_form_field_06"/>
                    <field name="x_form_field_09"/>
                    <field name="x_purchase_ids" widget="many2many_tags"/>
                    <field name="x_consolidation_ids" widget="many2many_tags"/>
                    <field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="x_form_field_07"/>
                    <field name="x_attachment_name" invisible="1"/>
                    <field name="x_attachment" widget="download_link" filename="x_attachment_name"/>
                </tree>
            </field>
        </record>

        <record id="free_zone_operations_view_search" model="ir.ui.view">
           <field name="name">free_zone_operations_view_search</field>
           <field name="model">free.zone.operations</field>
            <field name="arch" type="xml">
                <search string="Free Zone Operations">
                    <field name="x_form_field_01" string="Free Zone Operation"
                           filter_domain="['|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|',
                           ('x_form_field_01', 'ilike', self),
                           ('x_operation_type', 'ilike', self),
                           ('x_type', 'ilike', self),
                           ('x_form_field_02', 'ilike', self),
                           ('x_form_field_03', 'ilike', self),
                           ('x_form_field_04', 'ilike', self),
                           ('x_form_field_05', 'ilike', self),
                           ('x_form_field_06', 'ilike', self),
                           ('x_form_field_07', 'ilike', self),
                           ('x_form_field_08', 'ilike', self),
                           ('x_form_field_09', 'ilike', self),
                           ('x_form_field_10', 'ilike', self),
                           ('x_purchase_ids', 'ilike', self),
                           ('x_consolidation_ids', 'ilike', self),
                           ('x_partner_id', 'ilike', self),
                           ('x_attachment_id', 'ilike', self),
                           ('x_tag_ids', 'ilike', self)]"/>
                    <field name="x_purchase_ids" string="Purchase Orders"/>
                    <field name="x_consolidation_ids" string="Consolidations"/>
                    <field name="x_tag_ids"/>
                    <separator/>
                    <filter name="import"  string="Import" domain="[('x_operation_type', '=', 'import')]"/>
                    <filter name="export"  string="Export" domain="[('x_operation_type', '=', 'export')]"/>
                    <separator/>
                    <filter name="purchase"  string="Purchase Order" domain="[('x_type', '=', 'purchase')]"/>
                    <filter name="consolidation"  string="Consolidation" domain="[('x_type', '=', 'consolidation')]"/>
                    <separator/>
                    <filter name="x_form_field_02_01"  string="Bölgeye Türkiye'den Mal-Hizmet Girişi" domain="[('x_form_field_02', '=', 'from_turkey')]"/>
                    <filter name="x_form_field_02_02"  string="Bölgeye Yurt Dışından Mal-Hizmet Girişi" domain="[('x_form_field_02', '=', 'from_abroad')]"/>
                    <separator/>
                    <filter name="x_form_field_03_01"  string="Ticari-Mal" domain="[('x_form_field_03', '=', 'Ticari-Mal')]"/>
                    <filter name="x_form_field_03_02"  string="Ticari Olmayan-Demirbaş" domain="[('x_form_field_03', '=', 'Ticari Olmayan-Demirbaş')]"/>
                    <filter name="x_form_field_03_03"  string="Ticari Olmayan-Sarf Malzemesi" domain="[('x_form_field_03', '=', 'Ticari Olmayan-Sarf Malzemesi')]"/>
                    <filter name="x_form_field_03_04"  string="Ticari Olmayan-Yatırım ve Tesis" domain="[('x_form_field_03', '=', 'Ticari Olmayan-Yatırım ve Tesis')]"/>
                    <filter name="x_form_field_03_05"  string="Ticari Olmayan-Hizmet Alımı" domain="[('x_form_field_03', '=', 'Ticari Olmayan-Hizmet Alımı')]"/>
                    <separator/>
                    <filter name="x_form_field_04_01"  string="Kesin Alış/Satış" domain="[('x_form_field_04', '=', 'Kesin Alış/Satış')]"/>
                    <filter name="x_form_field_04_02"  string="Diğer İşlem Türleri-5000$ Altı" domain="[('x_form_field_04', '=', 'Diğer İşlem Türleri-5000$ Altı')]"/>
                    <separator/>
                    <filter name="tagged" string="Tagged" domain="[('x_tag_ids', '!=', False)]"/>
                    <group expand="0" string="Group by">
                        <filter string="Operation Type" name="group_by_operation_type" domain="[]" context="{'group_by': 'x_operation_type'}"/>
                        <filter string="Package Type" name="group_by_type" domain="[]" context="{'group_by': 'x_type'}"/>
                        <filter string="Vendor" name="group_by_vendor" domain="[]" context="{'group_by': 'x_partner_id'}"/>
                        <filter string="İŞLEM YÖNÜ" name="group_by_form_field_02_type" domain="[]" context="{'group_by': 'x_form_field_02'}"/>
                        <filter string="İŞLEM KONUSU" name="group_by_form_field_03_type" domain="[]" context="{'group_by': 'x_form_field_03'}"/>
                        <filter string="İŞLEM TÜRÜ" name="group_by_form_field_04_type" domain="[]" context="{'group_by': 'x_form_field_04'}"/>
                    </group>
                </search>
           </field>
        </record>

        <record id="free_zone_operations_action" model="ir.actions.act_window">
            <field name="name">Free Zone Operations</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">free.zone.operations</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="search_view_id" ref="free_zone_operations_view_search"/>
        </record>
    </data>
</odoo>
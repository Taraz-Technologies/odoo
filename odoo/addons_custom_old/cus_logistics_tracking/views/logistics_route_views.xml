<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="logistics_route_view_form" model="ir.ui.view">
		<field name="name">logistics.route.view.form</field>
		<field name="model">logistics.route</field>
		<field name="arch" type="xml">
            <form string="Logistics Routes">
                <sheet>
                    <group col="2">
                        <field name="x_name"/>
                        <field name="x_description"/>
                    </group>
                    <separator string="Sub-Routes" colspan="4"/>
                    <field name="x_sub_route_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="x_name"/>
                            <field name="x_from"/>
                            <field name="x_to"/>
                            <field name="x_delivery_days"/>
                        </tree>
                        <form>
                            <sheet>
                                <group col="4">
                                    <field name="x_name"/>
                                    <field name="x_from"/>
                                    <field name="x_to"/>
                                    <field name="x_delivery_days"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

	<record id="logistics_route_view_tree" model="ir.ui.view">
		<field name="name">logistics.route.view.tree</field>
		<field name="model">logistics.route</field>
		<field name="arch" type="xml">
            <tree string="Logistics Routes">
                <field name="x_name"/>
                <field name="x_description"/>
                <field name="x_sub_route_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

	<record id="logistics_route_view_search" model="ir.ui.view">
		<field name="name">logistics.route.view.search</field>
		<field name="model">logistics.route</field>
		<field name="arch" type="xml">
			<search string="Logistics Routes">
				<field name="x_name"/>
                <field name="x_description"/>
				<field name="x_sub_route_ids"/>
            </search>
        </field>
    </record>

    <record id="action_logistics_route" model="ir.actions.act_window">
		<field name="name">Logistics Routes</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">logistics.route</field>
		<field name="view_mode">tree,form</field>
		<field name="view_id" ref="logistics_route_view_tree"/>
		<field name="search_view_id" ref="logistics_route_view_search"/>
    </record>
</odoo>
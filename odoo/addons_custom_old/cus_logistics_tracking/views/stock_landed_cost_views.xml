<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_stock_landed_cost_form_cus_logistics_tracking" model="ir.ui.view">
            <field name="name">view_stock_landed_cost_form_cus_logistics_tracking</field>
            <field name="model">stock.landed.cost</field>
            <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='picking_ids']" position="after">
					<field name="x_free_zone_operation_id" attrs="{'invisible': [('company_id', '!=', 2)]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
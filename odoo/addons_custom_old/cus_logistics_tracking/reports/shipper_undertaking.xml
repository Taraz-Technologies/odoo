<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_shipper_undertaking">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial; font-size:16px; margin: 25px 25px 25px 25px;">
                        <div class="row">
                            <div class="col">
                                <center>
                                    <h4>
                                        <b>SHIPPER UNDERTAKING</b>
                                    </h4>
                                </center>
                                <span t-field="doc.x_body_su" style="margin-top: 50px;"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Marking Label-->
    <template id="report_marking_label">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <t t-foreach="doc.x_package_ids" t-as="line" >
                            <div class="row border border-dark" style="page-break-after:always;">
                                <div class="col">
                                    <div class="row border-bottom border-dark">
                                        <div class="col">
                                            <center><strong>Marking</strong></center>
                                        </div>
                                    </div>
                                    <div class="row" style="font-size:20px;">
                                        <div class="col mt8 mb8">
                                            <center>
                                                <span t-field="line.x_marking"/>
                                            </center>
                                        </div>
                                    </div>
                                    <div class="row" style="font-size:14px;">
                                        <div class="col mb8">
                                            <span>Sale Order #:</span>
                                            <span t-field="doc.origin"/>
                                            <br/>
                                            <span>Package: <span t-field="line.x_package"/></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
<!--    Shipping Label From-->
    <template id="report_shipping_label_from">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <div class="row border border-dark">
                            <div class="col">
                                <div class="row border-bottom border-dark">
                                    <div class="col">
                                        <center><strong>From</strong></center>
                                    </div>
                                </div>
                                <div class="row" style="font-size:20px;">
                                    <div class="col p-0 mt8 mb8">
                                        <center>
                                            <t t-if="doc.company_id.id == 1">
                                                <span>Taraz Technologies</span>
                                            </t>
                                            <t t-else="">
                                                <span>Taraz Teknolojileri Limited Şirketi</span>
                                            </t>
                                        </center>
                                    </div>
                                </div>
                                <div class="row" style="font-size:14px;">
                                    <div class="col mb8">
                                        <center>
                                            <span t-field="doc.company_id.street"/>
                                            <span t-field="doc.company_id.street2"/>
                                            <span t-field="doc.company_id.city"/>
                                            <span t-field="doc.company_id.zip"/>
                                            <span t-field="doc.company_id.country_id"/>
                                            <br/>
                                            <span>Tel:</span>
                                            <span t-field="doc.company_id.phone"/>
                                        </center>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
<!--    Shipping Label To-->
    <template id="report_shipping_label_to">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <div class="row border border-dark">
                            <div class="col">
                                <div class="row border-bottom border-dark">
                                    <div class="col">
                                        <center><strong>To</strong></center>
                                    </div>
                                </div>
                                <div class="row" style="font-size:20px;">
                                    <div class="col mt8 mb8">
                                        <center>
                                            <t t-if="doc.partner_id.parent_id">
                                                <span t-field="doc.partner_id.parent_id.name"/>
                                            </t>
                                            <t t-else="else">
                                                <span t-field="doc.partner_id.name"/>
                                            </t>
                                        </center>
                                    </div>
                                </div>
                                <div class="row" style="font-size:14px;">
                                    <div class="col mb8">
                                        <center>
                                            <span t-field="doc.partner_id.street"/>
                                            <span t-field="doc.partner_id.street2"/>
                                            <span t-field="doc.partner_id.city"/>
                                            <span t-field="doc.partner_id.zip"/>
                                            <span t-field="doc.partner_id.country_id"/>
                                            <t t-if="doc.partner_id.parent_id">
                                                <br/>
                                                <span t-field="doc.partner_id.name" style="font-size:14px;"/>
                                            </t>
                                            <t t-if="doc.partner_id.phone">
                                                <br/>
                                                <span t-field="doc.partner_id.phone"/>
                                            </t>
                                            <t t-if="doc.partner_id.mobile">
                                                <br/>
                                                <span t-field="doc.partner_id.mobile"/>
                                            </t>
                                        </center>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
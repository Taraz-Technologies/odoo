<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_product_barcodes">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-foreach="o.move_lines" t-as="line">
                        <div class="page" style="font-family: Arial; font-size:16px">
                            <div style="width: 100%; display: inline-table; height: 10rem;">
                                <table class="table table-bordered mb-0" style="border: 2px solid black;">
                                    <tr>
                                        <th class="table-active text-left" style="height: 4rem;">
                                            <strong t-field="line.product_id.name"/>
                                            [<span t-field="line.product_id.x_short_description"/>]
                                        </th>
                                    </tr>
                                    <tr>
                                        <td class="text-center align-middle" style="height: 6rem;">
                                            <t t-if="line.product_id.barcode">
                                                <img alt="Barcode"
                                                     t-if="len(line.product_id.barcode) == 13"
                                                     t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('EAN13', quote_plus(line.product_id.barcode or ''), 600, 150)"
                                                     style="width:100%;height:4rem;"/>
                                                <img alt="Barcode"
                                                     t-elif="len(line.product_id.barcode) == 8"
                                                     t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('EAN8', quote_plus(line.product_id.barcode or ''), 600, 150)"
                                                     style="width:100%;height:4rem;"/>
                                                <img alt="Barcode"
                                                     t-else=""
                                                     t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', quote_plus(line.product_id.barcode or ''), 600, 150)"
                                                     style="width:100%;height:4rem"/>
                                                <span t-field="line.product_id.barcode"/>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted">No barcode available</span>
                                            </t>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <template id="report_product_qrcodes">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-foreach="o.move_lines" t-as="line">
                        <div class="page" style="font-family: Arial; font-size:16px">
                            <div style="width: 100%; display: inline-table; height: 10rem;">
                                <table class="table table-bordered mb-0" style="border: 2px solid black;">
                                    <t t-if="len(str(line.product_id.x_short_description)) &lt; 95">
                                        <tr>
                                            <th class="table-active text-left" style="height: 4rem;">
                                                <strong t-field="line.product_id.name"/>
                                                [<span t-field="line.product_id.x_short_description"/>]
                                            </th>
                                        </tr>
                                        <tr>
                                            <td class="text-center align-middle" style="height: 6rem;">
                                                <t t-if="line.product_id.barcode">
                                                    <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', line.product_id.barcode, 70, 70)"/>
                                                    <div t-field="line.product_id.barcode"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-muted">No barcode available</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <th class="table-active text-left" style="height: 13rem;">
                                                <strong t-field="line.product_id.name"/>
                                                [<span t-field="line.product_id.x_short_description"/>]
                                            </th>
                                        </tr>
                                        <tr>
                                            <td class="text-center align-middle" style="height: 10rem;">
                                                <t t-if="line.product_id.barcode">
                                                    <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', line.product_id.barcode, 70, 70)"/>
                                                    <div t-field="line.product_id.barcode"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-muted">No barcode available</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>
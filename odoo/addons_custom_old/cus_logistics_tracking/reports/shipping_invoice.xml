<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_shipping_invoice_document">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o.x_partner_invoice_id.lang)" />
                <div class="page h5" style="font-size:16px;">
                    <t t-if="o.x_hide_customer">
                        <span><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/></span>
                    </t>
                    <t t-else="">
                        <div class="row">
                            <div class="col-5" t-if="o.x_show_customer and o.x_customer_id">
                                <strong>Customer:</strong>
                                <t t-if="o.x_customer_id.parent_id">
                                    <div t-field="o.x_customer_id.parent_id.name"/>
                                    <t t-if="o.x_customer_id.street">
                                        <div t-field="o.x_customer_id.street"/>
                                    </t>
                                    <t t-if="o.x_customer_id.street2">
                                        <div t-field="o.x_customer_id.street2"/>
                                    </t>
                                    <t t-if="o.x_customer_id.zip">
                                        <span t-field="o.x_customer_id.zip"/>
                                    </t>
                                    <t t-if="o.x_customer_id.city">
                                        <span t-field="o.x_customer_id.city"/>,
                                    </t>
                                    <t t-if="o.x_customer_id.state_id">
                                        <span t-field="o.x_customer_id.state_id.code"/>,
                                    </t>
                                    <span t-field="o.x_customer_id.country_id"/>
                                    <div class="mt8">
                                        <t t-if="o.x_customer_id.name">
                                            <div>Attn:
                                                <span t-field="o.x_customer_id.title"/>
                                                <span t-field="o.x_customer_id.name"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="else">
                                    <div t-field="o.x_customer_id.name"/>
                                    <t t-if="o.x_customer_id.street">
                                        <div t-field="o.x_customer_id.street"/>
                                    </t>
                                    <t t-if="o.x_customer_id.street2">
                                        <div t-field="o.x_customer_id.street2"/>
                                    </t>
                                    <t t-if="o.x_customer_id.zip">
                                        <span t-field="o.x_customer_id.zip"/>
                                    </t>
                                    <t t-if="o.x_customer_id.city">
                                        <span t-field="o.x_customer_id.city"/>,
                                    </t>
                                    <t t-if="o.x_customer_id.state_id">
                                        <span t-field="o.x_customer_id.state_id.code"/>,
                                    </t>
                                    <span t-field="o.x_customer_id.country_id"/>
                                    <div class="mt8">
                                        <t t-if="o.x_customer_id.x_contact_name">
                                            <div>Attn:
                                                <span t-field="o.x_customer_id.x_contact_name"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-if="o.x_customer_id.phone">
                                    <div>
                                        <span t-field="o.x_customer_id.phone"/>
                                    </div>
                                </t>
                                <t t-elif="o.x_customer_id.mobile">
                                    <div>
                                        <span t-field="o.x_customer_id.mobile"/>
                                    </div>
                                </t>
                                <t t-if="o.x_customer_id.email">
                                    <div>
                                        <span t-field="o.x_customer_id.email"/>
                                    </div>
                                </t>
                            </div>
                            <div class="col-2" t-if="o.x_show_customer and o.x_customer_id"/>
                            <div class="col-5" t-if="o.x_show_end_user and o.x_end_user_id">
                                <strong>End-User:</strong>
                                <t t-if="o.x_end_user_id.parent_id">
                                    <div t-field="o.x_end_user_id.parent_id.name"/>
                                    <t t-if="o.x_end_user_id.street">
                                        <div t-field="o.x_end_user_id.street"/>
                                    </t>
                                    <t t-if="o.x_end_user_id.street2">
                                        <div t-field="o.x_end_user_id.street2"/>
                                    </t>
                                    <t t-if="o.x_end_user_id.zip">
                                        <span t-field="o.x_end_user_id.zip"/>
                                    </t>
                                    <t t-if="o.x_end_user_id.city">
                                        <span t-field="o.x_end_user_id.city"/>,
                                    </t>
                                    <t t-if="o.x_end_user_id.state_id">
                                        <span t-field="o.x_end_user_id.state_id.code"/>,
                                    </t>
                                    <span t-field="o.x_end_user_id.country_id"/>
                                    <div class="mt8">
                                        <t t-if="o.x_end_user_id.name">
                                            <div>Attn:
                                                <span t-field="o.x_end_user_id.title"/>
                                                <span t-field="o.x_end_user_id.name"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="else">
                                    <div t-field="o.x_end_user_id.name"/>
                                    <t t-if="o.x_end_user_id.street">
                                        <div t-field="o.x_end_user_id.street"/>
                                    </t>
                                    <t t-if="o.x_end_user_id.street2">
                                        <div t-field="o.x_end_user_id.street2"/>
                                    </t>
                                    <t t-if="o.x_end_user_id.zip">
                                        <span t-field="o.x_end_user_id.zip"/>
                                    </t>
                                    <t t-if="o.x_end_user_id.city">
                                        <span t-field="o.x_end_user_id.city"/>,
                                    </t>
                                    <t t-if="o.x_end_user_id.state_id">
                                        <span t-field="o.x_end_user_id.state_id.code"/>,
                                    </t>
                                    <span t-field="o.x_end_user_id.country_id"/>
                                    <div class="mt8">
                                        <t t-if="o.x_end_user_id.x_contact_name">
                                            <div>Attn:
                                                <span t-field="o.x_end_user_id.x_contact_name"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-if="o.x_end_user_id.phone">
                                    <div>
                                        <span t-field="o.x_end_user_id.phone"/>
                                    </div>
                                </t>
                                <t t-elif="o.x_end_user_id.mobile">
                                    <div>
                                        <span t-field="o.x_end_user_id.mobile"/>
                                    </div>
                                </t>
                                <t t-if="o.x_end_user_id.email">
                                    <div>
                                        <span t-field="o.x_end_user_id.email"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <div class="row mt8">
                            <div class="col-5" t-if="o.x_show_bill_to and o.x_partner_invoice_id">
                                <strong>Bill To:</strong>
                                <t t-if="o.x_partner_invoice_id.parent_id">
                                    <div t-field="o.x_partner_invoice_id.parent_id.name"/>
                                    <t t-if="o.x_partner_invoice_id.street">
                                        <div t-field="o.x_partner_invoice_id.street"/>
                                    </t>
                                    <t t-if="o.x_partner_invoice_id.street2">
                                        <div t-field="o.x_partner_invoice_id.street2"/>
                                    </t>
                                    <t t-if="o.x_partner_invoice_id.zip">
                                        <span t-field="o.x_partner_invoice_id.zip"/>
                                    </t>
                                    <t t-if="o.x_partner_invoice_id.city">
                                        <span t-field="o.x_partner_invoice_id.city"/>,
                                    </t>
                                    <t t-if="o.x_partner_invoice_id.state_id">
                                        <span t-field="o.x_partner_invoice_id.state_id.code"/>,
                                    </t>
                                    <span t-field="o.x_partner_invoice_id.country_id"/>
                                    <div class="mt8">
                                        <t t-if="o.x_partner_invoice_id.name">
                                            <div>Attn:
                                                <span t-field="o.x_partner_invoice_id.title"/>
                                                <span t-field="o.x_partner_invoice_id.name"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="else">
                                    <div t-field="o.x_partner_invoice_id.name"/>
                                    <t t-if="o.x_partner_invoice_id.street">
                                        <div t-field="o.x_partner_invoice_id.street"/>
                                    </t>
                                    <t t-if="o.x_partner_invoice_id.street2">
                                        <div t-field="o.x_partner_invoice_id.street2"/>
                                    </t>
                                    <t t-if="o.x_partner_invoice_id.zip">
                                        <span t-field="o.x_partner_invoice_id.zip"/>
                                    </t>
                                    <t t-if="o.x_partner_invoice_id.city">
                                        <span t-field="o.x_partner_invoice_id.city"/>,
                                    </t>
                                    <t t-if="o.x_partner_invoice_id.state_id">
                                        <span t-field="o.x_partner_invoice_id.state_id.code"/>,
                                    </t>
                                    <span t-field="o.x_partner_invoice_id.country_id"/>
                                    <div class="mt8">
                                        <t t-if="o.x_partner_invoice_id.x_contact_name">
                                            <div>Attn:
                                                <span t-field="o.x_partner_invoice_id.x_contact_name"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-if="o.x_partner_invoice_id.phone">
                                    <div>
                                        <span t-field="o.x_partner_invoice_id.phone"/>
                                    </div>
                                </t>
                                <t t-elif="o.x_partner_invoice_id.mobile">
                                    <div>
                                        <span t-field="o.x_partner_invoice_id.mobile"/>
                                    </div>
                                </t>
                                <t t-if="o.x_partner_invoice_id.email">
                                    <div>
                                        <span t-field="o.x_partner_invoice_id.email"/>
                                    </div>
                                </t>
                            </div>
                            <div class="col-2" t-if="o.x_show_bill_to and o.x_partner_invoice_id"/>
                            <div class="col-5" t-if="o.x_show_ship_to and o.partner_id">
                                <strong>Ship To:</strong>
                                <t t-if="o.partner_id.x_company">
                                    <div t-field="o.partner_id.x_company"/>
                                </t>
                                <t t-else="else">
                                    <div t-field="o.partner_id.name"/>
                                </t>
                                <t t-if="o.partner_id.street">
                                    <div t-field="o.partner_id.street"/>
                                </t>
                                <t t-if="o.partner_id.street2">
                                    <div t-field="o.partner_id.street2"/>
                                </t>
                                <t t-if="o.partner_id.zip">
                                    <span t-field="o.partner_id.zip"/>
                                </t>
                                <t t-if="o.partner_id.city">
                                    <span t-field="o.partner_id.city"/>,
                                </t>
                                <t t-if="o.partner_id.state_id">
                                    <span t-field="o.partner_id.state_id.code"/>,
                                </t>
                                <span t-field="o.partner_id.country_id"/>
                                <div class="mt8">
                                    <t t-if="o.partner_id.name">
                                        <div>Attn:
                                            <span t-field="o.partner_id.title"/>
                                            <span t-field="o.partner_id.name"/>
                                        </div>
                                    </t>
                                    <t t-if="o.partner_id.phone">
                                        <div>
                                            <span t-field="o.partner_id.phone"/>
                                        </div>
                                    </t>
                                    <t t-elif="o.partner_id.mobile">
                                        <div>
                                            <span t-field="o.partner_id.mobile"/>
                                        </div>
                                    </t>
                                    <t t-if="o.partner_id.email">
                                        <div>
                                            <span t-field="o.partner_id.email"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                    <h2 class="mt24 mb16" style="color:#009999;">
                        <span t-if="o.x_invoice_id.type == 'out_invoice' or o.x_transit_invoice_id.type == 'out_invoice'">Invoice #: </span>
                        <span t-field="o.x_shipping_invoice_number"/>
                    </h2>
                    <div class="mt16 mb16" style="font-size:17px;">
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_shipping_date" name="shipping_date">
                            <div class="p-2">
                                <strong>Invoice Date:</strong>
                                <p class="m-0" t-esc="o.x_shipping_date"/>
                            </div>
                        </div>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.origin" name="origin">
                            <div class="p-2">
                                <strong>Sale Order #:</strong>
                                <p class="m-0" t-field="o.origin"/>
                            </div>
                        </div>
                        <t t-if="not o.x_transit_invoice_id">
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_invoice_id.x_web_order_number">
                                <div class="p-2">
                                    <strong>WEB Order#:</strong>
                                    <p class="m-0" t-field="o.x_invoice_id.x_web_order_number"/>
                                </div>
                            </div>
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_invoice_id.ref">
                                <div class="p-2">
                                    <strong>Customer PO#:</strong>
                                    <p class="m-0" t-field="o.x_invoice_id.ref"/>
                                </div>
                            </div>
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_show_payment_terms">
                                <div class="p-2">
                                    <strong>Payment Terms:</strong>
                                    <p t-field="o.x_invoice_payment_term_id"/>
                                </div>
                            </div>
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_invoice_id.x_bank.x_report_code and o.x_show_payment_method">
                                <div class="p-2">
                                    <strong>Payment Method:</strong>
                                    <p class="m-0" t-field="o.x_invoice_id.x_bank.x_report_code"/>
                                </div>
                            </div>
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_invoice_id.invoice_incoterm_id">
                                <div class="p-2">
                                    <strong>Incoterms:</strong>
                                    <p t-field="o.x_invoice_id.invoice_incoterm_id.code"/>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_transit_invoice_id.x_web_order_number">
                                <div class="p-2">
                                    <strong>WEB Order#:</strong>
                                    <p class="m-0" t-field="o.x_transit_invoice_id.x_web_order_number"/>
                                </div>
                            </div>
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_transit_invoice_id.ref">
                                <div class="p-2">
                                    <strong>Customer PO#:</strong>
                                    <p class="m-0" t-field="o.x_transit_invoice_id.ref"/>
                                </div>
                            </div>
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_show_transit_invoice_payment_terms">
                                <div class="p-2">
                                    <strong>Payment Terms:</strong>
                                    <p t-field="o.x_transit_invoice_payment_term_id"/>
                                </div>
                            </div>
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_transit_invoice_id.x_bank.x_report_code and o.x_show_transit_invoice_payment_method">
                                <div class="p-2">
                                    <strong>Payment Method:</strong>
                                    <p class="m-0" t-field="o.x_transit_invoice_id.x_bank.x_report_code"/>
                                </div>
                            </div>
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_transit_invoice_id.invoice_incoterm_id">
                                <div class="p-2">
                                    <strong>Incoterms:</strong>
                                    <p t-field="o.x_transit_invoice_id.invoice_incoterm_id.code"/>
                                </div>
                            </div>
                        </t>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.carrier_id">
                            <div class="p-2">
                                <strong>Carrier:</strong>
                                <p t-field="o.carrier_id"/>
                            </div>
                        </div>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.carrier_tracking_ref">
                            <div class="p-2">
                                <strong>Tracking #:</strong>
                                <p class="m-0" t-field="o.carrier_tracking_ref"/>
                            </div>
                        </div>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_reason_of_export">
                            <div class="p-2">
                                <strong>Reason of Export:</strong>
                                <p class="m-0" t-field="o.x_reason_of_export"/>
                            </div>
                        </div>
                    </div>
                    <t t-set="display_discount" t-value="any([l.discount for l in o.x_shipping_invoice_lines]) and not o.x_hide_discount"/>
                    <style>
                        tr:nth-child(odd)>td {
                          background-color: rgba(220, 220, 220, 0.02);
                        }
                    </style>
                    <t t-set="current_subtotal" t-value="0"/>
                    <table class="table table-sm" name="shipping_invoice_line_table">
                        <thead>
                            <tr>
                                <!-- TODO: remove in master -->
                                <t t-set="colspan" t-value="6"/>
                                <th class="text-left" style="color:#009999;">
                                    <span>Description</span>
                                </th>
                                <th class="text-right" style="color:#009999;">
                                    <span>Quantity</span>
                                </th>
                                <th t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="color:#009999;">
                                    <span>Unit Price</span>
                                </th>
                                <th t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="color:#009999;">
                                    <span>Disc.(%)</span>
                                    <!-- TODO: remove in master -->
                                    <t t-set="colspan" t-value="colspan+1"/>
                                </th>
                                <th class="text-right" style="color:#009999;">
                                    <span>Amount</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-foreach="o.x_shipping_invoice_lines" t-as="line">
                                <tr style="page-break-inside: avoid;">
                                    <t t-if="o.x_show_freight and 'Freight' in line.product_id.name">
                                        <td style="width: 50%;">
                                            <t t-if="o.x_hide_product != True">
                                                <strong t-field="line.product_id.name"/>
                                                <br/>
                                            </t>
                                            <span t-field="line.name"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="'{0:,.2f}'.format(line.quantity)"/>
                                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                        </td>
                                        <td t-attf-class="text-right">
                                            <span t-esc="'{0:,.2f}'.format(line.amount/line.quantity)"/>
                                        </td>
                                        <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <span t-field="line.discount"/>
                                        </td>
                                        <td class="text-right o_price_total">
                                            <span t-field="o.x_invoice_id.currency_id.symbol"/>
                                            <span t-esc="'{0:,.2f}'.format(line.amount)"/>
                                        </td>
                                        <t t-set="current_subtotal" t-value="current_subtotal + line.amount"/>
                                    </t>
                                    <t t-elif="not 'BOS' in line.product_id.name and not 'PACKING' in line.product_id.name
                                    and not 'Down Payment' in line.product_id.name and not 'Freight' in line.product_id.name and line.unit_price != 0">
                                        <td style="width: 50%;">
                                            <t t-if="o.x_hide_product != True">
                                                <strong t-field="line.product_id.name"/>
                                                <br/>
                                            </t>
                                            <span t-field="line.name"/>
                                            <t t-foreach="line.product_id.x_accessory_ids" t-as="accessory">
                                                <t t-if="accessory.x_active and line.accessories">
                                                    <br/>
                                                    <span t-esc="'{0:,.0f}'.format(accessory.x_quantity)"/>x
                                                    <span t-field="accessory.x_short_description"/>
                                                </t>
                                            </t>
                                            <t t-if="o.x_distributor_order == False">
                                                <t t-if="line.product_id.name != 'Freight'">
                                                    <t t-if="line.hs_code_id">
                                                        <span>
                                                            <br/>HS CODE:
                                                            <span t-field="line.hs_code_id.x_hs_code"/>
                                                        </span>
                                                    </t>
                                                    <t t-if="line.country_id">
                                                        <span>
                                                            <br/>COO:
                                                            <span t-field="line.country_id.name"/>
                                                        </span>
                                                    </t>
                                                </t>
                                            </t>
                                            <t t-if="o.x_sample_unit and (o.x_invoice_id.x_payment_method.id != 7 or o.x_down_factor != 1)">
                                                <br/><span>[Sample Unit]</span>
                                            </t>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="'{0:,.2f}'.format(line.quantity)"/>
                                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                        </td>
                                        <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <t t-if="display_discount">
                                                <span t-esc="'{0:,.2f}'.format(line.unit_price)"/>
                                            </t>
                                            <t t-else="else">
                                                <span t-esc="'{0:,.2f}'.format(line.unit_price * (1 - line.discount/100))"/>
                                            </t>
                                        </td>
                                        <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <span t-field="line.discount"/>
                                        </td>
                                        <td class="text-right o_price_total">
                                            <span t-field="o.x_invoice_id.currency_id.symbol"/>
                                            <span t-esc="'{0:,.2f}'.format(line.amount)"/>
                                        </td>
                                        <t t-set="current_subtotal" t-value="current_subtotal + line.amount"/>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div class="clearfix">
                        <div id="total" class="row">
                            <div t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-5'} ml-auto">
                                <table class="table table-sm">
                                    <tr class="o_subtotal" style="color:#009999;">
                                        <td>
                                            <span>Subtotal</span>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="o.x_invoice_id.currency_id.symbol"/>
                                            <span t-esc="'{0:,.2f}'.format(current_subtotal)"/>
                                        </td>
                                    </tr>
                                    <t t-set="GST" t-value="0"/>
                                    <t t-set="GST_Rate" t-value="0"/>
                                    <t t-foreach="o.x_invoice_id.amount_by_group" t-as="amount_by_group">
                                        <tr style="">
                                            <t t-if="len(o.x_invoice_id.line_ids) == 1 and o.amount_untaxed == amount_by_group[2]">
                                                <t t-set="GST_Rate" t-value="amount_by_group[1]/amount_by_group[2]"/>
                                                <td>
                                                    <span>GST @ <t t-esc="'{0:,.2f}'.format(GST_Rate*100)"/>%</span>
                                                </td>
                                                <td class="text-right o_price_total">
                                                    <span t-field="o.x_invoice_id.currency_id.symbol"/>
                                                    <span t-esc="'{0:,.2f}'.format(current_subtotal * GST_Rate)"/>
                                                </td>
                                            </t>
                                            <t t-elif="amount_by_group[1] != 0">
                                                <t t-if="'GST' in amount_by_group[0] and not 'Withheld' in amount_by_group[0]">
                                                    <t t-set="GST_Rate" t-value="amount_by_group[1]/amount_by_group[2]"/>
                                                    <td>
                                                        <span>GST @ <t t-esc="'{0:,.2f}'.format(GST_Rate*100)"/>%</span>
                                                    </td>
                                                    <td class="text-right o_price_total">
                                                        <span t-field="o.x_invoice_id.currency_id.symbol"/>
                                                        <span t-esc="'{0:,.2f}'.format(current_subtotal * GST_Rate)"/>
                                                    </td>
                                                </t>
                                            </t>
                                        </tr>
                                    </t>
                                    <tr class="o_total" style="color:#009999;">
                                        <td>
                                            <span>Total</span>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="o.x_invoice_id.currency_id.symbol"/>
                                            <span t-esc="'{0:,.2f}'.format(current_subtotal + (current_subtotal * GST_Rate))"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                    <t t-if="o.x_appear_shipping_remarks">
                        <div class="row mt32">
                            <div class="col">
                                <p t-field="o.x_shipping_remarks"/>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </template>

        <template id="report_shipping_invoice">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.invoice_user_id.sudo().lang if o.x_invoice_id.type in ('in_invoice', 'in_refund') else o.x_partner_invoice_id.lang"/>
                    <t t-call="cus_logistics_tracking.report_shipping_invoice_document" t-lang="lang"/>
                </t>
            </t>
        </template>
    </data>
</odoo>
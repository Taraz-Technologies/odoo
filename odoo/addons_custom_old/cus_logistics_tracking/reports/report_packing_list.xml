<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_packing_list">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                    <div class="page h5" style="font-size:16px;">
                        <t t-if="o.x_hide_customer">
                            <span><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/></span>
                        </t>
                        <t t-else="">
                            <div class="row">
                                <div class="col-5" t-if="o.x_show_customer and o.x_customer_id">
                                    <strong>Customer:</strong>
                                    <t t-if="o.x_customer_id.parent_id">
                                        <div t-field="o.x_customer_id.parent_id.name"/>
                                        <t t-if="o.x_customer_id.street">
                                            <div t-field="o.x_customer_id.street"/>
                                        </t>
                                        <t t-if="o.x_customer_id.street2">
                                            <div t-field="o.x_customer_id.street2"/>
                                        </t>
                                        <t t-if="o.x_customer_id.zip">
                                            <span t-field="o.x_customer_id.zip"/>
                                        </t>
                                        <t t-if="o.x_customer_id.city">
                                            <span t-field="o.x_customer_id.city"/>,
                                        </t>
                                        <t t-if="o.x_customer_id.state_id">
                                            <span t-field="o.x_customer_id.state_id.code"/>,
                                        </t>
                                        <span t-field="o.x_customer_id.country_id"/>
                                        <div class="mt8">
                                            <t t-if="o.x_customer_id.name">
                                                <div>Attn:
                                                    <span t-field="o.x_customer_id.title"/>
                                                    <span t-field="o.x_customer_id.name"/>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="else">
                                        <div t-field="o.x_customer_id.name"/>
                                        <t t-if="o.x_customer_id.street">
                                            <div t-field="o.x_customer_id.street"/>
                                        </t>
                                        <t t-if="o.x_customer_id.street2">
                                            <div t-field="o.x_customer_id.street2"/>
                                        </t>
                                        <t t-if="o.x_customer_id.zip">
                                            <span t-field="o.x_customer_id.zip"/>
                                        </t>
                                        <t t-if="o.x_customer_id.city">
                                            <span t-field="o.x_customer_id.city"/>,
                                        </t>
                                        <t t-if="o.x_customer_id.state_id">
                                            <span t-field="o.x_customer_id.state_id.code"/>,
                                        </t>
                                        <span t-field="o.x_customer_id.country_id"/>
                                        <div class="mt8">
                                            <t t-if="o.x_customer_id.x_contact_name">
                                                <div>Attn:
                                                    <span t-field="o.x_customer_id.x_contact_name"/>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-if="o.x_customer_id.phone">
                                        <div>
                                            <span t-field="o.x_customer_id.phone"/>
                                        </div>
                                    </t>
                                    <t t-elif="o.x_customer_id.mobile">
                                        <div>
                                            <span t-field="o.x_customer_id.mobile"/>
                                        </div>
                                    </t>
                                    <t t-if="o.x_customer_id.email">
                                        <div>
                                            <span t-field="o.x_customer_id.email"/>
                                        </div>
                                    </t>
                                </div>
                                <div class="col-2" t-if="o.x_show_customer and o.x_customer_id"/>
                                <div class="col-5" t-if="o.x_show_end_user and o.x_end_user_id">
                                    <strong>End-User:</strong>
                                    <t t-if="o.x_end_user_id.parent_id">
                                        <div t-field="o.x_end_user_id.parent_id.name"/>
                                        <t t-if="o.x_end_user_id.street">
                                            <div t-field="o.x_end_user_id.street"/>
                                        </t>
                                        <t t-if="o.x_end_user_id.street2">
                                            <div t-field="o.x_end_user_id.street2"/>
                                        </t>
                                        <t t-if="o.x_end_user_id.zip">
                                            <span t-field="o.x_end_user_id.zip"/>
                                        </t>
                                        <t t-if="o.x_end_user_id.city">
                                            <span t-field="o.x_end_user_id.city"/>,
                                        </t>
                                        <t t-if="o.x_end_user_id.state_id">
                                            <span t-field="o.x_end_user_id.state_id.code"/>,
                                        </t>
                                        <span t-field="o.x_end_user_id.country_id"/>
                                        <div class="mt8">
                                            <t t-if="o.x_end_user_id.name">
                                                <div>Attn:
                                                    <span t-field="o.x_end_user_id.title"/>
                                                    <span t-field="o.x_end_user_id.name"/>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="else">
                                        <div t-field="o.x_end_user_id.name"/>
                                        <t t-if="o.x_end_user_id.street">
                                            <div t-field="o.x_end_user_id.street"/>
                                        </t>
                                        <t t-if="o.x_end_user_id.street2">
                                            <div t-field="o.x_end_user_id.street2"/>
                                        </t>
                                        <t t-if="o.x_end_user_id.zip">
                                            <span t-field="o.x_end_user_id.zip"/>
                                        </t>
                                        <t t-if="o.x_end_user_id.city">
                                            <span t-field="o.x_end_user_id.city"/>,
                                        </t>
                                        <t t-if="o.x_end_user_id.state_id">
                                            <span t-field="o.x_end_user_id.state_id.code"/>,
                                        </t>
                                        <span t-field="o.x_end_user_id.country_id"/>
                                        <div class="mt8">
                                            <t t-if="o.x_end_user_id.x_contact_name">
                                                <div>Attn:
                                                    <span t-field="o.x_end_user_id.x_contact_name"/>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-if="o.x_end_user_id.phone">
                                        <div>
                                            <span t-field="o.x_end_user_id.phone"/>
                                        </div>
                                    </t>
                                    <t t-elif="o.x_end_user_id.mobile">
                                        <div>
                                            <span t-field="o.x_end_user_id.mobile"/>
                                        </div>
                                    </t>
                                    <t t-if="o.x_end_user_id.email">
                                        <div>
                                            <span t-field="o.x_end_user_id.email"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-5" t-if="o.x_show_bill_to and o.x_partner_invoice_id">
                                    <strong>Bill To:</strong>
                                    <t t-if="o.x_partner_invoice_id.parent_id">
                                        <div t-field="o.x_partner_invoice_id.parent_id.name"/>
                                        <t t-if="o.x_partner_invoice_id.street">
                                            <div t-field="o.x_partner_invoice_id.street"/>
                                        </t>
                                        <t t-if="o.x_partner_invoice_id.street2">
                                            <div t-field="o.x_partner_invoice_id.street2"/>
                                        </t>
                                        <t t-if="o.x_partner_invoice_id.zip">
                                            <span t-field="o.x_partner_invoice_id.zip"/>
                                        </t>
                                        <t t-if="o.x_partner_invoice_id.city">
                                            <span t-field="o.x_partner_invoice_id.city"/>,
                                        </t>
                                        <t t-if="o.x_partner_invoice_id.state_id">
                                            <span t-field="o.x_partner_invoice_id.state_id.code"/>,
                                        </t>
                                        <span t-field="o.x_partner_invoice_id.country_id"/>
                                        <div class="mt8">
                                            <t t-if="o.x_partner_invoice_id.name">
                                                <div>Attn:
                                                    <span t-field="o.x_partner_invoice_id.title"/>
                                                    <span t-field="o.x_partner_invoice_id.name"/>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="else">
                                        <div t-field="o.x_partner_invoice_id.name"/>
                                        <t t-if="o.x_partner_invoice_id.street">
                                            <div t-field="o.x_partner_invoice_id.street"/>
                                        </t>
                                        <t t-if="o.x_partner_invoice_id.street2">
                                            <div t-field="o.x_partner_invoice_id.street2"/>
                                        </t>
                                        <t t-if="o.x_partner_invoice_id.zip">
                                            <span t-field="o.x_partner_invoice_id.zip"/>
                                        </t>
                                        <t t-if="o.x_partner_invoice_id.city">
                                            <span t-field="o.x_partner_invoice_id.city"/>,
                                        </t>
                                        <t t-if="o.x_partner_invoice_id.state_id">
                                            <span t-field="o.x_partner_invoice_id.state_id.code"/>,
                                        </t>
                                        <span t-field="o.x_partner_invoice_id.country_id"/>
                                        <div class="mt8">
                                            <t t-if="o.x_partner_invoice_id.x_contact_name">
                                                <div>Attn:
                                                    <span t-field="o.x_partner_invoice_id.x_contact_name"/>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-if="o.x_partner_invoice_id.phone">
                                        <div>
                                            <span t-field="o.x_partner_invoice_id.phone"/>
                                        </div>
                                    </t>
                                    <t t-elif="o.x_partner_invoice_id.mobile">
                                        <div>
                                            <span t-field="o.x_partner_invoice_id.mobile"/>
                                        </div>
                                    </t>
                                    <t t-if="o.x_partner_invoice_id.email">
                                        <div>
                                            <span t-field="o.x_partner_invoice_id.email"/>
                                        </div>
                                    </t>
                                </div>
                                <div class="col-2" t-if="o.x_show_bill_to and o.x_partner_invoice_id"/>
                                <div class="col-5" t-if="o.x_show_ship_to and o.partner_id">
                                    <strong>Ship To:</strong>
                                    <t t-if="o.partner_id.x_company">
                                        <div t-field="o.partner_id.x_company"/>
                                    </t>
                                    <t t-else="else">
                                        <div t-field="o.partner_id.name"/>
                                    </t>
                                    <t t-if="o.partner_id.street">
                                        <div t-field="o.partner_id.street"/>
                                    </t>
                                    <t t-if="o.partner_id.street2">
                                        <div t-field="o.partner_id.street2"/>
                                    </t>
                                    <t t-if="o.partner_id.zip">
                                        <span t-field="o.partner_id.zip"/>
                                    </t>
                                    <t t-if="o.partner_id.city">
                                        <span t-field="o.partner_id.city"/>,
                                    </t>
                                    <t t-if="o.partner_id.state_id">
                                        <span t-field="o.partner_id.state_id.code"/>,
                                    </t>
                                    <span t-field="o.partner_id.country_id"/>
                                    <div class="mt8">
                                        <t t-if="o.partner_id.name">
                                            <div>Attn:
                                                <span t-field="o.partner_id.title"/>
                                                <span t-field="o.partner_id.name"/>
                                            </div>
                                        </t>
                                        <t t-if="o.partner_id.phone">
                                            <div>
                                                <span t-field="o.partner_id.phone"/>
                                            </div>
                                        </t>
                                        <t t-elif="o.partner_id.mobile">
                                            <div>
                                                <span t-field="o.partner_id.mobile"/>
                                            </div>
                                        </t>
                                        <t t-if="o.partner_id.email">
                                            <div>
                                                <span t-field="o.partner_id.email"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <h2 class="mt24 mb16" style="color:#009999;">
                            <span>Packing List</span>
                        </h2>
                        <div class="mt16 mb16" style="font-size:17px;">
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_shipping_date" name="div_sched_date">
                                <div class="p-2">
                                    <strong>Date:</strong>
                                    <p class="m-0" t-esc="o.x_shipping_date"/>
                                </div>
                            </div>
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.origin" name="div_origin">
                                <div class="p-2">
                                    <strong>Sale Order #:</strong>
                                    <p class="m-0" t-field="o.origin"/>
                                </div>
                            </div>
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_shipping_invoice_number" name="div_origin">
                                <div class="p-2">
                                    <strong>Invoice #:</strong>
                                    <p class="m-0" t-field="o.x_shipping_invoice_number"/>
                                </div>
                            </div>
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.x_sale_id.client_order_ref">
                                <div class="p-2">
                                    <strong>Customer Reference:</strong>
                                    <p class="m-0" t-field="o.x_sale_id.client_order_ref"/>
                                </div>
                            </div>
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.carrier_id">
                                <div class="p-2">
                                    <strong>Carrier:</strong>
                                    <p class="m-0" t-field="o.carrier_id"/>
                                </div>
                            </div>
                            <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.carrier_tracking_ref">
                                <div class="p-2">
                                    <strong>Tracking #:</strong>
                                    <p class="m-0" t-field="o.carrier_tracking_ref"/>
                                </div>
                            </div>
                        </div>
                        <t t-set="total_net" t-value="0"/>
                        <t t-set="total_gross" t-value="0"/>
                        <t t-foreach="o.x_package_ids" t-as="line" >
                            <div class="mt16 mb16" style="page-break-inside: avoid;">
                                <h5>
                                    <span>Package:</span>
                                    <span t-field="line.x_package"/>
                                </h5>
                                <style>
                                    tr:nth-child(odd)>td {
                                      background-color: rgba(220, 220, 220, 0.02);
                                    }
                                </style>
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th style="color:#009999;">Type</th>
                                            <th style="color:#009999;">Dimension</th>
                                            <th style="color:#009999;" t-if="line.x_net_weight != 0">Net Weight</th>
                                            <th style="color:#009999;">Gross Weight</th>
                                            <th style="color:#009999;">Marking</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <span t-field="line.x_shipping_box"/>
                                            </td>
                                            <td>
                                                <span t-field="line.x_dimension"/>
                                            </td>
                                            <td t-if="line.x_net_weight != 0">
                                                <span t-esc="'%.2f'%(line.x_net_weight)"/>
                                                <span>kg</span>
                                            </td>
                                            <td>
                                                <span t-esc="'%.2f'%(line.x_gross_weight)"/>
                                                <span>kg</span>
                                            </td>
                                            <td>
                                                <span t-field="line.x_marking"/>
                                            </td>
                                            <t t-set="total_net" t-value="total_net + line.x_net_weight"/>
                                            <t t-set="total_gross" t-value="total_gross + line.x_gross_weight"/>
                                        </tr>
                                    </tbody>
                                </table>
                                <table class="table table-sm mt16 mb16">
                                    <thead>
                                        <tr>
                                            <th style="color:#009999;">Product</th>
                                            <th class="text-right" style="color:#009999;">Quantity</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="o.x_packing_list_ids" t-as="packing_line">
                                            <tr t-if="packing_line.x_package.id == line.id">
                                                <td style="width:80%;">
                                                    <t t-if="not o.x_hide_product">
                                                        <span t-field="packing_line.x_product_id"/>
                                                    </t>
                                                    <p t-if="o.picking_type_code == 'outgoing'">
                                                        <t t-if="not o.x_distributor_order">
                                                            <span t-field="packing_line.x_product_id.x_short_description"/>
                                                        </t>
                                                        <t t-else="else">
                                                            <span t-field="packing_line.x_product_id.sudo().x_description_for_distributor"/>
                                                        </t>
                                                        <t t-foreach="packing_line.x_product_id.x_accessory_ids" t-as="accessory">
                                                            <t t-if="accessory.x_active and packing_line.x_accessories">
                                                                <br/>
                                                                <span t-esc="'{0:,.0f}'.format(accessory.x_quantity)"/>x
                                                                <span t-field="accessory.x_short_description"/>
                                                            </t>
                                                        </t>
                                                    </p>
                                                    <p t-if="o.picking_type_code == 'incoming'">
                                                        <span t-field="packing_line.x_product_id.sudo().description_pickingin"/>
                                                        <span t-field="packing_line.x_product_id.x_delivery_order_checklist"/>
                                                    </p>
                                                </td>
                                                <td class="text-right">
                                                    <span t-field="packing_line.x_quantity"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                        <style>
                            tr:nth-child(odd)>td {
                              background-color: rgba(220, 220, 220, 0.02);
                            }
                        </style>
                        <table class="table table-sm mt16 mb16" t-if="o.x_show_total_weights">
                            <thead>
                                <tr>
                                    <th class="text-center" style="color:#009999;">Total Net Weight</th>
                                    <th class="text-center" style="color:#009999;">Total Gross Weight</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-center">
                                        <span t-esc="'{0:,.2f}'.format(total_net)"/>
                                        <span>kg</span>
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="'{0:,.2f}'.format(total_gross)"/>
                                        <span>kg</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <t t-if="o.x_appear_delivery_remarks_on_report">
                            <div class="row mt16 mb16">
                                <div class="col">
                                    <p t-field="o.x_delivery_remarks"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
         </t>
    </template>
</odoo>

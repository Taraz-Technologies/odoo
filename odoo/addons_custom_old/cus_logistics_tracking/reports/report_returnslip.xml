<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_return_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <div class="page h5" style="font-size:16px;">
                    <t t-if="o.x_hide_customer">
                        <span><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/></span>
                    </t>
                    <t t-else="">
                        <div class="row">
                            <div class="col-5" t-if="o.picking_type_id.warehouse_id.partner_id">
                                <strong>Return To:</strong>
                                <div t-field="o.picking_type_id.warehouse_id.partner_id.name"/>
                                <t t-if="o.picking_type_id.warehouse_id.partner_id.street">
                                    <div t-field="o.picking_type_id.warehouse_id.partner_id.street"/>
                                </t>
                                <t t-if="o.picking_type_id.warehouse_id.partner_id.street2">
                                    <div t-field="o.picking_type_id.warehouse_id.partner_id.street2"/>
                                </t>
                                <t t-if="o.picking_type_id.warehouse_id.partner_id.zip">
                                    <span t-field="o.picking_type_id.warehouse_id.partner_id.zip"/>
                                </t>
                                <t t-if="o.picking_type_id.warehouse_id.partner_id.city">
                                    <span t-field="o.picking_type_id.warehouse_id.partner_id.city"/>,

                                </t>
                                <t t-if="o.picking_type_id.warehouse_id.partner_id.state_id">
                                    <span t-field="o.picking_type_id.warehouse_id.partner_id.state_id.code"/>,

                                </t>
                                <span t-field="o.picking_type_id.warehouse_id.partner_id.country_id"/>
                                <div class="mt8">
                                    <t t-if="o.picking_type_id.warehouse_id.partner_id.x_contact_name">
                                        <div>Attn:
                                            <span t-field="o.picking_type_id.warehouse_id.partner_id.x_contact_name"/>
                                        </div>
                                    </t>
                                </div>
                                <t t-if="o.picking_type_id.warehouse_id.partner_id.phone">
                                    <div>
                                        <span t-field="o.picking_type_id.warehouse_id.partner_id.phone"/>
                                    </div>
                                </t>
                                <t t-elif="o.picking_type_id.warehouse_id.partner_id.mobile">
                                    <div>
                                        <span t-field="o.picking_type_id.warehouse_id.partner_id.mobile"/>
                                    </div>
                                </t>
                                <t t-if="o.picking_type_id.warehouse_id.partner_id.email">
                                    <div>
                                        <span t-field="o.picking_type_id.warehouse_id.partner_id.email"/>
                                    </div>
                                </t>
                            </div>
                            <div class="col-2"/>
                            <div class="col-5" t-if="o.x_customer_id">
                                <strong>Customer:</strong>
                                <t t-if="o.x_customer_id.parent_id">
                                    <div t-field="o.x_customer_id.parent_id.name"/>
                                    <t t-if="o.x_customer_id.parent_id.street">
                                        <div t-field="o.x_customer_id.parent_id.street"/>
                                    </t>
                                    <t t-if="o.x_customer_id.parent_id.street2">
                                        <div t-field="o.x_customer_id.parent_id.street2"/>
                                    </t>
                                    <t t-if="o.x_customer_id.parent_id.zip">
                                        <span t-field="o.x_customer_id.parent_id.zip"/>
                                    </t>
                                    <t t-if="o.x_customer_id.parent_id.city">
                                        <span t-field="o.x_customer_id.parent_id.city"/>,
                                    </t>
                                    <t t-if="o.x_customer_id.parent_id.state_id">
                                        <span t-field="o.x_customer_id.parent_id.state_id.code"/>,
                                    </t>
                                    <span t-field="o.x_customer_id.parent_id.country_id"/>
                                    <div class="mt8">
                                        <t t-if="o.x_customer_id.name">
                                            <div>Attn:
                                                <span t-field="o.x_customer_id.title"/>
                                                <span t-field="o.x_customer_id.name"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="else">
                                    <div t-field="o.x_customer_id.name"/>
                                    <t t-if="o.x_customer_id.street">
                                        <div t-field="o.x_customer_id.street"/>
                                    </t>
                                    <t t-if="o.x_customer_id.street2">
                                        <div t-field="o.x_customer_id.street2"/>
                                    </t>
                                    <t t-if="o.x_customer_id.zip">
                                        <span t-field="o.x_customer_id.zip"/>
                                    </t>
                                    <t t-if="o.x_customer_id.city">
                                        <span t-field="o.x_customer_id.city"/>,

                                    </t>
                                    <t t-if="o.x_customer_id.state_id">
                                        <span t-field="o.x_customer_id.state_id.code"/>,

                                    </t>
                                    <span t-field="o.x_customer_id.country_id"/>
                                    <div class="mt8">
                                        <t t-if="o.x_customer_id.x_contact_name">
                                            <div>Attn:
                                                <span t-field="o.x_customer_id.x_contact_name"/>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-if="o.x_customer_id.phone">
                                    <div>
                                        <span t-field="o.x_customer_id.phone"/>
                                    </div>
                                </t>
                                <t t-elif="o.x_customer_id.mobile">
                                    <div>
                                        <span t-field="o.x_customer_id.mobile"/>
                                    </div>
                                </t>
                                <t t-if="o.x_customer_id.email">
                                    <div>
                                        <span t-field="o.x_customer_id.email"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                    <h2 class="mt24 mb16" style="color:#009999;">
                        <span>Return Receipt #:</span>
                        <span t-field="o.name"/>
                    </h2>
                    <div class="mt16 mb16" style="font-size:17px;">
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.date_done or o.scheduled_date" name="div_sched_date">
                            <div class="p-2">
                                <strong>Date:</strong>
                                <t t-if="o.state == 'done'">
                                    <p class="m-0" t-esc="o.date_done.date()"/>
                                </t>
                                <t t-if="o.state != 'done'">
                                    <p class="m-0" t-esc="o.scheduled_date.date()"/>
                                </t>
                            </div>
                        </div>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.origin" name="div_origin">
                            <div class="p-2">
                                <strong>Sale Order #:</strong>
                                <p class="m-0" t-field="o.origin"/>
                            </div>
                        </div>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.carrier_id">
                            <div class="p-2">
                                <strong>Carrier:</strong>
                                <p class="m-0" t-field="o.carrier_id"/>
                            </div>
                        </div>
                        <div class="d-inline-flex" style="white-space: nowrap;" t-if="o.carrier_tracking_ref">
                            <div class="p-2">
                                <strong>Tracking #:</strong>
                                <p class="m-0" t-field="o.carrier_tracking_ref"/>
                            </div>
                        </div>
                    </div>
                    <t t-set="total_packages" t-value="0"/>
                    <t t-set="total_net" t-value="0"/>
                    <t t-set="total_gross" t-value="0"/>
                    <t t-foreach="o.x_package_ids" t-as="line" >
                        <div class="mt16 mb16">
                            <h5>
                                <span>Package:</span>
                                <span t-field="line.x_package"/>
                            </h5>
                            <style>
                                tr:nth-child(odd)>td {
                                  background-color: rgba(220, 220, 220, 0.02);
                                }
                            </style>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th style="color:#009999;">Type</th>
                                        <th style="color:#009999;">Dimension</th>
                                        <th style="color:#009999;" t-if="line.x_net_weight != 0">Net Weight</th>
                                        <th style="color:#009999;">Gross Weight</th>
                                        <th style="color:#009999;">Marking</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <span t-field="line.x_shipping_box"/>
                                        </td>
                                        <td>
                                            <span t-field="line.x_dimension"/>
                                        </td>
                                        <td t-if="line.x_net_weight != 0">
                                            <span t-esc="'%.2f'%(line.x_net_weight)"/>
                                            <span>kg</span>
                                        </td>
                                        <td>
                                            <span t-esc="'%.2f'%(line.x_gross_weight)"/>
                                            <span>kg</span>
                                        </td>
                                        <td>
                                            <span t-field="line.x_marking"/>
                                        </td>
                                        <t t-set="total_packages" t-value="total_packages + 1"/>
                                        <t t-set="total_net" t-value="total_net + line.x_net_weight"/>
                                        <t t-set="total_gross" t-value="total_gross + line.x_gross_weight"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                    <style>
                        tr:nth-child(odd)>td {
                          background-color: rgba(220, 220, 220, 0.02);
                        }
                    </style>
                    <table class="table table-sm mt16 mb16" t-if="o.x_show_total_weights">
                        <thead>
                            <tr>
                                <th class="text-center" style="color:#009999;">Total Net Weight</th>
                                <th class="text-center" style="color:#009999;">Total Gross Weight</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-center">
                                    <span t-esc="'{0:,.2f}'.format(total_net)"/>
                                    <span>kg</span>
                                </td>
                                <td class="text-center">
                                    <span t-esc="'{0:,.2f}'.format(total_gross)"/>
                                    <span>kg</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="table table-sm mt16 mb16">
                        <thead>
                            <tr>
                                <th style="color:#009999;">Product</th>
                                <th class="text-right" style="color:#009999;">Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.x_shipping_invoice_lines" t-as="move_line">
                                <t t-if="not 'BOS' in move_line.product_id.name and not 'PACKING' in move_line.product_id.name and not 'Freight' in move_line.product_id.name">
                                    <td style="width:80%;">
                                        <t t-if="not o.x_hide_product">
                                            <span t-field="move_line.product_id"/>
                                        </t>
                                        <p t-if="o.picking_type_code == 'outgoing'">
                                            <t t-if="not o.x_distributor_order">
                                                <span t-field="move_line.product_id.sudo().description_pickingout"/>
                                            </t>
                                            <t t-else="else">
                                                <span t-field="move_line.product_id.sudo().x_description_for_distributor"/>
                                            </t>
                                        </p>
                                        <p t-if="o.picking_type_code == 'incoming'">
                                            <span t-field="move_line.product_id.sudo().description_pickingin"/>
                                            <span t-field="move_line.product_id.x_delivery_order_checklist"/>
                                        </p>
                                    </td>
                                    <td class="text-right">
                                        <span t-if="o.state=='done'" t-esc="'%.0f'%(move_line.quantity)"/>
                                        <span t-if="o.state!='done'" t-esc="'%.0f'%(move_line.quantity)"/>
                                        <span t-field="move_line.product_uom_id"/>
                                    </td>
                                </t>
                            </tr>
                        </tbody>
                    </table>
                    <t t-if="o.x_appear_delivery_remarks_on_report">
                        <div class="row mt16 mb16">
                            <div class="col">
                                <p t-field="o.x_delivery_remarks"/>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
         </t>
    </template>

    <template id="report_returnslip">
        <t t-foreach="docs" t-as="o">
            <t t-call="cus_logistics_tracking.report_return_document" t-lang="o.partner_id.lang"/>
        </t>
    </template>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cus_sale_view_partner_property_form" model="ir.ui.view">
            <field name="name">cus_sale_view_partner_property_form</field>
            <field name="model">res.partner</field>
            <field name="priority">2</field>
            <field name="inherit_id" ref="account.view_partner_property_form"/>
            <field name="groups_id" eval="[(5,)]"/>
            <field name="arch" type="xml">
                <data>
                    <field name="vat" position="before">
                        <field name="x_free_zone_contact" attrs="{'invisible': [('country_id', '!=', 224)]}"/>
                    </field>
                    <field name="property_account_receivable_id" position="before">
                        <label for="x_company_id"/>
                        <div class="o_row" style="white-space: nowrap;">
                            <field name="x_company_id"/>
                            <button name="create_related_accounts"
                                    string="Create Accounts"
                                    type="object"
                                    class="oe_highlight"/>
                        </div>
                    </field>
                    <field name="property_account_payable_id" position="attributes">
                        <attribute name="attrs">{'required': [('parent_id', '=', False)],}</attribute>
                    </field>
                    <field name="property_account_receivable_id" position="attributes">
                        <attribute name="attrs">{'required': [('parent_id', '=', False)],}</attribute>
                    </field>
                    <field name="property_account_payable_id" position="after">
                        <field name="x_customer_advance_account_id" attrs="{'required': [('parent_id', '=', False)],}"/>
                        <field name="x_vendor_advance_account_id" attrs="{'required': [('parent_id', '=', False)],}"/>
                    </field>
                </data>
            </field>
        </record>
    </data>
</odoo>

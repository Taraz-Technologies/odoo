<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_cus_accounts" model="ir.ui.view">
            <field name="name">view_move_form_cus_accounts</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <header position="inside">
                    <button string="Create Related Bill" name="action_create_bill" type="object" class="oe_highlight"
                            attrs="{'invisible':['|', ('x_create_bills', '=', False), ('state', '!=', 'posted')]}"/>
                    <button string="Create Income Journal Entry" name="create_income_journal_entry" type="object" class="oe_highlight"
                            attrs="{'invisible':['|', '|',
                            ('x_services_advance_visible', '!=', True),
                            ('state', '!=', 'posted'),
                            ('type', '!=', 'out_invoice')
                            ]}"/>
                    <button string="Add to SO" name="action_add_to_sale_order" type="object" class="oe_highlight"
                            attrs="{'invisible':['|', '|',
                            ('type', 'not in', ('out_invoice', 'out_refund')),
                            ('state', '!=', 'posted'),
                            ('x_sale_order', '!=', False),
                            ]}"/>
                    <button string="Add to PO" name="action_add_to_purchase_order" type="object" class="oe_highlight"
                            attrs="{'invisible':['|', '|', '|', '|',
                            ('type', 'not in', ('in_invoice', 'in_refund')),
                            ('state', '!=', 'posted'),
                            ('x_purchase_id', '!=', False),
                            ('x_related_po_s', '!=', []),
                            ('x_sale_ids', '!=', []),
                            ]}"/>
                    <button string="Relate to PO" name="action_relate_to_purchase_orders" type="object" class="oe_highlight"
                            attrs="{'invisible':['|', '|', '|', '|',
                            ('type', 'not in', ('in_invoice', 'in_refund')),
                            ('state', '!=', 'posted'),
                            ('x_purchase_id', '!=', False),
                            ('x_sale_order', '!=', False),
                            ('x_sale_ids', '!=', []),
                            ]}"/>
                    <button string="Relate to SO" name="action_relate_to_sale_orders" type="object" class="oe_highlight"
                            attrs="{'invisible':['|', '|', '|', '|',
                            ('type', 'not in', ('in_invoice', 'in_refund')),
                            ('state', '!=', 'posted'),
                            ('x_purchase_id', '!=', False),
                            ('x_sale_order', '!=', False),
                            ('x_related_po_s', '!=', []),
                            ]}"/>
                    <button string="Download Attachments" name="action_download_attachments" type="object" icon="fa-download"
                            class="oe_highlight" attrs="{'invisible': [('x_attachment_ids', '=', [])]}"/>
                </header>
				<div name="button_box" position="inside">
					<button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-calendar"
                            attrs="{'invisible': [('x_invoice_count', '=', 0)]}">
						<div class="o_stat_info">
							<field name="x_invoice_count" class="o_stat_value"/>
							<span class="o_stat_text" attrs="{'invisible': [('x_invoice_count', '&lt;', 2)]}"> Source Invoices</span>
							<span class="o_stat_text" attrs="{'invisible': [('x_invoice_count', '&gt;', 1)]}"> Source Invoice</span>
						</div>
					</button>
					<button name="action_view_bills" type="object" class="oe_stat_button" icon="fa-calendar"
                            attrs="{'invisible': [('x_bill_count', '=', 0)]}">
						<div class="o_stat_info">
							<field name="x_bill_count" class="o_stat_value"/>
							<span class="o_stat_text" attrs="{'invisible': [('x_bill_count', '&lt;', 2)]}"> Related Bills</span>
							<span class="o_stat_text" attrs="{'invisible': [('x_bill_count', '&gt;', 1)]}"> Related Bill</span>
						</div>
					</button>
					<button name="action_view_related_sale_orders" type="object" class="oe_stat_button" icon="fa-list-alt"
                            attrs="{'invisible': [('x_sale_ids', '=', [])]}">
						<div class="o_stat_info"><span class="o_stat_text"> Related SO(s)</span></div>
					</button>
					<button name="action_view_related_purchase_orders" type="object" class="oe_stat_button" icon="fa-list-alt"
                            attrs="{'invisible': [('x_related_po_s', '=', [])]}">
						<div class="o_stat_info"><span class="o_stat_text"> Related PO(s)</span></div>
					</button>
					<button name="action_view_journal_entry" type="object" class="oe_stat_button" icon="fa-calendar"
                            attrs="{'invisible': [('x_income_move_id', '=', False)]}">
						<div class="o_stat_info">
							<span class="o_stat_text"> Income<br/> Journal Entry</span>
						</div>
					</button>
					<button name="action_view_move_sale_order" type="object" class="oe_stat_button" icon="fa-exclamation-circle"
                            attrs="{'invisible': [('x_sale_order', '=', False)]}">
						<div class="o_stat_info">
							<span class="o_stat_text"> Sale Order</span>
						</div>
					</button>
                    <field name="x_purchase_id" invisible="1"/>
					<button name="action_view_move_purchase_order" type="object" class="oe_stat_button" icon="fa-exclamation-circle"
                            attrs="{'invisible': [('x_purchase_id', '=', False)]}">
						<div class="o_stat_info">
							<span class="o_stat_text"> Purchase<br/> Order</span>
						</div>
					</button>
                </div>
                <field name="ref" position="after">
                    <label for="x_lines_partner_id" attrs="{'invisible': [('type', '!=', 'entry')]}"/>
                    <div class="o_row" attrs="{'invisible': [('type', '!=', 'entry')]}">
                        <field name="x_lines_partner_id"/>
                        <button name="update_lines_partner" string="Update" type="object" class="oe_highlight"/>
                    </div>
                </field>
                <field name="line_ids" position="before">
                    <div class="o_row" groups="account.group_account_manager">
                        Replace account <field name="x_src_account_id"/>
                        with <field name="x_dst_account_id"/>
                        <button name="update_lines_account" string="Update" type="object" class="oe_highlight"/>
                    </div>
                </field>
                <field name="partner_id" position="attributes">
                    <attribute name="context">
                        {
                        'res_partner_search_mode': (context.get('default_type', 'entry') in ('out_invoice', 'out_refund', 'out_receipt') and 'customer') or (context.get('default_type', 'entry') in ('in_invoice', 'in_refund', 'in_receipt') and 'supplier') or False,
                        'show_address': 1,
                        'default_is_company': True,
                        'show_vat': True ,
                        'default_x_company_id': company_id,
                        }
                    </attribute>
                </field>
                <field name="type" position="after">
                    <field name="x_income_move_id" invisible="1"/>
                    <field name="x_services_advance_visible" invisible="1"/>
                    <field name="x_hide_paid_banner" invisible="1"/>
                </field>
                <widget name="web_ribbon" position="attributes">
                    <attribute name="attrs">{
                        'invisible': ['|', '|', ('invoice_payment_state', '!=', 'paid'), ('x_hide_paid_banner', '=', True),
                        ('type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}
                    </attribute>
                </widget>
                <field name="currency_id" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="ref" position="after">
                    <field name="purchase_id" attrs="{'invisible': ['|',
                                                ('purchase_id','=', False),
                                                ('type', 'not in', ('in_invoice', 'in_refund', 'in_receipt'))
                                                ]}"/>
                    <field name="x_purchase_id"
                           attrs="{'invisible': ['|', ('x_purchase_id', '=', False), ('purchase_id', '!=', False)]}" string="Purchase Order"/>
                    <field name="x_unreported" attrs="{'invisible': [('type', 'not in', ('in_invoice', 'in_refund'))]}"/>
                    <field name="x_create_bills" invisible="1"/>
                    <field name="x_attach_invoices" invisible="1"/>
                    <field name="x_related_bill_ids" widget="many2many_tags" invisible="1"/>
                    <field name="x_related_invoice_ids" widget="many2many_tags" attrs="{'invisible': [('x_attach_invoices', '=', False)]}"/>
                    <field name="x_sale_ids" widget="many2many_tags" invisible="1"/>
                </field>
                <field name="currency_id" position="after">
                    <label for="currency_id"/>
                    <div class="o_row">
                        <field name="currency_id" widget="selection"/>
                        <field name="x_currency_rate_id" context="{'default_currency_id': currency_id}" options="{'no_quick_create': True}"/>
                        <field name="x_rate"/>
                    </div>
                    <field name="x_currency_warning"
                           decoration-warning="x_currency_warning != False"
                           attrs="{'invisible': [('x_currency_warning', '=', False)]}"/>
                    <field name="x_statement_line_id" invisible="1"/>
                    <field name="x_document_name" invisible="1"/>
                    <field name="x_document" filename="x_document_name"/>
                    <field name="x_reconciled_doc" filename="x_document_name"/>
                    <field name="x_attachment_ids" widget="many2many_tags" invisible="1"/>
                </field>
                <field name="amount_total" position="after">
                    <field name="amount_total_signed" string="Total" attrs="{'invisible': ['|', ('currency_id', '=', 2), ('company_id', '!=', 2)]}"/>
                    <field name="x_try_currency_id" invisible="1"/>
                    <field name="x_amount_total_try" string="Total" attrs="{'invisible': ['|', ('currency_id', '=', 31), ('company_id', '!=', 2)]}"
                           widget="monetary" options="{'currency_field': 'x_try_currency_id'}"/>
                </field>
                <field name="narration" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="type" position="before">
                    <div style="padding-bottom: 15px;">
                    <field name="narration" style="border-radius: 5px; border: 1px solid black; font-style: italic; padding:5px"/>
<!--                    <field name="narration" style="background-color: #9d708f; color: white; border-radius: 5px; border: 1px solid #9d708f; font-style: italic; padding: 5px;"/>-->
                    </div>
<!--                  #875a7b  #9d708f-->
                </field>

                <page name="other_info" position="after">
                    <page name="apv_and_vi" string="APV &amp; VI">
                        <group col="4" string="APV Document">
                            <field name="x_document_date_apv"/>
                            <field name="x_shipment_date_apv"/>
                            <field name="x_payment_term_apv"/>
                            <field name="x_signatory_apv"/>
                            <field name="x_contact_no_apv" placeholder="03000000000"/>
                        </group>
                        <b>Certificate Body:</b>
                        <field name="x_body1_apv" nolabel="1"/>
                        <br/><br/>
                        <field name="x_body2_apv" nolabel="1"/>
                        <br/><br/>
                        <field name="x_body3_apv" nolabel="1"/>
                        <br/><br/>
                        <field name="x_body4_apv" nolabel="1"/>
                    </page>
                </page>
            </field>
        </record>

        <record id="cus_accounts_account_invoice_form" model="ir.ui.view">
            <field name="name">cus_accounts_account_invoice_form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="sale.account_invoice_form"/>
            <field name="arch" type="xml">
                <data>
                    <field name="partner_shipping_id" position="attributes">
                        <attribute name="context">
                            {
                            'default_x_company_id': company_id,
                            }
                        </attribute>
                    </field>
                </data>
            </field>
        </record>

        <record id="cus_accounts_view_account_invoice_filter" model="ir.ui.view">
            <field name="name">cus_accounts_view_account_invoice_filter</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <field name="name" position="attributes">
                    <attribute name="filter_domain">[
                        '|', '|' , '|', '|', '|', '|', '|', '|', '|',
                        ('name', 'ilike', self),
                        ('invoice_origin', 'ilike', self),
                        ('ref', 'ilike', self),
                        ('invoice_payment_ref', 'ilike', self),
                        ('partner_id', 'child_of', self),
                        ('amount_total', 'ilike', self),
                        ('amount_total_signed', 'ilike', self),
                        ('x_tag_ids', 'ilike', self),
                        ('narration', 'ilike', self),
                        ('x_related_so_s', 'ilike', self),
                        ]
                    </attribute>
                </field>
                <field name="name" position="after">
                    <field name="amount_total"/>
                    <field name="name" string="Label" filter_domain="[('invoice_line_ids.name', 'ilike', self)]"/>
                    <field name="x_account_id" string="Account" filter_domain="[('invoice_line_ids.account_id', 'ilike', self)]"/>
                    <field name="narration" string="Comments"/>
                    <field name="x_related_so_s" string="Related Exp SO(s)"/>
                </field>
                <filter name="late" position="after">
                    <separator/>
                    <filter name="commented" string="Commented" domain="[('narration', '!=', False)]"/>
                </filter>
                <xpath expr="//group" position="inside">
                    <filter string="Journal" name="journal" context="{'group_by': 'journal_id'}"/>
                    <filter string="Payment Status" name="payment_status" context="{'group_by': 'x_payment_status'}"/>
                    <filter string="Attach T&amp;C" name="attach_terms" context="{'group_by': 'x_attach_long_terms'}"/>
                    <separator/>
                    <filter string="Created On" name="create_day" domain="[]" context="{'group_by': 'create_date:day'}"/>
                    <filter string="Created By" name="created_by" domain="[]" context="{'group_by':'create_uid'}"/>
                    <separator/>
                    <filter string="Bill To" name="bill_to" context="{'group_by': 'x_commercial_partner'}"/>
                </xpath>
            </field>
        </record>

        <record id="view_invoice_tree_cus_accounts" model="ir.ui.view">
            <field name="name">view_invoice_tree_cus_accounts</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <field name="company_id" position="before">
                    <field name="journal_id" optional="hide"/>
                </field>
                <field name="invoice_origin" position="after">
                    <field name="x_freight" sum="Total" optional="hide"/>
                </field>
                <field name="state" position="after">
                    <field name="x_is_commented" invisible="1"/>
                    <button name="action_show_notes" type="object" icon="fa-comment" string="Show Notes"
                                    attrs="{'invisible': [('x_is_commented', '=', False)]}"/>
                    <field name="x_payment_status" optional="hide"/>
                    <field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                    <field name="x_income_journal_entry_state" widget="state_selection" optional="hide"/>
                    <field name="create_uid" optional="hide"/>
                    <field name="create_date" optional="hide"/>
                    <field name="x_is_attachment" optional="hide" readonly="1"/>
                </field>
            </field>
        </record>

        <record id="view_invoice_tree_cus_accounts_1" model="ir.ui.view">
            <field name="name">view_invoice_tree_cus_accounts_1</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="customizations.view_invoice_tree_customization_0"/>
            <field name="arch" type="xml">
                <field name="amount_untaxed" position="after">
                    <field name="x_currency_pkr_id" invisible="1"/>
                    <field name="x_amount_untaxed_in_pkr" sum="Total" optional="hide"/>
                </field>
                <field name="amount_tax" position="after">
                    <field name="x_amount_tax_in_pkr" sum="Total" optional="hide"/>
                </field>
                <field name="amount_total" position="after">
                    <field name="x_amount_total_in_pkr" sum="Total" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="view_invoice_related_bills_action" model="ir.actions.act_window">
            <field name="name">Related Bills</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="view_bill_related_invoices_action" model="ir.actions.act_window">
            <field name="name">Related Invoices</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="cus_accounts_view_move_line_form" model="ir.ui.view">
            <field name="name">cus_accounts_view_move_line_form</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_form"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="x_custom_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="x_status" readonly="1"/>
                    <field name="x_tags_by_source" widget="many2many_tags" options="{'color_field': 'color'}" readonly="1"/>
                </field>
            </field>
        </record>

        <record id="cus_accounts_view_move_line_tree_grouped" model="ir.ui.view">
            <field name="name">cus_accounts_view_move_line_tree_grouped</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree_grouped"/>
            <field name="arch" type="xml">
                <field name="account_id" position="after">
                    <field name="x_account_type"/>
                    <field name="x_is_otb_account" invisible="1"/>
                    <field name="x_main_account_id" optional="show"/>
                    <field name="x_main_account_type" optional="show"/>
                    <field name="x_gl_type_id" optional="hide"/>
                    <field name="x_gl_group_id" optional="hide"/>
                </field>
                <field name="name" position="after">
                    <field name="x_custom_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="x_tags_by_source" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="analytic_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="x_status" optional="hide"/>
                </field>
                <field name="debit" position="after">
                    <field name="x_currency_pkr_id" invisible="1"/>
                    <field name="x_debit_in_pkr" optional="hide"/>
                </field>
                <field name="credit" position="after">
                    <field name="x_credit_in_pkr" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="cus_accounts_view_account_move_line_filter" model="ir.ui.view">
            <field name="name">cus_accounts_view_account_move_line_filter</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_account_move_line_filter"/>
            <field name="arch" type="xml">
                <field name="name" position="attributes">
                    <attribute name="filter_domain">
                        [
                        '|', '|', '|', '|', '|', '|', '|', '|', '|',
                        ('name', 'ilike', self),
                        ('ref', 'ilike', self),
                        ('account_id', 'ilike', self),
                        ('partner_id', 'ilike', self),
                        ('move_id', 'ilike', self),
                        ('x_custom_tag_ids', 'ilike', self),
                        ('x_gl_type_id', 'ilike', self),
                        ('x_gl_group_id', 'ilike', self),
                        ('analytic_tag_ids', 'ilike', self),
                        ('x_tags_by_source', 'ilike', self),
                        ]
                    </attribute>
                </field>
                <field name="move_id" position="after">
                    <field name="x_custom_tag_ids"/>
                    <field name="x_tags_by_source"/>
                </field>
<!--                <filter name="unreconciled" position="before">-->
<!--                    <filter name="reconciled" string="Reconciled" domain="[('full_reconcile_id', '!=', False), ('balance', '=', 0), ('account_id.reconcile', '=', False)]"/>-->
<!--                </filter>-->
                <filter name="date" position="after">
                    <separator/>
                    <filter string="ITB Accounts" name="itb_accounts" domain="[('x_is_otb_account', '=', False)]"/>
                    <filter string="OTB Accounts" name="otb_accounts" domain="[('x_is_otb_account', '!=', False)]"/>
                    <separator/>
                    <filter string="Tagged" name="tagged" domain="[('x_custom_tag_ids', '!=', False)]"/>
                    <separator/>
                    <filter string="Analytic Tags" name="analytic_tags" domain="[('analytic_tag_ids', '!=', False)]"/>
                </filter>
                <filter name="groupby_date" position="after">
                    <filter string="Account GL Type" name="gl_type_id" context="{'group_by':'x_gl_type_id'}"/>
                    <filter string="Account GL Group" name="gl_group_id" context="{'group_by':'x_gl_group_id'}"/>
                    <filter string="ITB Account" name="groupby_x_main_account_id" context="{'group_by': 'x_main_account_id'}"/>
                    <filter string="ITB Account Type" name="groupby_x_main_account_type" context="{'group_by': 'x_main_account_type'}"/>
                    <filter string="Status" name="status" context="{'group_by': 'x_status'}"/>
                    <filter string="Parent Account" name="groupby_x_parent_id" context="{'group_by': 'x_parent_id'}"/>
                    <filter string="Parent Account 1" name="groupby_x_parent_id_1" context="{'group_by': 'x_parent_id_1'}"/>
                    <filter string="Parent Account 2" name="groupby_x_parent_id_2" context="{'group_by': 'x_parent_id_2'}"/>
                    <filter string="Parent Account 3" name="groupby_x_parent_id_3" context="{'group_by': 'x_parent_id_3'}"/>
                    <filter string="Parent Account 4" name="groupby_x_parent_id_4" context="{'group_by': 'x_parent_id_4'}"/>
                    <filter string="Parent Account 5" name="groupby_x_parent_id_5" context="{'group_by': 'x_parent_id_5'}"/>
                </filter>
            </field>
        </record>

        <record id="view_move_form_inherited_cus_accounts" model="ir.ui.view">
            <field name="name">view_move_form_inherited_cus_accounts</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="stock_landed_costs.account_view_move_form_inherited"/>
            <field name="arch" type="xml">
                <field name="is_landed_costs_line" position="attributes">
                    <attribute name="string">LC</attribute>
                </field>
            </field>
        </record>

        <record id="view_invoice_asset_category_cus_accounts" model="ir.ui.view">
            <field name="name">view_invoice_asset_category_cus_accounts</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="base_accounting_kit.view_invoice_asset_category"/>
            <field name="arch" type="xml">
                <field name="asset_category_id" position="attributes">
                    <attribute name="optional">hide</attribute>
                </field>
            </field>
        </record>
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cus_sale_view_move_form" model="ir.ui.view">
            <field name="name">cus_sale_view_move_form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="ref" position="after">
                    <field name="x_update_move_line_sale_orders" invisible="1"/>
                </field>
                <xpath expr="//field[@name='line_ids']/tree[1]/field[@name='account_id']" position="before">
                    <field name="x_origin" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='line_ids']/tree[1]/field[@name='name']" position="after">
                    <field name="x_label" invisible="1"/>
                    <field name="x_luca_name" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='line_ids']/form[1]/group[1]/field[@name='recompute_tax_line']" position="after">
                    <field name="x_luca_name"/>
                </xpath>
            </field>
        </record>

        <record id="cus_sale_view_move_line_form" model="ir.ui.view">
            <field name="name">cus_sale_view_move_line_form</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_form"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="x_luca_name"/>
                </field>
            </field>
        </record>

        <record id="cus_sale_view_move_line_tree" model="ir.ui.view">
            <field name="name">cus_sale_view_move_line_tree</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="x_luca_name" optional="hide"/>
                    <field name="x_origin" optional="hide"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
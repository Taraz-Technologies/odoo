<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--        Cable Manufacturing Views-->
    <record id="view_cable_assembly_form" model="ir.ui.view">
        <field name="name">cable.assembly.form</field>
        <field name="model">cable.assembly</field>
        <field name="arch" type="xml">
            <form string="Manufacturing Orders">
                <header>
                    <button name="export_bom" string="Export BOM" type="object" class="oe_highlight"/>
                    <button name="export_wire_label_e800tk" string="Export Wire Label E800TK" type="object"
                            class="oe_highlight"/>
                    <button name="export_wire_label_p600" string="Export Wire Label P600" type="object"
                            class="oe_highlight"/>
                    <button name="export_product_label" string="Export Product Label" type="object"
                            class="oe_highlight"/>
                    <button name="export_cut_list" string="Export Cut List" type="object" class="oe_highlight"/>
                    <button name="start_manufacturing" string="Start" type="object"
                            attrs="{'invisible': [('state', '=', 'in_progress')]}"/>
                    <button name="pause_manufacturing" string="Pause" type="object"
                            attrs="{'invisible': [('state', 'in', ('on_hold', 'done'))]}"/>
                    <button name="finish_manufacturing" string="Finish" type="object"
                            attrs="{'invisible': [('state', '=', 'done')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,on_hold,done"/>
                </header>
                <div class="oe_button_box" name="button_box">
                    <field name="x_cable_assembly_demand_list_id" invisible="1"/>
                    <button string="Demand List"
                            name="action_view_demand_list"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-tasks"
                            attrs="{'invisible': [('x_cable_assembly_demand_list_id', '=', False)]}">
                    </button>
                    <field name="x_task_id" invisible="1"/>
                    <button string="Task"
                            name="action_view_task"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-tasks"
                            attrs="{'invisible': [('x_task_id', '=', False)]}">
                    </button>
                </div>
                <group>
                    <group>
                        <div class="oe_title">
                            <h1>
                                <field name="x_name"/>
                            </h1>
                        </div>
                    </group>
                    <group>
                        <div class="oe_title">
                            <h1>Time:
                                <field name="x_hours" widget="float_time" readonly="1"/>
                            </h1>
                        </div>
                    </group>
                </group>
                <group>
                    <field name="x_time" invisible="1"/>
                </group>
                <group>
                    <group>
                        <field name="x_uom_id"/>
                    </group>
                    <group>

                    </group>
                </group>
                <group>
                    <field name="x_bom_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="x_product_id"/>
                            <field name="x_product_bom_id"/>
                            <field name="x_quantity" sum="Quantity"/>
                        </tree>
                    </field>
                </group>
                <separator string="Wiring Lines" colspan="4"/>
                <group>
                    <field name="x_wiring_lines" nolabel="1">
                        <form string="Wiring Line">
                            <header>
                                <field name="state" widget="statusbar" statusbar_visible="new,done"/>
                            </header>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="x_ref_des"/>
                                        <field name="x_name"/>
                                        <field name="x_quantity"/>
                                        <field name="x_unit_length"/>
                                        <field name="x_uom_id"/>
                                        <field name="x_harness"/>
                                        <field name="x_wire_core"/>
                                        <field name="x_wire"/>
                                    </group>
                                    <group>
                                        <field name="x_start_connector"/>
                                        <field name="x_end_connector"/>
                                        <field name="x_start_heat_shrink_label"/>
                                        <field name="x_end_heat_shrink_label"/>
                                    </group>
                                    <group>
                                        <field name="x_start_label"/>
                                        <field name="x_end_label"/>
                                        <field name="x_wire_label"/>
                                        <field name="x_core_label"/>
                                        <field name="x_harness_label"/>
                                        <field name="x_notes"/>
                                        <field name="x_cable_assembly_id" invisible="1"/>
                                    </group>
                                </group>
                                <separator string="Images" colspan="4"/>
                                <field name="x_image_ids" mode="kanban"/>
                            </sheet>
                        </form>
                        <tree editable="bottom"
                              decoration-warning="x_wire_color == 'yellow'"
                              decoration-danger="x_wire_color == 'red'"
                              decoration-success="x_wire_color == 'green'"
                              decoration-info="x_wire_color == 'blue'"
                              decoration-bf="x_wire_color in ('grey', 'black')"
                              decoration-muted="x_wire_color == 'grey'"
                        >
                            <button name="change_state_done" string="Change state to DONE" type="object"
                                    icon="fa-check"/>
                            <field name="x_wire_color" invisible="1"/>
                            <field name="state" invisible="1"/>
                            <field name="x_ref_des" optional="show" widget="many2one"/>
                            <field name="x_name"/>
                            <field name="x_quantity"/>
                            <field name="x_unit_length"/>
                            <field name="x_uom_id"/>
                            <field name="x_wire_core" optional="show" widget="many2one"/>
                            <field name="x_harness" optional="show" widget="many2one"/>
                            <field name="x_wire" optional="show"/>
                            <field name="x_start_connector" optional="show"/>
                            <field name="x_end_connector" optional="show"/>
                            <field name="x_start_heat_shrink_label" optional="show"/>
                            <field name="x_end_heat_shrink_label" optional="show"/>
                            <field name="x_status" optional="show"/>
                            <field name="x_start_label" optional="show"/>
                            <field name="x_end_label" optional="show"/>
                            <field name="x_wire_label" optional="show"/>
                            <field name="x_core_label" optional="show"/>
                            <field name="x_harness_label" optional="show"/>
                            <field name="x_notes" optional="show"/>
                        </tree>
                    </field>
                </group>
                <separator string="Capture Images" colspan="4"/>
                <field name="x_image_ids" mode="kanban"/>
            </form>
        </field>
    </record>

    <record id="view_cable_assembly_tree" model="ir.ui.view">
        <field name="name">cable.assembly.tree</field>
        <field name="model">cable.assembly</field>
        <field name="arch" type="xml">
            <tree string="Manufacturing Orders">
                <field name="x_name"/>
                <field name="x_bom_ids" widget="many2many_tags"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_cable_assembly_filter" model="ir.ui.view">
        <field name="name">cable.assembly.select</field>
        <field name="model">cable.assembly</field>
        <field name="arch" type="xml">
            <search string="Manufacturing Orders">
                <field name="x_name" string="Manufacturing Orders" filter_domain="[('x_name','ilike',self)]"/>
            </search>
        </field>
    </record>

    <record id="action_cable_assembly" model="ir.actions.act_window">
        <field name="name">Manufacturing Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cable.assembly</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cable_assembly_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Record
            </p>
        </field>
    </record>
    <!--        Demand List-->
    <record id="view_demand_list_form" model="ir.ui.view">
        <field name="name">cable.assembly.demand.list.form</field>
        <field name="model">cable.assembly.demand.list</field>
        <field name="arch" type="xml">
            <form string="Demand list">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name"/>
                        </h1>
                    </div>
                    <field name="x_cable_assembly_id" invisible="1"/>
                    <separator string="Product List" colspan="4"/>
                    <field name="x_product_demand_list_line_ids">
                        <form>
                            <group col="4">
                                <field name="x_name"/>
                                <field name="x_description"/>
                                <field name="x_quantity"/>
                                <field name="x_uom_id"/>
                                <field name="x_cable_assembly_demand_list_id" invisible="1"/>
                            </group>
                        </form>
                        <tree>
                            <field name="x_name"/>
                            <field name="x_description"/>
                            <field name="x_quantity"/>
                            <field name="x_uom_id"/>
                            <field name="x_cable_assembly_demand_list_id" invisible="1"/>
                        </tree>
                    </field>
                    <separator string="Connector List" colspan="4"/>
                    <field name="x_connector_demand_list_line_ids">
                        <form>
                            <group col="4">
                                <field name="x_label"/>
                                <field name="x_product_id"/>
                                <field name="x_description"/>
                                <field name="x_required_qty"/>
                                <field name="x_available_qty"/>
                                <field name="x_uom_id"/>
                                <field name="x_cable_assembly_demand_list_id" invisible="1"/>
                            </group>
                        </form>
                        <tree decoration-success="(x_required_qty &lt; x_available_qty)"
                              decoration-danger="(x_required_qty &gt; x_available_qty)"
                              decoration-info="(x_required_qty == x_available_qty)">
                            <field name="x_label"/>
                            <field name="x_product_id"/>
                            <field name="x_description"/>
                            <field name="x_required_qty"/>
                            <field name="x_available_qty"/>
                            <field name="x_uom_id"/>
                            <field name="x_cable_assembly_demand_list_id" invisible="1"/>
                        </tree>
                    </field>
                    <separator string="Wire List" colspan="4"/>
                    <field name="x_wire_demand_list_line_ids">
                        <form>
                            <group col="4">
                                <field name="x_label"/>
                                <field name="x_product_id"/>
                                <field name="x_description"/>
                                <field name="x_required_qty"/>
                                <field name="x_available_qty"/>
                                <field name="x_uom_id"/>
                                <field name="x_cable_assembly_demand_list_id" invisible="1"/>
                            </group>
                        </form>
                        <tree decoration-success="(x_required_qty &lt; x_available_qty)"
                              decoration-danger="(x_required_qty &gt; x_available_qty)"
                              decoration-info="(x_required_qty == x_available_qty)">
                            <field name="x_label"/>
                            <field name="x_product_id"/>
                            <field name="x_description"/>
                            <field name="x_required_qty"/>
                            <field name="x_available_qty"/>
                            <field name="x_uom_id"/>
                            <field name="x_cable_assembly_demand_list_id" invisible="1"/>
                        </tree>
                    </field>
                    <separator string="Harness List" colspan="4"/>
                    <field name="x_harness_demand_list_line_ids">
                        <form>
                            <group col="4">
                                <field name="x_harness_id"/>
                                <field name="x_quantity"/>
                                <field name="x_uom_id"/>
                                <field name="x_cable_assembly_demand_list_id" invisible="1"/>
                            </group>
                        </form>
                        <tree>
                            <field name="x_harness_id"/>
                            <field name="x_quantity"/>
                            <field name="x_uom_id"/>
                            <field name="x_cable_assembly_demand_list_id" invisible="1"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_demand_list" model="ir.actions.act_window">
        <field name="name">Demand List</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cable.assembly.demand.list</field>
        <field name="view_mode">form</field>
    </record>
    <!--        Project Views-->
    <record id="act_cable_assembly_project_task_all" model="ir.actions.act_window">
        <field name="name">Cable Manufacturing Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,tree,form,calendar,pivot,graph,activity</field>
        <field name="context">{
            'pivot_row_groupby': ['user_id'],
            'search_default_project_id': [6],
            'search_default_trackbot_task': 1,
            'search_default_pending_task': 1,
            'search_default_normal_task': 1,
            'search_default_blocked_task': 1,
            'default_project_id': 6,
            'default_user_id': 28,
            }
        </field>
        <field name="domain">[('project_id', '=', 6),('user_id', '=', 28)]</field>
        <field name="search_view_id" ref="project.view_task_search_form"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click <i>Create</i> to start a new task.
            </p>
            <p>
                To get things done, use activities and status on tasks.
                <br/>
                Chat in real time or by email to collaborate efficiently.
            </p>
        </field>
    </record>
</odoo>
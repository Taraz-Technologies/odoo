<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--        Product Label Views-->
    <record id="view_product_label_form" model="ir.ui.view">
        <field name="name">product.label.form</field>
        <field name="model">product.label</field>
        <field name="arch" type="xml">
            <form string="Products">
                <sheet>
                    <group col="4">
                        <field name="x_name"/>
                        <field name="x_description"/>
                        <field name="x_product_code_ids" widget="many2many_tags"/>
                        <field name="x_label_required"/>
                    </group>
                    <separator string="Points" colspan="4"/>
                    <field name="x_product_point_ids">
                        <tree editable="bottom">
                            <field name="x_name"/>
                            <field name="x_point_desc"/>
                            <field name="x_pin_ids" widget="many2many_tags"/>
                        </tree>
                    </field>
                    <separator string="Capture Images" colspan="4"/>
                    <field name="x_image_ids" mode="kanban"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_label_tree" model="ir.ui.view">
        <field name="name">product.label.tree</field>
        <field name="model">product.label</field>
        <field name="arch" type="xml">
            <tree string="Products">
                <field name="x_sequence" widget="handle"/>
                <field name="x_name"/>
                <field name="x_description"/>
                <field name="x_product_code_ids" widget="many2many_tags"/>
                <field name="x_product_point_ids" widget="many2many_tags"/>
                <field name="x_label_required"/>
            </tree>
        </field>
    </record>

    <record id="view_product_label_filter" model="ir.ui.view">
        <field name="name">product.label.select</field>
        <field name="model">product.label</field>
        <field name="arch" type="xml">
            <search string="Products">
                <field name="x_name" string="Products" filter_domain="[('x_name','ilike',self)]"/>
            </search>
        </field>
    </record>

    <record id="action_product_label" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.label</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_product_label_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Record
            </p>
        </field>
    </record>

    <!--        Product Point Views-->
    <record id="view_product_point_form" model="ir.ui.view">
        <field name="name">product.point.form</field>
        <field name="model">product.point</field>
        <field name="arch" type="xml">
            <form string="Product Point">
                <sheet>
                    <group col="4">
                        <field name="x_point_name"/>
                        <field name="x_name"/>
                        <field name="x_point_desc"/>
                        <field name="x_pin_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_point_tree" model="ir.ui.view">
        <field name="name">product.point.tree</field>
        <field name="model">product.point</field>
        <field name="arch" type="xml">
            <tree string="Product Point">
                <field name="x_point_name"/>
                <field name="x_name"/>
                <field name="x_point_desc"/>
                <field name="x_pin_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_product_point_filter" model="ir.ui.view">
        <field name="name">product.point.select</field>
        <field name="model">product.point</field>
        <field name="arch" type="xml">
            <search string="Product Point">
                <field name="x_name" string="Product Point" filter_domain="[('x_name','ilike',self)]"/>
            </search>
        </field>
    </record>

    <record id="action_product_point" model="ir.actions.act_window">
        <field name="name">Product Point</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.point</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_product_point_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Record
            </p>
        </field>
    </record>

</odoo>
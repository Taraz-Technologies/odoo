<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_serial_number_tree" model="ir.ui.view">
            <field name="name">serial.number.tree</field>
            <field name="model">serial.number</field>
            <field name="arch" type="xml">
                <tree string="QC Lines" create="0" delete="0">
                    <field name="x_manufacturing_id"/>
                    <field name="x_product_id"/>
                    <field name="x_serial_number"/>
                    <field name="x_sale_order_number" widget="many2one"/>
                    <field name="x_mega_mo_number"/>
                    <field name="x_status"/>
                </tree>
            </field>
        </record>

        <record id="view_serial_number_form" model="ir.ui.view">
            <field name="name">serial.number.form</field>
            <field name="model">serial.number</field>
            <field name="arch" type="xml">
                <form string="QC Lines" create="0" delete="0">
                    <sheet>
                        <group col="4">
                            <field name="x_manufacturing_id" readonly="1"/>
                            <field name="x_product_id" readonly="1"/>
                            <field name="x_serial_number" readonly="1"/>
                            <field name="x_sale_order_number" readonly="1"/>
                            <field name="x_mega_mo_number" readonly="1"/>
                            <field name="x_status"/>
                            <field name="x_notes"/>
                        </group>
                        <separator colspan="4" string="QC Checklist"/>
                        <div class="o_row">
                            <button name="get_qc_checklist" string="Refresh" type="object"
                                    class="oe_highlight" icon="fa-refresh"/>
                        </div>
                        <field name="x_qc_checklist_ids">
                            <tree create="0" delete="0" editable="bottom">
                                <field name="x_checklist" readonly="1"/>
                                <field name="x_description" readonly="1"/>
                                <field name="x_notes" readonly="1"/>
                                <field name="x_typical_value" readonly="1"/>
                                <field name="x_measured_value"/>
                                <field name="x_status"/>
                            </tree>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_serial_number_search" model="ir.ui.view">
            <field name="name">serial.number.search</field>
            <field name="model">serial.number</field>
            <field name="arch" type="xml">
                <search string="Search QC Lines">
                    <field name="x_serial_number" filter_domain="[
                    '|', '|', '|', '|',
                    ('x_manufacturing_id', 'ilike', self),
                    ('x_serial_number', 'ilike', self),
                    ('x_sale_order_number.name', 'ilike', self),
                    ('x_mega_mo_number', 'ilike', self),
                    ('x_status', 'ilike', self)
                    ]"/>
                    <field name="x_sale_order_number"/>
                    <field name="x_mega_mo_number"/>
                    <field name="x_status"/>
                    <separator/>
                    <filter name="fail" string="Fail" domain="[('x_status', '=', 'fail')]"/>
                    <filter name="pass" string="Pass" domain="[('x_status', '=', 'pass')]"/>
                    <group expand="0" string="Group By">
                        <filter name="manufacturing" string="Manufacturing Order"
                                context="{'group_by': 'x_manufacturing_id'}"/>
                        <filter name="status" string="Status" context="{'group_by': 'x_status'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <menuitem id="cus_quality_control_root"
                  name="Quality Control"
                  sequence="1"
                  web_icon="cus_quality_control,static/description/icon.png"/>

        <record id="quality_control_view_form" model="ir.ui.view">
            <field name="name">quality_control_view_form</field>
            <field name="model">quality.control</field>
            <field name="arch" type="xml">
                <form string="Quality Control" create="0">
                    <header>
                        <button name="start_qc" class="oe_highlight" type="object" string="Start QC" states="draft"/>
                        <button name="mark_as_done" class="oe_highlight" type="object" string="Mark as Done"
                                attrs="{'invisible': ['|',  ('x_qc_complete', '=', False), ('state', '!=', 'in_progress')]}"/>
                        <button name="mark_as_done_with_complete_qc" class="oe_highlight" type="object"
                                string="Mark as Done"
                                attrs="{'invisible': ['|',  ('x_qc_complete', '=', True), ('state', '!=', 'in_progress')]}"
                                confirm="QC status of some products in not defined. Do you want to pass all undefined products?"/>
                        <button name="set_to_draft" type="object" string="Set to Draft" states="done,in_progress"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="x_manufacturing_id" readonly="1"/>
                                <field name="x_product_id"/>
                                <field name="x_qc_complete" invisible="1"/>
                                <field name="x_deadline"/>
                            </group>
                            <group>
                                <field name="x_bom_tool_id"/>
                                <field name="x_quantity"/>
                                <field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Products">
                                <field name="x_serial_product_ids">
                                    <tree create="0" delete="0">
                                        <field name="x_serial_number"/>
                                        <field name="x_sale_order_number" widget="many2one"/>
                                        <field name="x_mega_mo_number"/>
                                        <field name="x_status"/>
                                    </tree>
                                    <form>
                                        <sheet>
                                            <group col="4">
                                                <field name="x_serial_number" readonly="1"/>
                                                <field name="x_sale_order_number" readonly="1"/>
                                                <field name="x_mega_mo_number" readonly="1"/>
                                                <field name="x_status"/>
                                                <field name="x_notes"/>
                                            </group>
                                            <separator colspan="4" string="QC Checklist"/>
                                            <div class="o_row">
                                                <button name="get_qc_checklist" string="Refresh" type="object"
                                                        class="oe_highlight" icon="fa-refresh"/>
                                            </div>
                                            <field name="x_qc_checklist_ids">
                                                <tree create="0" delete="0" editable="bottom">
                                                    <field name="x_checklist" readonly="1"/>
                                                    <field name="x_description" readonly="1"/>
                                                    <field name="x_notes" readonly="1"/>
                                                    <field name="x_typical_value" readonly="1"/>
                                                    <field name="x_measured_value"/>
                                                    <field name="x_status"/>
                                                </tree>
                                            </field>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page string="Fine Distribution">
                                <group>
                                    <group>
                                        <field name="x_department_ids" widget="many2many_tags"/>
                                        <field name="x_split_by"/>
                                    </group>
                                    <group>
                                        <field name="x_stock_valuation_layer_id"/>
                                        <field name="x_currency_id"/>
                                        <field name="x_fine_amount" widget="monetary"
                                               options="{'currency_field': 'x_currency_id'}"/>
                                        <field name="x_distribute_fine" invisible="1"/>
                                    </group>
                                </group>
                                <field name="x_employee_ids">
                                    <tree editable="bottom">
                                        <field name="x_quality_id" invisible="1"/>
                                        <field name="x_employee_id"/>
                                        <field name="x_share" sum="Total"
                                               attrs="{'column_invisible': [('parent.x_split_by', '!=', 'by_share')]}"/>
                                        <field name="x_percentage" widget="percentage" sum="Total"
                                               attrs="{'column_invisible': [('parent.x_split_by', '!=', 'by_percentage')]}"/>
                                        <field name="x_currency_id" invisible="1"/>
                                        <field name="x_fine_amount" widget="monetary" sum="Total"
                                               options="{'currency_field': 'x_currency_id'}"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread" options="{'post_refresh': 'recipients'}"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="quality_control_view_tree" model="ir.ui.view">
            <field name="name">quality_control_view_tree</field>
            <field name="model">quality.control</field>
            <field name="arch" type="xml">
                <tree string="Quality Control" create="0" default_order="x_deadline">
                    <field name="x_deadline"/>
                    <field name="x_product_id"/>
                    <field name="x_quantity"/>
                    <field name="x_manufacturing_id"/>
                    <field name="x_bom_tool_id"/>
                    <field name="x_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="x_mrp_demand_ids" widget="many2many_tags" optional="show"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="quality_control_view_search" model="ir.ui.view">
            <field name="name">quality_control_view_search</field>
            <field name="model">quality.control</field>
            <field name="arch" type="xml">
                <search string="Quality Control">
                    <field name="x_product_id" filter_domain="[
                    '|', '|', '|',
                    ('x_product_id', 'ilike', self),
                    ('x_manufacturing_id', 'ilike', self),
                    ('x_mrp_demand_ids', 'ilike', self),
                    ('x_tag_ids', 'ilike', self),
                    ]"/>
                    <field name="x_manufacturing_id"/>
                    <field name="x_mrp_demand_ids"/>
                    <field name="x_tag_ids"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Product" name="product" context="{'group_by': 'x_product_id'}"/>
                        <filter string="Manufacturing Order" name="manufacturing"
                                context="{'group_by': 'x_manufacturing_id'}"/>
                        <filter string="Status" name="state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="quality_control_action" model="ir.actions.act_window">
            <field name="name">Quality Control</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">quality.control</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="quality_control_view_tree"/>
            <field name="search_view_id" ref="quality_control_view_search"/>
        </record>

        <menuitem id="quality_control_menu"
                  name="Quality Control"
                  parent="cus_quality_control_root"
                  action="quality_control_action"
                  sequence="1"/>
    </data>
</odoo>
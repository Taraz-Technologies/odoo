<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_form_cus_production_planner" model="ir.ui.view">
            <field name="name">stock.picking.form.cus_production_planner</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="priority" eval="99"/>
            <field name="arch" type="xml">
                <data>
                    <div name="button_box" position="inside">
                        <button name="action_view_picking_lines" type="object"
                                class="oe_stat_button" icon="fa-align-justify"
                                attrs="{'invisible': ['|',
                                ('state', 'in', ('draft')),
                                ('picking_type_code', 'not in', ('internal')),
                            ]}"
                        >
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Short Parts</span>
                            </div>
                        </button>
                        <button name="action_view_manufacturing_order" type="object"
                                class="oe_stat_button" icon="fa-align-justify"
                                attrs="{'invisible': [('x_manufacturing_id', '=', False) ]}"
                        >
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">MO</span>
                            </div>
                        </button>
                    </div>
                    <field name='origin' position="after">
                        <field name="x_manufacturing_id" attrs="{'invisible': [('x_manufacturing_id', '=', False)]}"/>
                        <field name="x_production_status" attrs="{'invisible': [('x_manufacturing_id', '=', False)]}"/>
                        <field name="x_mo_deadline" attrs="{'invisible': [('x_manufacturing_id', '=', False)]}"/>
                        <field name="x_product_id" attrs="{'invisible': [('x_product_id', '=', False)]}"/>
                        <label for="x_bom_id" attrs="{'invisible': [('x_bom_id', '=', False)]}"/>
                        <div class="o_row" attrs="{'invisible': [('x_bom_id', '=', False)]}">
                            <field name="x_bom_id"/>
                            <button string="Update Lines" name="update_move_raw_ids" type="object" class="btn-primary"
                                    attrs="{'invisible': ['|', ('x_bom_id', '=', False), ('state', 'in', ('done', 'cancel'))]}"/>
                        </div>
                        <field name="x_manufacturing_type"
                               attrs="{'invisible': [('picking_type_code', 'not in', ('internal'))]}"/>
                    </field>
                    <page name="note" position="after">
                        <page string="Manufacturing Orders"
                              attrs="{'invisible': [('picking_type_code', 'not in', ('outgoing'))]}">
                            <separator colspan="4" string="Product Delivery Status"/>
                            <field name="x_product_delivery_status_ids">
                                <tree>
                                    <field name="x_picking_id" invisible="1"/>
                                    <field name="x_mrp_demand_id" invisible="1"/>
                                    <field name="x_manufacturing_id" widget="many2one"/>
                                    <field name="x_expected_date"/>
                                    <field name="x_product_id"/>
                                    <field name="x_quantity"/>
                                    <field name="x_completion" widget="percentage"/>
                                    <field name="x_status"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="x_product_id"/>
                                                <field name="x_quantity"/>
                                            </group>
                                            <group>
                                                <field name="x_completion" widget="percentage"/>
                                                <field name="x_status"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                            <separator colspan="4" string="Manufacturing Orders"/>
                            <field name="x_mrp_demand_ids" readonly="1">
                                <tree default_order="x_date_planned_start">
                                    <field name="x_date_planned_start"/>
                                    <field name="x_date_planned_finished"/>
                                    <field name="x_manufacturing_id" widget="many2one" readonly="1"/>
                                    <field name="x_mo_state" optional="hide"/>
                                    <field name="x_child_product_id" readonly="1"/>
                                    <field name="x_child_product_qty" sum="Total"/>
                                    <field name="x_master_order_id" widget="many2one" readonly="1"/>
                                    <field name="x_product_id"/>
                                    <field name="x_product_qty"/>
                                    <field name="x_product_category" string="Category" optional="hide"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="x_sale_id" widget="many2one"/>
                                                <field name="x_folder_name" string="Sale Order Details"/>
                                                <field name="x_deadline"/>
                                                <field name="x_quantity"/>
                                            </group>
                                            <group>
                                                <field name="x_master_order_id" widget="many2one"/>
                                                <field name="x_product_id"/>
                                                <field name="x_product_category"/>
                                                <field name="x_demand_type"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </page>
                </data>
            </field>
        </record>

        <record id="view_picking_tree_cus_production_planner" model="ir.ui.view">
            <field name="name">stock.picking.tree.cus_production_planner</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree"/>
            <field name="priority" eval="99"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//tree" position="attributes">
                        <attribute name="default_order">x_mo_deadline</attribute>
                    </xpath>
                    <field name='name' position="after">
                        <field name="x_product_id" optional="show"/>
                        <field name="x_production_status" invisible="1"/>
                    </field>
                    <field name="scheduled_date" position="before">
                        <field name="x_mo_deadline"/>
                        <field name="x_sale_order_ids" widget="many2many_tags" optional="show"/>
                    </field>
                </data>
            </field>
        </record>

        <record id="view_picking_internal_search_cus_production_planner" model="ir.ui.view">
            <field name="name">view_picking_internal_search_cus_production_planner</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_internal_search"/>
            <field name="priority" eval="99"/>
            <field name="arch" type="xml">
                <data>
                    <filter name="cancel" position="after">
                        <separator/>
                        <filter string="Procurement" name="procurement"
                                domain="[('x_manufacturing_type', '=', 'proc')]"/>
                        <filter string="Manufacturing" name="manufacturing"
                                domain="[('x_manufacturing_type', '=', 'mrp')]"/>
                        <separator/>
                        <filter string="MO Draft" name="mo_draft" domain="[('x_production_status', '=', 'draft')]"/>
                        <filter string="MO Confirmed" name="mo_confirmed"
                                domain="[('x_production_status', '=', 'confirmed')]"/>
                        <filter string="MO Planned" name="mo_planned"
                                domain="[('x_production_status', '=', 'planned')]"/>
                        <filter string="MO In Progress" name="mo_progress"
                                domain="[('x_production_status', '=', 'progress')]"/>
                        <filter string="MO To Close" name="mo_to_close"
                                domain="[('x_production_status', '=', 'to_close')]"/>
                        <filter string="MO Done" name="mo_done" domain="[('x_production_status', '=', 'done')]"/>
                        <filter string="MO Cancel" name="mo_cancel" domain="[('x_production_status', '=', 'cancel')]"/>
                        <separator/>
                        <filter string="BOM" name="status_bom" domain="[('x_product_delivery_status_ids.x_status', '=', 'bom')]"/>
                        <filter string="PRC" name="status_prc" domain="[('x_product_delivery_status_ids.x_status', '=', 'procurement')]"/>
                        <filter string="PRD" name="status_prd" domain="[('x_product_delivery_status_ids.x_status', '=', 'production')]"/>
                        <filter string="QCT" name="status_qct" domain="[('x_product_delivery_status_ids.x_status', '=', 'quality')]"/>
                        <filter string="PAC" name="status_pac" domain="[('x_product_delivery_status_ids.x_status', '=', 'packing')]"/>
                    </filter>
                    <filter name="picking_type" position="after">
                        <filter string="Order Type" name="manufacturing_type" domain="[]"
                                context="{'group_by': 'x_manufacturing_type'}"/>
                        <filter string="MO Status" name="manufacturing_status" domain="[]"
                                context="{'group_by': 'x_production_status'}"/>
                    </filter>
                </data>
            </field>
        </record>

        <record id="stock_picking_kanban_cus_production_planner" model="ir.ui.view">
            <field name="name">stock_picking_kanban_cus_production_planner</field>
            <field name="model">stock.picking</field>
            <field name="priority" eval="10"/>
            <field name="inherit_id" ref="cus_logistics_tracking.stock_picking_kanban_cus_logistics_tracking"/>
            <field name="arch" type="xml">
                <data>
                    <field name="x_shipping_invoice_lines" position="after">
                        <field name="x_compute_delivery_order_state"/>
                        <field name="x_product_delivery_status_ids"/>
                    </field>
                    <div class="o_kanban_record_body" position="inside">
                        <span>
                            <field name="x_product_delivery_status_ids" widget="many2many_tags"/>
                        </span>
                    </div>
                </data>
            </field>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<template id="report_letter_reports_document">
		<t t-call="web.external_layout">
			<div class="page">
				<div class="row">
					<div class="col">
						<span t-field="o.x_letter_content"/>
						<span t-field="o.x_signature" t-if="o.x_add_signature"/>
					</div>
				</div>
			</div>
		</t>
	</template>

	<template id="report_letter_reports">
		<t t-call="web.html_container">
			<t t-foreach="docs" t-as="o">
				<t t-call="cus_letters.report_letter_reports_document"/>
			</t>
		</t>
	</template>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
<!--        Scrum Project Stages-->
        <record id="scrum_project_stage_0" model="scrum.project.type">
            <field name="x_name">New</field>
            <field name="x_description">New projects are created here by default</field>
            <field name="x_sequence">0</field>
            <field name="x_fold">0</field>
            <field name="x_default_stage">1</field>
            <field name="x_last_stage">0</field>
            <field name="x_stage_id" ref="scrum_task_stage_0"/>
        </record>

        <record id="scrum_project_stage_1" model="scrum.project.type">
            <field name="x_name">In Progress</field>
            <field name="x_description">Projects in progress will be listed in this stage</field>
            <field name="x_sequence">1</field>
            <field name="x_fold">0</field>
            <field name="x_last_stage">0</field>
            <field name="x_stage_id" ref="scrum_task_stage_1"/>
        </record>

        <record id="scrum_project_stage_2" model="scrum.project.type">
            <field name="x_name">Done</field>
            <field name="x_description">Completed projects will be listed in this stage</field>
            <field name="x_sequence">2</field>
            <field name="x_fold">0</field>
            <field name="x_last_stage">1</field>
            <field name="x_stage_id" ref="scrum_task_stage_7"/>
        </record>
    </data>
</odoo>
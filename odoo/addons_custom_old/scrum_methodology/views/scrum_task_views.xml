<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Task Types-->
    <record id="scrum_task_type_view_form" model="ir.ui.view">
        <field name="name">scrum_task_type_view_form</field>
        <field name="model">scrum.task.type</field>
        <field name="arch" type="xml">
            <form string="Task Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="x_name"/>
                        </group>
                        <group>
                            <field name="fold"/>
                            <field name="x_ready_stage"/>
                            <field name="x_last_stage"/>
                        </group>
                    </group>
                    <group string="Stage Description">
                        <p class="text-muted" colspan="2">
                            You can also add a description to help your coworkers understand the meaning and purpose of the stage.
                        </p>
                        <field name="x_description" placeholder="Add a description..." nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="scrum_task_type_view_tree" model="ir.ui.view">
        <field name="name">scrum_task_type_view_tree</field>
        <field name="model">scrum.task.type</field>
        <field name="arch" type="xml">
            <tree string="Task Stage">
                <field name="sequence" widget="handle"/>
                <field name="x_name"/>
                <field name="x_description"/>
                <field name="fold"/>
                <field name="x_ready_stage"/>
                <field name="x_last_stage"/>
            </tree>
        </field>
    </record>

    <record id="scrum_task_type_view_search" model="ir.ui.view">
       <field name="name">scrum_task_type_view_search</field>
       <field name="model">scrum.task.type</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="x_name"/>
                <field name="x_description"/>
            </search>
       </field>
    </record>

    <record id="scrum_task_type_action" model="ir.actions.act_window">
        <field name="name">Task Stage</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">scrum.task.type</field>
        <field name="view_mode">tree,form</field>
    </record>
<!--    Tasks-->
    <record id="scrum_task_view_kanban" model="ir.ui.view">
        <field name="name">scrum_task_view_kanban</field>
        <field name="model">scrum.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="x_stage_id" class="o_kanban_small_column">
                <field name="x_priority"/>
                <field name="x_task_weightage"/>
                <field name="x_weightage"/>
                <field name="x_name"/>
                <field name="x_project_id"/>
                <field name="x_stage_id" options='{"group_by_tooltip": {"x_description": "Description"}, "fold_field": "fold"}'/>
                <field name="x_user_id"/>
                <field name="x_user_ids"/>
                <progressbar field="x_priority" colors='{"1": "success", "2": "warning", "3": "danger"}' sum_field="x_weightage"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="x_name"/></strong>
                                        <span style="color:rgb(0,159,159);font-weight:bold;"><br/><field name="x_project_id"/></span>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown" t-if="!selection_mode" groups="base.group_user">
                                        <a role="button" class="dropdown-toggle o-no-caret btn" data-toggle="dropdown" data-display="static" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a t-if="widget.editable" role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                            <a name="copy" role="menuitem" type="object" class="dropdown-item">Duplicate</a>
                                            <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom" t-if="!selection_mode">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="x_priority" widget="priority"/>
                                        <button name="increase_weightage" type="object" class="btn btn-secondary fa fa-plus"/>
                                        <field name="x_task_weightage"/>
                                        <button name="decrease_weightage" type="object" class="btn btn-secondary fa fa-minus"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right" t-if="!selection_mode">
                                        <img t-att-src="kanban_image('res.users', 'image_128', record.x_user_id.raw_value)" t-att-title="user_id" t-att-alt="record.x_user_id.raw_value" class="oe_kanban_avatar"/>
                                        <t t-foreach="record.x_user_ids.raw_value" t-as="user_id">
                                            <img t-att-src="kanban_image('res.users', 'image_128', user_id)" t-att-title="user_id" t-att-alt="user_id" class="oe_kanban_avatar"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="oe_clear"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="scrum_task_view_form" model="ir.ui.view">
        <field name="name">scrum_task_view_form</field>
        <field name="model">scrum.task</field>
        <field name="arch" type="xml">
            <form string="Tasks">
                <header>
                    <field name="x_stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="x_sequence" invisible="1"/>
                    <div class="oe_title pr-0">
                        <h3>
                            <field name="x_name" placeholder="Task Title..."
                                   style="max-width: 688px; margin-right: auto; overflow: hidden;
                                   text-overflow: ellipsis; white-space: nowrap;"/>
                        </h3>
                    </div>
                    <group>
                        <field name="x_priority" widget="priority"/>
                        <field name="x_task_weightage"/>
                        <field name="x_weightage" invisible="1"/>
                        <field name="x_department_id"/>
                        <field name="x_user_id"/>
                        <field name="x_user_ids" widget="many2many_tags"/>
                        <field name="x_project_id" readonly="1"/>
                    </group>
                    <group string="Task Description">
                        <field name="x_description" placeholder="Add a description..." nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="scrum_task_view_tree" model="ir.ui.view">
        <field name="name">scrum_task_view_tree</field>
        <field name="model">scrum.task</field>
        <field name="arch" type="xml">
            <tree string="Tasks" editable="bottom">
                <field name="x_project_id" invisible="1"/>
                <field name="x_sequence" widget="handle"/>
                <field name="x_priority" widget="priority" class="mr-3"/>
                <field name="x_task_weightage" string="Weightage"/>
                <field name="x_name"/>
                <field name="x_description"/>
                <field name="x_department_id"/>
                <field name="x_user_id"/>
                <field name="x_user_ids" widget="many2many_tags"/>
                <field name="x_stage_id" readonly="1" force_save="1"/>
            </tree>
        </field>
    </record>

    <record id="scrum_task_view_search" model="ir.ui.view">
       <field name="name">scrum_task_view_search</field>
       <field name="model">scrum.task</field>
        <field name="arch" type="xml">
            <search string="Tasks">
                <field name="x_name"/>
                <field name="x_project_id"/>
                <field name="x_department_id"/>
                <field name="x_user_id"/>
                <field name="x_user_ids"/>
                <separator/>
                <filter name="my_tasks" string="My Tasks" domain="[('x_user_id', '=', uid)]"/>
                <filter name="my_participation" string="My Participation" domain="[('x_user_ids', 'ilike', uid)]"/>
                <separator/>
                <filter name="low_priority" string="Low priority" domain="[('x_priority', '=', 0)]"/>
                <filter name="medium_priority" string="Medium priority" domain="[('x_priority', '=', 1)]"/>
                <filter name="high_priority" string="High priority" domain="[('x_priority', '=', 2)]"/>
                <filter name="very_high_priority" string="Very High priority" domain="[('x_priority', '=', 3)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Stage" name="stage" context="{'group_by': 'x_stage_id'}"/>
                    <filter string="Project" name="project" context="{'group_by': 'x_project_id'}"/>
                </group>
            </search>
       </field>
    </record>

    <record id="scrum_task_action" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">scrum.task</field>
        <field name="context">{"search_default_my_tasks": 1}</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
</odoo>

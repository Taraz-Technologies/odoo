<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_payslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Pay Slip</h2>
                        <p t-field="o.name"/>

                        <table class="table table-sm table-bordered">
                            <tr>
                                <td>
                                    <strong>Name</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id"/>
                                </td>
                                <td>
                                    <strong>Designation</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.job_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Email</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.work_email"/>
                                </td>
                                <td>
                                    <strong>Identification No</strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id.identification_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Reference</strong>
                                </td>
                                <td>
                                    <span t-field="o.number"/>
                                </td>
                                <td>
                                    <strong>Currency Rate</strong>
                                </td>
                                <td>
                                    <span t-field="o.x_rate"
                                          t-options='{"widget": "monetary", "display_currency": o.journal_id.currency_id}'/>
                                </td>
                            </tr>
                        </table>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th style="width:50%;">Name</th>
                                    <th style="width:25%;text-align:right;">Amount (USD)</th>
                                    <th style="width:25%;text-align:right;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids.filtered(lambda line:
                                line.appears_on_payslip and line.x_amount_currency &gt; 0 and
                                line.category_id.name in ['Basic', 'Skill Increments', 'Allowance', 'Increments', 'Deduction',  'Bonus', 'Loan', 'Gross'])"
                                    t-as="line">
                                    <td>
                                        <t t-if="line.category_id.name == 'Loan'">
                                            <span>Loan Received</span>
                                        </t>
                                        <t t-elif="line.category_id.name == 'Gross'">
                                            <b style="color:#009999;"><span t-field="line.name"/></b>
                                        </t>
                                        <t t-else="else">
                                            <span t-field="line.name"/>
                                        </t>
                                    </td>
                                    <td style="text-align:right;">
                                        <t t-if="line.category_id.name == 'Gross'">
                                            <b style="color:#009999;">
                                                <span t-esc="line.amount"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </b>
                                        </t>
                                        <t t-elif="line.category_id.name == 'Deduction'">
                                            <span t-esc="-line.amount"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </t>
                                        <t t-else="else">
                                            <span t-esc="line.amount"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </t>
                                    </td>
                                    <td style="text-align:right;">
                                        <t t-if="line.category_id.name == 'Gross'">
                                            <b style="color:#009999;">
                                                <span t-esc="line.x_amount_currency"
                                                      t-options='{"widget": "monetary", "display_currency": o.journal_id.currency_id}'/>
                                            </b>
                                        </t>
                                        <t t-elif="line.category_id.name == 'Deduction'">
                                            <span t-esc="-line.x_amount_currency"
                                                  t-options='{"widget": "monetary", "display_currency": o.journal_id.currency_id}'/>
                                        </t>
                                        <t t-else="else">
                                            <span t-esc="line.x_amount_currency"
                                                  t-options='{"widget": "monetary", "display_currency": o.journal_id.currency_id}'/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h5>Deductions</h5>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th style="width:50%;">Name</th>
                                    <th style="width:25%;text-align:right;">Amount (USD)</th>
                                    <th style="width:25%;text-align:right;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_deduction_usd" t-value="0"/>
                                <t t-set="total_deduction" t-value="0"/>
                                <tr t-foreach="o.line_ids.filtered(lambda line:
                                line.appears_on_payslip and line.x_amount_currency &gt; 0 and
                                line.category_id.name in ['Fine', 'Leaves', 'Loan Return', 'Taxes', 'EOBI'])"
                                    t-as="line">
                                    <td>
                                        <t t-if="line.category_id.name == 'Loan Return'">
                                            <span>Loan Returned</span>
                                        </t>
                                        <t t-elif="line.category_id.name == 'Taxes'">
                                            <t t-if="'Additional' in line.name">
                                                <span>WHT - Income Tax Withheld (Yearly Adjustment)</span>
                                            </t>
                                            <t t-else="else">
                                                <span>WHT - Income Tax Withheld</span>
                                            </t>
                                        </t>
                                        <t t-elif="line.category_id.name == 'EOBI'">
                                            <span>EOBI Deducted</span>
                                        </t>
                                        <t t-else="else">
                                            <span t-field="line.name"/>
                                        </t>
                                    </td>
                                    <td style="text-align:right;">
                                        <span t-esc="-line.amount"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td style="text-align:right;">
                                        <span t-esc="-line.x_amount_currency"
                                              t-options='{"widget": "monetary", "display_currency": o.journal_id.currency_id}'/>
                                    </td>
                                    <t t-set="total_deduction_usd" t-value="total_deduction_usd + line.amount"/>
                                    <t t-set="total_deduction" t-value="total_deduction + line.x_amount_currency"/>
                                </tr>
                                <tr>
                                    <th style="color:#009999;">
                                        <span>Total Deductions</span>
                                    </th>
                                    <th style="text-align:right; color:#009999;">
                                        <span t-esc="-total_deduction_usd"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </th>
                                    <th style="text-align:right; color:#009999;">
                                        <span t-esc="-total_deduction"
                                              t-options='{"widget": "monetary", "display_currency": o.journal_id.currency_id}'/>
                                    </th>
                                </tr>
                            </tbody>
                        </table>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th style="width:50%;">Name</th>
                                    <th style="width:25%;text-align:right;">Amount (USD)</th>
                                    <th style="width:25%;text-align:right;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids.filtered(lambda line:
                                line.appears_on_payslip and line.x_amount_currency &gt; 0 and
                                line.category_id.name in ['Gross', 'EOBI', 'Net'])"
                                    t-as="line">
                                    <td>
                                        <t t-if="line.category_id.name == 'EOBI'">
                                            <span>Deductions</span>
                                        </t>
                                        <t t-elif="line.category_id.name == 'Net'">
                                            <b style="color:#009999;"><span t-field="line.name"/></b>
                                        </t>
                                        <t t-else="else">
                                            <span t-field="line.name"/>
                                        </t>
                                    </td>
                                    <td style="text-align:right;">
                                        <t t-if="line.category_id.name == 'EOBI'">
                                            <span t-esc="-total_deduction_usd"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </t>
                                        <t t-elif="line.category_id.name == 'Net'">
                                            <b style="color:#009999;">
                                                <span t-esc="line.amount"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </b>
                                        </t>
                                        <t t-else="else">
                                            <span t-esc="line.amount"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </t>
                                    </td>
                                    <td style="text-align:right;">
                                        <t t-if="line.category_id.name == 'EOBI'">
                                            <span t-esc="-total_deduction"
                                                  t-options='{"widget": "monetary", "display_currency": o.journal_id.currency_id}'/>
                                        </t>
                                        <t t-elif="line.category_id.name == 'Net'">
                                            <b style="color:#009999;">
                                                <span t-esc="line.x_amount_currency"
                                                      t-options='{"widget": "monetary", "display_currency": o.journal_id.currency_id}'/>
                                            </b>
                                        </t>
                                        <t t-else="else">
                                            <span t-esc="line.x_amount_currency"
                                                  t-options='{"widget": "monetary", "display_currency": o.journal_id.currency_id}'/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="clearfix" t-if="o.salary_payments_widget != ''">
                            <div class="row">
                                <div class="col-4"/>
                                <div class="col-8">
                                    <table class="table table-sm">
                                        <t t-set="payments_vals" t-value="o.get_payment_vals()"/>
                                        <t t-foreach="payments_vals" t-as="payments">
                                            <tr>
                                                <td>
                                                    <t t-esc="payments['paid_from']"/>
                                                </td>
                                                <td class="text-right">
                                                    <span t-field="o.journal_id.currency_id.symbol"/>
                                                    <span t-esc="'{0:,.2f}'.format(payments['payment_amount'])" t-if="o.x_show_balance_in_report"/>
                                                    <span t-esc="'{0:,.2f}'.format(payments['amount'])" t-if="not o.x_show_balance_in_report"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <tr class="o_subtotal" t-if="o.x_show_balance_in_report">
                                            <td>
                                                <span>Balance</span>
                                            </td>
                                            <td class="text-right">
                                                <span t-field="o.journal_id.currency_id.symbol"/>
                                                <span t-esc="'{0:,.2f}'.format(payments_vals[0]['balance'])"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
